{
  "name": "rcktbs.astro",
  "version": "0.1.0",
  "description": "Southwell Astro Boilerplate - A production-ready starter template built on Astro 6 and Tailwind CSS v4",
  "type": "module",
  "author": "Southwell Media",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-theme",
    "theme",
    "tailwind",
    "tailwindcss",
    "typescript",
    "blog",
    "starter",
    "boilerplate",
    "seo"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm lint && pnpm check && pnpm build && pnpm check:links",
    "test": "vitest",
    "test:e2e": "playwright test",
    "og:capture": "tsx scripts/capture-og-screenshots.ts",
    "check:links": "tsx scripts/check-links.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@calcom/embed-react": "^1.5.3",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@netlify/blobs": "^10.7.13",
    "astro": "7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "satori": "^0.28.2",
    "satori-html": "^0.3.2",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "@netlify/functions": "^5.3.0",
    "@pagefind/default-ui": "^1.5.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
