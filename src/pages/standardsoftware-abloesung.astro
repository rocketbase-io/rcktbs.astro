---
/**
 * Standardsoftware ablösen: keine vierte Tür, sondern „das Ganze“ quer über Angebot, Einsatz und
 * Zahlen. Inhalt in components/abloesung/AbloesungPage.astro. Seit 2026-10-07 neu, ohne Funnel.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Image } from 'astro:assets';
import Landschaft from '@/components/abloesung/Landschaft.astro';
import SchlankPage from '@/components/funnel-schlank/SchlankPage.astro';
import Abloeseplan from '@/components/abloesung/Abloeseplan.astro';
import AbloeseplanMobil from '@/components/funnel-schlank/AbloeseplanMobil.astro';
import HeuteAbloesung from '@/components/abloesung/HeuteAbloesung.astro';
import kundenstandorte from '@/assets/references/kundenstandorte-uebersicht-demo-1920.png';
import { eigeneSoftware, preisFrage } from '@/data/funnelSchlank';
import { additionalCases, cases } from '@/data/rocketbase';
import { abloesungFaqs } from '@/components/abloesung/faqs';
import { createServiceSchema, createFAQSchema } from '@/lib/schema';

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const serviceSchema = createServiceSchema({
  name: 'Standardsoftware-Ablösung',
  description:
    'Ablösung gewachsener Branchensoftware durch eine eigene Anwendung, die zum tatsächlichen Ablauf passt. Schrittweise im Parallelbetrieb, mit Übernahme der gesamten Datenhistorie.',
  url: pageUrl,
  serviceType: 'Ablösung von Standardsoftware durch Individualentwicklung',
  areaServed: 'DE',
});
const stimme = [...cases, ...additionalCases].find((c) => c.slug === 'sam-vorteilsguru')?.testimonial;
---

<LandingLayout
  title="Branchensoftware ablösen: eigene Software statt Vertec oder Centric"
  description="Eigene Software Stück für Stück einführen, das alte Programm läuft weiter, bis das Neue trägt. Vieles davon läuft schon bei anderen Betrieben. Für Betriebe ab etwa 30 Leuten."
  lang="de"
  routeId="standardsoftwareAbloesung"
  extraSchemas={[serviceSchema, createFAQSchema(abloesungFaqs.map((f) => ({ question: f.q, answer: f.a })))]}
>
  <SchlankPage mehrTitel="Aus vielen Programmen wird eins, Stück für Stück" tor={eigeneSoftware} modus="seite" blogTuer="abloesung" faqs={[preisFrage, ...abloesungFaqs]} headline="Eigene Software statt Branchensoftware, Schritt für Schritt" zitat={stimme}>
  <Image
    slot="hero"
    src={kundenstandorte}
    alt="Kundenstandorte und Berater auf einer Deutschlandkarte, Demo-Daten"
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 50vw, 100vw"
    class="border-border w-full rounded-2xl border shadow-xl"
    loading="eager"
  />
  <div class="hidden lg:block"><Abloeseplan variante="funnel" /></div>
  <AbloeseplanMobil class="lg:hidden" />
  <HeuteAbloesung slot="heute" />
  <Landschaft slot="mehr" />
</SchlankPage>
</LandingLayout>
