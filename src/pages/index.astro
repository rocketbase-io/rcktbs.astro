---
import SeitenHero from '@/components/landing/SeitenHero.astro';
import kundenstandorte from '@/assets/references/kundenstandorte-uebersicht-demo-1920.png';
import auftragsplanung from '@/assets/references/auftragsplanung-demo-1920.png';
import cockpit from '@/assets/references/cockpit-demo-1920.png';
import angebotBild from '@/assets/references/angebot-db-demo-1920.png';
import BildWechsler from '@/components/landing/BildWechsler.astro';
import MiniVisual from '@/components/loesungen/MiniVisual.astro';
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import { ClientLogoStrip } from '@/components/ui/marketing/ClientLogoStrip';
import { TestimonialCarousel } from '@/components/ui/marketing/TestimonialCarousel';
import { getCollection } from 'astro:content';
import { defaultLocale } from '@/i18n/config';
import { getLocalizedPath } from '@/i18n/index';
import { getReadingTime } from '@/lib/utils';
import founderImage from '@/assets/rocketbase/founder-marten-priess.jpg';
import statistaCaseImage from '@/assets/references/teaser-statista.jpeg';
import fkcCaseImage from '@/assets/references/teaser-fkc.jpeg';
import schlossereiCaseImage from '@/assets/references/teaser-schlosserei.jpeg';
import logomark from '@/assets/branding/logomark.svg?url';
import logomarkDark from '@/assets/branding/logomark-dark.svg?url';
import {
  cases,
  additionalCases,
  contactLinks,
} from '@/data/rocketbase';

const locale = defaultLocale;
const servicesUrl = getLocalizedPath('services', locale);
const contactUrl = getLocalizedPath('contact', locale);
const workUrl = getLocalizedPath('work', locale);
const referencesUrl = '/referenzen/';
const standardsoftwareUrl = getLocalizedPath('standardsoftwareAbloesung', locale);
const einsatzplanungUrl = getLocalizedPath('einsatzplanung', locale);

type FeaturedCase = (typeof cases)[number] & { image?: ImageMetadata };

// Die Angebotstreppe: jede Stufe hat einen Preis und ein Ergebnis, und jede
// Stufe bepreist die nächste. Nur hier auf der Startseite — /leistungen nutzt
// weiter die allgemeinen processSteps.
const heroBilder = [
  { src: angebotBild, alt: 'Angebot mit Positionen, Stunden und Gewinn je Baustein, Demo-Daten' },
  { src: auftragsplanung, alt: 'Auftragsplanung mit Mitarbeitern, Einsätzen und Krankmeldungen, Demo-Daten' },
  { src: cockpit, alt: 'Cockpit mit Umsatz, Auslastung und Forderungen, Demo-Daten' },
  { src: kundenstandorte, alt: 'Kundenstandorte und Berater auf einer Deutschlandkarte, Demo-Daten' },
];

// Kurzfassung der früheren Abschnitte „Drei Dinge“ und „Weniger Overhead“.
const kurzStaerken = [
  { titel: 'Ihr sprecht mit dem Gründer', text: 'Marten Prieß sitzt selbst in den Workshops und trifft die wichtigen Entscheidungen.' },
  { titel: 'Erfahrung aus dem Konzern', text: 'Auch bonprix und Statista gehören zu unseren Projekten. Das bringen wir in den Mittelstand.' },
  { titel: 'Ein kleines, festes Team', text: 'Wenige Übergaben, kurze Wege und ein Ansprechpartner vom ersten Gespräch bis in den Betrieb.' },
];

const ladderSteps = [
  {
    title: 'Erstgespräch',
    price: 'kostenlos',
    description:
      '30 Minuten direkt mit Marten Prieß. Ihr zeigt uns, wo es klemmt, gern an einem echten Beispiel. Wir sagen ehrlich, ob sich ein nächster Schritt lohnt.',
  },
  {
    title: 'Workshop',
    price: 'fester Preis',
    description:
      'Drei Termine: Aufnahme, Abstimmung, Übergabe. Am Ende steht euer Ablauf schriftlich, ein Zielbild für die erste Stufe und ein Festpreis für die Umsetzung. Das Dokument gehört euch.',
  },
  {
    title: 'Umsetzung',
    price: 'Festpreis, inkl. Betrieb im ersten Jahr',
    description:
      'In Wochen live, wo wir auf laufenden Bausteinen aus unseren Projekten aufsetzen. Individuell, wo euer Prozess besonders ist. Hosting, Updates und Betrieb im ersten Jahr sind drin.',
  },
  {
    title: 'Betrieb',
    price: 'ab Jahr 2 jährliche Pauschale',
    description:
      'Hosting in Deutschland, Backups, Updates, kleine Anpassungen. Ohne Lizenzkosten, egal wie viele bei euch damit arbeiten: Ihr zahlt für den Betrieb, nicht für die Nutzung.',
  },
];

const caseImageMap: Record<string, ImageMetadata> = {
  'fkc-consulting': fkcCaseImage,
  'schlosserei-diezinger': schlossereiCaseImage,
  statista: statistaCaseImage,
};

// Startseiten-Auswahl: drei Fälle, in denen sich ein Mittelständler wiederfindet —
// FKC (Standardsoftware-Ablösung, Hauptfokus), Schlosserei Diezinger
// (Einsatzplanung) und Statista (Altsystem im laufenden Betrieb ablösen).
const featuredSlugs = ['fkc-consulting', 'schlosserei-diezinger', 'statista'];
const caseBySlug = new Map([...cases, ...additionalCases].map((c) => [c.slug, c]));
const featuredCases: FeaturedCase[] = featuredSlugs
  .map((slug) => caseBySlug.get(slug))
  .filter((entry): entry is (typeof cases)[number] => Boolean(entry))
  .map((entry) => ({ ...entry, image: caseImageMap[entry.slug] }));

// Bewusst die Stärken, die NICHT schon im Marten-Block stehen (direkte
// Zusammenarbeit / Team sind dort abgedeckt): Konzernniveau, Datenmigration
// aus Altsystemen und die Bereitschaft zu widersprechen.

// "Wofür wir gerufen werden" – drei Türen, durch die ein Betrieb einsteigt. Jede ist
// ein Prozess, der heute in Excel, Word oder einer verbogenen Branchensoftware steckt.
const calledForSituations = [
  {
    icon: 'edit',
    visual: 'angebot' as const,
    eyebrow: 'Angebot & Kalkulation',
    title: 'Ihr rechnet in Excel und schreibt in Word',
    text: 'Jemand tippt die Zahlen ab, und was ein Auftrag einbringt, seht ihr erst hinterher.',
    href: '/angebote/',
    cta: 'Angebote ansehen',
  },
  {
    icon: 'users',
    visual: 'einsatz' as const,
    eyebrow: 'Einsatz & Abrechnung',
    title: 'Ihr plant in Excel und telefoniert bei jeder Änderung',
    text: 'Stunden kommen auf Zetteln zurück, und jede Rechnung wird von Hand zusammengebaut.',
    href: einsatzplanungUrl,
    cta: 'Einsatzplanung ansehen',
  },
  {
    icon: 'table',
    visual: 'zahlen' as const,
    eyebrow: 'Zahlen & Steuerung',
    title: 'Eure Zahlen sind alt, wenn sie da sind',
    text: 'Der Monatsabschluss dauert Tage, und auslaufende Verträge fallen zu spät auf.',
    href: '/zahlen/',
    cta: 'Zahlen ansehen',
  },
];

const clientLogos = [
  { key: 'bonprix_logo', name: 'bonprix' },
  { key: 'statista-logo', name: 'Statista' },
  { key: 'stage_logo', name: 'Stage Entertainment' },
  { key: 'delta-sport_logo', name: 'Delta-Sport' },
  { key: 'fkc_logo', name: 'FKC Consulting' },
  { key: 'mavox_logo', name: 'MAVOX Winterdienst' },
  { key: 'sam', name: 'Smart Active Media' },
  { key: 'yomei_logo', name: 'YOMEI' },
  { key: 'venus_logo', name: 'Venus' },
  { key: 'stueckgut', name: 'Stückgut' },
];

const portraitModules = import.meta.glob<{ default: ImageMetadata }>(
  '@/assets/testimonials/*.{jpeg,jpg,png,webp}',
  { eager: true },
);
const portraitMap: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(portraitModules).map(([path, mod]) => {
    const key = path.split('/').pop()!.replace(/\.(jpe?g|png|webp)$/i, '');
    return [key, mod.default];
  }),
);

const allCases = [...cases, ...additionalCases];
const testimonialItems = allCases
  .filter((c) => c.testimonial)
  .map((c) => {
    const t = c.testimonial!;
    return {
      quote: t.quote,
      author: t.author,
      position: t.position,
      client: c.client,
      portrait: t.portraitKey ? portraitMap[t.portraitKey] : undefined,
    };
  });

const getReferenceUrl = (slug: string) => `${referencesUrl}${slug}/`;

const featuredBlogPosts = (
  await getCollection('blog', ({ data }) => {
    return data.locale === locale && data.featured === true && (import.meta.env.PROD ? data.draft !== true : true);
  })
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);

const getBlogPostUrl = (postId: string) => '/blog/' + postId.replace(locale + '/', '') + '/';
---

<LandingLayout
  title="Individualsoftware für den Mittelstand"
  description="Software, die nach euren Regeln rechnet: Angebot, Einsatz, Zahlen. Für Betriebe, die neben der Branchensoftware in Excel arbeiten. Erstgespräch kostenlos."
  includeOrgSchema
  lang={locale}
  routeId="home"
>
  <SeitenHero eyebrow="Eigene Software für den Mittelstand" titel="Software für Betriebe," titelFarbe="die nicht in Standardlösungen passen." text="Was euer ERP oder eure Branchensoftware nicht kann, läuft heute daneben in Excel. Wir bauen die Software dafür, nach euren Regeln." zweiterKnopf={{ text: 'Leistungen ansehen', href: servicesUrl }}>
    <BildWechsler bilder={heroBilder} />
  </SeitenHero>

  <div id="hero-next" class="scroll-mt-24" aria-hidden="true" />

  <script is:inline>
    (() => {
      const hero = document.querySelector('[data-hero-root]');
      const copy = document.querySelector('[data-hero-copy]');

      if (!hero || !copy) return;

      let ticking = false;

      const updateHeroProgress = () => {
        const rect = hero.getBoundingClientRect();
        const viewport = window.innerHeight || 1;
        const progress = Math.min(Math.max(-rect.top / viewport, 0), 1);

        copy.style.transform = `translate3d(0, ${progress * 36}px, 0)`;
        copy.style.opacity = `${1 - progress * 0.22}`;

        ticking = false;
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateHeroProgress);
      };

      updateHeroProgress();
      document.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    })();
  </script>

  <section class="border-border border-b py-14 sm:py-24 lg:py-32">
    <div class="container">
      <div data-reveal>
        <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">Wofür wir gerufen werden</p>
        <h2 class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          Wo wir Betrieben{' '}
          <span class="text-brand-500">am meisten helfen</span>
        </h2>
        <p class="text-foreground-secondary mt-6 text-lg leading-8">
          Meistens hakt es an einer von drei Stellen. Dort fangen wir an.
        </p>
      </div>

      <div class="mt-16 grid gap-x-6 gap-y-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-y-0">
        {
          calledForSituations.map((situation) => (
            <article
              data-reveal
              class="group relative flex cursor-pointer flex-col lg:row-span-6 lg:grid lg:grid-rows-subgrid lg:gap-y-0 rounded-[2rem] border border-border bg-card p-7 shadow-sm transition-[transform,box-shadow,border-color] duration-300 hover:border-brand-300 hover:shadow-[0_28px_60px_rgba(34,43,74,0.12)] has-[a:focus-visible]:ring-2 has-[a:focus-visible]:ring-brand-500 has-[a:focus-visible]:ring-offset-2 sm:p-7"
            >
              <div class="mb-6">
                <MiniVisual kind={situation.visual} />
              </div>
              <div class="flex items-center gap-4">
                <div class="bg-brand-50 text-brand-600 dark:bg-brand-900/30 dark:text-brand-100 group-hover:bg-brand-500 group-hover:text-on-invert inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl transition-all duration-300 group-hover:scale-110">
                  <Icon name={situation.icon} size="md" />
                </div>
                <p class="text-brand-600 text-xs font-semibold tracking-[0.22em] uppercase">
                  {situation.eyebrow}
                </p>
              </div>
              <h3 class="font-display text-foreground mt-6 text-xl font-semibold leading-snug sm:text-2xl">
                {situation.title}
              </h3>
              <p class="text-foreground-secondary mt-4 text-base leading-7">{situation.text}</p>
              <div class="mt-auto pt-8">
                <a
                  href={situation.href}
                  class="tuer-cta flex items-center justify-between gap-3 rounded-2xl border border-brand-300/70 bg-brand-500/5 py-2.5 pr-2.5 pl-5 text-sm font-semibold text-brand-600 transition-colors duration-300 group-hover:border-brand-500 group-hover:bg-brand-500 group-hover:text-white focus-visible:outline-none after:absolute after:inset-0 after:rounded-[2rem] after:content-[''] dark:text-brand-200"
                >
                  {situation.cta}
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-500 text-white transition-[transform,background-color] duration-300 group-hover:translate-x-0.5 group-hover:bg-white/20">
                    <Icon name="arrow-right" size="sm" />
                  </span>
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Oder das Ganze -->
      <a
        href={standardsoftwareUrl}
        data-reveal
        class="group border-brand-300/70 bg-card hover:border-brand-400 dark:border-brand-700 mt-5 grid items-center gap-6 overflow-hidden rounded-[1.6rem] border p-5 shadow-sm transition-[transform,box-shadow] duration-300 hover:shadow-[0_26px_55px_-28px_oklch(40%_0.1_265_/_0.45)] md:grid-cols-[minmax(0,1fr)_17rem] md:p-7"
      >
        <div>
          <p class="text-foreground-muted text-xs font-semibold tracking-[0.2em] uppercase">Oder das Ganze</p>
          <h3 class="font-display text-foreground mt-2 text-2xl font-bold tracking-tight">Standardsoftware ablösen</h3>
          <p class="text-foreground-secondary mt-2 max-w-xl text-sm leading-6 sm:text-base sm:leading-7">
            Wenn mehr fehlt als ein einzelner Teil: Wir lösen eure Branchensoftware und die Excel-Listen
            drumherum Schritt für Schritt ab. Das Alte läuft daneben weiter, und eure ganze Datenhistorie
            zieht mit.
          </p>
          <span class="text-brand-600 mt-4 inline-flex items-center gap-2 text-sm font-semibold transition-transform duration-300 group-hover:translate-x-1">
            So läuft eine Ablösung
            <Icon name="arrow-right" size="sm" />
          </span>
        </div>
        <MiniVisual kind="abloesung" />
      </a>

      <!-- Oder erst prüfen: für Betriebe, die Software schon haben -->
      <a
        href="/software-check/"
        data-reveal
        class="group border-border bg-card hover:border-brand-300 mt-5 grid items-center gap-6 overflow-hidden rounded-[1.6rem] border p-5 shadow-sm transition-[transform,box-shadow,border-color] duration-300 hover:shadow-[0_26px_55px_-28px_oklch(40%_0.1_265_/_0.45)] md:grid-cols-[minmax(0,1fr)_17rem] md:p-7"
      >
        <div>
          <p class="text-foreground-muted text-xs font-semibold tracking-[0.2em] uppercase">Ihr baut selbst</p>
          <h3 class="font-display text-foreground mt-2 text-2xl font-bold tracking-tight">Software-Check</h3>
          <p class="text-foreground-secondary mt-2 max-w-xl text-sm leading-6 sm:text-base sm:leading-7">
            Ihr habt mit KI gebaut und wollt technischen Rat von jemandem, der es auch könnte? Ein
            erfahrener Entwickler und Architekt prüft Sicherheit, Struktur und Betrieb. Den Bericht könnt
            ihr Kunden und Auditoren vorlegen.
          </p>
          <span class="text-brand-600 mt-4 inline-flex items-center gap-2 text-sm font-semibold transition-transform duration-300 group-hover:translate-x-1">
            Was geprüft wird
            <Icon name="arrow-right" size="sm" />
          </span>
        </div>
        <MiniVisual kind="check" />
      </a>
    </div>
  </section>

  <section class="border-border relative overflow-hidden border-b py-14 sm:py-24 lg:py-28">
    <div class="bg-brand-300/10 absolute left-0 top-1/3 h-80 w-80 rounded-full blur-3xl" />
    <div class="container relative z-10 grid items-center gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
      <div
        data-reveal
        class="group relative mx-auto w-full max-w-[220px] sm:max-w-[260px] lg:max-w-none"
      >
        <div class="bg-brand-300/15 absolute -inset-3 -z-10 rounded-[2rem] blur-2xl" aria-hidden="true" />
        <div class="overflow-hidden rounded-[1.8rem] border border-border shadow-[0_20px_50px_rgba(34,43,74,0.12)] rotate-[-2.5deg] transition-transform duration-500 will-change-transform [backface-visibility:hidden] group-hover:rotate-0">
          <Picture
            src={founderImage}
            alt="Marten Prieß, Gründer von RocketBase"
            widths={[220, 260, 320, 440, 520, 640, 780, 960]}
            sizes="(max-width: 640px) 220px, (max-width: 1024px) 260px, 320px"
            formats={['avif', 'webp']}
            class="aspect-[2/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
            loading="lazy"
          />
        </div>
      </div>

      <div data-reveal>
        <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">Über RocketBase</p>
        <h2 class="font-display text-foreground mt-6 text-3xl font-bold tracking-tight sm:text-4xl">
          Marten Prieß
          <span class="mt-2 block text-brand-500">und ein kleines, festes Entwicklerteam.</span>
        </h2>
        <p class="text-foreground-muted mt-4 text-sm font-medium tracking-wide">
          Diplom-Wirtschaftsinformatiker
        </p>
        <p class="text-foreground-secondary mt-6 text-lg leading-8">
          Ihr arbeitet direkt mit dem Gründer, im Rücken ein festes Team aus Entwicklerinnen und
          Entwicklern. Einer, der zuhört, die beiläufige Idee im Gespräch aufgreift und den besseren
          Prozess vorschlägt, wenn er einen sieht.
        </p>
        <p class="text-foreground-secondary mt-5 hidden text-lg leading-8 sm:block">
          Was in Konzernprojekten bei bonprix und Statista funktioniert hat, landet so direkt in
          eurem Projekt. Mit kurzen Wegen statt Abstimmungsschleifen.
        </p>
        <div data-reveal class="mt-8 flex flex-wrap gap-4">
          <Button href={contactLinks.cal} target="_blank">
            Erstgespräch buchen
            <Icon name="arrow-up-right" size="sm" />
          </Button>
          <Button variant="outline" href={workUrl}>
            So arbeiten wir
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>

        <div class="border-border/70 text-foreground-muted mt-10 grid gap-4 border-t pt-8 text-sm sm:grid-cols-3">
          <div data-reveal>
            <p class="text-foreground font-semibold">Seit 2016</p>
            <p class="mt-2 leading-6">Aufbau von Digitalprodukten und internen Plattformen.</p>
          </div>
          <div data-reveal>
            <p class="text-foreground font-semibold">bonprix &amp; Statista</p>
            <p class="mt-2 leading-6">Konzern-Erfahrung, übertragen auf mittelständische Realitäten.</p>
          </div>
          <div data-reveal>
            <p class="text-foreground font-semibold">Discovery bis Betrieb</p>
            <p class="mt-2 leading-6">Konzeption, Delivery, Integration und Weiterentwicklung aus einer Hand.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ClientLogoStrip
    heading="Erfahrung aus Projekten mit"
    logos={clientLogos}
    variant="subtle"
  />

  <section class="border-border border-b py-12 lg:py-16">
    <div class="container grid gap-6 lg:grid-cols-3 lg:gap-8">
      {
        kurzStaerken.map((s) => (
          <div>
            <p class="font-display text-foreground text-lg font-bold">{s.titel}</p>
            <p class="text-foreground-secondary mt-1.5 text-[0.95rem] leading-7">{s.text}</p>
          </div>
        ))
      }
    </div>
  </section>





  <section class="border-border border-b py-14 sm:py-28 lg:py-36">
    <div class="container">
      <div data-reveal>
        <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">Referenzen</p>
        <h2 class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          Was wir für
          <span class="mt-2 block text-brand-500">andere Betriebe gebaut haben</span>
        </h2>
        <p class="text-foreground-secondary mt-6 text-lg leading-8">
          Standardsoftware abgelöst, Einsatzplanung aus Excel geholt, Budgets in eine eigene Software gebracht.
        </p>
      </div>

      <div class="mt-16 grid gap-6 lg:grid-cols-3 lg:items-stretch">
        {
          featuredCases.map((item) => (
            <article
              data-reveal
              class="group flex flex-col overflow-hidden rounded-[2rem] border border-border bg-card shadow-sm transition-shadow hover:shadow-lg"
            >
              <a href={getReferenceUrl(item.slug)} class="flex h-full flex-col">
                <div class="overflow-hidden">
                  {item.image && (
                    <Picture
                      src={item.image}
                      alt={item.heading}
                      widths={[320, 480, 640, 960]}
                      sizes="(max-width: 1024px) 100vw, 33vw"
                      formats={['avif', 'webp']}
                      class="aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
                      loading="lazy"
                    />
                  )}
                </div>
                <div class="flex flex-1 flex-col p-6">
                  <p class="text-brand-600 text-xs font-semibold tracking-[0.22em] uppercase">{item.client}</p>
                  <h3 class="text-foreground mt-3 text-xl leading-snug font-semibold">{item.heading}</h3>
                  <div class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-brand-600">
                    Projekt ansehen
                    <Icon name="arrow-right" size="sm" />
                  </div>
                </div>
              </a>
            </article>
          ))
        }
      </div>

      <div class="mt-10 flex justify-start" data-reveal>
        <Button variant="outline" href={referencesUrl}>
          Alle Referenzen ansehen
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>

  {testimonialItems.length > 0 && (
    <section class="border-border border-b py-12 sm:py-20 lg:py-24">
      <div class="container max-w-2xl">
        <header class="mb-10" data-reveal>
          <p class="text-brand-600 text-xs font-semibold tracking-[0.22em] uppercase">
            Stimmen aus Projekten
          </p>
          <h2 class="font-display text-foreground mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Was unsere Kunden sagen
          </h2>
        </header>
        <div data-reveal>
          <TestimonialCarousel items={testimonialItems} />
        </div>
      </div>
    </section>
  )}

  {featuredBlogPosts.length > 0 && (
    <section class="hidden lg:block border-border border-b py-12 sm:py-20 lg:py-24">
      <div class="container">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between" data-reveal>
          <div class="max-w-2xl">
            <p class="text-brand-600 text-xs font-semibold tracking-[0.22em] uppercase">
              Einblicke aus der Praxis
            </p>
            <h2 class="font-display text-foreground mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
              Aus unseren Projekten
            </h2>
          </div>
          <a
            href="/blog/"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 hover:text-brand-500 dark:text-brand-400 dark:hover:text-brand-300 transition-colors"
          >
            Alle Beiträge
            <Icon name="arrow-right" size="sm" />
          </a>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-2" data-reveal="fade-up">
          {featuredBlogPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              href={getBlogPostUrl(post.id)}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
              image={post.data.image}
              readingTime={getReadingTime(post.body ?? '')}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="border-border bg-surface-invert text-on-invert border-b py-14 sm:py-28 lg:py-36">
    <div class="container grid gap-14 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
      <div data-reveal class="lg:sticky lg:top-28">
        <p class="text-brand-300 text-sm font-semibold tracking-[0.22em] uppercase">So startet ihr</p>
        <h2 class="font-display mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          So fangen wir an:
          <span class="mt-2 block text-brand-200">Jede Stufe hat einen Preis und ein Ergebnis</span>
        </h2>
        <p class="text-on-invert-secondary mt-6 text-lg leading-8">
          Nach jeder Stufe könnt ihr aufhören, das Ergebnis behaltet ihr.
        </p>
      </div>

      <div class="space-y-5">
        {
          ladderSteps.map((step, index) => (
            <article
              data-reveal
              class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur sm:rounded-[2rem] sm:p-7"
            >
              <div class="flex items-center gap-4 sm:grid sm:gap-5 md:grid-cols-[72px_1fr] md:items-start">
                <div class="text-brand-300 shrink-0 text-sm font-semibold">0{index + 1}</div>
                <div>
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <h3 class="text-on-invert text-lg font-semibold sm:text-2xl">{step.title}</h3>
                    <span class="text-brand-200 text-xs font-semibold tracking-wide uppercase sm:text-sm">
                      {step.price}
                    </span>
                  </div>
                  <p class="text-on-invert-secondary mt-3 hidden text-base leading-7 sm:block">{step.description}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>


  <section id="cta" class="py-14 sm:py-28 lg:py-36">
    <div class="container">
      <div class="relative overflow-hidden rounded-[2.8rem] border border-border bg-background-secondary p-8 shadow-[0_24px_60px_rgba(34,43,74,0.08)] sm:p-10 lg:p-12">
        <img
          src={logomark}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute -right-12 -top-16 hidden w-72 opacity-[0.06] select-none lg:block dark:hidden"
        />
        <img
          src={logomarkDark}
          alt=""
          aria-hidden="true"
          class="pointer-events-none absolute -right-12 -top-16 hidden w-72 opacity-[0.08] select-none dark:lg:block"
        />
        <div data-reveal class="relative max-w-4xl">
          <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">Nächster Schritt</p>
          <h2
            lang="de"
            class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight text-balance hyphens-auto [-webkit-hyphens:auto] sm:text-4xl"
          >
            Software,{' '}
            <span class="text-brand-500">die zu eurem Betrieb passt</span>
          </h2>
          <p class="text-foreground-secondary mt-6 max-w-3xl text-lg leading-8">
            Wenn Prozesse mehr bremsen als tragen, lohnt ein strukturierter Blick von außen. Wir
            ordnen ein, was zuerst drankommt, und bauen die Lösung anschließend mit euch.
          </p>
        </div>

        <div
          data-reveal="fade-up"
          class="mt-10 rounded-[2rem] border border-border bg-card p-7 sm:p-8"
        >
          <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
            <div class="text-foreground-muted grid gap-4 text-sm sm:grid-cols-2 sm:gap-6">
              <div class="flex items-center gap-3">
                <Icon name="clock" size="sm" class="text-brand-500 shrink-0" />
                30 Minuten direkt mit dem Gründer
              </div>
              <div class="flex items-center gap-3">
                <Icon name="mail" size="sm" class="text-brand-500 shrink-0" />
                <span class="break-all">{contactLinks.email}</span>
              </div>
            </div>
            <div class="flex flex-wrap items-center gap-4 lg:justify-end">
              <Button href={contactLinks.cal} target="_blank">
                Erstgespräch buchen
                <Icon name="arrow-up-right" size="sm" />
              </Button>
              <Button variant="link" href={`${contactUrl}#anfrage-stellen`}>
                Lieber schreiben
                <Icon name="arrow-right" size="sm" />
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>
