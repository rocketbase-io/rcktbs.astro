---
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import { ClientLogoStrip } from '@/components/ui/marketing/ClientLogoStrip';
import { TestimonialCarousel } from '@/components/ui/marketing/TestimonialCarousel';
import { getCollection } from 'astro:content';
import { defaultLocale } from '@/i18n/config';
import { getLocalizedPath } from '@/i18n/index';
import { getReadingTime } from '@/lib/utils';
import founderImage from '@/assets/rocketbase/founder-marten-priess.jpg';
import statistaCaseImage from '@/assets/references/teaser-statista.jpeg';
import fkcCaseImage from '@/assets/references/teaser-fkc.jpeg';
import schlossereiCaseImage from '@/assets/references/teaser-schlosserei.jpeg';
import toolsBefore from '@/assets/work/tools-before.png';
import toolsAfter from '@/assets/work/tools-after.png';
import logomark from '@/assets/branding/logomark.svg?url';
import logomarkDark from '@/assets/branding/logomark-dark.svg?url';
import {
  cases,
  additionalCases,
  contactLinks,
  discoveryOffer,
  processSteps,
  serviceAreas,
  strengths,
} from '@/data/rocketbase';

const locale = defaultLocale;
const servicesUrl = getLocalizedPath('services', locale);
const contactUrl = getLocalizedPath('contact', locale);
const missionUrl = getLocalizedPath('mission', locale);
const workshopUrl = getLocalizedPath('discoveryWorkshop', locale);
const referencesUrl = '/referenzen/';
const workUrl = getLocalizedPath('work', locale);
const standardsoftwareUrl = getLocalizedPath('standardsoftwareAbloesung', locale);
const einsatzplanungUrl = getLocalizedPath('einsatzplanung', locale);

type FeaturedCase = (typeof cases)[number] & { image?: ImageMetadata };

const caseImageMap: Record<string, ImageMetadata> = {
  statista: statistaCaseImage,
  'fkc-consulting': fkcCaseImage,
  'schlosserei-diezinger': schlossereiCaseImage,
};

// Startseiten-Auswahl, konsistent mit Nav-Dropdown und Referenz-Übersicht:
// FKC (Standardsoftware-Ablösung, Hauptfokus), Statista (Konzern-Track-Record)
// und Schlosserei Diezinger (Einsatzplanung im Mittelstand).
const featuredSlugs = ['fkc-consulting', 'statista', 'schlosserei-diezinger'];
const caseBySlug = new Map([...cases, ...additionalCases].map((c) => [c.slug, c]));
const featuredCases: FeaturedCase[] = featuredSlugs
  .map((slug) => caseBySlug.get(slug))
  .filter((entry): entry is (typeof cases)[number] => Boolean(entry))
  .map((entry) => ({ ...entry, image: caseImageMap[entry.slug] }));

// Bewusst die Stärken, die NICHT schon im Marten-Block stehen (direkte
// Zusammenarbeit / Team sind dort abgedeckt): Konzernniveau, Open-Source-
// Pragmatismus und zukunftssichere Übergabe.
const topStrengths = [strengths[1], strengths[3], strengths[4]];

// "Wofür wir gerufen werden" – genau zwei benannte Situationen, jede führt auf
// eine eigene, scharfe Sub-Landingpage. Bewusst nur zwei, kein dritter Einstieg.
const calledForSituations = [
  {
    icon: 'box',
    eyebrow: 'Standardsoftware am Limit',
    title: 'Vertec, Centric oder ein ähnliches System wächst nicht mehr mit.',
    text: 'Egal ob bekanntes Branchensystem oder selbst gewachsene Lösung: Über die Jahre so weit verbogen, dass sie eure Arbeit eher behindert als trägt. Ihr arbeitet drumherum statt damit – und jede Stunde, die dafür draufgeht, fehlt in der fakturierbaren Leistung.',
    points: [
      'Updates werden zum Risiko – also bleiben sie aus',
      'Neben dem teuren System läuft längst eine Excel-Welt mit',
      'Bei den eigenen Zahlen bleibt ein ungutes Bauchgefühl',
    ],
    href: standardsoftwareUrl,
    cta: 'Standardsoftware ablösen',
  },
  {
    icon: 'table',
    eyebrow: 'Steuerung über Excel',
    title: 'Disposition, Einsatzplanung und Abrechnung laufen über Excel.',
    text: 'Auftrag, Disposition, Einsatz, Erfassung, Abrechnung – die ganze Kette hängt in gewachsenen Tabellen. Mit dem Betrieb wächst der manuelle Aufwand schneller als der Umsatz, und keiner hat den Echtzeit-Überblick.',
    points: [
      'Wer wann an was arbeitet, steckt in Köpfen und Tabellen',
      'Abwesenheiten und Auslastung müssen mühsam gepflegt werden',
      'Erfassung draußen und Abrechnung drinnen sind entkoppelt',
    ],
    href: einsatzplanungUrl,
    cta: 'Einsatzplanung ansehen',
  },
];

const clientLogos = [
  { key: 'bonprix_logo', name: 'bonprix' },
  { key: 'statista-logo', name: 'Statista' },
  { key: 'stage_logo', name: 'Stage Entertainment' },
  { key: 'fkc_logo', name: 'FKC Consulting' },
  { key: 'mavox_logo', name: 'MAVOX Winterdienst' },
  { key: 'sam', name: 'Smart Active Media' },
  { key: 'yomei_logo', name: 'YOMEI' },
  { key: 'venus_logo', name: 'Venus' },
  { key: 'stueckgut', name: 'Stückgut' },
];

const portraitModules = import.meta.glob<{ default: ImageMetadata }>(
  '@/assets/testimonials/*.{jpeg,jpg,png,webp}',
  { eager: true },
);
const portraitMap: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(portraitModules).map(([path, mod]) => {
    const key = path.split('/').pop()!.replace(/\.(jpe?g|png|webp)$/i, '');
    return [key, mod.default];
  }),
);

const allCases = [...cases, ...additionalCases];
const testimonialItems = allCases
  .filter((c) => c.testimonial)
  .map((c) => {
    const t = c.testimonial!;
    return {
      quote: t.quote,
      author: t.author,
      position: t.position,
      client: c.client,
      portrait: t.portraitKey ? portraitMap[t.portraitKey] : undefined,
    };
  });

const getReferenceUrl = (slug: string) => `${referencesUrl}${slug}/`;

const featuredBlogPosts = (
  await getCollection('blog', ({ data }) => {
    return data.locale === locale && data.featured === true && (import.meta.env.PROD ? data.draft !== true : true);
  })
)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 2);

const getBlogPostUrl = (postId: string) => '/blog/' + postId.replace(locale + '/', '') + '/';
---

<LandingLayout
  title="Individualsoftware, die euch trägt – statt ausbremst"
  description="Wenn Standardsoftware wie Vertec oder Centric oder eine gewachsene Excel-Welt das Wachstum bremst: RocketBase baut die individuelle Lösung, die zum echten Prozess passt - direkt mit Marten Prieß."
  includeOrgSchema
  lang={locale}
  routeId="home"
>
  <section class="hero-landing border-border relative min-h-[62vh] max-h-[760px] overflow-hidden border-b max-[760px]:min-h-0 max-[760px]:max-h-none" data-hero-root>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_18%_18%,rgba(99,114,165,0.14),transparent_0,transparent_28%),radial-gradient(circle_at_82%_20%,rgba(99,114,165,0.16),transparent_0,transparent_32%),linear-gradient(135deg,rgba(255,255,255,0.98)_0%,rgba(248,250,253,0.97)_36%,rgba(242,246,251,0.96)_100%)] dark:bg-[radial-gradient(circle_at_18%_18%,rgba(99,114,165,0.18),transparent_0,transparent_28%),radial-gradient(circle_at_82%_20%,rgba(99,114,165,0.2),transparent_0,transparent_32%),linear-gradient(135deg,rgba(18,22,31,0.98)_0%,rgba(20,25,35,0.97)_36%,rgba(15,19,27,0.96)_100%)]"
    />
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,rgba(99,114,165,0.22),transparent)]"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute left-[8%] top-[14%] h-40 w-40 rounded-full border border-white/40 opacity-40 blur-[2px] dark:border-white/10 dark:opacity-25"
      aria-hidden="true"
    />
    <div
      class="pointer-events-none absolute right-[10%] bottom-[18%] h-56 w-56 rounded-full border border-brand-300/30 opacity-50 blur-[2px] dark:border-brand-300/15 dark:opacity-30"
      aria-hidden="true"
    />
    <div class="container relative z-10 flex min-h-[62vh] max-h-[760px] flex-col justify-center pt-24 pb-24 max-[760px]:min-h-0 max-[760px]:max-h-none max-[760px]:pt-20 max-[760px]:pb-24 sm:pt-28 lg:pt-24 lg:pb-24">
      <div data-reveal="fade-right" class="hero-landing-copy will-change-transform" data-hero-copy>
        <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">
          Insellösungen verbinden · Prozesse bauen · Weiterdenken
        </p>
        <h1 class="hero-landing-title font-display text-foreground mt-5 text-4xl font-bold tracking-tight max-[760px]:mt-4 max-[760px]:text-[2.15rem] sm:text-5xl">
          <span class="block sm:whitespace-nowrap">Eure Software sollte euch tragen –</span>
          <span class="mt-2 block text-brand-500">nicht ausbremsen.</span>
        </h1>

        <p class="hero-landing-intro text-foreground-secondary mt-6 text-lg leading-8 max-[760px]:mt-5 max-[760px]:text-base max-[760px]:leading-7">
          Software, die zu euren Abläufen passt – nicht umgekehrt. Gebaut für den Prozess, mit dem ihr
          wirklich arbeitet, nicht für den, den ein Standard vorgibt.
        </p>

        <div data-reveal class="hero-landing-actions mt-8 flex flex-wrap items-center gap-4 max-[760px]:mt-6 max-[760px]:gap-3">
          <Button size="lg" href={contactLinks.cal} target="_blank">
            Erstgespräch buchen
            <Icon name="arrow-up-right" size="sm" />
          </Button>
          <Button variant="link" href={servicesUrl}>
            Leistungen ansehen
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
      </div>
    </div>

    {/* Scroll indicator */}
    <a
      href="#hero-next"
      aria-label="Weiter scrollen"
      class="group text-foreground-muted hover:text-brand-500 absolute bottom-6 left-1/2 z-10 -translate-x-1/2 transition-colors duration-300 max-[760px]:hidden"
    >
      <span class="block text-[10px] font-semibold tracking-[0.3em] uppercase">Scrollen</span>
      <span class="border-foreground-muted/40 group-hover:border-brand-500 mx-auto mt-3 flex h-10 w-6 justify-center rounded-full border-2 transition-colors duration-300">
        <span class="bg-foreground-muted/60 group-hover:bg-brand-500 mt-2 h-2 w-1 animate-bounce rounded-full transition-colors duration-300" />
      </span>
    </a>
  </section>

  <div id="hero-next" class="scroll-mt-24" aria-hidden="true" />

  <script is:inline>
    (() => {
      const hero = document.querySelector('[data-hero-root]');
      const copy = document.querySelector('[data-hero-copy]');

      if (!hero || !copy) return;

      let ticking = false;

      const updateHeroProgress = () => {
        const rect = hero.getBoundingClientRect();
        const viewport = window.innerHeight || 1;
        const progress = Math.min(Math.max(-rect.top / viewport, 0), 1);

        copy.style.transform = `translate3d(0, ${progress * 36}px, 0)`;
        copy.style.opacity = `${1 - progress * 0.22}`;

        ticking = false;
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(updateHeroProgress);
      };

      updateHeroProgress();
      document.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
    })();
  </script>

  <section class="border-border border-b py-24 lg:py-32">
    <div class="container">
      <div data-reveal>
        <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">Wofür wir gerufen werden</p>
        <h2 class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          Zwei Situationen,
          <span class="text-brand-500">in denen man uns dazuholt.</span>
        </h2>
        <p class="text-foreground-secondary mt-6 text-lg leading-8">
          Ihr führt einen Betrieb, der läuft – und merkt an einer konkreten Stelle, dass die Software
          den nächsten Schritt nicht mehr trägt. Meistens ist es eine von zwei Geschichten:
        </p>
      </div>

      <div class="mt-16 grid gap-6 lg:grid-cols-2">
        {
          calledForSituations.map((situation) => (
            <article
              data-reveal
              class="group relative flex flex-col rounded-[2rem] border border-border bg-card p-7 shadow-sm transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:border-brand-300 hover:shadow-[0_28px_60px_rgba(34,43,74,0.12)] sm:p-9"
            >
              <div class="flex items-center gap-4">
                <div class="bg-brand-50 text-brand-600 dark:bg-brand-900/30 dark:text-brand-100 group-hover:bg-brand-500 group-hover:text-on-invert inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl transition-all duration-300 group-hover:scale-110">
                  <Icon name={situation.icon} size="md" />
                </div>
                <p class="text-brand-600 text-xs font-semibold tracking-[0.22em] uppercase">
                  {situation.eyebrow}
                </p>
              </div>
              <h3 class="font-display text-foreground mt-6 text-xl font-semibold leading-snug sm:text-2xl">
                {situation.title}
              </h3>
              <p class="text-foreground-secondary mt-4 text-base leading-7">{situation.text}</p>
              <ul class="text-foreground-secondary mt-6 space-y-3 text-sm leading-6">
                {situation.points.map((point) => (
                  <li class="flex gap-3">
                    <Icon name="alert-circle" size="sm" class="text-brand-400 mt-0.5 shrink-0" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-auto pt-8">
                <a
                  href={situation.href}
                  class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 transition-transform duration-300 group-hover:translate-x-1"
                >
                  {situation.cta}
                  <Icon name="arrow-right" size="sm" />
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <div data-reveal class="mt-10 flex flex-wrap items-center gap-4">
        <Button href={contactLinks.cal} target="_blank">
          Lass uns draufschauen
          <Icon name="arrow-up-right" size="sm" />
        </Button>
        <p class="text-foreground-muted text-sm leading-7">
          Nicht eindeutig zuzuordnen? Ein Gespräch, ehrliche Einschätzung, kein Vertriebsdruck.
        </p>
      </div>
    </div>
  </section>

  <section class="border-border relative overflow-hidden border-b py-24 lg:py-28">
    <div class="bg-brand-300/10 absolute left-0 top-1/3 h-80 w-80 rounded-full blur-3xl" />
    <div class="container relative z-10 grid items-center gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
      <div
        data-reveal="fade-right"
        class="group relative mx-auto w-full max-w-[220px] sm:max-w-[260px] lg:max-w-none"
      >
        <div class="bg-brand-300/15 absolute -inset-3 -z-10 rounded-[2rem] blur-2xl" aria-hidden="true" />
        <div class="overflow-hidden rounded-[1.8rem] border border-border shadow-[0_20px_50px_rgba(34,43,74,0.12)] rotate-[-2.5deg] transition-transform duration-500 will-change-transform [backface-visibility:hidden] group-hover:rotate-0 group-hover:-translate-y-1">
          <Picture
            src={founderImage}
            alt="Marten Prieß, Gründer von RocketBase"
            widths={[220, 260, 320, 440, 520, 640, 780, 960]}
            sizes="(max-width: 640px) 220px, (max-width: 1024px) 260px, 320px"
            formats={['avif', 'webp']}
            class="aspect-[2/3] w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
            loading="lazy"
          />
        </div>
      </div>

      <div data-reveal="fade-left">
        <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">Über RocketBase</p>
        <h2 class="font-display text-foreground mt-6 text-3xl font-bold tracking-tight sm:text-4xl">
          Marten Prieß
          <span class="mt-2 block text-brand-500">und ein kleines, festes Entwicklerteam.</span>
        </h2>
        <p class="text-foreground-muted mt-4 text-sm font-medium tracking-wide">
          Diplom-Wirtschaftsinformatiker
        </p>
        <p class="text-foreground-secondary mt-6 text-lg leading-8">
          Kein Body-Leasing, keine verlängerte Werkbank. Ihr arbeitet direkt mit dem Gründer – und einem
          eingespielten Team fester Entwicklerinnen und Entwickler im Rücken. Einer, der zuhört, die
          beiläufigen Ideen im Gespräch aufgreift und den besseren Prozess vorschlägt, wenn er einen sieht.
        </p>
        <p class="text-foreground-secondary mt-5 hidden text-lg leading-8 sm:block">
          Erfahrung aus Konzernprojekten, Produktentwicklung und Mittelstandsvorhaben fließt so in jedes
          Projekt ein – ohne aufgeblähte Kommunikation, mit weniger Übergaben und schnelleren Entscheidungen.
        </p>
        <div data-reveal class="mt-8 flex flex-wrap gap-4">
          <Button href={contactLinks.cal} target="_blank">
            Erstgespräch buchen
            <Icon name="arrow-up-right" size="sm" />
          </Button>
          <Button variant="outline" href={missionUrl}>
            Zur Mission
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>

        <div class="border-border/70 text-foreground-muted mt-10 grid gap-4 border-t pt-8 text-sm sm:grid-cols-3">
          <div data-reveal>
            <p class="text-foreground font-semibold">Seit 2016</p>
            <p class="mt-2 leading-6">Aufbau von Digitalprodukten und internen Plattformen.</p>
          </div>
          <div data-reveal>
            <p class="text-foreground font-semibold">bonprix &amp; Statista</p>
            <p class="mt-2 leading-6">Konzern-Erfahrung, übertragen auf mittelständische Realitäten.</p>
          </div>
          <div data-reveal>
            <p class="text-foreground font-semibold">Discovery bis Betrieb</p>
            <p class="mt-2 leading-6">Konzeption, Delivery, Integration und Weiterentwicklung aus einer Hand.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ClientLogoStrip
    heading="Erfahrung aus Projekten mit"
    logos={clientLogos}
    variant="subtle"
  />

  <section class="border-border bg-background-secondary relative overflow-hidden border-b py-28 lg:py-36">
    <div class="bg-grid-pattern pointer-events-none absolute inset-0 opacity-25 [mask-image:radial-gradient(circle_at_center,black_24%,transparent_78%)]" />
    <div class="container relative z-10 space-y-14">
      <div data-reveal="fade-right">
        <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">Worauf ihr euch verlassen könnt</p>
        <h2 class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          <span class="block">Drei Dinge, die den Unterschied&nbsp;machen –</span>
          <span class="mt-2 block text-brand-500">vom ersten Gespräch bis in den Betrieb.</span>
        </h2>
      </div>

      <div class="why-rocketbase-track relative space-y-6">
        {
          topStrengths.map((strength, index) => (
            <article
              data-reveal="fade-left"

              data-why-card
              class:list={[
                'why-rocketbase-card rounded-[2rem] border p-8 transition-all duration-300',
                index === 0
                  ? 'border-brand-300 bg-card shadow-[0_20px_50px_rgba(34,43,74,0.08)]'
                  : 'border-border bg-background/80',
              ]}
            >
              <div class="grid gap-5 md:grid-cols-[72px_1fr] md:items-start">
                <div class="bg-background text-brand-600 flex h-13 w-13 items-center justify-center rounded-2xl border border-border text-sm font-semibold">
                  0{index + 1}
                </div>
                <div>
                  <h3 class="text-foreground text-2xl font-semibold">{strength.title}</h3>
                  <p class="text-foreground-secondary mt-4 max-w-2xl text-base leading-7">
                    {strength.description}
                  </p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-border relative overflow-hidden border-b py-24 lg:py-32">
    <div class="container">
      <a data-reveal="zoom-in" href={workUrl} class="how-we-work group block" data-how-we-work>
        <div class="relative overflow-hidden py-2 transition-all duration-500">
          <div class="bg-brand-300/12 absolute top-12 right-0 h-48 w-48 rounded-full blur-3xl transition-all duration-500 group-hover:bg-brand-300/20" />
          <div class="relative space-y-10">
            <div class="grid gap-10 xl:grid-cols-[0.9fr_1.1fr] xl:items-start xl:gap-12">
              <div>
                <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">Wie wir arbeiten</p>
                <h2 class="font-display text-foreground mt-5 text-3xl font-bold tracking-tight sm:text-4xl">
                  <span class="block">Weniger Overhead.</span>
                  <span class="mt-2 block whitespace-nowrap text-brand-500">Mehr Geschwindigkeit.</span>
                </h2>
                <p class="text-foreground-secondary mt-6 max-w-3xl text-lg leading-8">
                  Wir zeigen dir konkret, wie moderne Softwareentwicklung heute funktioniert und warum
                  klassische Ansätze Projekte unnötig ausbremsen.
                </p>
              </div>

              <div class="relative mx-auto w-full max-w-xl xl:pt-2">
                <div class="relative min-h-[18rem] sm:min-h-[22rem]">
                  <div class="how-we-work-after absolute right-0 top-0 z-10 w-[64%] sm:w-[62%]" data-reveal="fade-left">
                    <div class="relative overflow-hidden rounded-[2.4rem] shadow-[0_30px_70px_rgba(34,43,74,0.16)] transition-[transform,box-shadow] duration-500 will-change-transform [backface-visibility:hidden] group-hover:z-20 group-hover:-translate-y-2 group-hover:scale-[1.03] group-hover:shadow-[0_38px_90px_rgba(34,43,74,0.22)]">
                      <Picture
                        src={toolsAfter}
                        alt="Nachher: integriertes System mit klaren Datenflüssen"
                        widths={[320, 480, 640, 800, 1000]}
                        sizes="(max-width: 640px) 74vw, (max-width: 1024px) 480px, 500px"
                        formats={['avif', 'webp']}
                        class="aspect-[4/3.8] w-full object-cover"
                        loading="lazy"
                      />
                      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-black/35 to-transparent" />
                      <div class="absolute right-5 bottom-5 rounded-full bg-white/88 px-3 py-1 text-[11px] font-semibold tracking-[0.22em] uppercase text-brand-700 backdrop-blur">
                        Mit RocketBase
                      </div>
                    </div>
                  </div>

                  <div class="how-we-work-before absolute bottom-0 left-0 z-0 w-[42%] sm:w-[40%]" data-reveal="fade-right">
