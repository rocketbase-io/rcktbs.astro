---
/**
 * Anzeigen-Landing für Tür 2 (Einsatz & Abrechnung) (Funnel-Fassung, seit 2026-10-16). Inhalt in components/einsatz-funnel/.
 * Die indexierte Tür-Seite /einsatzplanung/ hängt an components/einsatz/ und ist bewusst ausführlicher;
 * hier steht nur, was zur Kontaktaufnahme führt.
 * FunnelLayout: noindex, ohne Navigation, nicht in der Sitemap.
 * Liegt als statische Datei neben /f/[slug].astro und gewinnt gegen die
 * dynamische Route; in funnels.ts darf es deshalb keinen Slug „einsatz" geben.
 */
import FunnelLayout from '@/layouts/FunnelLayout.astro';
import EinsatzPage from '@/components/einsatz-funnel/EinsatzPage.astro';
---

<FunnelLayout
  title="Einsatz & Abrechnung: geplant, erledigt, abgerechnet, in einem System"
  description="Plantafel, Ablauf je Auftrag, Leistungserfassung, Rechnung und Mahnwesen. Nach eurem Ablauf gebaut, statt Excel und Stundenzettel."
  headerNote="Einsatz & Abrechnung"
>
  <EinsatzPage variant="funnel" />
</FunnelLayout>
