---
/**
 * Anzeigen-Landing für die Standardsoftware-Ablösung (Funnel-Fassung, seit 2026-10-16). Inhalt in components/abloesung-funnel/.
 * Die indexierte Tür-Seite /standardsoftware-abloesung/ hängt an components/abloesung/ und ist bewusst ausführlicher;
 * hier steht nur, was zur Kontaktaufnahme führt.
 * FunnelLayout: noindex, ohne Navigation, nicht in der Sitemap.
 * Liegt als statische Datei neben /f/[slug].astro und gewinnt gegen die
 * dynamische Route; in funnels.ts darf es deshalb keinen Slug „abloesung" geben.
 */
import FunnelLayout from '@/layouts/FunnelLayout.astro';
import AbloesungPage from '@/components/abloesung-funnel/AbloesungPage.astro';
---

<FunnelLayout
  title="Standardsoftware ablösen: raus aus der Branchensoftware, ohne Stillstand"
  description="Wenn euer Programm nur noch mit Tricks zu eurem Ablauf passt: Ablösung Schritt für Schritt, im Parallelbetrieb, mit allen Daten. Für Betriebe ab etwa 30 Leuten."
  headerNote="Standardsoftware ablösen"
>
  <AbloesungPage variant="funnel" />
</FunnelLayout>
