---
/**
 * Anzeigen-Landing für den Software-Check (Tür 5). Inhalt in components/check/CheckPage.astro,
 * geteilt mit der indexierten Tür-Seite /software-check/.
 *
 * FunnelLayout: noindex, ohne Navigation, nicht in der Sitemap.
 * Liegt als statische Datei neben /f/[slug].astro und gewinnt gegen die
 * dynamische Route; in funnels.ts darf es deshalb keinen Slug „software-check“ geben.
 */
import FunnelLayout from '@/layouts/FunnelLayout.astro';
import CheckPage from '@/components/check/CheckPage.astro';
---

<FunnelLayout
  title="Mit KI gebaut? Jetzt soll jemand draufschauen, der es auch selbst könnte."
  description="Kundenportal, internes Tool oder Produkt mit Software drin: Wir prüfen gegen OWASP ASVS 5.0 und schreiben auf, was offen ist. Mit Bericht, den ihr Kunden vorlegen könnt. Für Betriebe ab etwa 30 Leuten."
  headerNote="Software-Check"
>
  <CheckPage variant="funnel" />
</FunnelLayout>
