<FunnelLayout
  title="Angebotsbaustein: individuell für euch, durchgerechnet, Zusage online"
  description="Angebote, die sich nach eurer Kalkulation selbst rechnen und beim Kunden als Seite ankommen. Zusage per Klick, Nachfassen automatisch. Für euren Betrieb entwickelt."
  headerNote="Angebotsbaustein"
>
  <!-- HERO: Text links, Quiz rechts (drei Fragen, dann Kontaktformular) -->
  <!--
    Ab lg füllt der Hero die erste Bildschirmhöhe (unter dem 3.5rem-Header): Inhalt mittig,
    Logos am unteren Rand, darauf ein Scroll-Hinweis, der beim ersten Scrollen ausblendet.
  -->
  <section
    data-hero
    class="relative overflow-x-clip lg:flex lg:min-h-[calc(100svh-3.5rem)] lg:flex-col"
  >
    <Blueprint />
    <div
      class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(ellipse_60%_50%_at_30%_40%,var(--color-background)_0%,transparent_75%)] opacity-80"
      aria-hidden="true"
    >
    </div>

    <div
      class="relative z-10 mx-auto w-full max-w-[84rem] px-5 pt-8 pb-16 sm:px-8 sm:pt-14 lg:grid lg:flex-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:items-center lg:gap-16 lg:px-12 lg:py-6"
    >
      <div class="text-center lg:text-left">
        <p
          data-reveal="fade-down"
          class="text-brand-600 dark:text-brand-300 text-sm font-semibold tracking-[0.22em] uppercase"
        >
          Unser Angebotsbaustein
        </p>
        <h1
          data-reveal="fade-down"
          lang="de"
          class="font-display text-foreground mt-3 text-[2.6rem] leading-[1.05] sm:mt-5 font-bold tracking-tight text-balance sm:text-6xl xl:text-[4.25rem]"
        >
          Euer Angebot
          <span class="text-brand-500 block">rechnet sich selbst.</span>
        </h1>
        <p
          data-reveal
          class="text-foreground-muted mt-6 hidden flex-wrap items-center justify-center gap-x-2.5 gap-y-2 text-sm font-medium sm:flex lg:justify-start"
        >
          <span>Schluss mit</span>
          {
            ['Excel daneben', 'Word-Vorlage', 'PDF-Anhang'].map((alt) => (
              <span class="hero-alt border-border rounded-md border px-2 py-0.5">{alt}</span>
            ))
          }
        </p>
        <p
          data-reveal
          class="text-foreground-secondary mx-auto mt-4 max-w-lg text-base leading-7 sm:mt-7 sm:text-lg sm:leading-8 lg:mx-0"
        >
          Nach eurer Kalkulation durchgerechnet, beim Kunden als Seite statt Anhang, angenommen per
          Klick. Und ihr wisst vorher, was es einbringt.
        </p>
        <p
          data-reveal
          class="text-foreground-muted border-border/70 bg-background/85 mx-auto mt-8 hidden max-w-lg rounded-xl border px-4 py-3 text-sm leading-6 backdrop-blur-sm lg:mx-0 lg:block"
        >
          Ein bewährter Baustein aus unseren Kundenlösungen, für euren Betrieb individuell
          angepasst. Ob Prüfung, Zertifizierung, Wartung, Service oder Handwerk.
        </p>
      </div>

      <!-- Mindesthöhe = höchster Schritt (Frage 1, ca. 600px), sonst springt der mittig gesetzte Hero je Schritt -->
      <div id="quiz" class="mt-7 scroll-mt-20 sm:mt-10 lg:mt-0 lg:min-h-[38rem]" data-quiz>
        <FunnelQuiz
          client:load
          funnel="angebote"
          questions={quizFragen}
          contact={{
            heading: 'Wohin darf sich Marten Prieß melden?',
            text: 'Hinterlasst eure Kontaktdaten, Marten Prieß meldet sich werktags persönlich und sucht mit euch einen Termin.',
          }}
          success={{
            heading: 'Danke, eure Nachricht ist angekommen.',
            text: 'Marten Prieß meldet sich werktags bei euch.',
          }}
          submitLabel="Nachricht senden"
          phoneRequired
          companyOptional
          markRequired
          phoneHint="Telefon für eine kurze Rückfrage. Wir rufen an, wenn es hilft."
          leadEvent="angebote_lead"
          compact
          privacyUrl="/datenschutz/"
        />
      </div>
      <!-- mobil unter dem Quiz, damit das Quiz ohne Scrollen anfängt -->
      <p
        class="text-foreground-muted border-border/70 bg-background/85 mx-auto mt-6 max-w-lg rounded-xl border px-4 py-3 text-center text-sm leading-6 backdrop-blur-sm lg:hidden"
      >
        Ein bewährter Baustein aus unseren Kundenlösungen, für euren Betrieb individuell angepasst.
        Ob Prüfung, Zertifizierung, Wartung, Service oder Handwerk.
      </p>
    </div>
    <!-- LOGOS: schließen die erste Bildschirmhöhe ab; der Scroll-Hinweis sitzt auf ihrer Oberkante -->
    <div class="relative z-10">
      <a
        href="#heute"
        class="hero-scroll absolute top-0 left-1/2 z-20 hidden h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full lg:flex"
        aria-label="Weiter nach unten"
        data-hero-scroll
      >
        <span class="hero-scroll-icon flex"><Icon name="chevron-down" size="sm" /></span>
      </a>
      <ClientLogoStrip
        heading="Aus Projekten mit"
        logos={clientLogos}
        variant="light"
        uniform
        class="py-10 lg:py-11"
      />
    </div>
  </section>


  <!-- HEUTE: der Ist-Zustand, kurz, damit sich Leser wiedererkennen -->
  <section
    id="heute"
    class="heute-sec border-border relative scroll-mt-14 overflow-x-clip border-b pt-16 pb-12 sm:py-20 lg:py-24"
  >
    <div class="container grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-16">
      <div class="af-rise">
        <p
          class="inline-flex items-center gap-2 font-mono text-xs font-semibold tracking-[0.2em] text-[oklch(58%_0.19_25)] uppercase"
        >
          <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
          Kommt euch das bekannt vor?
        </p>
        <h2
          class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-[2.35rem] lg:leading-[1.15]"
        >
          Die Kalkulation liegt neben dem System.{' '}
          <span class="text-foreground-muted">Dazwischen tippt jemand ab.</span>
        </h2>
        <p class="text-foreground-secondary mt-5 text-[0.95rem] leading-7">
          Bei den einen steht sie in Excel und das Angebot entsteht in Word. Bei den anderen läuft
          eine Branchenlösung, die den Standardfall ihrer Branche sauber rechnet. Die Frage ist, ob
          ihr rechnet wie alle anderen. Sobald eine Vorschrift die Stunden vorgibt oder über Jahre
          eigene Sonderfälle dazugekommen sind, wandert genau dieser Teil wieder nach draußen: in
          Custom-Felder, in einen Export, in die Datei einer Person, die alles davon kennt.
        </p>
        <p class="text-foreground-secondary mt-4 text-[0.95rem] leading-7">
          Dann geht das Angebot als PDF raus, und das Warten beginnt. Hat der Kunde es überhaupt
          geöffnet? Wann ruft ihr an, ohne zu drängeln? Und rechnet sich der Rabatt, den ihr letzte
          Woche zugesagt habt? Die Antworten liegen in fünf Dateien. Oder nirgends.
        </p>
        <p class="text-foreground mt-4 text-[0.95rem] leading-7 font-semibold">
          Tools, die schöne Angebote zaubern, gibt es viele. Keins davon rechnet so, wie ihr rechnet.
        </p>

        <div class="border-border mt-7 flex items-start gap-3 border-t pt-6">
          <span
            class="bg-brand-500 mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg text-white"
          >
            <Icon name="layers" size="xs" />
          </span>
          <p class="text-foreground-secondary text-sm leading-6">
            <strong class="text-foreground">Unser Angebotsbaustein</strong> ist bei Kunden bewährt und
            wird für euch individuell aufgebaut. Keine Standardsoftware.
          </p>
        </div>
      </div>

      <div class="af-rise">
        <HeuteChaos />
      </div>
    </div>
  </section>

  <!-- 01 DIE KALKULATION: direkt nach dem Ist-Zustand, der eigentliche Unterschied -->
  <section
    id="kalkulation"
    class="bg-background relative scroll-mt-16 overflow-x-clip py-24 lg:py-36"
  >
    <div
      class="bg-brand-300/10 pointer-events-none absolute top-40 left-1/2 h-[40rem] w-[60rem] -translate-x-1/2 rounded-full blur-[120px]"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 container max-w-7xl">
      <SectionHeader
        size="md"
        number="01"
        eyebrow="Die Kalkulation"
        title="Eure Kalkulation. Nicht unsere."
        lead="Die Kalkulation ist das Herz des Bausteins, und sie wird für jeden Betrieb eigens gebaut: mit euren Vorschriften, Sonderfällen und Sätzen. Sie sitzt im Angebot statt daneben, niemand tippt mehr ab, und bevor es rausgeht, seht ihr, was es einbringt. So kann das aussehen:"
      />

      <div class="af-rise mx-auto mt-14 max-w-6xl lg:mt-16">
        <KalkulationRechner rechnungen={rechnungen} gemeinsam={gemeinsameGroessen}>
          <p slot="hinweis">
            <span class="text-foreground font-semibold">Die Zahlen sind frei erfunden, die
            Vorschriften echt.</span> Welche Fassung für euch gilt und wie ihr sie auslegt,
            entscheidet ihr; eingebaut wird eure Auslegung. Genau solche Regeln rechnen bei unseren
            Kunden im Tagesgeschäft, von der Betreuungsvorschrift bis zum Prüfzyklus. Preise und Sätze
            legt ihr danach selbst fest.{' '}
            <a
              href="#ablauf-02"
              class="text-brand-600 hover:text-brand-700 dark:text-brand-300 inline-flex items-center gap-1 font-semibold whitespace-nowrap underline-offset-4 hover:underline"
            >
              Zum Workshop
              <Icon name="arrow-right" size="xs" />
            </a>
          </p>
        </KalkulationRechner>
      </div>


    </div>
  </section>

  <!-- 02 SO ARBEITEN WIR: kompakt (Detail in 06) -->
  <section class="bg-background-secondary border-border relative border-b py-20 lg:py-24">
    <div class="relative z-10 container max-w-6xl">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
        <div class="af-rise">
          <p
            class="text-brand-600 dark:text-brand-300 font-mono text-xs font-semibold tracking-[0.2em] uppercase"
          >
            02 · So arbeiten wir
          </p>
          <h2
            class="font-display text-foreground mt-4 text-2xl font-bold tracking-tight text-balance sm:text-3xl lg:text-[2.5rem] lg:leading-tight"
