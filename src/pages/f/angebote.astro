              </summary>
              <p class="text-foreground-secondary border-border/60 mt-4 border-t pt-4 text-[0.95rem] leading-7">
                {item.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA: Ablauf, Termin und Formular in einem Block -->
  <section
    id="kontakt"
    class="invert-section bg-surface-invert relative scroll-mt-20 overflow-x-clip py-24 lg:py-32"
  >
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <div
        class="bg-brand-500/25 absolute -bottom-40 -left-24 h-[34rem] w-[34rem] rounded-full blur-[150px]"
      >
      </div>
      <div
        class="bg-grid-pattern absolute inset-0 [mask-image:linear-gradient(to_top,black,transparent_85%)] opacity-[0.06]"
      >
      </div>
    </div>
    <div
      class="relative z-10 container grid max-w-6xl gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-start lg:gap-16"
    >
      <div class="af-rise lg:sticky lg:top-24">
        <p
          class="text-brand-300 font-mono text-xs font-semibold tracking-[0.2em] uppercase"
        >
          Nächster Schritt
        </p>
        <h2
          lang="de"
          class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight text-balance hyphens-auto [-webkit-hyphens:auto] sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]"
        >
          Zeigt uns, wie ihr heute ein Angebot rechnet.
        </h2>
        <p class="text-foreground-secondary mt-5 text-lg leading-8">
          30 Minuten mit Marten Prieß, ohne Präsentation. Danach wisst ihr, ob sich ein Workshop
          lohnt und in welchem Preisrahmen euer Baustein liegt.
        </p>

        <ol class="mt-9 space-y-0" aria-label="Ablauf">
          {
            ablauf.map((stufe, index) => (
              <li class="relative flex gap-4 pb-6 last:pb-0">
                {index < ablauf.length - 1 && (
                  <span
                    class="bg-border absolute top-10 bottom-1 left-[1.125rem] w-px"
                    aria-hidden="true"
                  />
                )}
                <span
                  class:list={[
                    'relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full font-mono text-xs font-bold',
                    index === 0
                      ? 'bg-brand-500 text-white shadow-[0_0_0_6px_color-mix(in_oklch,var(--color-brand-500)_25%,transparent)]'
                      : 'border-border text-foreground-secondary border',
                  ]}
                >
                  {stufe.number}
                </span>
                <div class="min-w-0 pt-1">
                  <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span
                      class:list={[
                        'font-display font-bold tracking-tight',
                        index === 0 ? 'text-foreground text-lg' : 'text-foreground-secondary',
                      ]}
                    >
                      {stufe.title}
                    </span>
                    {index === 0 && (
                      <span class="bg-brand-500/20 text-brand-200 rounded-full px-2.5 py-0.5 text-[11px] font-semibold">
                        Hier fangt ihr an
                      </span>
                    )}
                  </p>
                  <p class="text-foreground-muted mt-0.5 text-sm">{stufe.meta}</p>
                </div>
              </li>
            ))
          }
        </ol>

        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
          <Button
            href={contactLinks.cal}
            target="_blank"
            size="lg"
            class="bg-brand-500 hover:bg-brand-400 text-white shadow-[0_14px_34px_-12px_var(--color-brand-500)]"
            data-track-cal="cta"
          >
            Erstgespräch buchen
            <Icon name="arrow-up-right" size="sm" />
          </Button>
          <p class="text-foreground-muted text-sm">
            Kostenlos, unverbindlich, online.
            <span class="hidden lg:inline"> Oder rechts schreiben.</span>
          </p>
        </div>
      </div>

      <div class="af-rise">
        <AngeboteKontakt
          client:load
          funnel="angebote"
          heading="Lieber erst schreiben?"
          text="Hinterlasst eure Kontaktdaten, Marten Prieß meldet sich werktags persönlich und sucht mit euch einen Termin."
          erfolg={{
            heading: 'Danke, eure Nachricht ist angekommen.',
            text: 'Marten Prieß meldet sich werktags bei euch.',
          }}
        />
      </div>
    </div>
  </section>
</FunnelLayout>

