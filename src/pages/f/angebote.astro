<script>
  // Hero: Scroll-Hinweis nach dem ersten Scrollen ausblenden (und oben wieder zeigen).
  const heroScroll = document.querySelector<HTMLElement>('[data-hero-scroll]');
  if (heroScroll) {
    const sync = () => (heroScroll.dataset.hidden = window.scrollY > 40 ? 'true' : 'false');
    window.addEventListener('scroll', sync, { passive: true });
    sync();
  }

  // 03: fünf Schritte auf- und zuklappen. Beim Laden immer zu, auch mit #angebot in der
  // Adresse; nur ein Klick (Knopf oder Hero-Link) klappt auf.
  const more = document.querySelector<HTMLElement>('[data-af-more]');
  const moreBtn = more?.querySelector<HTMLButtonElement>('[data-af-more-btn]');
  const morePanel = more?.querySelector<HTMLElement>('.af-more-panel');
  const setMore = (open: boolean) => {
    if (!moreBtn || !morePanel) return;
    moreBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
    morePanel.dataset.open = open ? 'true' : 'false';
    morePanel.toggleAttribute('inert', !open);
    // Beschnitt nur während der Animation: offen darf Überstehendes (Pfeile, große Ziffer) sichtbar sein
    if (!open) delete morePanel.dataset.settled;
    else if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) morePanel.dataset.settled = 'true';
  };
  morePanel?.addEventListener('transitionend', (e) => {
    if (e.target === morePanel && morePanel.dataset.open === 'true') morePanel.dataset.settled = 'true';
  });
  moreBtn?.addEventListener('click', () =>
    setMore(moreBtn.getAttribute('aria-expanded') !== 'true'),
  );
  document.querySelectorAll<HTMLAnchorElement>('a[href="#angebot"]').forEach((a) =>
    a.addEventListener('click', () => setMore(true)),
  );
</script>
