---
/**
 * Anzeigen-Landing für den Angebotsbaustein (Funnel-Fassung, seit 2026-10-16). Inhalt in components/angebote-funnel/.
 * Die indexierte Tür-Seite /angebote/ hängt an components/angebote/ und ist bewusst ausführlicher;
 * hier steht nur, was zur Kontaktaufnahme führt.
 * FunnelLayout: noindex, ohne Navigation, nicht in der Sitemap.
 * Liegt als statische Datei neben /f/[slug].astro und gewinnt gegen die
 * dynamische Route; in funnels.ts darf es deshalb keinen Slug „angebote" geben.
 */
import FunnelLayout from '@/layouts/FunnelLayout.astro';
import SchlankPage from '@/components/funnel-schlank/SchlankPage.astro';
import AngebotMini from '@/components/funnel-schlank/AngebotMini.astro';
import AngebotEbenen, { type Ebene } from '@/components/angebote-funnel/AngebotEbenen.astro';
import HeuteChaos from '@/components/angebote/HeuteChaos.astro';
import editor from '@/assets/angebote/v2-editor-praesentation.webp';
import bausteine from '@/assets/angebote/v2-bausteine-falk.webp';
import kundeStart from '@/assets/angebote/kunde-umfang-hd.webp';
import kundeAnnahme from '@/assets/angebote/kunde-annahme-hd.webp';
import { angebote } from '@/data/funnelSchlank';

const ebenen: Ebene[] = [
  { titel: 'Vorlage und Texte', text: 'Texte und Bilder kommen aus eurer Bibliothek.', image: editor, alt: 'Editor der Angebotsseite mit Abschnitten, Präsentation und Bildauswahl' },
  { titel: 'Kalkulation', text: 'Jede Position rechnet, wie ihr rechnet. Der Gewinn steht dran.', image: bausteine, alt: 'Angebot mit Positionen, Stunden und Gewinn je Zeile' },
  { titel: 'Beim Kunden', text: 'Der Kunde sieht das Angebot online in eurem Design.', image: kundeStart, alt: 'Angebotsseite beim Kunden mit Abschnitten und Leistungen' },
  { titel: 'Zusage', text: 'Der Kunde sagt mit einem Klick zu.', image: kundeAnnahme, alt: 'Zusage auf der Angebotsseite mit wählbaren Leistungen und Summe' },
];
---

<FunnelLayout
  title="Angebote: individuell für euch, durchgerechnet, Zusage online"
  description="Angebote, die sich nach eurer Kalkulation selbst rechnen und beim Kunden als Seite ankommen. Zusage per Klick, Nachfassen automatisch. Für euren Betrieb entwickelt."
  headerCta
>
  <SchlankPage tor={angebote}>
  <AngebotMini slot="hero" stapel />
  <AngebotEbenen ebenen={ebenen} start={2} />
  <HeuteChaos slot="heute" szene />
</SchlankPage>
</FunnelLayout>
