<script>
  // Der Cal-Klick ist der häufigste Konversionspunkt und verlässt die Domain.
  import { trackPlausible, pushEvent } from '@/lib/leadTracking';

  document.querySelectorAll<HTMLAnchorElement>('[data-track-cal]').forEach((link) => {
    link.addEventListener('click', () => {
      const position = link.dataset.trackCal ?? 'unbekannt';
      trackPlausible('Cal Click', { page: 'angebote', position });
      pushEvent('cal_click', { page: 'angebote', position });
    });
  });
</script>
