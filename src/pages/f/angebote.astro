    class="bg-background-secondary border-border relative overflow-x-clip border-y py-24 lg:py-32"
  >
    <div
      class="bg-grid-pattern pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_70%)] opacity-30"
      aria-hidden="true"
    >
    </div>
    <div class="relative z-10 container max-w-6xl">
      <SectionHeader
        number="07"
        eyebrow="Nach der Zusage"
        title="Die Zusage ist der Anfang, nicht das Ende."
        lead="Was nach dem Ja passiert, bleibt dieselbe Strecke. Niemand überträgt das Angebot in einen Auftrag, einen Vertrag oder eine Rechnung."
      />

      <ol class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          danach.map((node, index) => (
            <li class="af-rise border-border bg-card flex gap-4 rounded-2xl border p-6 shadow-sm">
              <span class="bg-brand-500/10 text-brand-600 dark:text-brand-300 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl">
                <Icon name={node.icon} size="sm" />
              </span>
              <div>
                <p class="text-foreground-muted font-mono text-[11px]">0{index + 1}</p>
                <h3 class="font-display text-foreground mt-1 text-base font-bold tracking-tight">
                  {node.step}
                </h3>
                <p class="text-foreground-secondary mt-2 text-sm leading-6">{node.text}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="mx-auto mt-16 max-w-4xl">
        <VideoPlaceholder
          class="af-rise"
          title="Vom Ja zum Auftrag"
          script="Der Status springt auf gewonnen, die Auftragsbestätigung geht als PDF raus, ein Klick legt den Auftrag mit allen Positionen an, die Termine erscheinen in der Planung."
          duration="30 Sek."
          where="Angebot → Auftrag → Planung"
        />
      </div>
    </div>
  </section>

  <!-- 08 FÜR WEN -->
  <section class="bg-background relative overflow-hidden py-24 lg:py-32">
    <div class="relative z-10 container max-w-6xl">
      <SectionHeader
        number="08"
        eyebrow="Für wen"
        title="Ihr erkennt euch wieder? Dann lohnt sich das Gespräch."
        lead="Die Branche ist zweitrangig. Entscheidend ist, dass eure Angebote aus einer Kalkulation entstehen und ihr wiederkehrend ähnlich rechnet."
      />

      <div class="mt-16 grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:gap-8">
        <div
          class="af-rise border-brand-300 bg-card dark:border-brand-800 rounded-2xl border p-7 shadow-sm sm:p-9"
        >
          <p
            class="text-brand-600 dark:text-brand-300 font-mono text-xs font-semibold tracking-wider uppercase"
          >
            Kommt euch bekannt vor
          </p>
          <ul class="mt-6 space-y-4">
            {
              wiedererkennen.map((p) => (
                <li class="flex gap-3">
                  <Icon name="check" size="sm" class="text-brand-500 mt-1 shrink-0" />
                  <span class="text-foreground text-base leading-7">{p}</span>
                </li>
              ))
            }
          </ul>
          <div class="border-border mt-8 flex flex-wrap gap-2 border-t pt-6">
            {
              branchen.map((b) => (
                <span class="bg-brand-500/10 text-brand-700 dark:text-brand-200 rounded-full px-3 py-1 text-xs font-medium">
                  {b}
                </span>
              ))
            }
          </div>
        </div>
        <div class="af-rise border-border bg-background-secondary rounded-2xl border p-7 sm:p-9">
          <p class="text-foreground-muted font-mono text-xs font-semibold tracking-wider uppercase">
            Eher nicht
          </p>
          <ul class="mt-6 space-y-4">
            {
              passtNicht.map((p) => (
                <li class="flex gap-3">
                  <Icon name="minus" size="sm" class="text-foreground-muted mt-1 shrink-0" />
                  <span class="text-foreground-secondary text-base leading-7">{p}</span>
                </li>
              ))
            }
          </ul>
          <p class="text-foreground-muted mt-6 text-sm leading-6">
            Das sagen wir im Erstgespräch auch so, wenn es so ist.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 09 SO GEHT ES LOS -->
  <section
    class="bg-background-secondary border-border relative overflow-hidden border-y py-24 lg:py-32"
  >
    <div class="relative z-10 container max-w-6xl">
      <SectionHeader
        number="09"
        eyebrow="So geht es los"
        title="Drei Stufen. Jede bepreist die nächste."
        lead="Kostenlos ist, was aus öffentlichen Daten entsteht. Bezahlt wird, wofür eure Zahlen und eure Zeit nötig sind. Und der Festpreis kommt erst, wenn wir eure Kalkulation kennen."
      />

      <ol class="mt-16 grid gap-6 lg:grid-cols-3">
        {
          treppe.map((stufe) => (
            <li class="af-rise border-border bg-card flex flex-col rounded-2xl border p-7 shadow-sm sm:p-8">
              <span class="text-brand-600 font-mono text-xs font-semibold tracking-wider">
                {stufe.number}
              </span>
              <h3 class="font-display text-foreground mt-3 text-xl font-bold tracking-tight">
                {stufe.title}
              </h3>
              <p class="text-brand-600 mt-1 text-sm font-semibold">{stufe.meta}</p>
              <p class="text-foreground-secondary mt-4 text-[0.95rem] leading-7">{stufe.text}</p>
            </li>
          ))
        }
      </ol>
      <p class="text-foreground-muted mt-6 text-center text-sm leading-6">
        Mehr zum Angebots-Konzept und den Formaten:{' '}
        <a
          href={workshopUrl}
          class="text-brand-600 hover:text-brand-700 decoration-brand-300/60 font-semibold underline underline-offset-4 transition-colors"
        >
          Workshop &amp; Preise
        </a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-background relative overflow-hidden py-24 lg:py-32">
    <div class="relative z-10 container max-w-4xl">
      <SectionHeader number="10" eyebrow="Häufige Fragen" title="Was vorab gefragt wird." />

      <div class="mt-12 flex flex-col gap-4">
        {
          miniFaqs.map((item) => (
            <details class="group border-border bg-card rounded-2xl border p-5 shadow-sm transition-shadow duration-300 open:shadow-lg sm:p-6">
              <summary class="flex cursor-pointer list-none items-start gap-4 [&::-webkit-details-marker]:hidden">
                <h3 class="font-display text-foreground flex-1 text-base font-bold tracking-tight sm:text-lg">
                  {item.q}
                </h3>
                <Icon
                  name="chevron-down"
                  size="sm"
                  class="text-foreground-muted mt-1 shrink-0 transition-transform duration-300 group-open:rotate-180"
                />
              </summary>
              <p class="text-foreground-secondary border-border/60 mt-4 border-t pt-4 text-[0.95rem] leading-7">
                {item.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="kontakt" class="border-border bg-background-secondary scroll-mt-20 border-t py-24">
    <div class="container max-w-5xl">
      <div
        data-reveal="zoom-in"
        class="border-border bg-card rounded-[2.25rem] border p-6 shadow-sm sm:p-8 lg:p-10"
      >
        <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">
              Nächster Schritt
            </p>
            <h2
              lang="de"
              class="font-display text-foreground mt-4 text-2xl font-bold tracking-tight text-balance hyphens-auto [-webkit-hyphens:auto] sm:text-3xl lg:text-4xl"
            >
              Zeigt uns, wie bei euch ein Angebot entsteht.
            </h2>
            <p class="text-foreground-secondary mt-6 text-lg leading-8">
              30 Minuten mit Marten Prieß, ohne Präsentation. Wir schauen uns an, wo bei euch Zeit
              liegen bleibt, und ihr bekommt eine ehrliche Einschätzung, ob sich etwas lohnt. Wenn
              nicht, sagen wir das genauso.
            </p>
          </div>
          <div
            class="bg-background-secondary flex flex-wrap items-center gap-4 rounded-[1.5rem] p-5 sm:p-6"
          >
            <Button href={contactLinks.cal} target="_blank" data-track-cal="cta">
              Erstgespräch buchen
              <Icon name="arrow-up-right" size="sm" />
            </Button>
            <Button variant="link" href={contactUrl}>
              Kontaktseite
              <Icon name="arrow-right" size="sm" />
            </Button>
          </div>
        </div>
      </div>

      <div class="mt-8">
        <AngeboteKontakt
          client:load
          heading="Lieber erst schreiben?"
          text="Hinterlasst eure Kontaktdaten, Marten Prieß meldet sich werktags persönlich. Kein Newsletter, keine Weitergabe eurer Daten."
          erfolg={{
            heading: 'Danke, eure Nachricht ist angekommen.',
            text: 'Marten Prieß meldet sich werktags bei euch.',
          }}
        />
      </div>
    </div>
  </section>
</FunnelLayout>

<script>
  // Der Cal-Klick ist der häufigste Konversionspunkt und verlässt die Domain.
  import { trackPlausible, pushEvent } from '@/lib/leadTracking';

  document.querySelectorAll<HTMLAnchorElement>('[data-track-cal]').forEach((link) => {
    link.addEventListener('click', () => {
      const position = link.dataset.trackCal ?? 'unbekannt';
      trackPlausible('Cal Click', { page: 'angebote', position });
      pushEvent('cal_click', { page: 'angebote', position });
    });
  });
</script>
