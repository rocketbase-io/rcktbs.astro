---
import SeitenHero from '@/components/landing/SeitenHero.astro';
import { Image } from 'astro:assets';
import teamBild from '@/assets/rocketbase/team-am-laptop.jpg';
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { ClientLogoStrip } from '@/components/ui/marketing/ClientLogoStrip';
import { defaultLocale } from '@/i18n/config';
import { getLocalizedPath } from '@/i18n/index';
import { contactLinks } from '@/data/rocketbase';
import { createServiceSchema, createFAQSchema } from '@/lib/schema';

import Prozessbild from '@/components/workshop/Prozessbild.astro';
import Entwurf from '@/components/workshop/Entwurf.astro';
import '@/components/angebote/frame.css';

const locale = defaultLocale;
const contactUrl = getLocalizedPath('contact', locale);

const clientLogos = [
  { key: 'bonprix_logo', name: 'bonprix' },
  { key: 'statista-logo', name: 'Statista' },
  { key: 'stage_logo', name: 'Stage Entertainment' },
  { key: 'fkc_logo', name: 'FKC Consulting' },
  { key: 'mavox_logo', name: 'MAVOX Winterdienst' },
  { key: 'sam', name: 'Smart Active Media' },
  { key: 'yomei_logo', name: 'YOMEI' },
  { key: 'venus_logo', name: 'Venus' },
];

const deliverables = [
  {
    icon: 'share',
    title: 'Ihr seht, wo Zeit verloren geht',
    text: 'Wir zeigen, welche Infos zwischen euren Programmen und Abteilungen wandern und wo heute doppelt gearbeitet oder abgetippt wird.',
  },
  {
    icon: 'layers',
    title: 'Euer Ablauf auf einem Bild',
    text: 'So einfach aufgezeichnet, dass Fachbereich, Geschäftsführung und IT dasselbe darunter verstehen.',
  },
  {
    icon: 'palette',
    title: 'Ihr seht eure Software, bevor sie gebaut wird',
    text: 'Skizzen der Oberflächen für euren wichtigsten Ablauf. So könnt ihr über etwas Konkretes sprechen.',
  },
  {
    icon: 'file-text',
    title: 'Eine klare Empfehlung mit festem Preis',
    text: 'Schriftlich: ausbauen, ablösen oder so lassen, dazu ein fester Preis für die erste Stufe und die nächsten Schritte. Damit könnt ihr intern entscheiden.',
  },
];

// Ein Format (entschieden 2026-10-07). Preis seit 2026-10-31: 1.500 €, ohne Anrechnung. Steht nur hier, nicht im Funnel. Vertieft und Individuell sind raus:
// Reicht ein Workshop nicht, sagen wir das im dritten Termin und machen einen Vorschlag.
const formats = [
  {
    name: 'Workshop',
    duration: 'drei Termine',
    sessions: '3 h + 2 h + 1 h, verteilt über ein bis zwei Wochen',
    price: '1.500 €',
    summary: 'Drei Termine, ein Dokument, ein Festpreis für die Umsetzung. Das Ergebnis gehört euch, auch wenn ihr danach nicht mit uns weitermacht.',
    includes: [
      'Aufnahme (3 Stunden, gern vor Ort): euer Ablauf von der Anfrage bis zur Rechnung, eure Programme und Gespräche mit den Leuten, die täglich damit arbeiten',
      'Abstimmung (2 Stunden, online, wenige Tage später): gemeinsam gegenlesen, Lücken schließen, festlegen, was zuerst gebaut wird',
      'Übergabe (1 Stunde, mit der Geschäftsführung): Ergebnis vorstellen, Dokument übergeben, festen Preis nennen',
      'Bild eures Ablaufs und Entwürfe für euren wichtigsten Ablauf',
      'Schriftliche Empfehlung: ausbauen, ablösen oder so lassen',
    ],
    fit: 'Wenn ihr wissen wollt, was eine Lösung bei euch leisten muss und was sie kostet, bevor ihr Budget freigebt.',
    featured: true,
  },
];

const processSteps = [
  {
    number: '01',
    icon: 'monitor',
    title: 'Vorbereitung',
    text: 'Etwa 30 Minuten online, meist im Erstgespräch. Danach bekommt ihr die Agenda und eine kurze Liste mit Fragen und Unterlagen.',
  },
  {
    number: '02',
    icon: 'users',
    title: 'Aufnahme · 3 Stunden',
    text: 'Gern bei euch vor Ort. Wir gehen euren Ablauf mit den Leuten durch, die ihn täglich machen: wer was womit macht, wo abgetippt wird und nach welcher Regel ihr rechnet.',
  },
  {
    number: '03',
    icon: 'layers',
    title: 'Abstimmung · 2 Stunden',
    text: 'Wenige Tage später, online. Wir lesen gemeinsam, was wir aufgeschrieben haben, schließen Lücken und legen fest, was zuerst gebaut wird.',
  },
  {
    number: '04',
    icon: 'check-circle',
    title: 'Übergabe · 1 Stunde',
    text: 'Mit der Geschäftsführung. Wir stellen das Ergebnis vor und nennen den festen Preis für die Umsetzung. Das Dokument gehört euch, ohne Bindung.',
  },
];

const workshopUrl = new URL(Astro.url.pathname, Astro.site).toString();
const workshopServiceSchema = createServiceSchema({
  name: 'Discovery-Workshop',
  description:
    'Strukturierter Außenblick auf Prozesse und Systemlandschaft: Datenflüsse, Prozessbilder, Mockups und eine priorisierte Handlungsempfehlung. Für Entscheider, die eine belastbare Entscheidungsgrundlage brauchen, bevor gebaut wird.',
  url: workshopUrl,
  serviceType: 'Software-Discovery und Prozessanalyse',
  areaServed: 'DE',
  offers: [
    {
      name: 'Workshop',
      price: '1500',
      description: 'Drei Termine (3 h Aufnahme, 2 h Abstimmung, 1 h Übergabe), Dokument mit Empfehlung und Festpreis für die Umsetzung.',
    },
  ],
});

const miniFaqs = [
  {
    q: 'Was müssen wir vorbereiten?',
    a: 'Sehr wenig. Wir sprechen vorab etwa 30 Minuten online und legen eine grobe Agenda fest. Die schicken wir mit ein paar Fragen an alle Teilnehmenden.',
  },
  {
    q: 'Können wir das Dokument intern weiterverwenden?',
    a: 'Ja, uneingeschränkt, denn das Ergebnis gehört euch. Das Dokument beschreibt, was vorhanden ist, wo es hakt und wie die Lösung aussieht. Damit könnt ihr intern planen oder andere Angebote vergleichen.',
  },
  {
    q: 'Reicht ein Workshop immer?',
    a: 'Für den Einstieg ja. Drei Termine reichen, um einen Ablauf aufzunehmen, die erste Stufe festzulegen und einen Festpreis dafür zu nennen. Ist es größer, zum Beispiel mehrere Abteilungen, eine Ablösung mit Datenübernahme aus Vertec oder dem ERP oder mehrere Standorte, sagen wir das im dritten Termin und schlagen vor, wie wir die Analyse vertiefen. Das Dokument behaltet ihr in jedem Fall.',
  },
  {
    q: 'Treffen wir uns vor Ort oder online?',
    a: 'Das entscheidet ihr. Wir empfehlen, sich mindestens einmal persönlich zu sehen, wenn der Weg es zulässt. Für die Anfahrt legen wir vorher eine Pauschale fest. Sie wird nicht von den Workshop-Stunden abgezogen.',
  },
  {
    q: 'Bei uns läuft schon eine Anwendung, der wir nicht ganz trauen. Passt der Workshop dafür?',
    a: 'Dafür gibt es die technische Variante: den Code-Check. Der Rahmen ist derselbe wie beim Workshop. Statt des Ablaufs prüfen wir Code, Zugriffe, Datenhaltung und Betrieb, egal wer die Anwendung gebaut hat. Geprüft wird entlang OWASP ASVS. Am Ende steht eine schriftliche Empfehlung: betreiben, härten oder neu aufsetzen. Ein Penetrationstest ist das nicht. Wenn ihr einen braucht, sagen wir das im Dokument. Sprecht uns im Erstgespräch darauf an.',
  },
];
---

<PageLayout
  title="Discovery-Workshop für Entscheider"
  description="Strukturierter Außenblick auf Prozesse und Systemlandschaft: Datenflüsse, Mockups und eine Empfehlung mit Festpreis. Drei Termine, ein Dokument, ein Festpreis für die Umsetzung. Das Ergebnis gehört euch."
  lang={locale}
  routeId="discoveryWorkshop"
  extraSchemas={[
    workshopServiceSchema,
    createFAQSchema(miniFaqs.map((f) => ({ question: f.q, answer: f.a }))),
  ]}
>
  <!-- HERO -->
  <SeitenHero eyebrow="Discovery-Workshop" titel="In drei Terminen wissen, was zu tun ist und was es kostet" text="Wir nehmen euren Ablauf auf, wie er wirklich läuft. Am Ende habt ihr ein Prozessbild, erste Entwürfe und einen festen Preis für die Umsetzung. Das Ergebnis gehört euch." knopf="Workshop anfragen" href={contactLinks.calDiscovery} zweiterKnopf={{ text: 'Ablauf und Preis', href: '#formate' }}>
    <Image
      src={teamBild}
      alt="Marten Prieß und ein Kollege arbeiten gemeinsam am Laptop"
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      class="border-border mx-auto aspect-[3/2] w-full max-w-lg rounded-2xl border object-cover shadow-xl"
      loading="eager"
    />
  </SeitenHero>

  <!-- CLIENT LOGOS -->
  <ClientLogoStrip
    heading="Erfahrung aus Projekten mit"
    logos={clientLogos}
    variant="light"
  />

  <!-- DELIVERABLES -->
  <section class="bg-background relative overflow-hidden py-24 lg:py-32">
    <div class="container relative z-10 max-w-6xl">
      <header data-reveal class="mx-auto max-w-3xl text-center">
        <div class="mx-auto flex max-w-md items-center gap-4">
          <span class="bg-border h-px flex-1"></span>
          <span
            class="border-brand-300 bg-card text-brand-600 flex h-10 w-10 items-center justify-center rounded-full border-2 font-mono text-sm font-bold"
          >
            01
          </span>
          <span
            class="text-foreground-muted text-xs font-semibold tracking-[0.22em] uppercase"
          >
            Was ihr bekommt
          </span>
          <span class="bg-border h-px flex-1"></span>
        </div>
        <h2
          lang="de"
          class="font-display text-foreground mt-8 text-3xl font-bold tracking-tight text-balance hyphens-auto [-webkit-hyphens:auto] sm:text-4xl"
        >
          Das habt ihr nach dem Workshop in der Hand
        </h2>
        <p class="text-foreground-secondary mt-6 text-lg leading-8">
          Drei Termine, ein Dokument, ein Festpreis. Am Ende stehen Unterlagen, mit denen
          Fachbereich, IT und Geschäftsführung gleichermaßen arbeiten können.
        </p>
      </header>

      <div
        data-reveal
        class="mt-16 grid gap-6 md:grid-cols-2 md:gap-7"
      >
        {
          deliverables.map((item) => (
            <article class="group border-border bg-card relative flex flex-col gap-4 rounded-2xl border p-7 shadow-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-lg sm:p-8">
              <div class="flex items-start gap-4">
                <div class="border-brand-300/70 bg-brand-500/5 text-brand-600 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border transition-colors duration-300 group-hover:bg-brand-500 group-hover:text-on-invert group-hover:border-brand-500">
                  <Icon name={item.icon} size="md" />
                </div>
                <h3 class="font-display text-foreground mt-1 text-lg font-bold tracking-tight sm:text-xl">
                  {item.title}
                </h3>
              </div>
              <p class="text-foreground-secondary text-[0.95rem] leading-7">
                {item.text}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ABLAUF -->
  <section
    class="bg-background-secondary border-border relative overflow-hidden border-y py-24 lg:py-32"
  >
    <div
      class="bg-grid-pattern pointer-events-none absolute inset-0 opacity-30 [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_70%)]"
      aria-hidden="true"
    >
    </div>
    <div class="container relative z-10 max-w-6xl">
      <header data-reveal class="mx-auto max-w-3xl text-center">
        <div class="mx-auto flex max-w-md items-center gap-4">
          <span class="bg-border h-px flex-1"></span>
          <span
            class="border-brand-300 bg-card text-brand-600 flex h-10 w-10 items-center justify-center rounded-full border-2 font-mono text-sm font-bold"
          >
            02
          </span>
          <span
            class="text-foreground-muted text-xs font-semibold tracking-[0.22em] uppercase"
          >
            Ablauf
          </span>
          <span class="bg-border h-px flex-1"></span>
        </div>
        <h2
          class="font-display text-foreground mt-8 text-3xl font-bold tracking-tight sm:text-4xl"
        >
          So läuft der Workshop ab
        </h2>
      </header>

      <!-- Icon-Timeline (Desktop) -->
      <div
        data-reveal
        class="relative mx-auto mt-16 hidden max-w-4xl md:block"
        aria-hidden="true"
      >
        <div class="bg-border/60 absolute left-[12%] right-[12%] top-8 h-px"></div>
        <ol class="relative grid grid-cols-4 gap-4">
          {
            processSteps.map((step) => (
              <li class="flex flex-col items-center text-center">
                <div class="border-brand-300 bg-card text-brand-600 relative z-10 flex h-16 w-16 items-center justify-center rounded-2xl border-2 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-brand-500 hover:bg-brand-500 hover:text-on-invert">
                  <Icon name={step.icon} size="lg" />
                </div>
                <p class="text-foreground-muted mt-4 font-mono text-xs font-semibold tracking-[0.22em] uppercase">
                  {step.number}
                </p>
                <p class="font-display text-foreground mt-2 text-sm font-bold tracking-tight">
                  {step.title}
                </p>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Detail-Cards -->
      <div
        data-reveal
        class="mt-12 grid gap-5 md:mt-16 md:grid-cols-2 md:gap-6"
      >
        {
          processSteps.map((step) => (
            <article class="border-border bg-card group relative flex gap-4 rounded-2xl border p-6 shadow-sm transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-lg">
              <div class="border-brand-300/70 bg-brand-500/5 text-brand-600 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl border transition-colors duration-300 group-hover:bg-brand-500 group-hover:text-on-invert group-hover:border-brand-500 md:hidden">
                <Icon name={step.icon} size="md" />
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-foreground-muted font-mono text-xs font-semibold tracking-[0.22em] uppercase">
                  {step.number}
                </p>
                <h3 class="font-display text-foreground mt-1 text-base font-bold tracking-tight sm:text-lg">
                  {step.title}
                </h3>
                <p class="text-foreground-secondary mt-2.5 text-sm leading-6">
                  {step.text}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>


  <!-- VISUAL EXAMPLES -->
  <section class="bg-background relative overflow-hidden py-24 lg:py-32">
    <div class="container relative z-10 max-w-6xl">
      <header data-reveal class="mx-auto max-w-3xl text-center">
        <div class="mx-auto flex max-w-md items-center gap-4">
          <span class="bg-border h-px flex-1"></span>
          <span
            class="border-brand-300 bg-card text-brand-600 flex h-10 w-10 items-center justify-center rounded-full border-2 font-mono text-sm font-bold"
          >
            02
          </span>
          <span
            class="text-foreground-muted text-xs font-semibold tracking-[0.22em] uppercase"
          >
            Ergebnis
          </span>
          <span class="bg-border h-px flex-1"></span>
        </div>
        <h2
          class="font-display text-foreground mt-8 text-3xl font-bold tracking-tight sm:text-4xl"
        >
          So sieht das Ergebnis aus
        </h2>
        <p class="text-foreground-secondary mt-6 text-lg leading-8">
          Das sind zwei Ausschnitte, nachgebaut nach echten Workshops. Das ganze Dokument ist deutlich
          länger.
        </p>
      </header>

      <div data-reveal class="mx-auto mt-16 grid max-w-6xl gap-10 lg:grid-cols-2 lg:gap-8">
        <figure class="min-w-0">
          <div class="af-frame">
            <div class="af-bar" aria-hidden="true">
              <span class="af-dots"><span></span><span></span><span></span></span>
              <span class="af-url">workshop · prozessbild</span>
              <span class="af-dots invisible"><span></span><span></span><span></span></span>
            </div>
            <div class="p-3 sm:p-4"><Prozessbild /></div>
          </div>
          <figcaption class="text-foreground-muted mt-5 flex items-start gap-2 text-sm leading-6">
            <Icon name="layers" size="xs" class="text-brand-500 mt-1 shrink-0" />
            <span>
              <strong class="text-foreground">Prozessbild.</strong>{' '}
              Euer Ablauf über alle Beteiligten, so wie er wirklich läuft. Rot markiert ist, wo heute
              abgetippt oder in Excel gerechnet wird. Geschäftsführung, Fachbereich und IT können es lesen.
            </span>
          </figcaption>
        </figure>
        <figure class="min-w-0">
          <div class="af-frame">
            <div class="af-bar" aria-hidden="true">
              <span class="af-dots"><span></span><span></span><span></span></span>
              <span class="af-url">workshop · entwurf</span>
              <span class="af-dots invisible"><span></span><span></span><span></span></span>
            </div>
            <div class="p-3 sm:p-4"><Entwurf /></div>
          </div>
          <figcaption class="text-foreground-muted mt-5 flex items-start gap-2 text-sm leading-6">
            <Icon name="palette" size="xs" class="text-brand-500 mt-1 shrink-0" />
            <span>
              <strong class="text-foreground">Oberflächen-Entwurf.</strong>{' '}
              Die wichtigsten Bildschirmseiten als klickbare Skizze. So sieht jeder im Raum, wie die
              Lösung arbeiten würde.
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- FORMATE & PREISE -->
  <section
    id="formate"
    class="bg-background-secondary border-border relative overflow-hidden border-y py-24 lg:py-32"
  >
    <div
      class="bg-brand-300/15 pointer-events-none absolute -right-24 top-1/3 h-96 w-96 rounded-full blur-3xl"
      aria-hidden="true"
    >
    </div>

    <div class="container relative z-10 max-w-6xl">
      <header data-reveal class="mx-auto max-w-3xl text-center">
        <div class="mx-auto flex max-w-md items-center gap-4">
          <span class="bg-border h-px flex-1"></span>
          <span
            class="border-brand-300 bg-card text-brand-600 flex h-10 w-10 items-center justify-center rounded-full border-2 font-mono text-sm font-bold"
          >
            03
          </span>
          <span
            class="text-foreground-muted text-xs font-semibold tracking-[0.22em] uppercase"
          >
            Preis
          </span>
          <span class="bg-border h-px flex-1"></span>
        </div>
        <h2
          class="font-display text-foreground mt-8 text-3xl font-bold tracking-tight sm:text-4xl"
        >
          Der Workshop kostet 1.500 €, das Ergebnis gehört euch
        </h2>
        <p class="text-foreground-secondary mt-6 text-lg leading-8">
          Der Preis gilt zzgl. USt. und ist bei Buchung fällig. Für Termine vor Ort kommt eine
          Anreisepauschale dazu.
        </p>
      </header>

      <div
        data-reveal
        class="mt-16 grid gap-6 md:grid-cols-[1.15fr_0.85fr] md:gap-7"
      >
        {
          formats.map((format) => (
            <article
              class:list={[
                'relative flex flex-col rounded-2xl border p-7 transition-all duration-300 ease-out hover:-translate-y-1 hover:shadow-lg sm:p-8',
                format.featured
                  ? 'border-brand-300 bg-card shadow-[0_20px_50px_-20px_rgba(99,102,241,0.35)]'
                  : 'border-border bg-card shadow-sm',
              ]}
            >
              {format.featured && (
                <span class="bg-brand-500 text-on-invert absolute -top-3 left-7 rounded-full px-3 py-1 text-[10px] font-bold tracking-[0.22em] uppercase">
                  Empfohlen
                </span>
              )}
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="font-display text-foreground text-xl font-bold tracking-tight">
                  {format.name}
                </h3>
                <span class="text-foreground-muted font-mono text-xs uppercase tracking-[0.18em]">
                  {format.duration}
                </span>
              </div>
              <p class="text-brand-600 mt-3 font-display text-3xl font-bold">
                {format.price}
              </p>
              <p class="text-foreground-muted border-border/60 mt-4 flex items-center gap-2 border-t pt-4 text-xs font-semibold tracking-[0.08em] uppercase">
                <Icon name="clock" size="xs" class="text-brand-500" />
                {format.sessions}
              </p>
              <p class="text-foreground-secondary mt-4 text-[0.95rem] leading-7">
                {format.summary}
              </p>
              <ul class="mt-6 flex flex-col gap-3">
                {format.includes.map((line) => (
                  <li class="text-foreground flex items-start gap-2.5 text-sm leading-6">
                    <Icon
                      name="check-circle"
                      size="sm"
                      class="text-brand-500 mt-0.5 shrink-0"
                    />
                    <span>{line}</span>
                  </li>
                ))}
              </ul>
              <p class="text-foreground-muted border-border/60 mt-6 border-t pt-5 text-sm leading-6">
                <strong class="text-foreground-secondary">Passt, wenn:</strong> {format.fit}
              </p>
            </article>
          ))
        }
        <article class="border-border bg-card flex flex-col rounded-2xl border p-7 shadow-sm sm:p-8">
          <h3 class="font-display text-foreground text-xl font-bold tracking-tight">
            Und wenn es größer ist?
          </h3>
          <p class="text-foreground-secondary mt-4 text-[0.95rem] leading-7">
            Dann sehen wir das im Workshop, etwa bei einer Ablösung mit Datenübernahme aus Vertec oder
            dem ERP. Das sagen wir im dritten Termin offen und schlagen vor, wie wir die Analyse
            vertiefen, mit eigenem Festpreis.
          </p>
          <p class="text-foreground-secondary mt-4 text-[0.95rem] leading-7">
            Das Dokument aus dem Workshop behaltet ihr in jedem Fall, auch wenn ihr danach mit
            jemand anderem weiterarbeitet.
          </p>
          <ul class="mt-6 flex flex-col gap-3">
            <li class="text-foreground flex items-start gap-2.5 text-sm leading-6">
              <Icon name="check-circle" size="sm" class="text-brand-500 mt-0.5 shrink-0" />
              <span>Umsetzung zum Festpreis, Betrieb im ersten Jahr inklusive</span>
            </li>
            <li class="text-foreground flex items-start gap-2.5 text-sm leading-6">
              <Icon name="check-circle" size="sm" class="text-brand-500 mt-0.5 shrink-0" />
              <span>Ab dem zweiten Jahr eine jährliche Pauschale für Hosting, Updates, Backups und kleine Anpassungen</span>
            </li>
            <li class="text-foreground flex items-start gap-2.5 text-sm leading-6">
              <Icon name="check-circle" size="sm" class="text-brand-500 mt-0.5 shrink-0" />
              <span>Ihr zahlt keine Lizenzkosten und seid über den Betrieb hinaus an keine Laufzeit gebunden</span>
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-background relative overflow-hidden py-24 lg:py-32">
    <div class="container relative z-10 max-w-4xl">
      <header data-reveal class="mx-auto max-w-3xl text-center">
        <div class="mx-auto flex max-w-md items-center gap-4">
          <span class="bg-border h-px flex-1"></span>
          <span
            class="border-brand-300 bg-card text-brand-600 flex h-10 w-10 items-center justify-center rounded-full border-2 font-mono text-sm font-bold"
          >
            04
          </span>
          <span
            class="text-foreground-muted text-xs font-semibold tracking-[0.22em] uppercase"
          >
            Fragen
          </span>
          <span class="bg-border h-px flex-1"></span>
        </div>
        <h2
          class="font-display text-foreground mt-8 text-3xl font-bold tracking-tight sm:text-4xl"
        >
          Häufige Fragen zum Workshop
        </h2>
      </header>

      <div data-reveal class="mt-12 flex flex-col gap-4">
        {
          miniFaqs.map((item) => (
            <details class="group border-border bg-card rounded-2xl border p-5 shadow-sm transition-shadow duration-300 open:shadow-lg sm:p-6">
              <summary class="flex cursor-pointer list-none items-start gap-4 [&::-webkit-details-marker]:hidden">
                <h3 class="font-display text-foreground flex-1 text-base font-bold tracking-tight sm:text-lg">
                  {item.q}
                </h3>
                <Icon
                  name="chevron-down"
                  size="sm"
                  class="text-foreground-muted mt-1 shrink-0 transition-transform duration-300 group-open:rotate-180"
                />
              </summary>
              <p class="text-foreground-secondary mt-4 border-t border-border/60 pt-4 text-[0.95rem] leading-7">
                {item.a}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-border bg-background-secondary border-t py-24">
    <div class="container max-w-4xl">
      <div
        data-reveal="zoom-in"
        class="border-border bg-card rounded-[2.25rem] border p-6 shadow-sm sm:p-8 lg:p-10"
      >
        <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">
              Nächster Schritt
            </p>
            <h2
              lang="de"
              class="font-display text-foreground mt-4 text-2xl font-bold tracking-tight text-balance hyphens-auto [-webkit-hyphens:auto] sm:text-3xl lg:text-4xl"
            >
              Wollt ihr wissen, was bei euch zu tun ist und was es kostet?
            </h2>
            <p class="text-foreground-secondary mt-6 text-lg leading-8">
              Vereinbart ein kurzes Vorgespräch mit Marten Prieß: über 15 Jahre als Softwarearchitekt, sechs davon bei bonprix.
            </p>
          </div>
          <div class="bg-background-secondary flex flex-wrap items-center gap-4 rounded-[1.5rem] p-5 sm:p-6">
            <Button href={contactLinks.calDiscovery} target="_blank">
              Workshop anfragen
              <Icon name="arrow-up-right" size="sm" />
            </Button>
            <Button variant="link" href={contactUrl}>
              Kontaktseite
              <Icon name="arrow-right" size="sm" />
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
