---
import SeitenHero from '@/components/landing/SeitenHero.astro';
import { Image } from 'astro:assets';
import leistungBild from '@/assets/angebote/kunde-annahme-hd.webp';
/**
 * „Alle Lösungen ansehen“: Übersicht über die drei Türen (Angebot, Einsatz, Zahlen), die Ablösung
 * als „das Ganze“ und den immer gleichen Weg dorthin. Seit 2026-10-07 neu, ersetzt die alte
 * Leistungsseite (Leistungsbausteine + typische Vorhaben). Die übrigen Vorhaben stehen kompakt
 * unter „Was wir außerdem bauen“. Keine Preise auf dieser Seite.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { ClientLogoStrip } from '@/components/ui/marketing/ClientLogoStrip';
import SectionHeader from '@/components/angebote/SectionHeader.astro';
import MiniVisual from '@/components/loesungen/MiniVisual.astro';
import { Picture } from 'astro:assets';
import founderPortrait from '@/assets/rocketbase/founder-marten-priess.jpg';
import { defaultLocale } from '@/i18n/config';
import { getLocalizedPath } from '@/i18n/index';
import { contactLinks } from '@/data/rocketbase';
import { createProfessionalServiceSchema } from '@/lib/schema';

const locale = defaultLocale;
const contactUrl = getLocalizedPath('contact', locale);
const workshopUrl = getLocalizedPath('discoveryWorkshop', locale);
const einsatzUrl = getLocalizedPath('einsatzplanung', locale);
const abloesungUrl = getLocalizedPath('standardsoftwareAbloesung', locale);
const checkUrl = '/software-check/';

const tueren = [
  {
    nr: '01',
    kind: 'angebot' as const,
    titel: 'Angebot & Kalkulation',
    wenn: 'Wenn die Kalkulation neben dem System liegt und jemand die Summe abtippt.',
    punkte: ['Angebote rechnen nach eurer Regel', 'Der Kunde sagt online mit einem Klick zu', 'Ihr seht, wann der Kunde geöffnet hat'],
    href: '/angebote/',
  },
  {
    nr: '02',
    kind: 'einsatz' as const,
    titel: 'Einsatz & Abrechnung',
    wenn: 'Wenn geplant wird in Excel, umgeplant am Telefon und abgerechnet aus Stundenzetteln.',
    punkte: ['Plantafel mit Abwesenheiten und Ablauf je Auftrag', 'Aus erfasster Leistung wird per Klick die Rechnung', 'Mahnungen mit Vorlagen für jede Stufe'],
    href: einsatzUrl,
  },
  {
    nr: '03',
    kind: 'zahlen' as const,
    titel: 'Zahlen & Steuerung',
    wenn: 'Wenn der Monatsabschluss viel Arbeit macht und die Zahlen schon alt sind, wenn sie kommen.',
    punkte: ['Umsatz und Prognose, jeden Tag aktuell', 'Auslastung bis zur einzelnen Person', 'Auslaufende Verträge seht ihr rechtzeitig'],
    href: '/zahlen/',
  },
];

const weg = [
  { nr: '01', titel: 'Erstgespräch', meta: '30 Minuten · kostenlos', text: 'Ihr erzählt, wo es hakt. Wir sagen ehrlich, ob und wie wir helfen können.' },
  { nr: '02', titel: 'Workshop', meta: 'drei Termine', text: 'Wir nehmen euren Ablauf auf, wie er wirklich läuft. Danach wisst ihr, was die Lösung kann und was sie kostet.' },
  { nr: '03', titel: 'Umsetzung', meta: 'Baustein für Baustein', text: 'Zuerst der Teil, der am meisten Zeit kostet. Das Tagesgeschäft läuft weiter.' },
  { nr: '04', titel: 'Betrieb', meta: 'aus einer Hand', text: 'Hosting, Updates und Weiterentwicklung von denen, die es gebaut haben. Im ersten Jahr inklusive.' },
];

const ausserdem = [
  { icon: 'layers', titel: 'Interne Plattformen', text: 'Für Produktdaten, Inhalte oder Abläufe, die in kein Standardprogramm passen.' },
  { icon: 'globe', titel: 'Schnittstellen', text: 'Damit eure Programme Daten austauschen und niemand sie von Hand überträgt.' },
  { icon: 'users', titel: 'Portale für Kunden', text: 'Eure Kunden bestellen, beantworten Rückfragen und holen Unterlagen ab, ohne lange Mailwechsel.' },
];

const clientLogos = [
  { key: 'fkc_logo', name: 'FKC Consulting' },
  { key: 'diezinger_logo', name: 'Schlosserei Diezinger' },
  { key: 'statista-logo', name: 'Statista' },
  { key: 'stage_logo', name: 'Stage Entertainment' },
  { key: 'bonprix_logo', name: 'bonprix' },
];

const servicesPageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const professionalServiceSchema = createProfessionalServiceSchema({
  url: servicesPageUrl,
  description:
    'Individuelle Software für inhabergeführte Betriebe: Angebot und Kalkulation, Einsatz und Abrechnung, Zahlen und Steuerung, oder die Ablösung der Branchensoftware. Vom Erstgespräch über den Workshop bis zum Betrieb aus einer Hand.',
  services: [...tueren.map((t) => t.titel), 'Standardsoftware ablösen', 'Software-Check'],
});
---

<PageLayout
  title="Lösungen: Angebot, Einsatz, Zahlen oder das Ganze"
  description="Software für Betriebe, die nicht in Standardlösungen passen: Angebot und Kalkulation, Einsatz und Abrechnung, Zahlen und Steuerung, oder die Ablösung der Branchensoftware. Der erste Schritt ist ein kostenloses Gespräch."
  lang={locale}
  routeId="services"
  extraSchemas={professionalServiceSchema}
>
  <!-- HERO -->
  <SeitenHero eyebrow="Lösungen" titel="Software für Angebot, Einsatz und Zahlen, die zu eurem Betrieb passt" text="In diesen drei Bereichen werden wir am häufigsten gebraucht. Ihr könnt mit einem anfangen oder eure Branchensoftware ganz ablösen." zweiterKnopf={{ text: 'Die drei Bereiche', href: '#tueren' }}>
    <Image
      src={leistungBild}
      alt="Zusage auf einer Angebotsseite mit wählbaren Leistungen und Summe"
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      class="border-border w-full rounded-2xl border shadow-xl"
      loading="eager"
    />
  </SeitenHero>
  <ClientLogoStrip heading="Aus Projekten mit" logos={clientLogos} variant="light" uniform class="py-8" />

  <!-- 01 DIE DREI TÜREN -->
  <section id="tueren" class="bg-background relative scroll-mt-16 overflow-x-clip py-24 lg:py-28">
    <div class="bg-brand-300/10 pointer-events-none absolute top-40 left-1/2 h-[36rem] w-[56rem] -translate-x-1/2 rounded-full blur-[120px]" aria-hidden="true"></div>
    <div class="relative z-10 container max-w-6xl">
      <SectionHeader
        size="md"
        number="01"
        eyebrow="Drei Bereiche"
        title="Wo geht bei euch die meiste Zeit verloren?"
        lead="Mit jedem Bereich könnt ihr einzeln anfangen. Jeder hat eine eigene Seite mit echten Ansichten aus Kundenlösungen. Der Weg ist immer gleich: erst reden, dann der Workshop, dann bauen."
      />
      <div class="mt-14 grid gap-5 lg:grid-cols-3 lg:gap-y-0">
        {
          tueren.map((t) => (
            <a href={t.href} data-reveal class="group border-border bg-card hover:border-brand-300 flex flex-col overflow-hidden rounded-[1.6rem] border p-4 pb-6 shadow-sm transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:shadow-[0_26px_55px_-28px_oklch(40%_0.1_265_/_0.45)] lg:row-span-6 lg:grid lg:grid-rows-subgrid lg:gap-y-0">
              <MiniVisual kind={t.kind} />
              <p class="text-brand-600 dark:text-brand-300 mt-5 px-2 font-mono text-xs font-semibold tracking-[0.2em]">{t.nr}</p>
              <h3 class="font-display text-foreground mt-2 px-2 text-xl font-bold tracking-tight">{t.titel}</h3>
              <p class="text-foreground-secondary mt-2 px-2 text-sm leading-6">{t.wenn}</p>
              <ul class="mt-4 space-y-2 px-2">
                {t.punkte.map((p) => (
                  <li class="text-foreground-secondary flex gap-2.5 text-sm leading-6">
                    <Icon name="check-circle" size="sm" class="text-brand-500 mt-0.5 shrink-0" />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
              <span class="mt-auto px-2 pt-6">
                <span class="border-brand-300/70 bg-brand-500/5 text-brand-600 group-hover:border-brand-500 group-hover:bg-brand-500 dark:text-brand-200 flex items-center justify-between gap-3 rounded-2xl border py-2.5 pr-2.5 pl-5 text-sm font-semibold transition-colors duration-300 group-hover:text-white">
                  {t.titel} ansehen
                  <span class="bg-brand-500 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl text-white transition-colors duration-300 group-hover:bg-white/20">
                    <Icon name="arrow-right" size="sm" />
                  </span>
                </span>
              </span>
            </a>
          ))
        }
      </div>

      <!-- Oder das Ganze -->
      <a
        href={abloesungUrl}
        data-reveal
        class="group border-brand-300/70 bg-card hover:border-brand-400 dark:border-brand-700 mt-5 grid items-center gap-6 overflow-hidden rounded-[1.6rem] border p-5 shadow-sm transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-[0_26px_55px_-28px_oklch(40%_0.1_265_/_0.45)] md:grid-cols-[minmax(0,1fr)_17rem] md:p-7"
      >
        <div>
          <p class="text-foreground-muted text-xs font-semibold tracking-[0.2em] uppercase">Oder das Ganze</p>
          <h3 class="font-display text-foreground mt-2 text-2xl font-bold tracking-tight">Standardsoftware ablösen</h3>
          <p class="text-foreground-secondary mt-2 max-w-xl text-sm leading-6 sm:text-base sm:leading-7">
            Wenn mehr fehlt als ein einzelner Teil: Wir lösen eure Branchensoftware und die Excel-Listen
            drumherum Schritt für Schritt ab. Das Alte läuft daneben weiter, und eure ganze Datenhistorie
            zieht mit.
          </p>
          <span class="text-brand-600 mt-4 inline-flex items-center gap-2 text-sm font-semibold transition-transform duration-300 group-hover:translate-x-1">
            So läuft eine Ablösung
            <Icon name="arrow-right" size="sm" />
          </span>
        </div>
        <MiniVisual kind="abloesung" />
      </a>

      <!-- Oder erst prüfen: für Betriebe, die Software schon haben -->
      <a
        href={checkUrl}
        data-reveal
        class="group border-border bg-card hover:border-brand-300 mt-5 grid items-center gap-6 overflow-hidden rounded-[1.6rem] border p-5 shadow-sm transition-[transform,box-shadow,border-color] duration-300 hover:-translate-y-1 hover:shadow-[0_26px_55px_-28px_oklch(40%_0.1_265_/_0.45)] md:grid-cols-[minmax(0,1fr)_17rem] md:p-7"
      >
        <div>
          <p class="text-foreground-muted text-xs font-semibold tracking-[0.2em] uppercase">Ihr baut selbst</p>
          <h3 class="font-display text-foreground mt-2 text-2xl font-bold tracking-tight">Software-Check</h3>
          <p class="text-foreground-secondary mt-2 max-w-xl text-sm leading-6 sm:text-base sm:leading-7">
            Ihr habt mit KI gebaut und wollt technischen Rat von jemandem, der es auch könnte? Ein
            erfahrener Entwickler und Architekt prüft Sicherheit, Struktur und Betrieb. Den Bericht könnt
            ihr Kunden und Auditoren vorlegen.
          </p>
          <span class="text-brand-600 mt-4 inline-flex items-center gap-2 text-sm font-semibold transition-transform duration-300 group-hover:translate-x-1">
            Was geprüft wird
            <Icon name="arrow-right" size="sm" />
          </span>
        </div>
        <MiniVisual kind="check" />
      </a>
    </div>
  </section>

  <!-- 02 DER WEG -->
  <section class="bg-background-secondary border-border relative border-y py-24 lg:py-28">
    <div class="relative z-10 container max-w-6xl">
      <SectionHeader
        size="md"
        number="02"
        eyebrow="Der Weg"
        title="In jedem Bereich fängt es gleich an"
        lead="Beratung, Konzept, Umsetzung und Betrieb kommen aus einer Hand, damit bei Übergaben kein Wissen verloren geht. Habt ihr jemanden, der selbst baut und bleibt, prüfen und begleiten wir seine Arbeit."
      />
      <ol class="relative mt-14 grid gap-4 md:grid-cols-4">
        <span class="bg-border absolute top-[1.35rem] right-[12%] left-[12%] hidden h-px md:block" aria-hidden="true"></span>
        {
          weg.map((s, i) => (
            <li data-reveal class="relative">
              <span class:list={['relative z-10 mx-auto flex h-11 w-11 items-center justify-center rounded-full font-mono text-sm font-bold md:mx-0', i === 1 ? 'bg-brand-500 text-white shadow-[0_10px_24px_-10px_var(--color-brand-500)]' : 'border-brand-300 bg-card text-brand-600 border-2']}>
                {s.nr}
              </span>
              <div class="border-border bg-card mt-4 rounded-2xl border p-5 text-center md:text-left">
                <h3 class="font-display text-foreground text-lg font-bold tracking-tight">{s.titel}</h3>
                <p class="text-brand-600 dark:text-brand-300 mt-0.5 text-xs font-semibold">{s.meta}</p>
                <p class="text-foreground-secondary mt-2 text-sm leading-6">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-center">
        <a href={workshopUrl} class="text-brand-600 inline-flex items-center gap-2 text-sm font-semibold hover:gap-3">
          Der Workshop im Detail
          <Icon name="arrow-right" size="sm" />
        </a>
      </p>
    </div>
  </section>

  <!-- 03 AUSSERDEM -->
  <section class="bg-background relative py-24 lg:py-28">
    <div class="relative z-10 container max-w-6xl">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:gap-16">
        <div data-reveal>
          <SectionHeader size="md" align="left" number="03" eyebrow="Was wir außerdem bauen" title="Manche Anfragen passen in keinen der drei Bereiche" />
          <p class="text-foreground-secondary mt-6 text-base leading-7">
            Auch dann reden wir zuerst miteinander und sagen euch ehrlich, ob wir die Richtigen sind.
          </p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            ausserdem.map((a) => (
              <article data-reveal class="border-border bg-card rounded-2xl border p-5">
                <span class="border-brand-300/70 bg-brand-500/5 text-brand-600 flex h-10 w-10 items-center justify-center rounded-xl border">
                  <Icon name={a.icon} size="sm" />
                </span>
                <h3 class="font-display text-foreground mt-4 text-base font-bold tracking-tight">{a.titel}</h3>
                <p class="text-foreground-secondary mt-1.5 text-sm leading-6">{a.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- KONTAKT -->
  <section class="loes-kontakt border-border relative overflow-x-clip border-t py-20 lg:py-24">
    <div class="relative z-10 container grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-16">
      <div data-reveal class="flex items-start gap-5">
        <Picture src={founderPortrait} alt="Marten Prieß" widths={[64, 128]} sizes="64px" formats={['avif', 'webp']} class="hidden h-16 w-16 shrink-0 rounded-full object-cover sm:block" loading="lazy" />
        <div>
          <h2 class="font-display text-foreground text-2xl font-bold tracking-tight text-balance sm:text-3xl">
            Nicht sicher, welcher Bereich passt?
          </h2>
          <p class="text-foreground-secondary mt-3 max-w-xl text-[0.95rem] leading-7">
            Das klären wir in 30 Minuten. Ihr erzählt, wo es hakt, und wir sagen ehrlich, wo wir anfangen
            würden. Das Gespräch führt Marten Prieß selbst, der Gründer von RocketBase.
          </p>
        </div>
      </div>
      <div data-reveal class="flex flex-wrap gap-3 lg:justify-end">
        <Button size="lg" href={contactLinks.cal} target="_blank">
          Erstgespräch buchen
          <Icon name="arrow-up-right" size="sm" />
        </Button>
        <Button variant="outline" size="lg" href={contactUrl}>
          Lieber schreiben
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .loes-kontakt {
    background:
      radial-gradient(55% 140% at 90% 50%, color-mix(in oklch, var(--color-brand-400) 22%, transparent), transparent 70%),
      color-mix(in oklch, var(--color-brand-500) 7%, var(--color-background));
  }
</style>
