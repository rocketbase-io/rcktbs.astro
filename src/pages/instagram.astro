---
/**
 * Ziel des Bio-Links auf Instagram (/instagram/).
 *
 * Instagram erlaubt genau einen Link im Profil. Statt ihn bei jedem Post zu
 * tauschen, zeigt er dauerhaft hierher: die vier neuesten Posts als Kachel
 * (quadratisches Bild, Text daneben, auf dem Desktop zwei nebeneinander),
 * ältere als schlichte Linkzeile. Gepflegt wird nur src/data/instagram.ts.
 *
 * Anders als /f/ und /b/ läuft die Seite bewusst mit Navigation (PageLayout
 * statt FunnelLayout): Ein Funnel soll keine Ausstiege haben, eine Bio-Seite
 * schon — wer von Instagram kommt, kennt die Firma noch nicht und darf sich
 * umsehen. noindex ist sie trotzdem, sie hat keinen eigenen Inhalt und würde
 * in der Suche nur mit dem Blog konkurrieren.
 */
import { Picture } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { ladeInstagramEintraege, mitTracking } from '@/features/instagram/eintraege';
import { contactLinks } from '@/data/rocketbase';
import { defaultLocale } from '@/i18n/config';

/** Anzahl der großen Kacheln; alles darüber hinaus wird zur Linkzeile. */
const KACHEL_ANZAHL = 4;

const eintraege = await ladeInstagramEintraege();
const kacheln = eintraege.slice(0, KACHEL_ANZAHL);
const weitere = eintraege.slice(KACHEL_ANZAHL);

const titel = 'Links aus unseren Instagram-Posts';
const beschreibung =
  'Die Artikel zu unseren Instagram-Beiträgen — jeder Post führt hier zum passenden Text in voller Länge.';
---

<PageLayout
  title={titel}
  description={beschreibung}
  lang={defaultLocale}
  routeId="instagram"
  noindex
>
  <section class="border-border bg-background-secondary border-b py-14 sm:py-16">
    <div class="container max-w-5xl">
      <p
        class="text-brand-600 dark:text-brand-300 inline-flex items-center gap-2 text-sm font-semibold tracking-[0.22em] uppercase"
      >
        <Icon name="instagram" size="sm" />
        Instagram
      </p>
      <h1
        lang="de"
        class="font-display text-foreground mt-4 max-w-3xl text-3xl font-bold tracking-tight text-balance sm:text-4xl"
      >
        {titel}
      </h1>
      <p class="text-foreground-secondary mt-5 max-w-2xl text-base leading-7 sm:text-lg">
        Auf Instagram passt immer nur der kurze Gedanke. Hier steht der lange:
        zu jedem Post der Artikel, aus dem er stammt.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container max-w-5xl">
      <!-- Kacheln: Bild und Text gleich breit; ab lg zwei Kacheln nebeneinander. -->
      <ul class="grid gap-6 lg:grid-cols-2">
        {
          kacheln.map((eintrag) => (
            <li>
              <article class="group border-border bg-card h-full overflow-hidden rounded-[2rem] border shadow-sm transition-[transform,box-shadow,border-color] duration-300 will-change-transform [backface-visibility:hidden] hover:border-border-strong hover:shadow-[0_20px_45px_rgba(34,43,74,0.1)]">
                <a
                  href={mitTracking(eintrag.href)}
                  data-instagram-link
                  class="grid h-full grid-cols-1 sm:grid-cols-2"
                >
                  {eintrag.bild ? (
                    <div class="overflow-hidden">
                      <Picture
                        src={eintrag.bild}
                        alt={eintrag.bildAlt}
                        widths={[320, 512, 640]}
                        sizes="(min-width: 1024px) 15rem, (min-width: 640px) 45vw, 100vw"
                        formats={['avif', 'webp']}
                        class="aspect-[4/5] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
                        loading="lazy"
                      />
                    </div>
                  ) : (
                    <div class="bg-background-secondary flex aspect-[4/5] items-center justify-center">
                      <span class="text-brand-500/40">
                        <Icon name="instagram" size="lg" />
                      </span>
                    </div>
                  )}

                  <div class="flex flex-col p-6">
                    <h2 class="font-display text-foreground text-lg leading-snug font-bold text-balance">
                      {eintrag.titel}
                    </h2>
                    {eintrag.text && (
                      <p class="text-foreground-secondary mt-3 line-clamp-4 text-sm leading-6">
                        {eintrag.text}
                      </p>
                    )}
                    <div class="text-brand-600 mt-auto inline-flex items-center gap-1.5 pt-5 text-sm font-semibold transition-transform duration-300 group-hover:translate-x-1">
                      Zum Artikel
                      <Icon name="arrow-right" size="sm" />
                    </div>
                  </div>
                </a>
              </article>
            </li>
          ))
        }
      </ul>

      <!-- Ältere Posts: nur noch Linkzeilen, ohne Bild. -->
      {
        weitere.length > 0 && (
          <div class="mt-12">
            <h2 class="text-foreground-muted text-xs font-semibold tracking-[0.22em] uppercase">
              Früher gepostet
            </h2>
            <ul class="border-border mt-4 border-t">
              {weitere.map((eintrag) => (
                <li class="border-border border-b">
                  <a
                    href={mitTracking(eintrag.href)}
                    data-instagram-link
                    class="group hover:bg-background-secondary flex items-baseline justify-between gap-4 py-4 transition-colors"
                  >
                    <span class="text-foreground group-hover:text-brand-600 text-base leading-snug font-medium transition-colors">
                      {eintrag.titel}
                    </span>
                    <span class="text-foreground-muted group-hover:text-brand-600 shrink-0 transition-[color,transform] duration-300 group-hover:translate-x-1">
                      <Icon name="arrow-right" size="sm" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div
        class="border-border text-foreground-muted mt-12 flex flex-wrap items-center justify-between gap-4 border-t pt-8 text-sm"
      >
        <a href="/blog/" class="hover:text-foreground inline-flex items-center gap-1.5 transition-colors">
          Alle Beiträge
          <Icon name="arrow-right" size="xs" />
        </a>
        <a
          href={contactLinks.instagram}
          target="_blank"
          rel="noopener"
          class="hover:text-foreground inline-flex items-center gap-1.5 transition-colors"
        >
          <Icon name="instagram" size="xs" />
          Zurück zum Profil
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<script>
  // Tracking-Parameter, die an der Bio-URL ankommen, auf die Ziel-Links
  // weiterreichen. Instagram hängt selbst etwas an (fbclid), bei bezahlten
  // Kampagnen kommen eigene utm_* dazu. Ohne das endet die Spur hier, und im
  // Artikel steht nur noch das pauschale utm_source=instagram.
  import { UTM_KEYS, CLICK_ID_KEYS } from '@/lib/leadTracking';

  const ankommend = new URLSearchParams(window.location.search);
  const uebernehmen = [...UTM_KEYS, ...CLICK_ID_KEYS].filter((key) => ankommend.get(key));

  if (uebernehmen.length > 0) {
    document.querySelectorAll<HTMLAnchorElement>('[data-instagram-link]').forEach((link) => {
      // Nur eigene Ziele anfassen: Bei fremden Domains hat unsere Attribution
      // nichts zu suchen.
      if (link.hostname !== window.location.hostname) return;
      const ziel = new URL(link.href, window.location.origin);
      // Ankommende Parameter gewinnen gegen die hartcodierten Defaults: Ein
      // echtes Kampagnen-Tag ist genauer als das pauschale "instagram".
      for (const key of uebernehmen) {
        ziel.searchParams.set(key, ankommend.get(key)!);
      }
      link.href = ziel.toString();
    });
  }
</script>
