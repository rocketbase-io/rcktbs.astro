---
/**
 * Tür 2: Einsatz & Abrechnung. Dieselben Inhalte wie die Anzeigen-Landing
 * /f/einsatz/, aber mit Navigation, indexiert und ohne Quiz. Inhalt in
 * components/einsatz/EinsatzPage.astro. Die Adresse /einsatzplanung/ bleibt
 * (Links, Suchmaschinen), der Inhalt ist seit 2026-10-07 neu.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { einsatzFaqs } from '@/components/einsatz/faqs';
import { createServiceSchema, createFAQSchema } from '@/lib/schema';
import { Image } from 'astro:assets';
import LeistungRechnung from '@/components/einsatz/LeistungRechnung.astro';
import SchlankPage from '@/components/funnel-schlank/SchlankPage.astro';
import Plantafel from '@/components/einsatz/Plantafel.astro';
import HeuteEinsatz from '@/components/einsatz/HeuteEinsatz.astro';
import auftragsplanung from '@/assets/references/auftragsplanung-demo-1920.png';
import { einsatz, preisFrage } from '@/data/funnelSchlank';
import { additionalCases, cases } from '@/data/rocketbase';

const serviceSchema = createServiceSchema({
  name: 'Einsatz und Abrechnung',
  description: 'Plantafel mit Abwesenheiten, Ablauf je Auftrag, Einsatz je Vertrag, Leistungserfassung, Rechnung und Mahnwesen in einem System, nach dem Ablauf des Betriebs gebaut.',
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  serviceType: 'Individualsoftware für Einsatzplanung, Leistungserfassung und Abrechnung',
  areaServed: 'DE',
});
const faqs = einsatzFaqs.map((f) => (f.q === preisFrage.q ? preisFrage : f));
const faqSchema = createFAQSchema(faqs.map((f) => ({ question: f.q, answer: f.a })));
const stimme = [...cases, ...additionalCases].find((c) => c.slug === 'bonprix-collection-planning')?.testimonial;
---

<LandingLayout
  title="Software für Einsatzplanung und Abrechnung"
  description="Fällt jemand aus, seht ihr sofort, wer einspringen kann. Was erledigt ist, wird zur Rechnung. Eigene Software nach eurem Ablauf, statt Excel und Stundenzettel."
  lang="de"
  extraSchemas={[serviceSchema, faqSchema]}
  routeId="einsatzplanung"
>
  <SchlankPage mehrTitel="Aus erledigter Arbeit wird die Rechnung" tor={einsatz} modus="seite" blogTuer="einsatz" faqs={faqs} zitat={stimme}>
  <Image
    slot="hero"
    src={auftragsplanung}
    alt="Auftragsplanung mit Mitarbeitern, Einsätzen und Krankmeldungen, Demo-Daten"
    widths={[640, 960, 1280]}
    sizes="(min-width: 1024px) 50vw, 100vw"
    class="border-border w-full rounded-2xl border shadow-xl"
    loading="eager"
  />
  <Plantafel />
  <HeuteEinsatz slot="heute" />
  <LeistungRechnung slot="mehr" />
</SchlankPage>
</LandingLayout>
