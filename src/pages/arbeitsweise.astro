---
import SeitenHero from '@/components/landing/SeitenHero.astro';
import { Image } from 'astro:assets';
import auftragsplanung from '@/assets/references/auftragsplanung-demo-1920.png';
import PageLayout from '@/layouts/PageLayout.astro';
import { Picture } from 'astro:assets';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { defaultLocale } from '@/i18n/config';
import { contactLinks } from '@/data/rocketbase';
import { cn } from '@/lib/cn.ts';

import bsfzSiegel2025 from '@/assets/rocketbase/bsfz_siegel-2025.svg';
import bsfzSiegel2026 from '@/assets/rocketbase/bsfz_siegel-2026.svg';
import teamBefore from '@/assets/work/team-before.png';
import teamAfter from '@/assets/work/team-after.png';
import serverBefore from '@/assets/work/server-before.png';
import serverAfter from '@/assets/work/server-after.png';
import toolsBefore from '@/assets/work/tools-before.png';
import toolsAfter from '@/assets/work/tools-after.png';
import kiBefore from '@/assets/work/ki-before.png';
import kiAfter from '@/assets/work/ki-after.png';

const locale = defaultLocale;

// Das Wichtigste der früheren Seite /mission/, die seit 2026-10-31 hierher weiterleitet.
const haltungen = [
  { titel: 'Zuerst klären, welches Problem zu lösen ist', text: 'Wir setzen uns mit den Leuten zusammen, die den Ablauf jeden Tag machen. Oft ist das eigentliche Problem ein anderes als das, was zuerst auf dem Zettel stand.' },
  { titel: 'Ihr sprecht mit den Leuten, die auch bauen', text: 'Wer euch etwas zusagt, setzt es danach selbst um. Deshalb wird gebaut, was besprochen wurde.' },
  { titel: 'Wir widersprechen, wenn ein Wunsch falsch läuft', text: 'Gute Lösungen entstehen im Gespräch. Wir arbeiten direkt mit euch, und jemand widerspricht, wenn es nötig ist.' },
  { titel: 'Eure Software passt an eure anderen Programme', text: 'Jede Anwendung hat eine dokumentierte Schnittstelle. Damit verbindet ihr sie mit euren Programmen oder baut Automatisierungen in n8n oder Make.' },
];

const sections = [
  {
    id: 'team',
    number: '01',
    eyebrow: 'Team',
    title: 'Ein kleines Team, das schnell entscheidet',
    subline: 'Ihr habt einen gemeinsamen Slack-Channel und einen festen Verantwortlichen.',
    layout: 'split' as const,
    background: 'default' as const,
    before: {
      title: 'Typisch im Konzern',
      text: 'Typisch sind acht oder mehr Leute. Eine Entscheidung wandert durch mehrere Tickets und tägliche Abstimmungen, bis sie steht. Das Wissen verteilt sich, und jede Übergabe kostet Zeit und damit Geld.',
      image: teamBefore,
    },
    after: {
      title: 'Bei uns',
      text: 'Bei uns arbeitet ein eingespieltes Team aus technischer Leitung, Entwicklung und Architektur. Entscheidungen fallen im Gespräch. So schafft es so viel wie Teams ab 12 Personen.',
      image: teamAfter,
    },
  },
  {
    id: 'cloud',
    number: '02',
    eyebrow: 'Server',
    title: 'Eure Software läuft in einer Cloud in Deutschland',
    subline:
      'Wir nutzen Hetzner. Backups, Überwachung und mehr Leistung bei Bedarf sind dabei, und ihr braucht dafür kein eigenes Admin-Team.',
    layout: 'stacked' as const,
    background: 'secondary' as const,
    before: {
      title: 'Server im Büro',
      text: 'In vielen Betrieben steht der Server noch im Büroschrank. Backups macht jemand von Hand, Updates laufen am Wochenende, und von außen kommt man schwer dran. Geht die Hardware kaputt oder wächst der Betrieb, wird es schnell eng.',
      image: serverBefore,
    },
    after: {
      title: 'Cloud aus Deutschland',
      text: 'Eure Anwendung läuft in der Hetzner Cloud in Deutschland, DSGVO-konform. Backups laufen automatisch, und das System wird durchgehend überwacht. Braucht ihr mehr Leistung, geht das jederzeit.',
      image: serverAfter,
    },
  },
  {
    id: 'tools',
    number: '03',
    eyebrow: 'Werkzeuge',
    title: 'Alle Daten liegen in einem System',
    subline:
      'Ein System ersetzt drei Excel-Listen, ein CRM und einen Mailverteiler. Eure Auswertungen sind immer aktuell.',
    layout: 'split' as const,
    background: 'default' as const,
    before: {
      title: 'Viele Werkzeuge nebeneinander',
      text: 'Typisch sind Bestellungen in Excel, Kunden im CRM, Versand in Trello und Berichte per Mail. Vieles wird doppelt gepflegt, und niemand hat den ganzen Überblick.',
      image: toolsBefore,
    },
    after: {
      title: 'Ein System',
      text: 'Bestellungen, Stammdaten und Auswertungen greifen ineinander und stehen an einer Stelle.',
      image: toolsAfter,
    },
  },
  {
    id: 'ki',
    number: '04',
    eyebrow: 'Entwicklung',
    title: 'KI erledigt die Fleißarbeit, das senkt eure Kosten',
    subline:
      'Wir setzen KI dort ein, wo sie wirklich Zeit spart. Das senkt Aufwand und Kosten, und die Qualität bleibt gleich.',
    layout: 'reveal' as const,
    background: 'secondary' as const,
    before: {
      title: 'Alles von Hand',
      text: 'Klassisch wird vieles von Hand getippt: Standard-Code, Tests und Dokumentation. Diese Wiederholung frisst Zeit und kostet Geld.',
      image: kiBefore,
    },
    after: {
      title: 'KI und Open Source',
      text: 'KI übernimmt die wiederkehrende Arbeit. Unsere Entwickler kümmern sich um das, wofür es Erfahrung braucht: eure Geschäftsregeln und eine Lösung, die trägt.',
      image: kiAfter,
    },
  },
];
---

<PageLayout
  title="Wie wir arbeiten - schnell, schlank, KI-gestützt"
  description="Kleines Team, kurze Wege, KI da, wo sie Arbeit spart. Vier konkrete Wechsel in unserer Arbeitsweise, die Projekte schneller, günstiger und tragfähiger machen."
  lang={locale}
  routeId="work"
>
  <!-- HERO -->
  <SeitenHero eyebrow="Wie wir arbeiten" titel="Schneller und günstiger zur passenden Software" text="Vier Dinge machen wir heute anders als vor zehn Jahren. Euer Projekt wird dadurch schneller fertig und kostet weniger.">
    <Image
      src={auftragsplanung}
      alt="Auftragsplanung mit Mitarbeitern und Einsätzen, Demo-Daten"
      widths={[640, 960, 1280]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      class="border-border w-full rounded-2xl border shadow-xl"
      loading="eager"
    />
  </SeitenHero>

  <section class="border-border border-b py-14 lg:py-20">
    <div class="container max-w-6xl">
      <h2 class="font-display text-foreground text-2xl font-bold tracking-tight text-balance sm:text-4xl">
        Über 15 Jahre Erfahrung aus Konzern und Mittelstand
      </h2>
      <p class="text-foreground-secondary mt-3 max-w-2xl text-base leading-7">
        Wir haben unter anderem für bonprix und Statista gebaut. Die Technik wählen wir so, dass sie
        auch in fünf Jahren noch trägt, auch wenn dann jemand anderes das Projekt übernommen hat.
      </p>
      <div class="mt-7 grid gap-4 lg:grid-cols-2">
        {
          haltungen.map((h) => (
            <div class="bg-brand-500/5 rounded-2xl p-5">
              <p class="font-display text-foreground font-bold">{h.titel}</p>
              <p class="text-foreground-secondary mt-1.5 text-[0.95rem] leading-6">{h.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- SECTIONS -->
  <div>
    {
      sections.map((section) => (
        <section
          id={section.id}
          class={cn(
            'relative overflow-hidden py-24 lg:py-32',
            section.background === 'secondary'
              ? 'bg-background-secondary'
              : 'bg-background'
          )}
        >
          {section.background === 'secondary' && (
            <>
              <div
                class="bg-grid-pattern pointer-events-none absolute inset-0 opacity-30 [mask-image:radial-gradient(ellipse_at_center,black_20%,transparent_70%)]"
                aria-hidden="true"
              />
              <div
                class={cn(
                  'bg-brand-300/15 pointer-events-none absolute h-96 w-96 rounded-full blur-3xl',
                  section.id === 'team' ? '-left-24 top-1/3' : '-right-24 bottom-1/4'
                )}
                aria-hidden="true"
              />
            </>
          )}

          <div class="container relative z-10 max-w-6xl">
            {/* HEADER */}
            <header data-reveal class="mx-auto max-w-3xl text-center">
              <div class="mx-auto flex max-w-md items-center gap-4">
                <span class="bg-border h-px flex-1" />
                <span class="border-brand-300 bg-card text-brand-600 group-hover:bg-brand-500 group-hover:text-on-invert flex h-10 w-10 items-center justify-center rounded-full border-2 font-mono text-sm font-bold transition-colors duration-300">
                  {section.number}
                </span>
                <span class="text-foreground-muted text-xs font-semibold tracking-[0.22em] uppercase">
                  {section.eyebrow}
                </span>
                <span class="bg-border h-px flex-1" />
              </div>
              <h2 class="font-display text-foreground mt-8 text-3xl font-bold tracking-tight sm:text-4xl">
                {section.title}
              </h2>
              <p class="text-foreground-secondary mt-6 text-lg leading-8">
                {section.subline}
              </p>
            </header>

            {/* SPLIT LAYOUT */}
            {section.layout === 'split' && (
              <div class="mt-16 grid gap-12 md:grid-cols-2 md:items-center md:gap-16">
                <div data-reveal="fade-right" class="space-y-6">
                  <div>
                    <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">
                      So machen wir es · {section.after.title}
                    </p>
                    <p class="text-foreground mt-3 text-lg leading-8 font-medium">
                      {section.after.text}
                    </p>
                  </div>
                  <div class="border-border/60 border-l-2 pl-4">
                    <p class="text-foreground-muted text-[11px] font-semibold tracking-[0.22em] uppercase">
                      So ist es oft · {section.before.title}
                    </p>
                    <p class="text-foreground-muted mt-2 text-sm leading-6">
                      {section.before.text}
                    </p>
                  </div>
                </div>

                <div data-reveal="fade-left" class="relative mx-auto w-full max-w-md">
                  <div class="group relative">
                    <Picture
                      src={section.after.image}
                      alt={section.after.title}
                      widths={[320, 480, 640, 900]}
                      sizes="(max-width: 768px) calc(100vw - 3rem), 448px"
                      formats={['avif', 'webp']}
                      class="border-border w-full rotate-1 rounded-3xl border shadow-xl transition-all duration-500 ease-out group-hover:rotate-0 group-hover:-translate-y-1 group-hover:shadow-2xl"
                      loading="lazy"
                    />
                    <Picture
                      src={section.before.image}
                      alt={section.before.title}
                      widths={[128, 160, 320]}
                      sizes="(max-width: 640px) 128px, 160px"
                      formats={['avif', 'webp']}
                      class="border-border bg-card absolute -top-6 -left-6 w-32 -rotate-6 rounded-2xl border-4 border-white shadow-lg transition-all duration-500 ease-out hover:rotate-0 hover:scale-110 hover:z-20 sm:w-40"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>
            )}

            {/* STACKED LAYOUT */}
            {section.layout === 'stacked' && (
              <div class="mt-16 grid gap-12 md:grid-cols-[1fr_1.1fr] md:items-center md:gap-16">
                <div data-reveal="zoom-in" class="group relative mx-auto h-[360px] w-full max-w-sm">
                  <Picture
                    src={section.before.image}
                    alt={section.before.title}
                    widths={[224, 336, 448]}
                    sizes="224px"
                    formats={['avif', 'webp']}
                    class="border-border absolute top-12 left-0 w-56 -rotate-3 rounded-2xl border opacity-70 shadow-md grayscale transition-all duration-500 ease-out group-hover:-translate-x-4 group-hover:rotate-[-6deg] group-hover:opacity-90 group-hover:grayscale-0"
                    loading="lazy"
                  />
                  <Picture
                    src={section.after.image}
                    alt={section.after.title}
                    widths={[256, 384, 512]}
                    sizes="256px"
                    formats={['avif', 'webp']}
                    class="border-border absolute top-0 right-0 w-64 rotate-3 rounded-2xl border shadow-2xl transition-all duration-500 ease-out group-hover:translate-x-4 group-hover:rotate-6 group-hover:-translate-y-2"
                    loading="lazy"
                  />
                  <div
                    class="bg-brand-300/20 pointer-events-none absolute inset-0 -z-10 rounded-full blur-3xl"
                    aria-hidden="true"
                  />
                </div>

                <div data-reveal="fade-left" class="space-y-6">
                  <div>
                    <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">
                      So machen wir es · {section.after.title}
                    </p>
                    <p class="text-foreground mt-3 text-lg leading-8 font-medium">
                      {section.after.text}
                    </p>
                  </div>
                  <div class="border-border/60 border-l-2 pl-4">
                    <p class="text-foreground-muted text-[11px] font-semibold tracking-[0.22em] uppercase">
                      So ist es oft · {section.before.title}
                    </p>
                    <p class="text-foreground-muted mt-2 text-sm leading-6">
                      {section.before.text}
                    </p>
                  </div>
                </div>
              </div>
            )}

            {/* REVEAL LAYOUT */}
            {section.layout === 'reveal' && (
              <div class="mt-16 grid gap-12 md:grid-cols-[1.1fr_1fr] md:items-center md:gap-16">
                <div data-reveal="fade-right" class="group relative mx-auto h-[400px] w-full max-w-md">
                  <Picture
                    src={section.before.image}
                    alt={section.before.title}
                    widths={[176, 208, 352, 416]}
                    sizes="(max-width: 640px) 176px, 208px"
                    formats={['avif', 'webp']}
                    class="border-border absolute bottom-0 left-0 w-44 rounded-2xl border opacity-40 shadow-md grayscale transition-all duration-500 ease-out group-hover:opacity-80 group-hover:grayscale-0 sm:w-52"
                    loading="lazy"
                  />
                  <Picture
                    src={section.after.image}
                    alt={section.after.title}
                    widths={[288, 320, 576, 640]}
                    sizes="(max-width: 640px) 288px, 320px"
                    formats={['avif', 'webp']}
                    class="border-brand-300 absolute top-0 right-0 w-72 rotate-2 rounded-3xl border-2 shadow-[0_30px_60px_-15px_rgba(99,102,241,0.4)] transition-all duration-500 ease-out group-hover:rotate-0 group-hover:-translate-y-2 group-hover:shadow-[0_40px_80px_-15px_rgba(99,102,241,0.6)] sm:w-80"
                    loading="lazy"
                  />
                </div>

                <div data-reveal="fade-left" class="space-y-6">
                  <div>
                    <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">
                      So machen wir es · {section.after.title}
                    </p>
                    <p class="text-foreground mt-3 text-lg leading-8 font-medium">
                      {section.after.text}
                    </p>
                  </div>
                  <div class="border-border/60 border-l-2 pl-4">
                    <p class="text-foreground-muted text-[11px] font-semibold tracking-[0.22em] uppercase">
                      So ist es oft · {section.before.title}
                    </p>
                    <p class="text-foreground-muted mt-2 text-sm leading-6">
                      {section.before.text}
                    </p>
                  </div>
                </div>
              </div>
            )}

          </div>
        </section>
      ))
    }
  </div>

  <!-- BSFZ-Anerkennung -->
  <section class="border-border border-t py-20 lg:py-24">
    <div class="container max-w-5xl">
      <div data-reveal class="grid items-center gap-10 rounded-[2rem] border border-border bg-card p-8 shadow-sm sm:p-10 md:grid-cols-[auto_1fr] md:gap-12 lg:p-12">
        <div class="flex items-center justify-center gap-4 md:flex-col md:gap-5">
          <img
            src={bsfzSiegel2025.src}
            alt="BSFZ-Siegel 2025 – Bescheinigte Forschungszulage"
            width="112"
            height="112"
            class="h-24 w-24 lg:h-28 lg:w-28"
            loading="lazy"
          />
          <img
            src={bsfzSiegel2026.src}
            alt="BSFZ-Siegel 2026 – Bescheinigte Forschungszulage"
            width="112"
            height="112"
            class="h-24 w-24 lg:h-28 lg:w-28"
            loading="lazy"
          />
        </div>

        <div>
          <p class="text-brand-600 text-xs font-semibold tracking-[0.22em] uppercase">
            Anerkennung
          </p>
          <h2 class="font-display text-foreground mt-3 text-2xl font-bold tracking-tight sm:text-3xl">
            Vom Bund anerkannte Forschung &amp; Entwicklung
          </h2>
          <p class="text-foreground-secondary mt-4 text-base leading-7 sm:text-lg">
            Zwei unserer Vorhaben wurden 2025 und 2026 von der Bescheinigungsstelle
            Forschungszulage (BSFZ) als <strong>förderfähige Forschungs- und Entwicklungsvorhaben</strong>{' '}
            anerkannt.
          </p>
          <p class="text-foreground-secondary mt-4 text-base leading-7 sm:text-lg">
            Das ist eine unabhängige Bestätigung, dass unsere Entwicklungsarbeit auch hohen technischen
            Ansprüchen standhält.
          </p>
          <a
            href="https://www.bescheinigung-forschungszulage.de/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-brand-600 hover:text-brand-500 dark:text-brand-400 mt-6 inline-flex items-center gap-1.5 text-sm font-semibold transition-colors"
          >
            Mehr zur Bescheinigungsstelle Forschungszulage
            <Icon name="arrow-up-right" size="sm" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-border bg-background-secondary border-t py-24">
    <div class="container max-w-4xl">
      <div
        data-reveal="zoom-in"
        class="border-border bg-card rounded-[2.25rem] border p-6 shadow-sm sm:p-8 lg:p-10"
      >
        <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
          <div>
            <p class="text-brand-600 text-sm font-semibold tracking-[0.22em] uppercase">
              Zusammenarbeit
            </p>
            <h2 class="font-display text-foreground mt-4 text-2xl font-bold tracking-tight sm:text-3xl lg:text-4xl">
              Wo klemmt es bei euch gerade?
            </h2>
            <p class="text-foreground-secondary mt-6 text-lg leading-8">
              Erzählt uns davon. Wir sagen euch, was wir sehen und was wir tun würden.
            </p>
          </div>
          <div class="bg-background-secondary space-y-4 rounded-[1.5rem] p-5 sm:p-6">
            <Button href={contactLinks.cal} target="_blank">
              Erstgespräch buchen
              <Icon name="arrow-up-right" size="sm" />
            </Button>
            <p class="text-foreground-muted text-sm break-words">
              Oder direkt per Mail an {contactLinks.email}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

