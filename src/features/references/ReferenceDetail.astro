---
import PassendeLoesung from '@/components/blog/PassendeLoesung.astro';
import { referenzPasstWenn, referenzTueren } from '@/data/tueren';
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { Testimonial } from '@/components/ui/marketing/Testimonial';
import bonprixCaseImage from '@/assets/references/teaser-bonprix.jpeg';
import statistaCaseImage from '@/assets/references/teaser-statista.jpeg';
import fkcCaseImage from '@/assets/references/teaser-fkc.jpeg';
import schlossereiCaseImage from '@/assets/references/teaser-schlosserei.jpeg';
import statistaCanvaCaseImage from '@/assets/references/teaser-statista-canva.jpeg';
import stageCmlCaseImage from '@/assets/references/teaser-stage-cml.jpeg';
import samVorteilsguruCaseImage from '@/assets/references/teaser-sam-vorteilsguru.jpeg';
import mavoxCaseImage from '@/assets/references/teaser-mavox-winterdienst.jpeg';
import bonprixCollectionCaseImage from '@/assets/references/teaser-bonprix-collection-planning.jpeg';
import { defaultLocale } from '@/i18n/config';
import { cases, additionalCases, contactLinks } from '@/data/rocketbase';

// Builds "<client>: <case> | Referenz" but truncates the case part so the
// final <title> (incl. " - RocketBase" suffix) stays around 60 chars.
function buildSeoTitle(client: string, caseTitle: string): string {
  const suffix = ' | Referenz';
  const budget = 45 - suffix.length - client.length - 2; // ": "
  let casePart = caseTitle;
  if (casePart.length > budget) {
    const firstClause = casePart.split(/[,–:]/)[0].trim();
    casePart = firstClause.length <= budget
      ? firstClause
      : casePart.slice(0, budget - 1).trimEnd() + '…';
  }
  return `${client}: ${casePart}${suffix}`;
}

const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '@/assets/client-logos/*.{svg,png,webp,jpeg,jpg}',
  { eager: true },
);
const logoMap: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(logoModules).map(([path, mod]) => {
    const key = path.split('/').pop()!.replace(/\.(svg|png|webp|jpe?g)$/i, '');
    return [key, mod.default];
  }),
);

// Map case slugs to client logo keys (some slugs share a parent brand logo).
const caseLogoKey: Record<string, string> = {
  bonprix: 'bonprix_logo',
  'bonprix-collection-planning': 'bonprix_logo',
  statista: 'statista-logo',
  'statista-canva': 'statista-logo',
  'fkc-consulting': 'fkc_logo',
  'schlosserei-diezinger': 'diezinger_logo',
  'stage-cml': 'stage_logo',
  'sam-vorteilsguru': 'sam',
  'mavox-winterdienst': 'mavox_logo',
};

const screenshotModules = import.meta.glob<{ default: ImageMetadata }>(
  '@/assets/references/*.{png,jpeg,webp}',
  { eager: true },
);
const screenshotImages: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(screenshotModules)
    .filter(([path]) => !path.includes('/teaser-'))
    .map(([path, mod]) => {
      const key = path.split('/').pop()!.replace(/\.(png|jpe?g|webp)$/i, '');
      return [key, mod.default];
    }),
);

const allCases = [...cases, ...additionalCases];

type CaseItem = (typeof allCases)[number];

interface Props {
  item: CaseItem;
}

const { item } = Astro.props as Props;
const locale = defaultLocale;

const caseImages = {
  bonprix: bonprixCaseImage,
  statista: statistaCaseImage,
  'fkc-consulting': fkcCaseImage,
  'schlosserei-diezinger': schlossereiCaseImage,
  'statista-canva': statistaCanvaCaseImage,
  'stage-cml': stageCmlCaseImage,
  'sam-vorteilsguru': samVorteilsguruCaseImage,
  'mavox-winterdienst': mavoxCaseImage,
  'bonprix-collection-planning': bonprixCollectionCaseImage,
} as const;

const hasImage = item.slug in caseImages;
const clientLogo = logoMap[caseLogoKey[item.slug] ?? ''];
const loesungen = referenzTueren[item.slug] ?? [];
// Kurz genug, dass Google sie nicht abschneidet. Der Name vorn ist, wonach gesucht wird.
const seoTitel: Record<string, string> = {
  bonprix: 'bonprix: Neue Plattform für Produktdaten',
  'bonprix-collection-planning': 'bonprix: Sortimentsplanung statt Excel',
  'fkc-consulting': 'FKC Consulting: Vertec-Ablösung',
  'schlosserei-diezinger': 'Schlosserei Diezinger: Einsatzplanung',
  'stage-cml': 'Stage Entertainment: Budgetplanung statt Excel',
  statista: 'Statista: Neue Redaktionsplattform',
  'statista-canva': 'Statista: Daten direkt in Canva',
  'sam-vorteilsguru': 'Smart Active Media: Gutscheinportal',
  'mavox-winterdienst': 'MAVOX Winterdienst: Tourenplanung und App',
};
const passtWenn = referenzPasstWenn[item.slug] ?? [];
const fakten = (item as { fakten?: { label: string; wert: string }[] }).fakten ?? [];
const laufzeit = fakten.find((f) => f.label === 'Laufzeit')?.wert;
const otherCases = allCases.filter((entry) => entry.slug !== item.slug).slice(0, 2);

const contextBlocks = [
  { label: 'Die Ausgangslage', text: item.challenge },
  { label: 'Was wir gemacht haben', text: item.approach },
  { label: 'Das Ergebnis', text: item.impact },
];

// Optionale "Was jetzt läuft"-Sektion: konkrete Lösung + spürbarer Nutzen.
// Wird nur gerendert, wenn der Case ein `solved`-Feld hat.
const solvedItems = (item as { solved?: { title: string; benefit: string }[] }).solved ?? [];
const hasSolved = solvedItems.length > 0;

const resolvedScreenshots = await Promise.all(
  (item.screenshots ?? []).map(async (shot) => {
    const image = screenshotImages[shot.key];
    if (!image) return null;
    const large = await getImage({
      src: image,
      width: 1920,
      format: 'webp',
      quality: 85,
    });
    return { key: shot.key, alt: shot.alt, image, largeSrc: large.src };
  }),
).then((arr) => arr.filter((s): s is NonNullable<typeof s> => s !== null));
// Der erste Screenshot steht im Hero, der Rest in der Galerie.
const [heroShot, ...galerieShots] = resolvedScreenshots;
---

<PageLayout
  title={seoTitel[item.slug] ?? buildSeoTitle(item.client, item.title)}
  description={item.description}
  imageAlt={`${item.client} – ${item.title}`}
  lang={locale}
>
  <!-- Hero: Das echte Produkt zuerst, das Kunden-Bild nur, wenn es keine Screenshots gibt -->
  <section class="relative overflow-hidden border-b border-border bg-background-secondary pt-24 pb-12 sm:pt-28 lg:pb-20">
    <div class="pointer-events-none absolute -right-24 -top-24 h-96 w-96 rounded-full bg-brand-300/20 blur-3xl"></div>
    <div class="relative mx-auto grid w-full max-w-7xl items-center gap-x-14 gap-y-8 px-5 sm:px-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
      <div>
        {clientLogo && (
          <img
            src={clientLogo.src}
            alt={`${item.client} Logo`}
            width={clientLogo.width}
            height={clientLogo.height}
            class="mb-5 h-9 w-auto object-contain object-left dark:invert"
            loading="eager"
          />
        )}
        <p class="text-xs font-semibold tracking-[0.14em] text-brand-600 uppercase">Referenz · {item.client}</p>
        <h1 class="mt-3 font-display text-[2rem] leading-[1.1] font-bold tracking-tight text-balance text-foreground sm:text-5xl lg:text-[2.75rem] lg:leading-[1.12]">
          {item.heading}
        </h1>
        <p class="mt-4 text-base leading-7 text-foreground-secondary sm:text-lg sm:leading-8">{item.kicker}</p>
      </div>
      {heroShot ? (
        <Picture
          src={heroShot.image}
          alt={heroShot.alt}
          widths={[640, 960, 1280]}
          sizes="(max-width: 1024px) 100vw, 55vw"
          formats={['avif', 'webp']}
          class="border-border w-full rounded-2xl border object-cover object-top shadow-xl"
          loading="eager"
        />
      ) : hasImage && (
        <Picture
          src={caseImages[item.slug as keyof typeof caseImages]}
          alt={item.title}
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 1024px) 100vw, 55vw"
          formats={['avif', 'webp']}
          class="h-80 w-full rounded-2xl object-cover shadow-xl"
        />
      )}
    </div>
  </section>

  {fakten.length > 0 && (
    <section class="border-b border-border py-6 lg:py-8">
      <dl class="container flex max-w-6xl flex-wrap justify-between gap-x-10 gap-y-4">
        {fakten.map((f) => (
          <div>
            <dt class="text-xs font-semibold tracking-[0.14em] text-foreground-muted uppercase">{f.label}</dt>
            <dd class="mt-1 font-display text-lg font-bold tracking-tight text-foreground">{f.wert}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <!-- Die Geschichte links, das Ergebnis rechts -->
  <section class="py-12 lg:py-24">
    <div class="container grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:gap-16">
      <div class="space-y-8">
        {contextBlocks.map((block) => (
          <div>
            <h2 class="font-display text-xl font-bold tracking-tight text-foreground sm:text-2xl">{block.label}</h2>
            <p class="mt-2 text-base leading-7 text-foreground-secondary sm:text-[1.05rem] sm:leading-8">{block.text}</p>
          </div>
        ))}
      </div>
      <aside class="self-start rounded-2xl border border-border bg-card p-6 shadow-sm lg:sticky lg:top-24">
        <p class="text-xs font-semibold tracking-[0.14em] text-brand-600 uppercase">Das hat sich verbessert</p>
        <ul class="mt-4 space-y-3">
          {item.outcomes.map((outcome) => (
            <li class="flex gap-2.5 text-[0.95rem] leading-6 text-foreground">
              <Icon name="check-circle" size="sm" class="mt-0.5 shrink-0 text-brand-500" />
              <span>{outcome}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 border-t border-border pt-5 text-xs font-semibold tracking-[0.14em] text-foreground-muted uppercase">Unsere Arbeit</p>
        <ul class="mt-3 space-y-1.5">
          {item.services.map((service) => (
            <li class="text-sm leading-6 text-foreground-secondary">{service}</li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  {item.testimonial && (
    <section class="border-y border-border bg-background-secondary py-12 lg:py-16">
      <div class="container max-w-4xl">
        <Testimonial
          quote={item.testimonial.quote}
          author={item.testimonial.author}
          position={item.testimonial.position}
          portraitKey={item.testimonial.portraitKey}
          client={item.client}
        />
      </div>
    </section>
  )}

  <!-- Was jetzt läuft (optional) -->
  {hasSolved && (
    <section class="border-y border-border py-12 lg:py-20">
      <div class="container max-w-6xl">
        <h2 data-reveal class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Was wir gebaut haben und was es bringt</h2>

        <div class="mt-8 grid gap-4 md:grid-cols-2 md:gap-6">
          {solvedItems.map((entry) => (
            <article
              class="hover-lift group flex gap-4 rounded-2xl border border-border bg-card p-6 shadow-sm transition-all duration-300 hover:border-brand-300 hover:shadow-lg sm:p-7"
              data-reveal
            >
              <Icon name="check-circle" size="md" class="mt-0.5 shrink-0 text-brand-500" />
              <div>
                <h3 class="font-display text-lg font-bold tracking-tight text-foreground">{entry.title}</h3>
                <p class="mt-2 text-[0.95rem] leading-7 text-foreground-secondary">{entry.benefit}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Screenshots -->
  {galerieShots.length > 0 && (
    <section class="py-12 lg:py-20">
      <div class="container max-w-6xl">
        <h2 data-reveal class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">So sieht die Software aus</h2>
        {laufzeit && <p class="mt-2 text-sm text-foreground-muted">Aufnahmen aus dem Projekt, {laufzeit}.</p>}

        <div
          class="screenshot-gallery mt-8 grid gap-6 sm:grid-cols-2 lg:gap-8"
          data-lightbox-gallery
        >
          {galerieShots.map((shot, i) => {
            return (
              <figure
                class="screenshot-tile group relative"
                data-reveal

              >
                <button
                  type="button"
                  class:list={[
                    'relative block w-full cursor-zoom-in overflow-hidden rounded-xl',
                    'border border-border bg-card p-2 shadow-lg',
                    'transition-all duration-500 ease-out',
                    ' hover:shadow-2xl hover:shadow-brand-900/20',
                    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2 focus-visible:ring-offset-background',
                  ]}
                  data-lightbox-trigger
                  data-src={shot.largeSrc}
                  data-alt={shot.alt}
                  data-index={i}
                  aria-label={`${shot.alt} vergrößern`}
                >
                  <span
                    aria-hidden="true"
                    class="absolute left-3 top-3 z-10 font-mono text-[10px] font-bold tracking-[0.22em] text-foreground-muted/70"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="relative block overflow-hidden rounded-md bg-background-secondary">
                    <Picture
                      src={shot.image}
                      alt={shot.alt}
                      widths={[480, 640, 960]}
                      sizes="(max-width: 640px) 100vw, 45vw"
                      formats={['avif', 'webp']}
                      class="aspect-[16/10] w-full object-cover object-top"
                      loading="lazy"
                    />
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-500/0 via-brand-500/0 to-brand-500/30 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                    ></span>
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-foreground/70 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
                    ></span>
                    <span
                      aria-hidden="true"
                      class="pointer-events-none absolute bottom-3 right-3 flex items-center gap-1.5 rounded-full bg-background/95 px-3 py-1.5 text-xs font-semibold text-brand-600 shadow-md translate-y-2 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100"
                    >
                      Vergrößern
                      <Icon name="arrow-up-right" size="xs" />
                    </span>
                  </span>
                </button>
                <figcaption
                  class:list={[
                    'mt-3 px-1 text-left text-xs font-medium text-foreground-secondary transition-all duration-500',
                    'group-hover:text-foreground',
                  ]}
                >
                  {shot.alt}
                </figcaption>
              </figure>
            );
          })}
        </div>
      </div>

      <!-- Lightbox -->
      <div
        id="screenshot-lightbox"
        class="fixed inset-0 z-[60] hidden items-center justify-center"
        role="dialog"
        aria-modal="true"
        aria-label="Screenshot-Ansicht"
        data-lightbox
      >
        <div
          class="absolute inset-0 bg-foreground/85 opacity-0 backdrop-blur-md transition-opacity duration-300"
          data-lightbox-backdrop
          aria-hidden="true"
        ></div>

        <button
          type="button"
          class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-background/90 text-foreground shadow-lg backdrop-blur-sm transition-transform hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          data-lightbox-close
          aria-label="Schließen"
        >
          <Icon name="x" size="sm" />
        </button>

        <button
          type="button"
          class="absolute left-4 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-background/90 text-foreground shadow-lg backdrop-blur-sm transition-transform hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 sm:h-12 sm:w-12"
          data-lightbox-prev
          aria-label="Vorheriges Bild"
        >
          <Icon name="arrow-left" size="sm" />
        </button>

        <button
          type="button"
          class="absolute right-4 top-1/2 z-10 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-background/90 text-foreground shadow-lg backdrop-blur-sm transition-transform hover:scale-105 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 sm:h-12 sm:w-12"
          data-lightbox-next
          aria-label="Nächstes Bild"
        >
          <Icon name="arrow-right" size="sm" />
        </button>

        <figure
          class="relative z-0 mx-4 flex max-h-[90vh] w-full max-w-6xl scale-95 flex-col items-center opacity-0 transition-all duration-300"
          data-lightbox-panel
        >
          <img
            data-lightbox-image
            src=""
            alt=""
            class="max-h-[80vh] w-auto max-w-full rounded-xl border border-border/50 bg-card object-contain shadow-2xl"
          />
          <figcaption
            class="mt-4 flex items-center gap-3 rounded-full bg-background/90 px-4 py-2 text-sm text-foreground-secondary shadow-lg backdrop-blur-sm"
          >
            <span data-lightbox-caption></span>
            <span class="h-4 w-px bg-border"></span>
            <span class="font-mono text-xs text-foreground-muted" data-lightbox-counter></span>
          </figcaption>
        </figure>
      </div>

      <script>
        function initLightbox() {
          const lightbox = document.getElementById('screenshot-lightbox');
          if (!lightbox || lightbox.dataset.init) return;
          lightbox.dataset.init = 'true';

          const gallery = document.querySelector<HTMLElement>('[data-lightbox-gallery]');
          if (!gallery) return;

          const triggers = Array.from(
            gallery.querySelectorAll<HTMLButtonElement>('[data-lightbox-trigger]')
          );
          const backdrop = lightbox.querySelector<HTMLElement>('[data-lightbox-backdrop]');
          const panel = lightbox.querySelector<HTMLElement>('[data-lightbox-panel]');
          const image = lightbox.querySelector<HTMLImageElement>('[data-lightbox-image]');
          const caption = lightbox.querySelector<HTMLElement>('[data-lightbox-caption]');
          const counter = lightbox.querySelector<HTMLElement>('[data-lightbox-counter]');
          const closeBtn = lightbox.querySelector<HTMLElement>('[data-lightbox-close]');
          const prevBtn = lightbox.querySelector<HTMLElement>('[data-lightbox-prev]');
          const nextBtn = lightbox.querySelector<HTMLElement>('[data-lightbox-next]');

          let currentIndex = 0;
          let lastFocused: HTMLElement | null = null;

          function render(index: number) {
            const trigger = triggers[index];
            if (!trigger || !image || !caption || !counter) return;
            currentIndex = index;
            image.src = trigger.dataset.src || '';
            image.alt = trigger.dataset.alt || '';
            caption.textContent = trigger.dataset.alt || '';
            counter.textContent = `${index + 1} / ${triggers.length}`;
          }

          function open(index: number) {
            lastFocused = document.activeElement as HTMLElement;
            render(index);
            lightbox!.classList.remove('hidden');
            lightbox!.classList.add('flex');
            requestAnimationFrame(() => {
              backdrop?.classList.add('opacity-100');
              panel?.classList.remove('scale-95', 'opacity-0');
              panel?.classList.add('scale-100', 'opacity-100');
            });
            document.body.classList.add('overflow-hidden');
            closeBtn?.focus();
          }

          function close() {
            backdrop?.classList.remove('opacity-100');
            panel?.classList.add('scale-95', 'opacity-0');
            panel?.classList.remove('scale-100', 'opacity-100');
            setTimeout(() => {
              lightbox!.classList.add('hidden');
              lightbox!.classList.remove('flex');
              document.body.classList.remove('overflow-hidden');
              lastFocused?.focus();
            }, 280);
          }

          function next() {
            render((currentIndex + 1) % triggers.length);
          }

          function prev() {
            render((currentIndex - 1 + triggers.length) % triggers.length);
          }

          triggers.forEach((trigger, i) => {
            trigger.addEventListener('click', () => open(i));
          });
          closeBtn?.addEventListener('click', close);
          backdrop?.addEventListener('click', close);
          nextBtn?.addEventListener('click', next);
          prevBtn?.addEventListener('click', prev);

          document.addEventListener('keydown', (e) => {
            if (lightbox!.classList.contains('hidden')) return;
            if (e.key === 'Escape') close();
            else if (e.key === 'ArrowRight') next();
            else if (e.key === 'ArrowLeft') prev();
          });

          // Swipe support
          let touchStartX = 0;
          panel?.addEventListener('touchstart', (e) => {
            touchStartX = e.touches[0].clientX;
          });
          panel?.addEventListener('touchend', (e) => {
            const delta = e.changedTouches[0].clientX - touchStartX;
            if (Math.abs(delta) > 50) {
              if (delta < 0) next();
              else prev();
            }
          });
        }

        initLightbox();
        document.addEventListener('astro:page-load', initLightbox);
      </script>
    </section>
  )}

  <!-- Passt das zu euch? -->
  <section class="border-t border-border py-12 lg:py-20">
    <div class="container max-w-6xl">
      <div class="grid gap-8 rounded-2xl border border-border bg-card p-6 shadow-sm sm:p-8 lg:grid-cols-[1.2fr_0.8fr] lg:items-center lg:p-10">
        <div>
          <h2 class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Das passt zu euch, wenn …</h2>
          <ul class="mt-4 space-y-2">
            {passtWenn.map((p) => (
              <li class="flex gap-2.5 text-base leading-7 text-foreground-secondary">
                <Icon name="check-circle" size="sm" class="mt-1 shrink-0 text-brand-500" />
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="space-y-3 lg:justify-self-end">
          <Button href={contactLinks.cal} target="_blank">
            Erstgespräch buchen
            <Icon name="arrow-up-right" size="sm" />
          </Button>
          <p class="text-sm text-foreground-muted">30 Minuten, online, kostenlos.</p>
          <a href="/referenzen/" class="block text-sm font-semibold text-foreground-secondary hover:text-foreground">← Alle Referenzen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Passende Lösung: aus dieser Referenz entstandene Türen (data/tueren.ts) -->
  {
    loesungen.length > 0 && (
      <section class="border-border bg-background-secondary border-y py-16 lg:py-20">
        <div class="container max-w-6xl">
          <PassendeLoesung doors={loesungen} heading={loesungen.length > 1 ? 'Daraus entstandene Lösungen' : 'Daraus entstandene Lösung'} />
        </div>
      </section>
    )
  }

  <!-- Weitere Referenzen -->
  <section class="border-t border-border bg-background-secondary py-12 lg:py-20">
    <div class="container max-w-6xl">
      <h2 data-reveal class="font-display text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Weitere Referenzen</h2>

      <div class="mt-12 grid gap-6 lg:grid-cols-2">
        {otherCases.map((entry) => (
          <a
            href={`/referenzen/${entry.slug}/`}
            class="hover-lift group relative overflow-hidden rounded-2xl border border-border bg-card p-8 shadow-sm hover:border-brand-300"
            data-reveal
          >
            <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-600">{entry.client}</p>
            <h3 class="mt-3 text-xl font-semibold text-foreground transition-colors group-hover:text-brand-600">
              {entry.heading}
            </h3>
            <p class="mt-3 text-sm leading-7 text-foreground-secondary">{entry.kicker}</p>
            <div class="mt-6 flex items-center gap-1.5 text-sm font-semibold text-brand-600">
              Referenz öffnen
              <Icon name="arrow-right" size="sm" class="transition-transform duration-200 group-hover:translate-x-1" />
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</PageLayout>
