---
/**
 * Funnel-Fassung, gerendert von /f/zahlen/ (seit 2026-10-16, Branch new-funnels). Die indexierte
 * Tür-Seite /zahlen/ hängt an components/zahlen/ und bleibt ausführlicher.
 *
 * Inhalt der Tür 3 „Zahlen & Steuerung“, geteilt von zwei Seiten (wie AngebotePage):
 *   /f/zahlen/  (variant="funnel"): Anzeigen-Landing, FunnelLayout, noindex, Quiz im Hero und am Ende
 *   /zahlen/    (variant="site"):   Tür 3 in der Navigation, LandingLayout, indexiert, statt Quiz ein CTA
 * Entstanden 2026-10-07.
 *
 * Die Cockpit-Ansichten sind Nachbauten aus der laufenden Kundenlösung (Geschäftsführer-, Team-,
 * Kunden-Cockpit, Ressourcen-Dashboard) in HTML/SVG, mit Beispieldaten und neutralen Team- und
 * Bereichsnamen. Keine Screenshots: scharf auf jedem Bildschirm, Dark Mode, nichts Echtes.
 *
 * Funnel-Fassung 2026-10-18 (Muster wie /f/angebote/): Heute → 01 Cockpit (zählt hoch) →
 * 02 Auslastung (schaltet „+ Geplant“ selbst) → 03 Verträge → Band → 04 Lohnt sich + Marten →
 * 05 FAQ. Raus (stehen auf /zahlen/): Bis zur Person, Kunden, „Erst die Fragen“, mittlerer Aufruf.
 *
 * Keine Preise auf dieser Seite, auch kein „Festpreis“ (wie /f/angebote/). Der Workshop ist
 * kein Schritt auf der Seite; seine Konditionen stehen nur auf /discovery-workshop/.
 *
 * Abgrenzung zu Tür 2 (Einsatz & Abrechnung): hier die Verdichtung (Cockpit, Prognose,
 * Auslastung bis zur Person, Wegfall, Kunden, Forderungen). Vorgaben je Mitarbeiter,
 * Leistungserfassung, Rechnungen und Mahnstufen gehören auf die Einsatz-Seite.
 */
import { zahlenFaqs } from './faqs';
import BlogQuerverweis from '@/components/blog/BlogQuerverweis.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Blueprint from '@/components/hero-backgrounds/Blueprint.astro';
import { ClientLogoStrip } from '@/components/ui/marketing/ClientLogoStrip';
import SectionHeader from '@/components/angebote-funnel/SectionHeader.astro';
import FunnelQuiz from '@/components/funnel/FunnelQuiz';
import ErstgespraechKarte from '@/components/funnel/ErstgespraechKarte.astro';
import DealZeile from '@/components/funnel/DealZeile.astro';
import VonHeuteBisDahin from '@/components/funnel/VonHeuteBisDahin.astro';
import LohntSich from '@/components/funnel/LohntSich.astro';
import VertrauensBand from '@/components/funnel/VertrauensBand.astro';
import '@/styles/szene.css';
import { Picture } from 'astro:assets';
import founderPortrait from '@/assets/rocketbase/founder-marten-priess.jpg';
import type { FunnelQuizQuestion } from '@/data/funnels';
import { contactLinks } from '@/data/rocketbase';
import CockpitMock from './CockpitMock.astro';
import AuslastungTeams from './AuslastungTeams.astro';
import WegfallZiele from './WegfallZiele.astro';
import HeuteKalender from './HeuteKalender.astro';
import '@/components/angebote-funnel/frame.css';
import './zahlen.css';

interface Props {
  variant: 'funnel' | 'site';
}
const { variant } = Astro.props;
const istFunnel = variant === 'funnel';

const clientLogos = [
  { key: 'fkc_logo', name: 'FKC Consulting' },
  { key: 'statista-logo', name: 'Statista' },
  { key: 'stage_logo', name: 'Stage Entertainment' },
  { key: 'diezinger_logo', name: 'Schlosserei Diezinger' },
];

// Quiz: drei kurze Fragen, danach das Kontaktformular (Telefon Pflicht, Firma optional).
const quizFragen: FunnelQuizQuestion[] = [
  {
    id: 'heute',
    question: 'Woher kommen eure Zahlen heute?',
    hint: 'Grobe Einordnung reicht.',
    options: [
      {
        id: 'excel',
        label: 'Aus Excel, von Hand zusammengebaut',
        description: 'Exporte ziehen, abgleichen, Monat für Monat.',
      },
      {
        id: 'system',
        label: 'Aus Berichten im ERP oder der Branchensoftware',
        description: 'Die Standardberichte passen nicht ganz zu unseren Fragen.',
      },
      {
        id: 'bi',
        label: 'Aus einem BI-Tool',
        description: 'Power BI, Metabase oder ähnlich, aber die Pflege hängt an einer Person.',
      },
      {
        id: 'bwa',
        label: 'Von der BWA, einmal im Monat',
        description: 'Was im Betrieb los ist, sehen wir erst Wochen später.',
      },
      {
        id: 'sonstiges',
        label: 'Anders',
        allowText: true,
        textPlaceholder: 'Beschreibt in ein, zwei Sätzen, wie ihr heute an eure Zahlen kommt …',
      },
    ],
  },
  {
    id: 'zuerst',
    question: 'Was wollt ihr zuerst sehen?',
    hint: 'Das, was am meisten fehlt.',
    options: [
      {
        id: 'umsatz',
        label: 'Umsatz und Prognose',
        description: 'Wo stehen wir, wo landen wir am Jahresende?',
      },
      {
        id: 'auslastung',
        label: 'Auslastung der Mitarbeiter',
        description: 'Wer ist voll, wer hat Luft, und wie sieht es in drei Monaten aus?',
      },
      {
        id: 'db',
        label: 'Deckungsbeitrag',
        description: 'Woran verdienen wir, je Kunde, Vertrag, Produkt?',
      },
      {
        id: 'vertraege',
        label: 'Verträge und Forderungen',
        description: 'Was läuft aus, was ist offen, wer zahlt spät?',
      },
    ],
  },
  {
    id: 'groesse',
    question: 'Wie viele Leute arbeiten bei euch?',
    hint: 'Ungefähr reicht.',
    options: [
      { id: 'lt30', label: 'Unter 30' },
      { id: '30-80', label: '30 bis 80' },
      { id: '80-150', label: '80 bis 150' },
      { id: 'gt150', label: 'Über 150' },
    ],
  },
];

const quizProps = {
  funnel: 'zahlen',
  questions: quizFragen,
  contact: {
    heading: 'Wohin darf sich Marten Prieß melden?',
    text: 'Hinterlasst eure Kontaktdaten, Marten Prieß meldet sich werktags persönlich und sucht mit euch einen Termin.',
  },
  success: {
    heading: 'Danke, eure Nachricht ist angekommen.',
    text: 'Marten Prieß meldet sich werktags bei euch.',
  },
  submitLabel: 'Nachricht senden',
  phoneHint: 'Telefon für eine kurze Rückfrage. Wir rufen an, wenn es hilft.',
  leadEvent: 'zahlen_lead',
  privacyUrl: '/datenschutz/',
};

const miniFaqs = zahlenFaqs;

// „Von heute bis dahin“: Strecke und Einwände der Funnel-Fassung (ersetzt dort die FAQ).
const strecke = {
  stationen: [
    { wann: 'So läuft es heute', titel: 'Exporte, eine Excel, die BWA', text: 'Zahlen ziehen, abgleichen, eine Excel bauen. Die BWA kommt drei Wochen später und sagt, was war. Wie die Teams im nächsten Quartal ausgelastet sind, schätzt jemand nebenbei.' },
    { wann: 'Woche 1 bis 2', titel: 'Erstgespräch und Aufnahme', text: 'Dreißig Minuten über eure Zahlen. Dann sehen wir uns an, wo die Daten liegen und was zuerst fehlt, und ihr bekommt einen Festpreis.' },
    { wann: 'Danach, 4 bis 6 Wochen', titel: 'Das Cockpit steht', text: 'Programmiert zum Festpreis: Umsatz, Auslastung und Verträge aus euren Systemen. Weitere Zahlen kommen dazu, sobald die ersten tragen.' },
  ] as const,
  einwaende: [
    { satz: 'Das dauert ewig.', antwort: 'Nach der Aufnahme steht das Cockpit in vier bis sechs Wochen, mit den Zahlen, die euch heute am meisten fehlen.' },
    { satz: 'Dafür haben wir keine Zeit.', antwort: 'Zwei bis drei Stunden pro Woche von euch: ein Termin, dazu Ausprobieren.' },
    { satz: 'Unsere Daten sind nicht sauber genug.', antwort: 'Das ist der Normalfall. Oft reicht es, zwei, drei Felder verbindlich zu machen. Das Cockpit zeigt Lücken, statt sie zu verstecken.' },
    { satz: 'Wir haben schon ein ERP.', antwort: 'Das bleibt. Das Cockpit holt sich die Zahlen von dort, aus der Zeiterfassung und der Buchhaltung.' },
    { satz: 'Dann müssen wir alles umstellen.', antwort: 'Umgestellt wird Schritt für Schritt. Das Alte läuft, bis das Neue trägt.' },
    { satz: 'Ist das nicht wieder Software von der Stange?', antwort: 'Nein. Wir setzen auf dem auf, was bei anderen Betrieben schon läuft, und programmieren, was bei euch anders ist. Nichts zum Konfigurieren, keine Grenzen. Mit unserer Erfahrung und KI beim Programmieren geht das schnell und bleibt bezahlbar.' },
    { satz: 'Das ist sicher teuer.', antwort: 'Den Rahmen hört ihr im Erstgespräch, den Festpreis nach der Aufnahme. Programmiert wird erst, wenn ihr ihn kennt.' },
  ],
};

---

<!-- HERO -->
<section
  data-hero
  class:list={[
    'relative overflow-x-clip lg:flex lg:flex-col',
    istFunnel ? 'lg:min-h-[calc(100svh-3.5rem)]' : 'pt-24 sm:pt-20 lg:min-h-[100svh] lg:pt-16',
  ]}
>
  <Blueprint />
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(ellipse_60%_50%_at_30%_40%,var(--color-background)_0%,transparent_75%)] opacity-80"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-[84rem] px-5 pt-8 pb-16 sm:px-8 sm:pt-14 lg:grid lg:flex-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:items-center lg:gap-16 lg:px-12 lg:py-6"
  >
    <div class="text-center lg:text-left">
      <p
        data-reveal="fade-down"
        class="text-brand-600 dark:text-brand-300 text-sm font-semibold tracking-[0.22em] uppercase"
      >
        Zahlen &amp; Steuerung
      </p>
      <h1
        data-reveal="fade-down"
        lang="de"
        class="font-display text-foreground mt-3 text-[2.05rem] leading-[1.08] font-bold tracking-tight text-balance hyphens-auto [-webkit-hyphens:auto] sm:mt-5 sm:text-6xl sm:leading-[1.05] xl:text-[4.25rem]"
      >
        {
          istFunnel ? (
            <>
              Wie läuft der Betrieb?
              <span class="text-brand-500 block">Heute sehen, nicht am Monatsende.</span>
            </>
          ) : (
            <>
        Euer Betrieb auf einen Blick.
        <span class="text-brand-500 block">Live, nicht am Monatsende.</span>
            </>
          )
        }
      </h1>
      <p
        data-reveal
        class="text-foreground-muted mt-6 hidden flex-wrap items-center justify-center gap-x-2.5 gap-y-2 text-sm font-medium sm:flex lg:justify-start"
      >
        <span>Schluss mit</span>
        {
          ['Monats-Excel', 'Warten auf die BWA', 'Bauchgefühl'].map((alt) => (
            <span class="hero-alt border-border rounded-md border px-2 py-0.5">{alt}</span>
          ))
        }
      </p>
      {istFunnel && <DealZeile />}
      {
        !istFunnel && (
      <p
        data-reveal
        class="text-foreground-secondary mx-auto mt-4 max-w-lg text-base leading-7 sm:mt-7 sm:text-lg sm:leading-8 lg:mx-0"
      >
        Umsatz, Auslastung, was übrig bleibt, welche Verträge auslaufen. Jeden Morgen aktuell, aus
        den Systemen, die ihr habt.
      </p>
        )
      }
      <p
        class="text-foreground-muted border-border/70 bg-background/85 mx-auto mt-8 hidden max-w-lg rounded-xl border px-4 py-3 text-sm leading-6 backdrop-blur-sm lg:mx-0 lg:block"
      >
        Aus einer laufenden Kundenlösung, für euren Betrieb angepasst. Ob Beratung, Prüfung, Wartung
        oder Service.
      </p>
    </div>

    {
      istFunnel ? (
        <div id="quiz" class="mt-7 scroll-mt-20 sm:mt-10 lg:mt-0 lg:min-h-[38rem]" data-quiz>
          <FunnelQuiz
            client:load
            {...quizProps}
            phoneRequired
            companyOptional
            markRequired
            compact
          />
        </div>
      ) : (
        <div class="mt-7 sm:mt-10 lg:mt-0 lg:flex lg:items-center">
          <div class="border-border bg-card/90 rounded-[2rem] border p-7 shadow-[0_22px_55px_rgba(34,43,74,0.10)] backdrop-blur-sm sm:p-9">
            <p class="text-brand-600 text-xs font-semibold tracking-[0.22em] uppercase">
              So fängt es an
            </p>
            <h2 class="font-display text-foreground mt-4 text-2xl font-bold tracking-tight">
              30 Minuten über die Zahlen, die euch heute fehlen.
            </h2>
            <p class="text-foreground-secondary mt-4 text-base leading-7">
              Ihr erzählt, wonach ihr steuern wollt und woher die Zahlen heute kommen. Wir sagen,
              was davon sich live rechnen lässt. Kostenlos, ohne Folien.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <Button size="lg" href={contactLinks.cal} target="_blank">
                Erstgespräch buchen
                <Icon name="arrow-up-right" size="sm" />
              </Button>
              <Button variant="outline" size="lg" href="/discovery-workshop/">
                Der Workshop danach
                <Icon name="arrow-right" size="sm" />
              </Button>
            </div>
            <div class="border-border/70 mt-6 flex items-center gap-3 border-t pt-5">
              <Picture
                src={founderPortrait}
                alt="Marten Prieß"
                widths={[48, 96]}
                sizes="48px"
                formats={['avif', 'webp']}
                class="h-12 w-12 shrink-0 rounded-full object-cover"
                loading="lazy"
              />
              <p class="text-sm leading-6">
                <span class="text-foreground block font-semibold">Marten Prieß</span>
                <span class="text-foreground-secondary">
                  Gründer von RocketBase, führt das Gespräch selbst.
                </span>
              </p>
            </div>
          </div>
        </div>
      )
    }
  </div>

  <div class="relative z-10">
    <a
      href="#heute"
      class="hero-scroll absolute top-0 left-1/2 z-20 hidden h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full lg:flex"
      aria-label="Weiter nach unten"
      data-hero-scroll
    >
      <span class="hero-scroll-icon flex"><Icon name="chevron-down" size="sm" /></span>
    </a>
    <ClientLogoStrip
      heading="Aus Projekten mit"
      logos={clientLogos}
      variant="light"
      uniform
      class="py-10 lg:py-11"
    />
  </div>
</section>

<!-- HEUTE: mobil zuerst das Bild -->
<section
  id="heute"
  class="heute-sec border-border relative scroll-mt-20 overflow-x-clip border-b pt-14 pb-12 sm:py-20 lg:py-24"
>
  <div
    class="container grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-16"
  >
    <div class="af-rise order-2 lg:order-1">
      <p
        class="inline-flex items-center gap-2 font-mono text-xs font-semibold tracking-[0.2em] text-[oklch(58%_0.19_25)] uppercase"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
        Kommt euch das bekannt vor?
      </p>
      <h2
        class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-[2.35rem] lg:leading-[1.15]"
      >
        Die Zahlen gibt es.{' '}
        <span class="text-foreground-muted">Nur nicht dann, wenn ihr sie braucht.</span>
      </h2>
      <p class="text-foreground-secondary mt-5 text-[0.95rem] leading-7">
        Exporte ziehen, abgleichen, eine Excel bauen. Und die BWA kommt drei Wochen später und sagt,
        was war, nicht was kommt.
      </p>
      <p class="text-foreground mt-4 text-[0.95rem] leading-7 font-semibold">
        Gesteuert wird nach Gefühl. Meistens liegt es richtig. Manchmal teuer daneben.
      </p>
    </div>

    <div class="szene-auf order-1 lg:order-2" data-szene>
      <HeuteKalender />
    </div>
  </div>
</section>

<!-- 01 DAS COCKPIT -->
<section id="cockpit" class="bg-background relative scroll-mt-20 overflow-x-clip py-16 lg:py-28">
  <div
    class="bg-brand-300/10 pointer-events-none absolute top-40 left-1/2 h-[40rem] w-[60rem] -translate-x-1/2 rounded-full blur-[120px]"
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="01"
      eyebrow="Das Cockpit"
      title="Was heute los ist, ohne dass jemand eine Excel baut."
      lead="Jeden Morgen aktuell, aus den Systemen, die ihr schon habt. So sieht das bei einem Kunden aus."
    />
    <div
      class="szene-auf mx-auto mt-12 max-w-6xl lg:mt-14"
      data-szene
      data-szene-zaehlen="[data-kpi-zahl]"
    >
      <CockpitMock />
      <p class="z-note mt-4 text-center">
        Nachgebaut aus einer laufenden Kundenlösung. Beispieldaten.
      </p>
    </div>
  </div>
</section>

<!-- 02 AUSLASTUNG -->
<section class:list={['bg-background-secondary border-border relative border-y py-16 lg:py-28', istFunnel && 'hidden lg:block']}>
  <div
    class="relative z-10 container grid max-w-7xl gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:items-center lg:gap-14"
  >
    <div class="af-rise">
      <SectionHeader
        size="md"
        align="left"
        number="02"
        eyebrow="Auslastung"
        title="Wer ist voll, wer hat Luft?"
      />
      <p class="text-foreground-secondary mt-6 text-base leading-7">
        Je Team und je Person. Über 100 % ist schraffiert, unter 70 % rot. Neue Aufträge kommen
        dahin, wo wirklich Luft ist.
      </p>
    </div>
    <div
      class="szene-auf min-w-0"
      data-szene
      data-szene-klick="[data-mode='plan']"
      data-szene-pause="1500"
    >
      <AuslastungTeams />
    </div>
  </div>
</section>

<!-- 03 VERTRÄGE UND ZIELE -->
<section class:list={['bg-background relative overflow-x-clip py-16 lg:py-28', istFunnel && 'hidden lg:block']}>
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="03"
      eyebrow="Verträge und Ziele"
      title="Was nächstes Jahr fehlt, seht ihr in diesem."
      lead="Welche Verträge auslaufen und wo ihr gegen euer Ziel steht. Solange noch Zeit für Gespräche ist."
    />
    <div class="szene-auf mx-auto mt-12 max-w-6xl lg:mt-14" data-szene>
      <WegfallZiele />
    </div>
  </div>
</section>

<!-- VERTRAUEN -->
<VertrauensBand />

<!-- VON HEUTE BIS DAHIN: Strecke und Einwände, nur im Funnel -->
{istFunnel && <VonHeuteBisDahin stationen={strecke.stationen} einwaende={strecke.einwaende} />}

<!-- 04 LOHNT SICH DAS? Rechen-Streifen und Marten -->
<section
  id="ablauf"
  class="bg-background-secondary border-border relative scroll-mt-20 border-b py-16 lg:py-28"
>
  <div class="relative z-10 container max-w-6xl">
    <SectionHeader
      size="md"
      number="04"
      eyebrow="Lohnt sich das?"
      title="Das klärt ein Gespräch."
      lead="Unverbindlich, 30 Minuten, keine Vorbereitung. Vorher könnt ihr kurz überschlagen, worum es bei euch geht."
    />
    <div class="mx-auto mt-10 grid max-w-5xl gap-6 lg:mt-14">
      <div class="af-rise">
        <LohntSich
          id="ls-zahlen"
          frage="Wie viele Leute planen und rechnen bei euch in Excel?"
          wer="Controlling, Geschäftsführung, Projekt- und Teamleitung: alle, die Auslastung planen oder monatlich Zahlen zusammenstellen."
          min={1}
          max={15}
          step={1}
          start={3}
          minutenJe={600}
          wofuer="in Exporte, Abgleiche, Auslastungsreports und die Planung fürs nächste Quartal."
          annahme="Anderthalb Arbeitstage je Person und Monat: Exporte ziehen und abgleichen, den Auslastungsreport fürs Team bauen, Kapazitäten fürs nächste Quartal vorhalten, Zahlen für die Umsatzprognose bereitstellen. Darin steckt beides: zusammentragen, was war, und daraus planen, was kommt."
        />
      </div>
      <!-- Nur auf der indexierten Seite: Im Funnel führt das Quiz zum Gespräch, die Karte wäre ein zweiter Weg. -->
      {
        !istFunnel && (
          <ErstgespraechKarte
            id="ablauf-01"
            class="w-full max-w-none"
            zitat="Erzählt mir, welche Zahlen ihr heute vermisst. Nach 30 Minuten wisst ihr, ob sich ein Cockpit bei euch lohnt."
            text="Ihr erzählt, woher eure Zahlen heute kommen und welche fehlen. Ich sage euch ehrlich, ob sich ein Cockpit lohnt, und wenn ja, welche Zahl zuerst."
          />
        )
      }
    </div>
  </div>
</section>

<!-- FAQ -->
<section class:list={['bg-background border-border relative border-b py-24 lg:py-28', istFunnel && 'hidden']}>
  <div class="relative z-10 container max-w-4xl">
    <SectionHeader size="md" number="05" eyebrow="Häufige Fragen" title="Was vorab gefragt wird." />
    <div class="mt-12 flex flex-col gap-4">
      {
        miniFaqs.map((item) => (
          <details class="group border-border bg-card rounded-2xl border p-5 shadow-sm transition-shadow duration-300 open:shadow-lg sm:p-6">
            <summary class="flex min-h-11 cursor-pointer list-none items-start gap-4 py-0.5 [&::-webkit-details-marker]:hidden">
              <h3 class="font-display text-foreground flex-1 text-base font-bold tracking-tight sm:text-lg">
                {item.q}
              </h3>
              <Icon
                name="chevron-down"
                size="sm"
                class="text-foreground-muted mt-1 shrink-0 transition-transform duration-300 group-open:rotate-180"
              />
            </summary>
            <p class="text-foreground-secondary border-border/60 mt-4 border-t pt-4 text-[0.95rem] leading-7">
              {item.a}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- Blog: zwei Artikel zu dieser Tür, nur auf der indexierten Seite -->
{!istFunnel && <BlogQuerverweis tuer="zahlen" />}

<!-- KONTAKT -->
<section id="kontakt" class:list={['kontakt-sec relative scroll-mt-20 overflow-x-clip py-24 lg:py-32', istFunnel && 'hidden lg:block']}>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="bg-brand-400/15 absolute -bottom-40 -left-24 h-[34rem] w-[34rem] rounded-full blur-[150px]"
    >
    </div>
    <div
      class="bg-grid-pattern absolute inset-0 [mask-image:linear-gradient(to_top,black,transparent_85%)] opacity-[0.06]"
    >
    </div>
  </div>
  <div
    class="relative z-10 container grid max-w-6xl gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-stretch lg:gap-16"
  >
    <div class="af-rise flex flex-col">
      <p
        class="text-brand-600 dark:text-brand-300 font-mono text-xs font-semibold tracking-[0.2em] uppercase"
      >
        Nächster Schritt
      </p>
      <h2
        lang="de"
        class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]"
      >
        Erstgespräch vereinbaren.
      </h2>
      <p class="text-foreground-secondary mt-5 text-lg leading-8">
        {
          istFunnel
            ? 'Drei kurze Fragen und eure Kontaktdaten, mehr braucht es nicht. So kennen wir eure Ausgangslage schon vor dem Termin.'
            : 'Bucht direkt einen Termin oder schreibt uns. Wir melden uns persönlich.'
        }
      </p>
      <ol class="kontakt-ablauf mt-9 mb-8 space-y-6">
        {
          [
            {
              titel: istFunnel ? 'Fragen beantworten' : 'Termin buchen',
              text: istFunnel
                ? 'Woher eure Zahlen kommen, was zuerst fehlt, wie groß ihr seid. Dauert eine Minute.'
                : 'Einen freien Termin wählen, mehr braucht es nicht.',
            },
            { titel: 'Wir melden uns', text: 'Werktags, persönlich, mit einem Terminvorschlag.' },
            {
              titel: 'Erstgespräch',
              text: '30 Minuten, online, kostenlos. Ihr erzählt, wonach ihr steuern wollt. Danach wisst ihr, ob es passt.',
            },
          ].map((schritt, i) => (
            <li class="relative flex gap-4">
              <span class="bg-card border-brand-300 text-brand-600 dark:text-brand-300 relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border font-mono text-xs font-bold">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="pt-1">
                <p class="font-display text-foreground font-bold tracking-tight">{schritt.titel}</p>
                <p class="text-foreground-secondary mt-1 text-[0.95rem] leading-7">
                  {schritt.text}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="border-border mt-auto flex items-center gap-4 border-t pt-8">
        <Picture
          src={founderPortrait}
          alt="Marten Prieß"
          widths={[56, 112]}
          sizes="56px"
          formats={['avif', 'webp']}
          class="h-14 w-14 shrink-0 rounded-full object-cover"
          loading="lazy"
        />
        <p class="text-sm leading-6">
          <span class="text-foreground block font-semibold">Marten Prieß</span>
          <span class="text-foreground-secondary"
            >Gründer von RocketBase, meldet sich persönlich.</span
          >
        </p>
      </div>
    </div>

    {
      istFunnel ? (
        <div class="af-rise lg:min-h-[38rem]">
          <FunnelQuiz
            client:visible
            {...quizProps}
            phoneRequired
            companyOptional
            markRequired
            compact
          />
        </div>
      ) : (
        <div class="af-rise flex flex-col justify-center gap-4">
          <Button size="lg" href={contactLinks.cal} target="_blank">
            Erstgespräch buchen
            <Icon name="arrow-up-right" size="sm" />
          </Button>
          <Button variant="outline" size="lg" href="/discovery-workshop/">
            Der Workshop im Detail
            <Icon name="arrow-right" size="sm" />
          </Button>
          <p class="text-foreground-muted text-sm leading-6">
            Oder per Mail an{' '}
            <a href={`mailto:${contactLinks.email}`} class="text-brand-600 font-semibold">
              {contactLinks.email}
            </a>
            .
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero-scroll {
    color: var(--color-foreground-secondary);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 14px 30px -14px oklch(30% 0.08 265 / 0.45);
    transition:
      opacity 0.3s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  @media (hover: hover) {
    .hero-scroll:hover {
      color: var(--color-brand-600);
      border-color: color-mix(in oklch, var(--color-brand-400) 60%, var(--color-border));
    }
  }
  .hero-scroll[data-hidden='true'] {
    opacity: 0;
    pointer-events: none;
  }
  .hero-scroll-icon {
    animation: hero-scroll-bob 1.8s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes hero-scroll-bob {
    0%,
    100% {
      transform: translateY(-2px);
    }
    50% {
      transform: translateY(3px);
    }
  }
  .hero-alt {
    text-decoration: line-through;
    text-decoration-color: color-mix(in oklch, var(--color-brand-500) 70%, transparent);
    text-decoration-thickness: 2px;
    background: var(--color-card);
  }
  .heute-sec {
    background:
      radial-gradient(
        50% 70% at 85% 50%,
        color-mix(in oklch, oklch(60% 0.19 25) 6%, transparent),
        transparent 70%
      ),
      var(--color-background-secondary);
  }
  .cta-band {
    background:
      radial-gradient(
        55% 140% at 90% 50%,
        color-mix(in oklch, var(--color-brand-400) 28%, transparent),
        transparent 70%
      ),
      radial-gradient(
        45% 120% at 0% 100%,
        color-mix(in oklch, var(--color-brand-300) 18%, transparent),
        transparent 70%
      ),
      color-mix(in oklch, var(--color-brand-500) 9%, var(--color-background));
  }
  .kontakt-sec {
    background:
      radial-gradient(
        55% 80% at 85% 40%,
        color-mix(in oklch, var(--color-brand-400) 16%, transparent),
        transparent 70%
      ),
      color-mix(in oklch, var(--color-brand-500) 6%, var(--color-background));
  }
  .kontakt-ablauf > li:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 2.5rem;
    bottom: -1.25rem;
    left: 1.125rem;
    width: 1px;
    background: var(--color-border);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-icon {
      animation: none;
    }
  }
</style>

<script>
  import { szenenStarten } from '@/lib/szene';
  szenenStarten();
  const heroScroll = document.querySelector<HTMLElement>('[data-hero-scroll]');
  if (heroScroll) {
    const sync = () => (heroScroll.dataset.hidden = window.scrollY > 40 ? 'true' : 'false');
    window.addEventListener('scroll', sync, { passive: true });
    sync();
  }
</script>
