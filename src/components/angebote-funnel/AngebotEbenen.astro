---
/**
 * Die Ebenen eines Angebots als klickbarer Fächer: Vorlage & Texte, Kalkulation,
 * Angebotsseite, Zusage. Jede Ebene ist ein echter Screenshot. Die gewählte liegt gerade
 * und groß vorn, die anderen staffeln sich dahinter nach oben rechts, jede ein Stück
 * kleiner und blasser. Ein Klick (Ebene oder Liste) holt eine nach vorn.
 * (Erste Fassung lag isometrisch gekippt; dabei waren die Screenshots nicht lesbar.)
 *
 * Läuft beim Hereinscrollen an (`data-szene`): Die Ebenen legen sich nacheinander auf
 * den Stapel, danach wandert die Auswahl von selbst weiter, bis jemand klickt. Ohne JS
 * liegt der Stapel fertig da, die erste Ebene vorn. Ein Satz je Ebene, mehr Text nicht.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Ebene {
  titel: string;
  text: string;
  image: ImageMetadata;
  alt: string;
}

interface Props {
  ebenen: Ebene[];
  /** Welche Ebene anfangs vorn liegt (0-basiert). */
  start?: number;
}

const { ebenen, start = 0 } = Astro.props;
const n = ebenen.length;
const pos = (i: number) => (i - start + n) % n;
---

<div class="eb" data-szene data-eb data-start={start}>
  <div
    class="grid gap-8 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,0.75fr)] lg:items-center lg:gap-10"
  >
    <!-- Der Stapel -->
    <div class="eb-buehne relative" aria-hidden="true">
      <ul class="eb-stapel">
        {
          ebenen.map((e, i) => (
            <li
              class="eb-ebene"
              style={`--k: ${i}; --pos: ${pos(i)}; z-index: ${n - pos(i)}`}
              data-eb-ebene={i}
              data-aktiv={i === start ? 'true' : 'false'}
            >
              <button type="button" class="eb-blatt" data-eb-wahl={i} tabindex="-1">
                <span class="eb-tab">
                  {String(i + 1).padStart(2, '0')} · {e.titel}
                </span>
                <Picture
                  src={e.image}
                  alt=""
                  widths={[640, 960]}
                  sizes="(min-width: 1024px) 40rem, 100vw"
                  formats={['avif', 'webp']}
                  class="eb-bild block h-full w-full object-cover object-top"
                  loading="eager"
                />
              </button>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Die Liste: eine Zeile je Ebene -->
    <ol class="eb-liste grid gap-2" role="tablist" aria-label="Ebenen des Angebots">
      {
        ebenen.map((e, i) => (
          <li>
            <button
              type="button"
              role="tab"
              class="eb-punkt flex w-full items-start gap-3 rounded-2xl p-3.5 text-left sm:p-4"
              data-eb-wahl={i}
              aria-selected={i === start ? 'true' : 'false'}
            >
              <span class="eb-nr font-mono text-xs font-bold">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="min-w-0">
                <span class="font-display text-foreground block text-base leading-tight font-bold tracking-tight sm:text-lg">
                  {e.titel}
                </span>
                <span class="eb-satz text-foreground-secondary mt-1 block text-sm leading-6">
                  {e.text}
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  /*
   * Bühne: Platz für die vordere Ebene plus drei Staffelstufen nach oben rechts.
   * --pos ist der Abstand zur gewählten Ebene (0 vorn, 3 ganz hinten), JS setzt ihn.
   */
  /*
   * Kartenstapel ohne 3D: Die gewählte Ebene liegt groß vorn links, die anderen stehen
   * gut sichtbar nach rechts gestaffelt dahinter, jede ein Stück kleiner und dunkler.
   * Beim Wechsel wird die neue Ebene im Bogen aus dem Stapel gezogen und vorn abgelegt
   * (Keyframe auf `translate`, der Stapelplatz liegt auf `transform`).
   * Vorherige Fassungen lagen isometrisch bzw. in die Tiefe gedreht; beides war unleserlich.
   */
  .eb-buehne {
    position: relative;
    aspect-ratio: 16 / 9.6;
    width: 100%;
  }
  .eb-stapel {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .eb-ebene {
    position: absolute;
    left: 0;
    top: 50%;
    width: 80%;
    aspect-ratio: 16 / 10;
    transform-origin: right center;
    transform: translateY(-50%) translateX(calc(var(--pos) * 8.5%))
      scale(calc(1 - var(--pos) * 0.075));
    filter: brightness(calc(1 - var(--pos) * 0.16));
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.5s ease,
      filter 0.45s ease,
      translate 0.3s ease;
  }
  .eb-ebene[data-aktiv='true'] {
    animation: eb-raus 0.7s cubic-bezier(0.3, 0.7, 0.2, 1);
  }
  @keyframes eb-raus {
    0% {
      translate: 18% 0;
      scale: 0.9;
    }
    45% {
      translate: 32% -9%;
      scale: 0.96;
      rotate: 2deg;
    }
    100% {
      translate: 0 0;
      scale: 1;
      rotate: 0deg;
    }
  }
  .eb-blatt::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgb(255 255 255 / 0.22) 50%,
      transparent 65%
    );
    translate: -120% 0;
  }
  .eb-ebene[data-aktiv='true'] .eb-blatt::after {
    animation: eb-glanz 0.9s 0.35s ease-out both;
  }
  @keyframes eb-glanz {
    to {
      translate: 120% 0;
    }
  }
  .eb-blatt {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 0.9rem;
    overflow: hidden;
    background: var(--color-card);
    box-shadow:
      0 0 0 1px color-mix(in oklch, var(--color-foreground) 14%, transparent),
      0 24px 50px -24px oklch(10% 0.04 265 / 0.7);
    cursor: pointer;
    position: relative;
  }
  .eb-ebene[data-aktiv='true'] .eb-blatt {
    cursor: default;
    box-shadow:
      0 0 0 2px var(--color-brand-500),
      0 40px 80px -30px color-mix(in oklch, var(--color-brand-500) 55%, transparent);
  }
  @media (hover: hover) {
    .eb-ebene:not([data-aktiv='true']):hover {
      filter: brightness(1);
      translate: 1.5% -2%;
    }
  }
  .eb-tab {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 2;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: oklch(18% 0.03 265 / 0.85);
    color: #fff;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
  .eb-ebene[data-aktiv='true'] .eb-tab {
    background: var(--color-brand-500);
  }

  /* Liste */
  .eb-punkt {
    border: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-foreground) 2%, var(--color-card));
    cursor: pointer;
    transition:
      border-color 0.25s ease,
      background 0.25s ease,
      transform 0.25s ease;
  }
  @media (hover: hover) {
    .eb-punkt:hover {
      border-color: color-mix(in oklch, var(--color-brand-400) 55%, var(--color-border));
    }
  }
  .eb-punkt[aria-selected='true'] {
    border-color: var(--color-brand-400);
    background: var(--color-card);
    box-shadow: 0 18px 40px -26px color-mix(in oklch, var(--color-brand-500) 60%, transparent);
  }
  .eb-punkt:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
  }
  .eb-nr {
    display: inline-flex;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--color-brand-400) 60%, var(--color-border));
    color: var(--color-brand-600);
    background: var(--color-card);
  }
  .eb-punkt[aria-selected='true'] .eb-nr {
    background: var(--color-brand-500);
    border-color: var(--color-brand-500);
    color: #fff;
  }
  /* Mobil: der Satz nur bei der gewählten Ebene, sonst wird die Liste lang */
  @media (max-width: 1023px) {
    .eb-punkt[aria-selected='false'] .eb-satz {
      display: none;
    }
  }

  /* Szene: die Ebenen legen sich nacheinander in den Fächer */
  :global(html.szenen-ready) .eb[data-szene]:not([data-szene='an']) .eb-ebene {
    opacity: 0;
    transform: translateY(-50%) translateX(calc(var(--pos) * 8.5% + 6%)) scale(0.9);
  }
  .eb[data-szene='an']:not([data-bereit]) .eb-ebene {
    transition-delay: calc((3 - var(--pos)) * 140ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .eb-ebene {
      transition: none !important;
    }
    .eb-blatt::after {
      display: none;
    }
  }
</style>

<script>
  import { szenenStarten } from '@/lib/szene';

  document.querySelectorAll<HTMLElement>('[data-eb]').forEach((root) => {
    const ebenen = [...root.querySelectorAll<HTMLElement>('[data-eb-ebene]')];
    const punkte = [...root.querySelectorAll<HTMLButtonElement>('.eb-punkt')];
    const n = ebenen.length;
    let aktiv = Number(root.dataset.start ?? 0);
    let timer: number | undefined;
    const bewegt = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const waehle = (i: number) => {
      aktiv = ((i % n) + n) % n;
      ebenen.forEach((el, k) => {
        const pos = (k - aktiv + n) % n;
        el.dataset.aktiv = pos === 0 ? 'true' : 'false';
        el.style.setProperty('--pos', String(pos));
        el.style.zIndex = String(n - pos);
      });
      punkte.forEach((b, k) => b.setAttribute('aria-selected', k === aktiv ? 'true' : 'false'));
    };
    const stopp = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    root.querySelectorAll<HTMLElement>('[data-eb-wahl]').forEach((b) =>
      b.addEventListener('click', () => {
        stopp();
        waehle(Number(b.dataset.ebWahl));
      })
    );
    punkte.forEach((b, k) =>
      b.addEventListener('keydown', (e) => {
        const next =
          e.key === 'ArrowDown' || e.key === 'ArrowRight'
            ? k + 1
            : e.key === 'ArrowUp' || e.key === 'ArrowLeft'
              ? k - 1
              : null;
        if (next === null) return;
        e.preventDefault();
        stopp();
        waehle(next);
        punkte[((next % n) + n) % n]?.focus();
      })
    );

    // Nach dem Aufbau wandert die Auswahl von selbst weiter, bis jemand eingreift.
    root.addEventListener('szene:an', () => {
      if (!bewegt) return;
      window.setTimeout(() => root.setAttribute('data-bereit', ''), n * 140 + 700);
      window.setTimeout(
        () => {
          if (timer !== undefined) return;
          timer = window.setInterval(() => waehle(aktiv + 1), 2600);
        },
        n * 140 + 2200
      );
    });
  });

  szenenStarten();
</script>
