---
/**
 * Animierte Grafik: der Angebotsbaustein als Kern, drumherum die Bereiche, die
 * dazu entwickelt werden können.
 *
 * Ab md: Knoten absolut auf einer Fläche, Linien als SVG (viewBox 0..100,
 * `vector-effect: non-scaling-stroke`, damit sie bei jeder Breite gleich dünn
 * bleiben). Auf den Linien laufen Striche vom Kern nach außen, der Kern hat
 * einen langsam drehenden Ring, die Knoten schweben leicht versetzt.
 * Unter md: Kern oben, Knoten als zweispaltiges Raster, ohne Linien.
 * `prefers-reduced-motion` stellt alles still.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

export interface HubNode {
  icon: string;
  title: string;
  text: string;
  /** Position auf der Fläche in Prozent (Mittelpunkt des Knotens). */
  x: number;
  y: number;
  /** Gestrichelter Knoten für „individuell". */
  open?: boolean;
}

interface Props {
  nodes: HubNode[];
  kern: { title: string; parts: string[] };
}

const { nodes, kern } = Astro.props;
---

<div class="hub relative">
  <!-- Fläche ab md -->
  <div class="hub-stage relative mx-auto hidden aspect-[16/11] max-w-6xl md:block">
    <svg
      class="absolute inset-0 h-full w-full"
      viewBox="0 0 100 100"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      {
        nodes.map((n, i) => (
          <g>
            <line x1="50" y1="50" x2={n.x} y2={n.y} class="hub-line-base" />
            <line
              x1="50"
              y1="50"
              x2={n.x}
              y2={n.y}
              class="hub-line-flow"
              style={`animation-delay: ${-i * 0.6}s`}
            />
          </g>
        ))
      }
    </svg>

    <!-- Kern -->
    <div
      class="absolute top-1/2 left-1/2 z-10 w-[17rem] -translate-x-1/2 -translate-y-1/2 lg:w-[19rem]"
    >
      <div
        class="hub-core-ring pointer-events-none absolute -inset-6 rounded-[2.5rem]"
        aria-hidden="true"
      >
      </div>
      <div class="hub-core relative rounded-[2rem] p-6 text-center lg:p-7">
        <span
          class="bg-brand-500 mx-auto flex h-12 w-12 items-center justify-center rounded-2xl text-white shadow-lg"
        >
          <Icon name="file-text" size="md" />
        </span>
        <p
          class="bg-brand-500 mx-auto mt-4 w-fit rounded-full px-2.5 py-0.5 text-[10px] font-bold tracking-[0.16em] text-white uppercase"
        >
          Unser Angebot
        </p>
        <p class="font-display text-foreground mt-2 text-xl font-bold tracking-tight lg:text-2xl">
          {kern.title}
        </p>
        <ul class="mt-3 flex flex-wrap justify-center gap-1.5">
          {
            kern.parts.map((p) => (
              <li class="bg-brand-500/10 text-brand-700 dark:text-brand-200 rounded-full px-2.5 py-1 text-[11px] font-semibold">
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Knoten -->
    {
      nodes.map((n, i) => (
        <div
          class="absolute z-10 w-[12.5rem] -translate-x-1/2 -translate-y-1/2 lg:w-[14.5rem]"
          style={`left: ${n.x}%; top: ${n.y}%`}
        >
          <div
            class:list={['hub-node rounded-2xl p-4', n.open && 'hub-node-open']}
            style={`animation-delay: ${-i * 1.1}s`}
          >
            <div class="flex items-center gap-3">
              <span
                class:list={[
                  'flex h-9 w-9 shrink-0 items-center justify-center rounded-xl',
                  n.open
                    ? 'border-brand-400 text-brand-500 border border-dashed'
                    : 'bg-brand-500/10 text-brand-600 dark:text-brand-300',
                ]}
              >
                <Icon name={n.icon} size="sm" />
              </span>
              <p class="font-display text-foreground text-[0.95rem] leading-tight font-bold">
                {n.title}
              </p>
            </div>
            <p class="text-foreground-secondary mt-2.5 text-[0.8rem] leading-5">{n.text}</p>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Gestapelt unter md -->
  <div class="md:hidden">
    <div class="hub-core relative rounded-[2rem] p-6 text-center">
      <span
        class="bg-brand-500 mx-auto flex h-12 w-12 items-center justify-center rounded-2xl text-white shadow-lg"
      >
        <Icon name="file-text" size="md" />
      </span>
      <p
        class="bg-brand-500 mx-auto mt-4 w-fit rounded-full px-2.5 py-0.5 text-[10px] font-bold tracking-[0.16em] text-white uppercase"
      >
        Unser Angebot
      </p>
      <p class="font-display text-foreground mt-2 text-xl font-bold tracking-tight">{kern.title}</p>
      <ul class="mt-3 flex flex-wrap justify-center gap-1.5">
        {
          kern.parts.map((p) => (
            <li class="bg-brand-500/10 text-brand-700 dark:text-brand-200 rounded-full px-2.5 py-1 text-[11px] font-semibold">
              {p}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="bg-brand-300 mx-auto h-8 w-px" aria-hidden="true"></div>
    <ul class="grid grid-cols-2 gap-3">
      {
        nodes.map((n) => (
          <li class:list={['hub-node rounded-2xl p-4', n.open && 'hub-node-open']}>
            <span
              class:list={[
                'flex h-9 w-9 items-center justify-center rounded-xl',
                n.open
                  ? 'border-brand-400 text-brand-500 border border-dashed'
                  : 'bg-brand-500/10 text-brand-600 dark:text-brand-300',
              ]}
            >
              <Icon name={n.icon} size="sm" />
            </span>
            <p class="font-display text-foreground mt-3 text-sm leading-tight font-bold">
              {n.title}
            </p>
            <p class="text-foreground-secondary mt-1.5 text-xs leading-5">{n.text}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Legende: Kern vs. Erweiterungen -->
  <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm">
    <span class="text-foreground-secondary inline-flex items-center gap-2.5">
      <span class="hub-legend-core flex h-6 w-9 items-center justify-center rounded-md" aria-hidden="true">
        <span class="bg-brand-500 h-2 w-2 rounded-sm"></span>
      </span>
      Der Kern, den wir anbieten
    </span>
    <span class="text-foreground-secondary inline-flex items-center gap-2.5">
      <span class="hub-legend-node flex h-6 w-9 items-center justify-center rounded-md" aria-hidden="true">
        <span class="bg-foreground-muted/40 h-2 w-2 rounded-sm"></span>
      </span>
      Erweiterungen, wenn ihr sie braucht
    </span>
  </div>
</div>

<style>
  .hub-line-base {
    stroke: color-mix(in oklch, var(--color-brand-400) 35%, transparent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .hub-line-flow {
    stroke: var(--color-brand-500);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 2 14;
    vector-effect: non-scaling-stroke;
    animation: hub-flow 2.4s linear infinite;
  }
  @keyframes hub-flow {
    to {
      stroke-dashoffset: -32;
    }
  }

  .hub-core {
    background: color-mix(in oklch, var(--color-brand-500) 9%, var(--color-card));
    border: 2px solid var(--color-brand-400);
    box-shadow:
      0 30px 70px -25px color-mix(in oklch, var(--color-brand-500) 60%, transparent),
      0 0 0 8px color-mix(in oklch, var(--color-brand-500) 8%, transparent);
  }
  .hub-core-ring {
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      color-mix(in oklch, var(--color-brand-400) 55%, transparent) 90deg,
      transparent 180deg,
      color-mix(in oklch, var(--color-brand-300) 45%, transparent) 270deg,
      transparent 360deg
    );
    filter: blur(18px);
    animation: hub-spin 9s linear infinite;
  }
  @keyframes hub-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hub-legend-core {
    background: color-mix(in oklch, var(--color-brand-500) 9%, var(--color-card));
    border: 2px solid var(--color-brand-400);
  }
  .hub-legend-node {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 6px 14px -10px oklch(30% 0.06 265 / 0.5);
  }
  .hub-node {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 16px 36px -22px oklch(30% 0.06 265 / 0.45);
    animation: hub-float 6s ease-in-out infinite;
  }
  .hub-node-open {
    border-style: dashed;
    border-color: color-mix(in oklch, var(--color-brand-400) 70%, transparent);
    background: var(--color-card);
  }
  @keyframes hub-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }
  @media (max-width: 767px) {
    .hub-node {
      animation: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hub-line-flow,
    .hub-core-ring,
    .hub-node {
      animation: none;
    }
  }
</style>
