        {
          istFunnel ? (
            <>
              Ein System, das eure Kalkulation kennt.
              <span class="text-brand-500 block">Und eure Marge gleich mit.</span>
            </>
          ) : (
            <>
        Euer Angebot
        <span class="text-brand-500 block">rechnet sich selbst.</span>
            </>
          )
        }
