---
/**
 * Die drei Stationen eines Angebots als kleines Bild: Rechnung, Angebot, Zusage.
 * Beispielzahlen. Eigene Darstellung statt ZahlWandert, weil sie ohne Animation auskommt
 * und mobil einspaltig stehen kann.
 */
interface Props {
  /** Untereinander statt nebeneinander, für die Hero-Spalte. */
  stapel?: boolean;
}
const { stapel = false } = Astro.props;

const zeilenRechnung = [
  ['Anlagen', '85'],
  ['Zeit je Anlage', '1,2 h'],
  ['Stundensatz', '89 €'],
];
const zeilenAngebot = [
  ['Wartung Anlagen, 2 × im Jahr', '9.078 €'],
  ['Anfahrt, 24 Termine', '1.920 €'],
  ['Notdienst, Pauschale', '322 €'],
];
---

<div class:list={['grid gap-3', !stapel && 'lg:grid-cols-3']}>
  <div class="border-border bg-card rounded-2xl border p-5">
    <p class="text-brand-600 dark:text-brand-300 text-xs font-semibold tracking-[0.14em] uppercase">
      1 · Eure Rechnung
    </p>
    <dl class="mt-3 space-y-2 text-sm">
      {
        zeilenRechnung.map(([k, v]) => (
          <div class="flex justify-between">
            <dt class="text-foreground-secondary">{k}</dt>
            <dd class="text-foreground font-semibold">{v}</dd>
          </div>
        ))
      }
      <div class="border-border flex justify-between border-t pt-2 font-bold">
        <dt class="text-foreground">Ergibt</dt>
        <dd class="text-foreground">9.078 €</dd>
      </div>
    </dl>
  </div>
  <div class="border-border bg-card rounded-2xl border p-5">
    <p class="text-brand-600 dark:text-brand-300 text-xs font-semibold tracking-[0.14em] uppercase">
      2 · Euer Angebot
    </p>
    <dl class="mt-3 space-y-2 text-sm">
      {
        zeilenAngebot.map(([k, v]) => (
          <div class="flex justify-between gap-3">
            <dt class="text-foreground-secondary">{k}</dt>
            <dd class="text-foreground font-semibold whitespace-nowrap">{v}</dd>
          </div>
        ))
      }
      <div class="border-border flex justify-between border-t pt-2 font-bold">
        <dt class="text-foreground">Euer Gewinn</dt>
        <dd class="text-emerald-600 dark:text-emerald-400">31 %</dd>
      </div>
    </dl>
  </div>
  <div class="flex flex-col justify-between rounded-2xl bg-[oklch(18%_0.03_265)] p-5 text-white">
    <p class="text-xs font-semibold tracking-[0.14em] text-white/60 uppercase">3 · Beim Kunden</p>
    <div class="mt-6 flex items-end justify-between gap-3">
      <p class="font-display text-2xl font-bold">11.320 €</p>
      <span class="rounded-lg bg-white px-3 py-1.5 text-sm font-semibold text-[oklch(18%_0.03_265)]">
        Zugesagt
      </span>
    </div>
  </div>
</div>
