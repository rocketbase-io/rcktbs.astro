---
/**
 * „Findet ihr euch wieder?“: die Fragen, die sich jemand stellt, der mit KI baut und keinen Senior
 * im Haus hat. Kein Code-Stil, keine Geschmacksfragen (Prisma oder Drizzle), sondern die
 * Entscheidungen, die eine KI nicht dauerhaft im Blick behält: Architektur, Betrieb, Datenschutz,
 * KI-Einsatz, Migration. Aus dem Delta-Sport-Review und den Gesprächen davor (Marten, 2026-10-20).
 *
 * Form (Marten, 2026-10-20): gleich große Karten in drei Bahnen, die von selbst laufen wie ein Feed,
 * in wechselnder Richtung. Maus drüber oder Finger drauf hält an; man kann selbst schieben
 * (Drag, Touch, Trackpad) und rastet dann auf der nächsten Karte ein. Nach drei Sekunden ohne
 * Eingriff läuft es weiter. Bei prefers-reduced-motion läuft nichts von selbst, schieben geht.
 *
 * Technik: transform mit Subpixel, kein scrollLeft (das kann nur ganze Pixel und ruckelt bei
 * langsamem Lauf). Wischen, Ziehen und Trackpad werden selbst verrechnet (Pointer Events, wheel),
 * touch-action: pan-y lässt die Seite senkrecht weiter scrollen. Jede Bahn enthält ihre Karten
 * zweimal; läuft der Versatz über die halbe Breite, wird er um die halbe Breite zurückgesetzt.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

import Button from '@/components/ui/form/Button/Button.astro';
import { contactLinks } from '@/data/rocketbase';

interface Props {
  class?: string;
  /** Im Funnel führt der Knopf zum Quiz statt zu cal.com. */
  variant?: 'site' | 'funnel';
}
const { class: className, variant = 'site' } = Astro.props;
const istFunnel = variant === 'funnel';

type Thema = 'architektur' | 'betrieb' | 'datenschutz' | 'ki' | 'sicherheit';
const label: Record<Thema, string> = {
  architektur: 'Architektur',
  betrieb: 'Betrieb',
  datenschutz: 'Datenschutz',
  ki: 'KI im Produkt',
  sicherheit: 'Sicherheit',
};
// Ein Icon je Thema, auf der Karte groß und blass unten rechts, im Index klein vor dem Namen.
const ikon: Record<Thema, string> = {
  architektur: 'layout',
  betrieb: 'settings',
  datenschutz: 'eye-off',
  ki: 'brain',
  sicherheit: 'shield',
};

type Frage = { text: string; thema: Thema };

// Drei Bahnen, je sechs Fragen, Themen gemischt, damit jede Bahn bunt ist.
const bahnen: Frage[][] = [
  [
    { text: 'Wo will ich mit dem Ding in zwei Jahren hin, und trägt das, was ich jetzt gebaut habe, bis dahin?', thema: 'architektur' },
    { text: 'Darf ich Kundendaten an OpenAI oder Anthropic schicken? Und wenn nicht, was dann?', thema: 'ki' },
    { text: 'Woran merke ich, dass nachts etwas kaputtgegangen ist?', thema: 'betrieb' },
    { text: 'Prüft mein Backend die Rechte, oder nur meine Oberfläche?', thema: 'sicherheit' },
    { text: 'Wie betreibe ich das DSGVO-konform, und was muss ich dafür wirklich aufschreiben?', thema: 'datenschutz' },
    { text: 'Was passiert, wenn zwei Leute gleichzeitig auf denselben Datensatz klicken?', thema: 'architektur' },
  ],
  [
    { text: 'Welche meiner 1.200 Abhängigkeiten sind seit letzter Woche unsicher, und wer sagt es mir?', thema: 'sicherheit' },
    { text: 'Wie bekomme ich die Daten aus dem alten System rüber, ohne dass drei Wochen lang nichts geht?', thema: 'architektur' },
    { text: 'Wie binde ich ein offenes Modell ein, ohne selbst eine GPU zu betreiben?', thema: 'ki' },
    { text: 'Backup gibt es. Hat schon mal jemand zurückgespielt?', thema: 'betrieb' },
    { text: 'Was muss ich wegen des Cyber Resilience Act tun, und bin ich überhaupt gemeint?', thema: 'datenschutz' },
    { text: 'Wo liegen meine Schlüssel, und wer hat sie schon mal im Repository gesehen?', thema: 'sicherheit' },
  ],
  [
    { text: 'Was sind die Dinge, die alle falsch machen, und mache ich sie gerade auch?', thema: 'betrieb' },
    { text: 'Was passiert, wenn im Text, den mein Modell liest, eine Anweisung steht?', thema: 'ki' },
    { text: 'Welche Entscheidung von heute kann ich später nicht mehr zurücknehmen?', thema: 'architektur' },
    { text: 'Ein Kunde will einen Sicherheitsnachweis. Was schicke ich ihm?', thema: 'sicherheit' },
    { text: 'Wie komme ich sicher von Test nach Produktion, und wieder zurück?', thema: 'betrieb' },
    { text: 'Ab wann wird aus meinem einen Server ein Problem?', thema: 'architektur' },
  ],
];
---

<section class:list={['fragen-sec bg-background-secondary border-border relative overflow-x-clip border-y py-16 lg:py-24', className]}>
  <div class="relative z-10 container max-w-6xl">
    <header data-reveal class="mx-auto max-w-3xl text-center">
      <p class="text-brand-600 dark:text-brand-300 font-mono text-xs font-semibold tracking-[0.2em] uppercase">
        Findet ihr euch wieder?
      </p>
      <h2 lang="de" class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl">
        Nicht Prisma oder Drizzle. Die Fragen, die bleiben, wenn der Code läuft.
      </h2>
      <p class="text-foreground-secondary mt-5 text-lg leading-8">
        Bauen geht heute schnell. Was eine KI nicht dauerhaft im Blick behält, ist das große Bild:
        wohin das Ganze soll, was im Betrieb passiert, was ihr aufschreiben müsst und was ihr besser
        nicht an fremde Modelle schickt. Das sind die Fragen, über die wir reden.
      </p>
    </header>

    <!-- Themen-Index: zeigt, was wir abdecken; Klick hebt die Karten des Themas hervor. -->
    <div data-reveal class="mt-10 flex flex-wrap items-center justify-center gap-2" role="group" aria-label="Themen">
      {
        (Object.keys(label) as Thema[]).map((t) => (
          <button type="button" class:list={['thema-chip', `thema-${t}`]} data-thema={t} aria-pressed="false">
            <span class="thema-chip-ikon"><Icon name={ikon[t]} size="xs" /></span>
            {label[t]}
            <span class="thema-chip-zahl">{bahnen.flat().filter((f) => f.thema === t).length}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="fragen-bahnen mt-10 space-y-4" data-fragen>
    {
      bahnen.map((bahn, b) => (
        <div class="bahn" data-bahn data-richtung={b % 2 === 0 ? '1' : '-1'} aria-label={`Fragen, Reihe ${b + 1}`}>
          <ul class="bahn-spur" data-spur>
            {[...bahn, ...bahn].map((f, i) => (
              <li class:list={['frage', `thema-${f.thema}`]} data-thema={f.thema} aria-hidden={i >= bahn.length ? 'true' : undefined}>
                <span class="frage-glyph" aria-hidden="true"><Icon name={ikon[f.thema]} size="xl" strokeWidth={1.5} /></span>
                <span class="frage-thema">{label[f.thema]}</span>
                <p class="font-display text-foreground text-[1.05rem] leading-snug font-bold tracking-tight sm:text-lg">{f.text}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="container max-w-6xl">
    <p data-reveal class="text-foreground-secondary mx-auto mt-10 max-w-2xl text-center text-[0.95rem] leading-7">
      Wenn drei davon eure Fragen sind, lohnt sich das Erstgespräch. Wenn es alle sind, erst recht.
    </p>
    <div data-reveal class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <Button size="lg" href={istFunnel ? '#quiz' : contactLinks.cal} target={istFunnel ? undefined : '_blank'}>
        Erstgespräch {istFunnel ? 'anfragen' : 'buchen'}
        <Icon name={istFunnel ? 'arrow-up-right' : 'arrow-up-right'} size="sm" />
      </Button>
      <Button variant="outline" size="lg" href="#pakete">
        Was wir prüfen
        <Icon name="arrow-right" size="sm" />
      </Button>
    </div>
  </div>
</section>

<style>
  .fragen-bahnen {
    mask-image: linear-gradient(to right, transparent, black 7%, black 93%, transparent);
  }
  .bahn {
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    padding-block: 0.5rem;
  }
  .bahn.greift {
    cursor: grabbing;
    user-select: none;
  }
  .bahn-spur {
    display: flex;
    gap: 1rem;
    width: max-content;
    will-change: transform;
  }

  /* Themen-Index */
  .thema-chip {
    --akzent: var(--color-brand-500);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.85rem 0.45rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-card);
    color: var(--color-foreground-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    transition: border-color 0.2s, background 0.2s, color 0.2s, box-shadow 0.2s;
  }
  .thema-chip:hover {
    border-color: color-mix(in oklch, var(--akzent) 50%, var(--color-border));
  }
  .thema-chip[aria-pressed='true'] {
    border-color: var(--akzent);
    background: color-mix(in oklch, var(--akzent) 10%, var(--color-card));
    color: var(--color-foreground);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--akzent) 15%, transparent);
  }
  .thema-chip-ikon {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    color: var(--akzent);
    background: color-mix(in oklch, var(--akzent) 14%, transparent);
  }
  .thema-chip-zahl {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-foreground-muted);
  }

  /* Karten */
  .frage {
    --akzent: var(--color-brand-500);
    position: relative;
    overflow: hidden;
    flex: 0 0 auto;
    width: clamp(16rem, 78vw, 21rem);
    min-height: 10rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.3rem 1.35rem 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: 1.4rem;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in oklch, var(--akzent) 9%, transparent), transparent 55%),
      var(--color-card);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 14px 34px -26px rgb(20 28 60 / 0.3);
    transition: box-shadow 0.3s, border-color 0.3s, translate 0.3s, opacity 0.3s, filter 0.3s;
  }
  .frage::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--akzent), color-mix(in oklch, var(--akzent) 30%, transparent));
  }
  .frage:hover {
    translate: 0 -3px;
    border-color: color-mix(in oklch, var(--akzent) 45%, var(--color-border));
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 22px 44px -24px color-mix(in oklch, var(--akzent) 55%, transparent);
  }
  .frage-glyph {
    position: absolute;
    right: -0.9rem;
    bottom: -1rem;
    color: var(--akzent);
    opacity: 0.1;
    pointer-events: none;
    user-select: none;
    rotate: -8deg;
    transition: opacity 0.3s, rotate 0.3s, translate 0.3s;
  }
  .frage-glyph :global(svg) {
    width: 6.75rem;
    height: 6.75rem;
  }
  .frage:hover .frage-glyph {
    opacity: 0.16;
    rotate: 0deg;
    translate: -0.15rem -0.15rem;
  }
  :global(.dark) .frage-glyph {
    opacity: 0.14;
  }
  .frage-thema {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--akzent);
  }
  .frage-thema::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--akzent);
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--akzent) 18%, transparent);
  }

  /* Filter: ein Thema gewählt, die anderen treten zurück. */
  .fragen-sec[data-filter='architektur'] .frage:not(.thema-architektur),
  .fragen-sec[data-filter='betrieb'] .frage:not(.thema-betrieb),
  .fragen-sec[data-filter='datenschutz'] .frage:not(.thema-datenschutz),
  .fragen-sec[data-filter='ki'] .frage:not(.thema-ki),
  .fragen-sec[data-filter='sicherheit'] .frage:not(.thema-sicherheit) {
    opacity: 0.28;
    filter: saturate(0.3);
  }

  .thema-architektur { --akzent: oklch(60% 0.16 265); }
  .thema-betrieb { --akzent: oklch(66% 0.13 185); }
  .thema-datenschutz { --akzent: oklch(62% 0.14 300); }
  .thema-ki { --akzent: oklch(70% 0.15 60); }
  .thema-sicherheit { --akzent: oklch(62% 0.18 25); }
</style>

<script>
  // Autolauf je Bahn über transform (Subpixel, flüssig). Pause bei Hover, Finger oder Drag,
  // danach drei Sekunden Ruhe und weiter. Nach eigenem Schieben rastet die Bahn weich auf
  // der nächsten Karte ein.
  function bahnStarten(bahn: HTMLElement) {
    const spur = bahn.querySelector<HTMLElement>('[data-spur]');
    if (!spur) return;
    const richtung = Number(bahn.dataset.richtung || '1');
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tempo = 28; // Pixel je Sekunde

    let versatz = 0; // positiver Wert = Inhalt nach links verschoben
    let pausiert = false;
    let bisWeiter = 0;
    let sichtbar = true;
    let letzte = 0;
    let zieh: { x: number; start: number; bewegt: boolean; zeit: number; vx: number } | null = null;
    let rast: { von: number; nach: number; start: number } | null = null;

    const halbe = () => spur.scrollWidth / 2;
    const schrittweite = () => {
      const erste = spur.firstElementChild as HTMLElement | null;
      return erste ? erste.offsetWidth + parseFloat(getComputedStyle(spur).gap || '16') : 320;
    };
    const normieren = () => {
      const h = halbe();
      if (h <= 0) return;
      versatz = ((versatz % h) + h) % h;
    };
    const malen = () => {
      spur.style.transform = `translate3d(${-versatz}px,0,0)`;
    };
    if (richtung < 0) versatz = 1; // sonst steht die Bahn am Anfang und läuft erst nach dem Umbruch
    normieren();
    malen();

    const einrasten = () => {
      const w = schrittweite();
      const ziel = Math.round(versatz / w) * w;
      rast = { von: versatz, nach: ziel, start: performance.now() };
    };

    const frame = (zeit: number) => {
      const dt = letzte ? Math.min(zeit - letzte, 64) : 16;
      letzte = zeit;
      if (rast) {
        const t = Math.min((zeit - rast.start) / 420, 1);
        const e = 1 - Math.pow(1 - t, 3);
        versatz = rast.von + (rast.nach - rast.von) * e;
        if (t >= 1) rast = null;
        normieren();
        malen();
      } else if (!ruhig && sichtbar && !pausiert && !zieh && zeit > bisWeiter) {
        versatz += (richtung * tempo * dt) / 1000;
        normieren();
        malen();
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);

    // Maus drüber hält an.
    bahn.addEventListener('mouseenter', () => (pausiert = true));
    bahn.addEventListener('mouseleave', () => {
      pausiert = false;
      bisWeiter = performance.now() + 600;
    });

    // Ziehen und Wischen (Maus, Finger, Stift). Senkrecht bleibt die Seite scrollbar (touch-action).
    bahn.addEventListener('pointerdown', (e) => {
      rast = null;
      zieh = { x: e.clientX, start: versatz, bewegt: false, zeit: performance.now(), vx: 0 };
      bahn.setPointerCapture(e.pointerId);
    });
    bahn.addEventListener('pointermove', (e) => {
      if (!zieh) return;
      const dx = e.clientX - zieh.x;
      if (!zieh.bewegt && Math.abs(dx) < 4) return;
      zieh.bewegt = true;
      bahn.classList.add('greift');
      const jetzt = performance.now();
      const neu = zieh.start - dx;
      zieh.vx = (neu - versatz) / Math.max(jetzt - zieh.zeit, 1);
      zieh.zeit = jetzt;
      versatz = neu;
      normieren();
      malen();
    });
    const loslassen = () => {
      if (!zieh) return;
      const schwung = zieh.vx * 120; // kleiner Nachlauf, dann einrasten
      zieh = null;
      bahn.classList.remove('greift');
      versatz += schwung;
      normieren();
      einrasten();
      bisWeiter = performance.now() + 3000;
    };
    bahn.addEventListener('pointerup', loslassen);
    bahn.addEventListener('pointercancel', loslassen);

    // Trackpad und Maus-Rad seitwärts.
    let radTimer = 0;
    bahn.addEventListener(
      'wheel',
      (e) => {
        if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return; // senkrecht gehört der Seite
        e.preventDefault();
        rast = null;
        versatz += e.deltaX;
        normieren();
        malen();
        bisWeiter = performance.now() + 3000;
        window.clearTimeout(radTimer);
        radTimer = window.setTimeout(einrasten, 140);
      },
      { passive: false }
    );

    new IntersectionObserver(([e]) => (sichtbar = e.isIntersecting), { rootMargin: '100px' }).observe(bahn);
    window.addEventListener('resize', () => {
      normieren();
      malen();
    });
  }

  // Themen-Index: Klick wählt ein Thema (nochmal Klick hebt auf), die Sektion trägt data-filter.
  function indexStarten() {
    const sec = document.querySelector<HTMLElement>('.fragen-sec');
    if (!sec || sec.dataset.indexLaeuft) return;
    sec.dataset.indexLaeuft = '1';
    const chips = sec.querySelectorAll<HTMLButtonElement>('.thema-chip');
    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const thema = chip.dataset.thema || '';
        const aktiv = sec.dataset.filter === thema;
        chips.forEach((c) => c.setAttribute('aria-pressed', String(!aktiv && c === chip)));
        if (aktiv) delete sec.dataset.filter;
        else sec.dataset.filter = thema;
      });
    });
  }

  function alleStarten() {
    indexStarten();
    document.querySelectorAll<HTMLElement>('[data-fragen] [data-bahn]').forEach((b) => {
      if (b.dataset.laeuft) return;
      b.dataset.laeuft = '1';
      bahnStarten(b);
    });
  }
  alleStarten();
  document.addEventListener('astro:after-swap', alleStarten);
</script>
