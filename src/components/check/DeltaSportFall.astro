---
/**
 * Ein echter Check als Beleg: Delta-Sport, nacherzählt aus dem Blogbeitrag
 * `software-check-ki-gebaute-systeme`. Steht auf der Anzeigen-Landing unter den Logos „Aus Projekten
 * mit“ (SchlankPage, Slot `fall`, dort in einer weißen Karte) als das eine ausgeführte Beispiel.
 *
 * Der Funnel wirbt mit dem, was gefunden wurde: Die Befunde sind die Hauptsache, konkret und in
 * einfachen Worten. Was gepasst hat, steht nur als kurze Zeile darunter. Bewusst ohne Link zum
 * Beitrag, damit niemand den Funnel verlässt.
 *
 * Nur Aussagen, die so im Beitrag stehen. Das Zitat ist Martens eigener Satz aus dem Beitrag, von
 * Delta-Sport (Daniel Rübensam) gibt es noch keins. Kommt eins, gehört es an diese Stelle.
 * Der Zusammenhang „Live war noch nichts, Kundendaten gab es keine“ bleibt stehen: Ohne ihn klingt
 * es, als hätte Delta-Sport ein kaputtes System betrieben. Der Werkzeug-Befund fehlt bewusst, im
 * Beitrag ist er „Kleineres“.
 */
import { getImage } from 'astro:assets';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import founderPortrait from '@/assets/rocketbase/founder-marten-priess.jpg';
import WischHinweis from '@/components/ui/WischHinweis.astro';
import deltaLogo from '@/assets/client-logos/delta-sport_logo.svg';

const marten = await getImage({ src: founderPortrait, width: 112, format: 'webp' });

const befunde = [
  {
    icon: 'users',
    bereich: 'Lager und Zahlungen',
    titel: 'Das letzte Stück zweimal vergeben',
    text: 'Zwei reservieren gleichzeitig das letzte Stück, beide bekommen eine Zusage. Derselbe Fehler steckte im Zahllauf, also da, wo Geld rausgeht. Im Test nachgewiesen.',
  },
  {
    icon: 'eye-off',
    bereich: 'Betrieb',
    titel: 'Meldet „ok“, auch wenn nichts mehr geht',
    text: 'Selbst bei gestoppter Datenbank meldete das System „alles in Ordnung“. Ein Ausfall wäre erst aufgefallen, wenn jemand anruft.',
  },
  {
    icon: 'shield',
    bereich: 'Live-Umgebung',
    titel: 'Live-System nicht extra abgesichert',
    text: 'Es war genauso eingestellt wie das Testsystem: Zugänge und Netzregeln zu weit gefasst, die Laufzeitumgebung bekam keine Sicherheitsupdates mehr. Inzwischen behoben.',
  },
] as const;

const gut = ['Von außen kein Weg hinein', 'Anmeldung und Rechte sauber', 'Zugangsdaten nicht im Code', 'Gut dokumentiert'];
---

{/* Eine Fallstudien-Karte: Logo, „Ein echter Check“, Überschrift, Befunde und Martens Satz gehören
    zusammen in einen Block (Philipp, 2026-11-24). Kopfzeile wie der Kopf eines Berichts: Logo des
    Kunden links, Art des Systems rechts. Kein schwebendes Logo darüber, keine Pille. */}
<article class="border-border bg-card overflow-hidden rounded-[1.75rem] border shadow-[0_30px_70px_-34px_rgba(34,43,74,0.35)]">
  <header class="border-border/70 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b px-5 py-4 sm:px-10 sm:py-5">
    <div class="flex items-center gap-4">
      <img src={deltaLogo.src} alt="Delta-Sport" width="96" height="48" class="h-9 w-auto sm:h-12" loading="lazy" />
      <span class="bg-border h-8 w-px" aria-hidden="true"></span>
      <span class="text-brand-600 dark:text-brand-300 font-mono text-[0.7rem] font-semibold tracking-[0.18em] uppercase">Ein echter Check</span>
    </div>
    <p class="text-foreground-muted text-sm max-sm:hidden">Lagersystem und Service-App · mit KI gebaut · vor dem Go-live</p>
  </header>

  {/* Kompakt: oben Überschrift und Martens Satz nebeneinander, darunter die drei Befunde als
      Spalten, ganz unten was gepasst hat als eine Zeile. */}
  <div class="p-5 sm:px-10 sm:py-8">
    <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] lg:items-end lg:gap-14">
      <div>
        <h2 class="font-display text-foreground text-[1.5rem] leading-[1.12] font-bold tracking-tight text-balance sm:text-[2.5rem]">
          Was wir bei Delta‑Sport
          <span class="text-brand-500 block">gefunden haben.</span>
        </h2>
        <p class="text-foreground-secondary mt-3 text-[0.95rem] leading-6 sm:text-base sm:leading-7">
          Live war noch nichts, Kundendaten gab es keine. Gefunden haben wir trotzdem einige Dutzend Befunde, eine Handvoll davon kritisch.
        </p>
      </div>
      <figure class="bg-background-secondary flex items-start gap-3 rounded-2xl p-3.5 sm:gap-4 sm:p-5">
        <img
          src={marten.src}
          alt=""
          width="56"
          height="56"
          class="h-9 w-9 shrink-0 rounded-full object-cover object-[center_22%] sm:h-11 sm:w-11"
          loading="lazy"
        />
        <div class="min-w-0">
          <blockquote class="font-display text-foreground text-[0.95rem] leading-6 font-semibold text-balance sm:text-[1.05rem] sm:leading-7">
            „Der Code tat überall, was er sollte. Die Befunde lagen in Fragen, die niemand gestellt hat.“
          </blockquote>
          <figcaption class="text-foreground-muted mt-1 text-sm">Marten Prieß, hat den Check gemacht</figcaption>
        </div>
      </figure>
    </div>

    {/* Unter lg ein Wisch-Streifen statt drei gestapelter Karten: die Befunde bleiben vollständig,
        die Section wird aber nicht drei Bildschirme hoch. Die nächste Karte schaut rechts herein. */}
    <ul class="-mx-5 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-5 px-5 pb-1 sm:-mx-10 sm:scroll-px-10 sm:px-10 lg:mx-0 lg:mt-7 lg:grid lg:grid-cols-3 lg:gap-4 lg:overflow-visible lg:px-0 lg:pb-0" data-wisch>
      {
        befunde.map((b, i) => (
          <li class="border-l-[oklch(62%_0.2_25)] bg-background-secondary w-[84%] shrink-0 snap-start rounded-2xl border-l-[3px] p-4 sm:w-[46%] sm:p-5 lg:w-auto">
            <p class="text-foreground-muted flex items-center gap-2 font-mono text-[0.65rem] font-semibold tracking-[0.16em] uppercase">
              <Icon name={b.icon} size="xs" class="shrink-0 text-[oklch(55%_0.2_25)]" />
              0{i + 1} · {b.bereich}
            </p>
            <p class="font-display text-foreground mt-1.5 text-[1.05rem] font-bold text-balance">{b.titel}</p>
            <p class="text-foreground-secondary mt-1 text-[0.9rem] leading-6">{b.text}</p>
          </li>
        ))
      }
    </ul>
    <WischHinweis anzahl={befunde.length} class="mt-3" />

    <div class="border-border/70 mt-5 grid grid-cols-2 gap-x-3 gap-y-1.5 border-t pt-4 text-xs sm:mt-6 sm:flex sm:flex-wrap sm:items-center sm:gap-x-5 sm:gap-y-2 sm:pt-5 sm:text-sm">
      <span class="text-foreground-muted col-span-2 font-mono text-[0.65rem] font-semibold tracking-[0.18em] uppercase">Was gepasst hat</span>
      {
        gut.map((g) => (
          <span class="text-foreground-secondary flex items-center gap-1.5">
            <span class="flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-[oklch(68%_0.17_150/0.16)] text-[oklch(48%_0.13_150)]">
              <Icon name="check" size="xs" />
            </span>
            {g}
          </span>
        ))
      }
    </div>
  </div>
</article>
