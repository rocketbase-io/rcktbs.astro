---
/**
 * Inhalt von /standardsoftware-abloesung/: keine vierte Tür, sondern die Antwort auf „und wenn es
 * mehr ist als eine Tür?“. Die Ablösung liegt quer über Angebot, Einsatz und Zahlen.
 * Entstanden 2026-10-07, ersetzt die alte Seite. Gleicher Aufbau wie die Türen, aber ohne Funnel.
 *
 * Die Visuals zeigen Sicherheit statt Funktionen: Landschaft vorher/nachher, Ablöseplan mit
 * Parallelbetrieb, Datenübernahme mit Prüfbericht. Beispieldaten; das Vorgehen bei der
 * Datenübernahme entspricht dem Projekt bei FKC (Vertec-Ablösung, über 20 Jahre Historie).
 *
 * Keine Preise, auch kein „Festpreis“. Vertec wird nur im Zusammenhang mit FKC genannt.
 */
import BlogQuerverweis from '@/components/blog/BlogQuerverweis.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Blueprint from '@/components/hero-backgrounds/Blueprint.astro';
import { ClientLogoStrip } from '@/components/ui/marketing/ClientLogoStrip';
import SectionHeader from '@/components/angebote/SectionHeader.astro';
import { Picture } from 'astro:assets';
import founderPortrait from '@/assets/rocketbase/founder-marten-priess.jpg';
import fkcKanban from '@/assets/references/fkc-sales-kanban.png';
import { contactLinks } from '@/data/rocketbase';
import { getLocalizedPath } from '@/i18n/index';
import HeuteAbloesung from './HeuteAbloesung.astro';
import Landschaft from './Landschaft.astro';
import Abloeseplan from './Abloeseplan.astro';
import Datenuebernahme from './Datenuebernahme.astro';
import { abloesungFaqs } from './faqs';
import '@/components/angebote/frame.css';
import '@/components/zahlen/zahlen.css';
import './abloesung.css';


const clientLogos = [
  { key: 'fkc_logo', name: 'FKC Consulting' },
  { key: 'diezinger_logo', name: 'Schlosserei Diezinger' },
  { key: 'statista-logo', name: 'Statista' },
  { key: 'stage_logo', name: 'Stage Entertainment' },
];

const bausteine = [
  {
    nr: '01',
    icon: 'edit',
    titel: 'Angebot & Kalkulation',
    text: 'Angebote, die nach eurer Regel rechnen, als Seite statt PDF, Zusage per Klick.',
    href: '/angebote/',
  },
  {
    nr: '02',
    icon: 'users',
    titel: 'Einsatz & Abrechnung',
    text: 'Plantafel, Ablauf je Auftrag, Leistung, Rechnung und Mahnwesen in einem System.',
    href: getLocalizedPath('einsatzplanung', 'de'),
  },
  {
    nr: '03',
    icon: 'table',
    titel: 'Zahlen & Steuerung',
    text: 'Umsatz, Auslastung bis zur Person und auslaufende Verträge, live statt am Monatsende.',
    href: '/zahlen/',
  },
];

const fkcFakten = [
  { zahl: '3 → 20+', text: 'Jahre Kundenhistorie: In Vertec lagen drei, heute liegen über zwanzig in einer Anwendung.' },
  { zahl: '1', text: 'System vom Vertrieb über Kalkulation und Termine bis zur Rechnung.' },
  { zahl: 'Web', text: 'Angebote als Seite mit Optionen und mitlaufender Summe, während der Wettbewerb PDFs schickt.' },
];

const antworten = {
  bleiben: {
    label: 'Manchmal richtig',
    titel: 'Im Standard bleiben',
    text: 'Modul ergänzen, Workarounds aufräumen, ein Reporting daneben. Oft schneller und im ersten Moment günstiger. Für einen branchenüblichen Ablauf die richtige Wahl.',
    note: 'Wenn ein Ablauf kein Vorteil gegenüber dem Wettbewerb sein soll, muss er nicht individuell sein. Das sagen wir im Erstgespräch auch so.',
  },
  abloesen: {
    label: 'Wenn der Ablauf euer Vorteil ist',
    titel: 'Ablösen, Schritt für Schritt',
    text: 'Den Standard dort behalten, wo er passt: Buchhaltung, Lohn, alles, was bei euch läuft wie bei tausend anderen. Das, womit ihr euer Geld verdient, bekommt ein eigenes System.',
    note: 'Keine Zusatzfelder mit Fragezeichen, keine Liste mit Sonderfällen. Euer Ablauf steckt im System, nicht im Kopf von zwei Leuten.',
  },
};

const weg = [
  { number: '01', title: 'Erstgespräch', meta: '30 Minuten · kostenlos', text: 'Ihr erzählt, wo der Standard euch bremst. Wir sagen ehrlich, ob Ablösen sinnvoll ist oder ob ein Baustein daneben reicht.' },
  { number: '02', title: 'Workshop', meta: 'drei Termine', text: 'Wir nehmen auf, womit ihr euer Geld verdient, legen den Schnitt fest (was bleibt, was geht) und skizzieren den Ablöseplan mit Datenübernahme.' },
  { number: '03', title: 'Ablösung', meta: 'Baustein für Baustein', text: 'Zuerst der Teil, der am meisten Zeit kostet. Parallelbetrieb, Probeläufe, Stichtag. Betrieb und Updates im ersten Jahr inklusive.' },
];
---

<!-- HERO -->
<section data-hero class="relative overflow-x-clip pt-16 lg:flex lg:min-h-[100svh] lg:flex-col">
  <Blueprint />
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(ellipse_60%_50%_at_30%_40%,var(--color-background)_0%,transparent_75%)] opacity-80"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-[84rem] px-5 pt-8 pb-16 sm:px-8 sm:pt-14 lg:grid lg:flex-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:items-center lg:gap-16 lg:px-12 lg:py-6"
  >
    <div class="text-center lg:text-left">
      <p data-reveal="fade-down" class="text-brand-600 dark:text-brand-300 text-sm font-semibold tracking-[0.22em] uppercase">
        Standardsoftware ablösen
      </p>
      <h1
        data-reveal="fade-down"
        lang="de"
        class="font-display text-foreground mt-3 text-[2.6rem] leading-[1.05] font-bold tracking-tight text-balance sm:mt-5 sm:text-6xl xl:text-[4.25rem]"
      >
        Raus aus der Branchensoftware.
        <span class="text-brand-500 block">Ohne Stillstand.</span>
      </h1>
      <p data-reveal class="text-foreground-muted mt-6 hidden flex-wrap items-center justify-center gap-x-2.5 gap-y-2 text-sm font-medium sm:flex lg:justify-start">
        <span>Schluss mit</span>
        {['verschobenen Updates', 'Zusatzfeldern', 'Excel daneben'].map((alt) => <span class="hero-alt border-border rounded-md border px-2 py-0.5">{alt}</span>)}
      </p>
      <p data-reveal class="text-foreground-secondary mx-auto mt-4 max-w-lg text-base leading-7 sm:mt-7 sm:text-lg sm:leading-8 lg:mx-0">
        Wenn der Standard euren Ablauf nur noch über Sonderfälle trägt, lösen wir ihn ab. Schritt für
        Schritt, im Parallelbetrieb, mit allen Daten.
      </p>
      <p class="text-foreground-muted border-border/70 bg-background/85 mx-auto mt-8 hidden max-w-lg rounded-xl border px-4 py-3 text-sm leading-6 backdrop-blur-sm lg:mx-0 lg:block">
        Wenn es mehr ist als ein fehlender Teil: Angebot, Einsatz und Zahlen in einem System, das so
        arbeitet wie ihr.
      </p>
    </div>

    <div class="mt-7 sm:mt-10 lg:mt-0 lg:flex lg:items-center">
      <div class="border-border bg-card/90 rounded-[2rem] border p-7 shadow-[0_22px_55px_rgba(34,43,74,0.10)] backdrop-blur-sm sm:p-9">
        <p class="text-brand-600 text-xs font-semibold tracking-[0.22em] uppercase">So fängt es an</p>
        <h2 class="font-display text-foreground mt-4 text-2xl font-bold tracking-tight">
          30 Minuten über das, was euch am Standard bremst.
        </h2>
        <p class="text-foreground-secondary mt-4 text-base leading-7">
          Ihr erzählt, wo ihr gegen das System arbeitet. Wir sagen ehrlich, ob Ablösen sinnvoll ist oder
          ob ein Baustein daneben reicht. Kostenlos, ohne Folien.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <Button size="lg" href={contactLinks.cal} target="_blank">
            Erstgespräch buchen
            <Icon name="arrow-up-right" size="sm" />
          </Button>
          <Button variant="outline" size="lg" href="/discovery-workshop/">
            Der Workshop danach
            <Icon name="arrow-right" size="sm" />
          </Button>
        </div>
        <div class="border-border/70 mt-6 flex items-center gap-3 border-t pt-5">
          <Picture src={founderPortrait} alt="Marten Prieß" widths={[48, 96]} sizes="48px" formats={['avif', 'webp']} class="h-12 w-12 shrink-0 rounded-full object-cover" loading="lazy" />
          <p class="text-sm leading-6">
            <span class="text-foreground block font-semibold">Marten Prieß</span>
            <span class="text-foreground-secondary">Gründer von RocketBase, führt das Gespräch selbst.</span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="relative z-10">
    <a
      href="#heute"
      class="hero-scroll absolute top-0 left-1/2 z-20 hidden h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full lg:flex"
      aria-label="Weiter nach unten"
      data-hero-scroll
    >
      <span class="hero-scroll-icon flex"><Icon name="chevron-down" size="sm" /></span>
    </a>
    <ClientLogoStrip heading="Aus Projekten mit" logos={clientLogos} variant="light" uniform class="py-10 lg:py-11" />
  </div>
</section>

<!-- HEUTE -->
<section id="heute" class="heute-sec border-border relative scroll-mt-14 overflow-x-clip border-b pt-16 pb-12 sm:py-20 lg:py-24">
  <div class="container grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-16">
    <div class="af-rise">
      <p class="inline-flex items-center gap-2 font-mono text-xs font-semibold tracking-[0.2em] text-[oklch(58%_0.19_25)] uppercase">
        <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
        Kommt euch das bekannt vor?
      </p>
      <h2 class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-[2.35rem] lg:leading-[1.15]">
        Angepasst, bis nichts mehr geht.{' '}
        <span class="text-foreground-muted">Bezahlt wird trotzdem.</span>
      </h2>
      <p class="text-foreground-secondary mt-5 text-[0.95rem] leading-7">
        Die Branchensoftware ist für alle gemacht, also für niemanden ganz. Euer Ablauf passt nur über
        Zusatzfelder und Sonderfälle hinein. Jedes Update könnte etwas davon kaputt machen, also wird es
        verschoben. Seit Jahren. Die Wartung läuft weiter.
      </p>
      <p class="text-foreground-secondary mt-4 text-[0.95rem] leading-7">
        Daneben wächst Excel: für die Kalkulation, den Einsatzplan, die Auswertung für die Bank. Nicht
        für Notfälle, sondern im Tagesgeschäft. Und was wie gerechnet wird, wissen zwei Leute im Haus.
      </p>
      <p class="text-foreground mt-4 text-[0.95rem] leading-7 font-semibold">
        Irgendwann arbeitet ihr gegen das System statt damit.
      </p>
    </div>
    <div class="af-rise">
      <HeuteAbloesung />
    </div>
  </div>
</section>

<!-- 01 LANDSCHAFT -->
<section class="bg-background relative overflow-x-clip py-24 lg:py-32">
  <div class="bg-brand-300/10 pointer-events-none absolute top-40 left-1/2 h-[40rem] w-[60rem] -translate-x-1/2 rounded-full blur-[120px]" aria-hidden="true"></div>
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="01"
      eyebrow="Vorher, nachher"
      title="Aus acht Systemen wird eins. Nicht über Nacht."
      lead="Was ihr bei euch verdient, zieht Stück für Stück in eine Anwendung. Buchhaltung und Lohn bleiben, wo sie sind, und werden angebunden. Die Exporte von Hand fallen weg, eine nach der anderen."
    />
    <div class="af-rise mx-auto mt-14 max-w-6xl lg:mt-16">
      <Landschaft />
      <p class="z-note mt-4 text-center">Schaltet oben zwischen Heute, nach 6 und nach 12 Monaten. Beispiel.</p>
    </div>
  </div>
</section>

<!-- 02 ABLÖSEPLAN -->
<section class="bg-background-secondary border-border relative border-y py-24 lg:py-28">
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="02"
      eyebrow="Ablöseplan"
      title="Das Tagesgeschäft läuft weiter."
      lead="Kein großer Knall. Die neue Anwendung geht Baustein für Baustein live, das Altsystem läuft so lange parallel. Die Daten werden in Probeläufen übernommen, bis alles stimmt. Erst dann kommt der Stichtag."
    />
    <div class="af-rise mx-auto mt-14 max-w-6xl lg:mt-16">
      <Abloeseplan />
      <p class="z-note mt-4 text-center">Klickt auf die Meilensteine. Beispielplan für einen Betrieb mit drei Bausteinen.</p>
    </div>
  </div>
</section>

<!-- 03 DATENÜBERNAHME -->
<section class="bg-background relative overflow-x-clip py-24 lg:py-28">
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="03"
      eyebrow="Datenübernahme"
      title="Eure Historie kommt mit. Auch die von vor dem jetzigen System."
      lead="Alte Felder bekommen ihren richtigen Platz, Dubletten werden zusammengeführt, und am Ende steht ein Prüfbericht: Anzahlen und Summen alt gegen neu. Was nicht passt, klären wir mit euch, bevor es zählt."
    />
    <div class="af-rise mx-auto mt-14 max-w-6xl lg:mt-16">
      <Datenuebernahme />
      <p class="z-note mt-4 text-center">Vorgehen wie bei FKC, Zahlen sind Beispieldaten.</p>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-band relative overflow-x-clip py-20 lg:py-24">
  <div class="bg-grid-pattern pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_70%_90%_at_80%_50%,black,transparent_75%)] opacity-[0.08]" aria-hidden="true"></div>
  <div class="af-rise relative z-10 container grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-16">
    <div class="max-w-xl">
      <h2 class="font-display text-foreground text-2xl font-bold tracking-tight text-balance sm:text-3xl lg:text-[2.25rem] lg:leading-tight">
        Ablösen oder bleiben?
      </h2>
      <p class="text-brand-600 dark:text-brand-300 mt-2 text-sm font-semibold">30 Minuten · online · kostenlos</p>
      <p class="text-foreground-secondary mt-4 text-[0.95rem] leading-7">
        Erzählt uns, wo ihr gegen euer System arbeitet. Wir sagen ehrlich, ob sich eine Ablösung lohnt
        oder ob ein Baustein daneben reicht.
      </p>
    </div>
    <div class="lg:justify-self-end">
      <Button size="lg" href={contactLinks.cal} target="_blank" class="bg-brand-500 hover:bg-brand-400 text-white shadow-[0_14px_34px_-12px_var(--color-brand-500)]">
        <Icon name="arrow-up-right" size="sm" />
        Erstgespräch buchen
      </Button>
    </div>
  </div>
</section>

<!-- 04 BAUSTEINE -->
<section class="bg-background relative overflow-x-clip py-24 lg:py-28">
  <div class="relative z-10 container max-w-6xl">
    <SectionHeader
      size="md"
      number="04"
      eyebrow="Die Bausteine"
      title="Mit einem anfangen. Oder alles ablösen."
      lead="Die Ablösung besteht aus denselben Bausteinen, mit denen andere Betriebe einzeln einsteigen. Jeder läuft für sich, zusammen ersetzen sie die Branchensoftware."
    />
    <div class="relative mt-14 grid gap-4 md:grid-cols-3">
      <span class="bg-border absolute top-1/2 right-8 left-8 hidden h-px md:block" aria-hidden="true"></span>
      {
        bausteine.map((b) => (
          <a href={b.href} class="af-rise group border-border bg-card relative flex flex-col rounded-2xl border p-6 shadow-sm transition-[transform,box-shadow] duration-300 hover:-translate-y-1 hover:shadow-lg">
            <div class="flex items-center justify-between">
              <span class="border-brand-300/70 bg-brand-500/5 text-brand-600 flex h-11 w-11 items-center justify-center rounded-xl border">
                <Icon name={b.icon} size="sm" />
              </span>
              <span class="text-foreground-muted font-mono text-xs font-semibold">Baustein {b.nr}</span>
            </div>
            <h3 class="font-display text-foreground mt-5 text-lg font-bold tracking-tight">{b.titel}</h3>
            <p class="text-foreground-secondary mt-2 text-sm leading-6">{b.text}</p>
            <span class="text-brand-600 mt-auto inline-flex items-center gap-2 pt-5 text-sm font-semibold transition-transform duration-300 group-hover:translate-x-1">
              Ansehen
              <Icon name="arrow-right" size="sm" />
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<!-- 05 FKC -->
<section class="bg-background-secondary border-border relative border-y py-24 lg:py-28">
  <div class="relative z-10 container grid max-w-7xl gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16">
    <div class="af-rise order-2 lg:order-1">
      <figure class="af-frame">
        <div class="af-bar" aria-hidden="true">
          <span class="af-dots"><span></span><span></span><span></span></span>
          <span class="af-url">FKC · Vertrieb</span>
          <span class="af-dots invisible"><span></span><span></span><span></span></span>
        </div>
        <Picture src={fkcKanban} alt="Vertrieb als Kanban-Board in der Anwendung von FKC" widths={[640, 960, 1280]} sizes="(max-width: 1024px) 100vw, 55vw" formats={['avif', 'webp']} class="block w-full" loading="lazy" />
      </figure>
    </div>
    <div class="af-rise order-1 lg:order-2">
      <SectionHeader size="md" align="left" number="05" eyebrow="In der Praxis" title="FKC: von Vertec zur eigenen Plattform." />
      <p class="text-foreground-secondary mt-6 text-base leading-7">
        Eine Beratung, deren Angebots- und Projektablauf nur über Umwege in Vertec passte. Wir haben den
        echten Ablauf aufgenommen, die Daten aus Vertec und den Systemen davor übernommen und eine
        Anwendung gebaut, die vom Vertrieb bis zur Rechnung so arbeitet wie FKC.
      </p>
      <dl class="mt-7 space-y-4">
        {
          fkcFakten.map((f) => (
            <div class="flex gap-4">
              <dt class="font-display text-brand-600 dark:text-brand-300 w-24 shrink-0 text-xl font-bold whitespace-nowrap tracking-tight">{f.zahl}</dt>
              <dd class="text-foreground-secondary text-sm leading-6">{f.text}</dd>
            </div>
          ))
        }
      </dl>
      <a href="/referenzen/fkc-consulting/" class="text-brand-600 mt-7 inline-flex items-center gap-2 text-sm font-semibold hover:gap-3">
        Referenz ansehen
        <Icon name="arrow-right" size="sm" />
      </a>
    </div>
  </div>
</section>

<!-- 06 EHRLICH -->
<section class="invert-section bg-surface-invert relative overflow-x-clip py-20 lg:py-28">
  <div class="relative z-10 container max-w-6xl">
    <SectionHeader
      size="md"
      invert
      number="06"
      eyebrow="Ehrlich gesagt"
      title="Nicht jede Branchensoftware muss weg."
      lead="Wir verdienen an der Ablösung, also sagen wir es deutlich: Oft ist Bleiben die bessere Wahl. Entscheidend ist, ob der Ablauf, um den es geht, euer Vorteil gegenüber dem Wettbewerb ist."
    />
    <div class="mt-14 grid gap-4 md:grid-cols-2">
      {
        [antworten.bleiben, antworten.abloesen].map((a, i) => (
          <article class:list={['af-rise rounded-2xl border p-6 backdrop-blur sm:p-8', i === 1 ? 'border-brand-400/40 bg-brand-500/10' : 'border-white/10 bg-white/5']}>
            <p class:list={['text-xs font-semibold tracking-[0.2em] uppercase', i === 1 ? 'text-brand-200' : 'text-on-invert-secondary']}>{a.label}</p>
            <h3 class="font-display text-on-invert mt-4 text-xl font-bold tracking-tight sm:text-2xl">{a.titel}</h3>
            <p class="text-on-invert-secondary mt-3 text-[0.95rem] leading-7">{a.text}</p>
            <p class="text-on-invert mt-5 border-t border-white/10 pt-4 text-sm leading-6">{a.note}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- 07 WEG -->
<section id="ablauf" class="bg-background-secondary border-border relative scroll-mt-16 border-b py-20 lg:py-24">
  <div class="relative z-10 container max-w-6xl">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
      <div class="af-rise">
        <p class="text-brand-600 dark:text-brand-300 font-mono text-xs font-semibold tracking-[0.2em] uppercase">07 · So kommt ihr dazu</p>
        <h2 class="font-display text-foreground mt-4 text-2xl font-bold tracking-tight text-balance sm:text-3xl lg:text-[2.5rem] lg:leading-tight">
          Erst der Schnitt, dann die Ablösung.
        </h2>
        <p class="text-foreground-secondary mt-5 text-base leading-7">
          Bevor etwas abgelöst wird, legen wir gemeinsam fest, was bleibt und was geht, und in welcher
          Reihenfolge. Das passiert im Workshop.
        </p>
        <div class="af-after mt-6 flex gap-3 rounded-2xl p-4">
          <Icon name="check-circle" size="md" class="text-brand-500 mt-0.5 shrink-0" />
          <p class="text-foreground text-sm leading-6">
            <strong>Das Ergebnis des Workshops gehört euch.</strong> Euer Ablauf aufgeschrieben, der
            Schnitt zwischen Standard und eigener Lösung, ein Ablöseplan mit Datenübernahme. Auch wenn
            ihr danach mit jemand anderem weitermacht.
          </p>
        </div>
      </div>
      <ol class="relative grid gap-3">
        <span class="bg-border absolute top-8 bottom-8 left-[1.6rem] w-px" aria-hidden="true"></span>
        {
          weg.map((stufe, index) => (
            <li class="af-rise relative">
              <div class:list={['relative flex h-full gap-4 rounded-2xl border p-4 sm:gap-5 sm:p-5', index === 1 ? 'border-brand-300 bg-card dark:border-brand-700 shadow-[0_20px_45px_-24px_rgba(70,90,160,0.45)]' : 'border-border bg-card']}>
                <span class:list={['relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full font-mono text-xs font-bold', index === 1 ? 'bg-brand-500 text-white' : 'bg-brand-500/10 text-brand-600 dark:text-brand-300']}>
                  {stufe.number}
                </span>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h3 class="font-display text-foreground text-base font-bold tracking-tight sm:text-lg">{stufe.title}</h3>
                    <p class="text-brand-600 dark:text-brand-300 text-xs font-semibold sm:text-sm">{stufe.meta}</p>
                  </div>
