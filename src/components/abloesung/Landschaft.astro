---
/**
 * Systemlandschaft heute, nach 6 und nach 12 Monaten. Ein Schalter zieht die Inseln nacheinander
 * in eine Anwendung; Buchhaltung und Lohn bleiben und werden angebunden. Reines SVG mit
 * Zustand am Wurzelelement (data-stand), feste Breite, auf schmalen Schirmen scrollbar.
 */
import '@/components/angebote/frame.css';
import '@/components/zahlen/zahlen.css';
import './abloesung.css';

type Node = { id: string; x: number; y: number; w: number; h: number; t: string; s: string; kind: 'insel' | 'alt' | 'bleibt'; dim?: string; hide?: string };
const W = 880;
const H = 430;
const nodes: Node[] = [
  { id: 'k', x: 20, y: 24, w: 200, h: 56, t: 'Kalkulation.xlsx', s: 'Angebote nebenher in Word', kind: 'insel', dim: '1 2' },
  { id: 'e', x: 20, y: 120, w: 200, h: 56, t: 'Einsatzplan.xlsx', s: 'pflegt eine Person', kind: 'insel', dim: '1 2' },
  { id: 'z', x: 20, y: 216, w: 200, h: 56, t: 'Zeiterfassung', s: 'Export einmal im Monat', kind: 'insel', dim: '1 2' },
  { id: 'a', x: 20, y: 312, w: 200, h: 56, t: 'Auswertung_final.xlsx', s: 'für GF und Bank', kind: 'insel', dim: '2' },
  { id: 'r', x: 660, y: 24, w: 200, h: 56, t: 'Rechnungsprogramm', s: 'zweite Lizenz', kind: 'insel', dim: '2' },
  { id: 'd', x: 660, y: 180, w: 200, h: 56, t: 'DATEV / Steuerbüro', s: 'bleibt', kind: 'bleibt' },
  { id: 'l', x: 660, y: 312, w: 200, h: 56, t: 'Lohn & Gehalt', s: 'bleibt', kind: 'bleibt' },
];
const curve = (x1: number, y1: number, x2: number, y2: number) => {
  const mx = (x1 + x2) / 2;
  return `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`;
};
// Kanten: alt = Export von Hand (rot gestrichelt), neu = Schnittstelle (grün), sync = Parallelbetrieb.
const kanten = [
  { d: curve(220, 52, 330, 70), art: 'export', hide: '1 2' },
  { d: curve(220, 148, 330, 92), art: 'export', hide: '1 2' },
  { d: curve(220, 244, 330, 112), art: 'export', hide: '1 2' },
  { d: curve(220, 340, 330, 124), art: 'export', hide: '2' },
  { d: curve(550, 70, 660, 52), art: 'export', hide: '2' },
  { d: 'M 760 80 L 760 180', art: 'grau', hide: '2' },
  { d: curve(550, 120, 660, 336), art: 'grau', hide: '1 2' },
  { d: 'M 440 136 L 440 214', art: 'sync', hide: '0 2' },
  { d: curve(570, 290, 660, 208), art: 'neu', hide: '0 1' },
  { d: curve(570, 340, 660, 340), art: 'neu', hide: '0' },
  { d: curve(220, 340, 310, 370), art: 'neu', hide: '0 1' },
];
const module = [
  { t: 'Angebot & Kalkulation', dim: '' },
  { t: 'Einsatz & Abrechnung', dim: '' },
  { t: 'Zahlen & Steuerung', dim: '1' },
];
const stand = [
  { label: 'Heute', status: 'Acht Systeme, sieben Übergaben von Hand. Die Branchensoftware ist der Kern, um sie herum wächst Excel.' },
  { label: 'Nach 6 Monaten', status: 'Parallelbetrieb: Angebot und Einsatz laufen in der neuen Anwendung, Rechnungen und Auswertung noch im Altsystem. Die Daten werden abgeglichen.' },
  { label: 'Nach 12 Monaten', status: 'Eine Anwendung für das, womit ihr Geld verdient. Buchhaltung und Lohn sind angebunden, die alte Lizenz ist gekündigt.' },
];
const kpis = [
  { t: 'Systeme', v: ['8', '6', '3'] },
  { t: 'Übergaben von Hand', v: ['7', '3', '0'] },
  { t: 'Lizenzen für Altsysteme', v: ['2', '2', '0'] },
];
---

<figure class="af-frame z-app" data-landschaft data-stand="0">
  <div class="af-bar" aria-hidden="true">
    <span class="af-dots"><span></span><span></span><span></span></span>
    <span class="af-url">eure Systemlandschaft</span>
    <span class="af-dots invisible"><span></span><span></span><span></span></span>
  </div>
  <div class="p-3 sm:p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="z-seg" role="group" aria-label="Zeitpunkt">
        {stand.map((s, i) => <button type="button" data-stand-btn={i} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>)}
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-1 text-[0.7rem]">
        <span class="flex items-center gap-1.5"><span class="ls-key ls-key-export"></span>Export von Hand</span>
        <span class="flex items-center gap-1.5"><span class="ls-key ls-key-neu"></span>Schnittstelle</span>
        <span class="flex items-center gap-1.5"><span class="ls-key ls-key-sync"></span>Abgleich im Parallelbetrieb</span>
      </div>
    </div>

    <div class="mt-4 overflow-x-auto">
      <svg viewBox={`0 0 ${W} ${H}`} class="ls-svg block w-full min-w-[42rem]" role="img" aria-label="Systemlandschaft vor, während und nach der Ablösung">
        <defs>
          <marker id="ls-arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 0 L8 4 L0 8 z" class="ls-arr" />
          </marker>
        </defs>

        {kanten.map((k) => <path d={k.d} class:list={['ls-edge', `ls-${k.art}`]} data-hide={k.hide} marker-end={k.art === 'sync' ? undefined : 'url(#ls-arr)'} />)}

        {
          nodes.map((n) => (
            <Fragment>
              <g class:list={['ls-node', `ls-${n.kind}`]} data-dim={n.dim}>
                <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="12" />
                <text x={n.x + 16} y={n.y + 24} class="ls-t">{n.t}</text>
                <text x={n.x + 16} y={n.y + 42} class="ls-s">{n.s}</text>
              </g>
              {n.kind === 'insel' && <text x={n.x + n.w - 6} y={n.y + n.h + 15} text-anchor="end" class="ls-done" data-show={n.dim}>✓ abgelöst</text>}
            </Fragment>
          ))
        }

        <!-- Altsystem -->
        <g class="ls-node ls-alt" data-dim="2">
          <rect x="330" y="40" width="220" height="96" rx="14" />
          <text x="350" y="72" class="ls-t ls-big">Branchensoftware</text>
          <text x="350" y="94" class="ls-s" data-hide="1 2">Lizenz läuft, Updates verschoben</text>
          <text x="350" y="94" class="ls-s" data-hide="0 2">Parallelbetrieb, nur noch Rechnungen</text>
          <text x="350" y="94" class="ls-s" data-hide="0 1">nur noch lesend, bis Vertragsende</text>
          <text x="350" y="118" class="ls-s">seit 2014 · 17 Zusatzfelder</text>
        </g>
        <g class="ls-stamp" data-hide="0 1" transform="rotate(-8 500 70)">
          <rect x="452" y="54" width="96" height="28" rx="6" />
          <text x="500" y="73" text-anchor="middle">gekündigt</text>
        </g>

        <g class="ls-ghost" data-hide="1 2">
          <rect x="310" y="214" width="260" height="190" rx="16" />
          <text x="440" y="302" text-anchor="middle" class="ls-s">Hier entsteht</text>
          <text x="440" y="322" text-anchor="middle" class="ls-t">eure Anwendung</text>
        </g>

        <!-- Neue Anwendung -->
        <g class="ls-new" data-hide="0">
          <rect x="310" y="214" width="260" height="190" rx="16" class="ls-new-box" />
          <text x="330" y="244" class="ls-t ls-big ls-on-new">Eure Anwendung</text>
          <text x="330" y="264" class="ls-s ls-on-new-s">nach eurem Ablauf gebaut</text>
          {
            module.map((m, i) => (
              <g class="ls-mod" data-dim={m.dim}>
                <rect x="330" y={282 + i * 38} width="220" height="30" rx="8" />
                <circle cx="346" cy={297 + i * 38} r="4" />
                <text x="358" y={301 + i * 38} class="ls-mod-t">{m.t}</text>
                {m.dim && <text x="540" y={301 + i * 38} text-anchor="end" class="ls-folgt" data-show={m.dim}>folgt</text>}
              </g>
            ))
          }
        </g>
      </svg>
    </div>

    <div class="mt-4 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
      <p class="text-[0.82rem] leading-6" data-stand-status>{stand[0].status}</p>
      <div class="flex gap-2">
        {
          kpis.map((k) => (
            <div class="z-card min-w-[6.2rem] px-3 py-2">
              <p class="z-label">{k.t}</p>
              <p class="mt-0.5 text-xl font-bold tabular-nums">
                {k.v.map((v, i) => <span data-kpi={i} hidden={i !== 0}>{v}</span>)}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</figure>

<script define:vars={{ texte: stand.map((s) => s.status) }}>
  document.querySelectorAll('[data-landschaft]').forEach((root) => {
    const btns = root.querySelectorAll('[data-stand-btn]');
    const status = root.querySelector('[data-stand-status]');
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const s = b.dataset.standBtn;
        root.dataset.stand = s;
        btns.forEach((x) => x.setAttribute('aria-pressed', x === b ? 'true' : 'false'));
        if (status) status.textContent = texte[Number(s)];
        root.querySelectorAll('[data-kpi]').forEach((k) => (k.hidden = k.dataset.kpi !== s));
      }),
    );
  });
</script>
