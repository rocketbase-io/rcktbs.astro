---
/**
 * Bento-Raster: was der Angebotsbaustein neben der Kalkulation mitbringt.
 *
 * Acht gleich breite Kacheln (4 · 4), jede mit einer kleinen Illustration aus
 * HTML statt eines Screenshots: liest sich auf jeder Größe, folgt dem Theme und
 * braucht keine Bilddatei. Kartenstil wie Rechner und Kernpunkte in 03
 * (Fläche `--color-card`, Haarlinie, weicher Schatten), damit 04 trotz dunklem
 * Band zur Seite gehört. Kein Lichtkegel mehr (2026-10-05, zu eigen).
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

export interface BentoFeature {
  key:
    'kunden' | 'leistungen' | 'vorlagen' | 'seite' | 'mail' | 'nachfassen' | 'tracking' | 'analyse';
  icon: string;
  title: string;
  text: string;
}

interface Props {
  features: BentoFeature[];
  /** Kompakt: kleinere Kacheln, nur Illustration und Titel, ohne Beschreibung. */
  compact?: boolean;
}

const { features, compact = false } = Astro.props;

// Kompakt: Bento auf sechs Spalten (3 · 2 · 3), damit Kacheln breit genug für einzeilige Titel sind.
const span: Record<BentoFeature['key'], string> = {
  kunden: 'lg:col-span-2',
  leistungen: 'lg:col-span-2',
  vorlagen: 'lg:col-span-2',
  seite: 'lg:col-span-3',
  mail: 'lg:col-span-3',
  nachfassen: 'lg:col-span-2',
  tracking: 'lg:col-span-2',
  analyse: 'lg:col-span-2',
};

const bars = [38, 55, 42, 70, 62, 84];
---

<div class:list={['bento grid', compact ? 'bento-compact grid-cols-2 gap-3 lg:grid-cols-6' : 'gap-4 sm:grid-cols-2 lg:grid-cols-4']}>
  {
    features.map((f) => (
      <article
        class:list={[
          'bento-card af-rise group relative flex flex-col overflow-hidden',
          compact ? ['rounded-[1.25rem] p-4', span[f.key]] : 'rounded-[1.75rem] p-6',
        ]}
      >
        {/* Illustration */}
        <div
          class:list={[
            'bento-visual relative flex items-center overflow-hidden',
            compact ? 'mb-3 h-[9rem] py-1.5' : 'mb-6 h-[9.25rem]',
          ]}
          aria-hidden="true"
        >
          {f.key === 'kunden' && (
            <div class="w-full space-y-2">
              {[
                ['MB', 'Maren Bruns', 'Einkauf'],
                ['JK', 'Jonas Keller', 'Geschäftsführung'],
                ['SZ', 'Sara Ziegler', 'Technik'],
              ].map(([ini, name, role], i) => (
                <div
                  class:list={[
                    'bento-row flex items-center gap-3 rounded-xl px-3 py-1.5',
                    i === 0 && 'bento-row-active',
                  ]}
                >
                  <span class="bg-brand-500/20 text-brand-300 flex h-7 w-7 items-center justify-center rounded-full text-[10px] font-bold">
                    {ini}
                  </span>
                  <span class="text-foreground text-xs font-semibold">{name}</span>
                  <span class="text-foreground-muted ml-auto text-[10px]">{role}</span>
                </div>
              ))}
            </div>
          )}

          {f.key === 'leistungen' && (
            <div class="w-full">
              <div class="bento-row overflow-hidden rounded-xl">
                {[
                  ['Grundleistung', '75,00 €'],
                  ['Anfahrt je km', '0,90 €'],
                  ['Material +15 %', 'je Pos.'],
                ].map(([a, b]) => (
                  <div class="border-foreground/10 flex items-center justify-between border-b px-3 py-2 text-xs last:border-b-0">
                    <span class="text-foreground-secondary">{a}</span>
                    <span class="text-foreground font-mono font-semibold">{b}</span>
                  </div>
                ))}
              </div>
              <span class="bg-brand-500/15 text-brand-300 mt-2 inline-block rounded-full px-2.5 py-0.5 text-[10px] font-semibold">
                gültig ab 01.01.
              </span>
            </div>
          )}

          {f.key === 'vorlagen' && (
            <div class="grid w-full grid-cols-3 gap-2">
              {['Wartung', 'Beratung', 'Montage'].map((t, i) => (
                <div
                  class:list={[
                    'bento-row flex aspect-[3/4] flex-col gap-1.5 rounded-lg p-2',
                    i === 1 && 'bento-row-active',
                  ]}
                >
                  <span class="bg-brand-400/60 h-2 w-3/4 rounded" />
                  <span class="bg-foreground/15 h-1.5 w-full rounded" />
                  <span class="bg-foreground/15 h-1.5 w-5/6 rounded" />
                  <span class="bg-foreground/10 mt-auto h-4 w-full rounded" />
                  <span class="text-foreground-muted text-center text-[9px] font-semibold">
                    {t}
                  </span>
                </div>
              ))}
            </div>
          )}

          {f.key === 'seite' && (
            <div class="flex w-full items-end gap-3">
              <div class="bento-row flex-1 overflow-hidden rounded-xl">
                <div class="border-foreground/10 flex gap-1 border-b px-2.5 py-1.5">
                  <span class="bg-foreground/20 h-1.5 w-1.5 rounded-full" />
                  <span class="bg-foreground/20 h-1.5 w-1.5 rounded-full" />
                  <span class="bg-foreground/20 h-1.5 w-1.5 rounded-full" />
                </div>
                <div class="space-y-1.5 p-3">
                  <span class="bg-brand-400/60 block h-2 w-1/2 rounded" />
                  <span class="bg-foreground/15 block h-1.5 w-full rounded" />
                  <div class="flex items-center justify-between pt-1 text-[10px]">
                    <span class="text-foreground-muted flex items-center gap-1">
                      <span class="border-brand-400 bg-brand-500 h-2.5 w-2.5 rounded-sm border" />{' '}
                      Option B
                    </span>
                    <span class="text-foreground font-mono font-semibold">3.354,60 €</span>
                  </div>
                  <span class="bg-brand-500 mt-1 block rounded-md py-1 text-center text-[10px] font-semibold text-white">
                    Angebot annehmen
                  </span>
                </div>
              </div>
              <div class="bento-row flex h-20 w-16 shrink-0 flex-col items-center justify-center gap-1 rounded-lg">
                <Icon name="file-text" size="sm" class="text-brand-300" />
                <span class="text-foreground-muted text-[9px] font-bold">PDF</span>
              </div>
            </div>
          )}

          {f.key === 'mail' && (
            <div class="w-full space-y-2.5">
              <div class="bento-row flex items-center gap-3 rounded-xl px-3 py-2.5">
                <span class="relative flex h-2.5 w-2.5">
                  <span class="bento-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400/70" />
                  <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-400" />
                </span>
                <span class="text-foreground text-xs font-semibold">
                  Euer Postfach ist verbunden
                </span>
                <span class="text-foreground-muted ml-auto text-[10px]">
                  vertrieb@euer-betrieb.de
                </span>
              </div>
              <div class="bento-row rounded-xl px-3 py-2.5 text-[11px] leading-5">
                <p class="text-foreground-muted">An: m.bruns@kunde.de</p>
                <p class="text-foreground font-semibold">Ihr Angebot 11328-01</p>
                <p class="text-brand-300 mt-1 flex items-center gap-1">
                  <Icon name="external-link" size="xs" /> angebot.euer-betrieb.de/11328-01
                </p>
              </div>
            </div>
          )}

          {f.key === 'nachfassen' && (
            <ol class="relative w-full space-y-3 pl-5">
              <span class="bg-foreground/15 absolute top-1.5 bottom-1.5 left-[0.4rem] w-px" />
              {[
                ['Versendet', 'Tag 0', true],
                ['Erinnerung', 'Tag 28', false],
                ['Erinnerung', 'Tag 58', false],
              ].map(([a, b, done]) => (
                <li class="relative flex items-center justify-between text-xs">
                  <span
                    class:list={[
                      'absolute top-1/2 -left-5 h-3 w-3 -translate-y-1/2 rounded-full border-2',
                      done
                        ? 'border-brand-400 bg-brand-500'
                        : 'border-foreground/30 bg-transparent',
                    ]}
                  />
                  <span class="text-foreground font-semibold">{a}</span>
                  <span class="text-foreground-muted font-mono text-[10px]">{b}</span>
                </li>
              ))}
              <li class="text-foreground-muted text-[10px]">stoppt bei Zu- oder Absage</li>
            </ol>
          )}

          {f.key === 'tracking' && (
            <div class="w-full space-y-1.5">
              <div class="flex items-baseline gap-2">
                <span class="font-display text-foreground text-3xl font-bold">21×</span>
                <span class="text-foreground-muted text-xs">geöffnet</span>
              </div>
              {['21.09. · 13:18', '21.09. · 13:12'].map((t) => (
                <div class="bento-row flex items-center gap-2 rounded-lg px-2.5 py-1.5 text-[11px]">
                  <Icon name="eye" size="xs" class="text-brand-300" />
                  <span class="text-foreground-secondary">Zugriff · Kunde</span>
                  <span class="text-foreground-muted ml-auto font-mono">{t}</span>
                </div>
              ))}
            </div>
          )}

          {f.key === 'analyse' && (
            <div class="w-full">
              <div class="flex h-20 items-end gap-1.5">
                {bars.map((h, i) => (
                  <span
                    class:list={[
                      'bento-bar flex-1 rounded-t-md',
                      i === bars.length - 1 ? 'bg-brand-400' : 'bg-brand-500/35',
                    ]}
                    style={`height: ${h}%; animation-delay: ${i * 80}ms`}
                  />
                ))}
              </div>
              <div class="mt-2 flex items-baseline justify-between text-[11px]">
                <span class="text-foreground-muted">realistisch offen</span>
                <span class="text-foreground font-mono font-semibold">49.396 €</span>
              </div>
            </div>
          )}
        </div>

        <div class="relative">
          <div class="flex items-center gap-2.5">
            <span class:list={['bento-icon h-8 w-8 shrink-0 items-center justify-center rounded-lg', compact ? 'hidden sm:flex' : 'flex']}>
              <Icon name={f.icon} size="sm" />
            </span>
            <h3
              class:list={[
                'font-display text-foreground font-bold tracking-tight',
                compact
                  ? 'text-[0.8rem] whitespace-nowrap sm:text-sm lg:text-[0.95rem]'
                  : 'text-base sm:text-lg',
              ]}
            >
              {f.title}
            </h3>
          </div>
          {!compact && <p class="text-foreground-secondary mt-2.5 text-sm leading-6">{f.text}</p>}
        </div>
      </article>
    ))
  }
</div>

<style>
  /* Kompakt: Illustration maßstäblich verkleinern statt umbrechen. Layoutbreite
     = Kachelbreite / Faktor, per transform wieder auf Kachelbreite skaliert. */
  .bento-compact {
    --bz: 0.62;
  }
  @media (min-width: 1024px) {
    .bento-compact {
      --bz: 0.84;
    }
  }
  .bento-compact .bento-visual > * {
    width: calc(100% / var(--bz));
    flex-shrink: 0;
    transform: scale(var(--bz));
    transform-origin: left center;
  }
  .bento-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 30px 70px -44px oklch(10% 0.04 265 / 0.6);
    transition:
      border-color 300ms ease-out,
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) {
    .bento-card:hover {
      border-color: color-mix(in oklch, var(--color-brand-400) 45%, var(--color-border));
      transform: translateY(-3px);
    }
  }
  .bento-row {
    background: color-mix(in oklch, var(--color-foreground) 5%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-foreground) 9%, transparent);
  }
  .bento-row-active {
    border-color: color-mix(in oklch, var(--color-brand-400) 55%, transparent);
    background: color-mix(in oklch, var(--color-brand-500) 14%, transparent);
  }
  .bento-icon {
    color: var(--color-brand-300);
    background: color-mix(in oklch, var(--color-brand-500) 18%, transparent);
  }
  .bento-ping {
    animation: bento-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes bento-ping {
    75%,
    100% {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  .bento-bar {
    transform-origin: bottom;
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .bento-bar {
        animation: bento-grow linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
    }
  }
  @keyframes bento-grow {
    from {
      transform: scaleY(0.15);
    }
    to {
      transform: scaleY(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bento-ping {
      animation: none;
    }
    .bento-card {
      transition: none;
    }
  }
</style>
