---
/**
 * Scroll-Showcase: Schritte links an einem Fortschritts-Rail, rechts ein
 * Browser-Rahmen, in dem der Screenshot zum aktiven Schritt wechselt.
 *
 * Was den Effekt trägt (alles nur transform + opacity, Tokens aus dem Theme):
 *   - Browser-Rahmen mit leichter 3D-Neigung, die sich bei Hover aufrichtet
 *   - Bildwechsel: das neue Bild schiebt sich von unten herein, das alte
 *     sinkt leicht ab und blendet aus
 *   - Hinweis-Chips je Schritt, die mit kleinem Versatz nach dem Bild kommen
 *   - ein Farbschein hinter dem Rahmen, der je Schritt wandert
 *   - Rail mit Nummern-Punkten, der Füllstand folgt dem aktiven Schritt
 *
 * Ab lg bleibt die rechte Spalte stehen (sticky; die Sektion darf dafür kein
 * overflow-hidden tragen). Darunter steht jedes Bild im Rahmen direkt über
 * seinem Text, ohne Script. `prefers-reduced-motion` nimmt Neigung und
 * Bewegung raus, der Wechsel bleibt.
 */
import './frame.css';
import { Picture } from 'astro:assets';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import type { ImageMetadata } from 'astro';

export interface ShowcaseChip {
  text: string;
  /** Ecke des Rahmens: top-left, top-right, bottom-left, bottom-right. */
  pos: 'tl' | 'tr' | 'bl' | 'br';
}

export interface ShowcaseStep {
  /** Kurzes Stichwort über dem Titel, z. B. „Anfrage". */
  eyebrow: string;
  title: string;
  /** Wie es heute meistens läuft, in einem Satz. Daran erkennt sich der Leser wieder. */
  before: string;
  /** Was das Modul daraus macht. */
  text: string;
  image: ImageMetadata;
  alt: string;
  /** Pfad in der nachgebauten Adresszeile des Rahmens. */
  url: string;
  chips?: ShowcaseChip[];
}

interface Props {
  steps: ShowcaseStep[];
}

const { steps } = Astro.props;
---

<div
  class="grid gap-12 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1.38fr)] lg:gap-14 xl:gap-20"
  data-showcase
>
  <!-- Schritte mit Rail -->
  <ol class="relative space-y-12 lg:space-y-0 lg:pl-12">
    <span
      class="bg-border absolute top-3 bottom-3 left-[1.1875rem] hidden w-px lg:block"
      aria-hidden="true"></span>
    <span
      data-showcase-rail
      class="bg-brand-500 absolute top-3 left-[1.1875rem] hidden w-px origin-top transition-transform duration-500 ease-out motion-reduce:transition-none lg:block"
      style="height: calc(100% - 1.5rem); transform: scaleY(0)"
      aria-hidden="true"></span>

    {
      steps.map((step, index) => (
        <li
          data-showcase-step
          class:list={[
            'showcase-step relative lg:flex lg:min-h-[62vh] lg:flex-col lg:justify-center lg:py-8',
            index === 0 && 'is-active',
          ]}
        >
          <span
            data-showcase-dot
            class="showcase-dot border-border bg-card text-foreground-muted absolute top-1/2 -left-12 hidden h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full border-2 font-mono text-xs font-bold transition-[background-color,border-color,color,transform] duration-300 motion-reduce:transition-none lg:flex"
            aria-hidden="true"
          >
            0{index + 1}
          </span>

          {/* Unter lg: der Rahmen steht über dem Text, ohne Script. */}
          <figure class="af-frame af-rise mb-7 lg:hidden">
            <div class="af-bar" aria-hidden="true">
              <span class="af-dots">
                <span />
                <span />
                <span />
              </span>
              <span class="af-url">{step.url}</span>
            </div>
            <div class="relative">
              <Picture
                src={step.image}
                alt={step.alt}
                widths={[480, 768, 1024, 1440]}
                sizes="100vw"
                formats={['avif', 'webp']}
                class="block aspect-[16/10] w-full object-cover object-left-top"
                loading="lazy"
              />
              {step.chips?.map((chip) => (
                <span class="af-chip" data-pos={chip.pos}>
                  {chip.text}
                </span>
              ))}
            </div>
          </figure>

          <p class="text-brand-600 dark:text-brand-300 font-mono text-xs font-semibold tracking-[0.18em] uppercase">
            <span class="lg:hidden">0{index + 1} · </span>
            {step.eyebrow}
          </p>
          <h3 class="font-display text-foreground mt-3 text-2xl font-bold tracking-tight text-balance sm:text-[1.75rem] sm:leading-tight">
            {step.title}
          </h3>
          <div class="mt-6 max-w-xl space-y-3">
            <div class="before-card rounded-2xl border border-dashed p-4 sm:p-5">
              <span class="before-pill inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold tracking-[0.14em] uppercase">
                <Icon name="x" size="xs" />
                Bisher
              </span>
              <p class="before-text mt-3 text-[0.95rem] leading-6">{step.before}</p>
            </div>
            <div class="after-card rounded-2xl border p-4 sm:p-5">
              <span class="after-pill inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold tracking-[0.14em] uppercase">
                <Icon name="check" size="xs" />
                Mit dem Modul
              </span>
              <p class="text-foreground mt-3 text-base leading-7">{step.text}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <!-- Sticky-Rahmen ab lg -->
  <div class="hidden lg:sticky lg:top-24 lg:block lg:self-start">
    <div class="relative" style="perspective: 1800px">
      <!-- Farbschein, wandert je Schritt -->
      <div
        data-showcase-glow
        class="bg-brand-400/25 dark:bg-brand-500/20 pointer-events-none absolute -inset-10 rounded-[3rem] blur-3xl transition-transform duration-700 ease-out motion-reduce:transition-none"
        aria-hidden="true"
      >
      </div>

      <div data-showcase-frame class="showcase-frame af-frame relative">
        <div class="af-bar" aria-hidden="true">
          <span class="af-dots">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span data-showcase-url class="af-url">{steps[0]?.url}</span>
          <span
            data-showcase-counter
            class="text-foreground-muted w-14 shrink-0 text-right font-mono text-[11px] tabular-nums"
          >
            01 / 0{steps.length}
          </span>
        </div>

        <!-- Bildstapel -->
        <div class="relative aspect-[16/10]">
          {
            steps.map((step, index) => (
              <div
                data-showcase-image
                data-caption={step.alt}
                data-url={step.url}
                class:list={['showcase-image absolute inset-0', index === 0 && 'is-active']}
                aria-hidden={index === 0 ? 'false' : 'true'}
              >
                <Picture
                  src={step.image}
                  alt={step.alt}
                  widths={[960, 1280, 1920, 2560]}
                  sizes="(min-width: 1024px) 62vw, 100vw"
                  formats={['avif', 'webp']}
                  class="h-full w-full object-cover object-left-top"
                  loading={index === 0 ? 'eager' : 'lazy'}
                />
                {step.chips?.map((chip, chipIndex) => (
                  <span
                    class="af-chip showcase-chip"
                    data-pos={chip.pos}
                    style={`transition-delay: ${220 + chipIndex * 120}ms`}
                  >
                    {chip.text}
                  </span>
                ))}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <p
      data-showcase-caption
      class="text-foreground-muted mt-6 min-h-[1.5rem] text-center text-sm leading-6"
    >
      {steps[0]?.alt}
    </p>
  </div>
</div>

<style>
  /* Vorher/Nachher je Schritt. Farben über color-mix aus den Sektions-Tokens,
     damit es auf dem dunklen Band und im Dark Mode gleich gut lesbar ist. */
  .before-card {
    border-color: color-mix(in oklch, var(--color-foreground) 22%, transparent);
    background: color-mix(in oklch, var(--color-foreground) 4%, transparent);
  }
  .before-pill {
    color: oklch(72% 0.14 25);
    background: color-mix(in oklch, oklch(65% 0.18 25) 16%, transparent);
  }
  .before-text {
    color: var(--color-foreground-muted);
  }
  .after-card {
    border-color: color-mix(in oklch, var(--color-brand-400) 45%, transparent);
    background: color-mix(in oklch, var(--color-brand-500) 14%, transparent);
    box-shadow: 0 20px 40px -24px color-mix(in oklch, var(--color-brand-500) 70%, transparent);
  }
  .after-pill {
    color: white;
    background: var(--color-brand-500);
  }
  /* Schritte: inaktive abgedunkelt, Punkt auf dem Rail füllt sich */
  @media (min-width: 1024px) {
    .showcase-step {
      opacity: 0.4;
      transition: opacity 300ms ease-out;
    }
    .showcase-step.is-active {
      opacity: 1;
    }
    .showcase-step.is-active .showcase-dot {
      background-color: var(--color-brand-500);
      border-color: var(--color-brand-500);
      color: var(--color-on-invert, #fff);
      transform: translateY(-50%) scale(1.08);
    }
  }

  /* Rahmen: leichte Neigung, richtet sich bei Hover auf, kurzer Impuls beim Wechsel */
  .showcase-frame {
    transform: rotateY(-5deg) rotateX(2deg);
    transform-style: preserve-3d;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .showcase-frame:hover {
    transform: rotateY(0deg) rotateX(0deg);
  }
  .showcase-frame.is-switching {
    transform: rotateY(-5deg) rotateX(2deg) scale(0.985);
  }

  /* Bildstapel: neues Bild kommt von unten, altes sinkt ab */
  .showcase-image {
    opacity: 0;
    transform: translateY(28px) scale(0.985);
    transition:
      opacity 500ms ease-out,
      transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }
  .showcase-image.is-leaving {
    opacity: 0;
    transform: translateY(-16px) scale(0.99);
  }
  .showcase-image.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  /* Chips folgen dem Bild mit Versatz */
  .showcase-chip {
    opacity: 0;
    transform: translateY(10px) scale(0.96);
    transition:
      opacity 400ms ease-out,
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .showcase-image.is-active .showcase-chip {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase-step,
    .showcase-dot,
    .showcase-frame,
    .showcase-image,
    .showcase-chip {
      transition: none;
    }
    .showcase-frame,
    .showcase-frame:hover,
    .showcase-frame.is-switching {
      transform: none;
    }
    .showcase-image,
    .showcase-image.is-leaving {
      transform: none;
    }
    .showcase-chip {
      transform: none;
    }
  }
</style>

<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-showcase]');

  roots.forEach((root) => {
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-showcase-step]'));
    const images = Array.from(root.querySelectorAll<HTMLElement>('[data-showcase-image]'));
    const frame = root.querySelector<HTMLElement>('[data-showcase-frame]');
    const glow = root.querySelector<HTMLElement>('[data-showcase-glow]');
    const rail = root.querySelector<HTMLElement>('[data-showcase-rail]');
    const caption = root.querySelector<HTMLElement>('[data-showcase-caption]');
    const url = root.querySelector<HTMLElement>('[data-showcase-url]');
    const counter = root.querySelector<HTMLElement>('[data-showcase-counter]');
    if (steps.length === 0) return;

    const desktop = window.matchMedia('(min-width: 1024px)');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const pad = (n: number) => String(n).padStart(2, '0');
    let active = 0;
    let leaveTimer: number | undefined;

    const applyRail = () => {
      if (!rail) return;
      const progress = steps.length > 1 ? active / (steps.length - 1) : 1;
      rail.style.transform = `scaleY(${progress})`;
    };

    const applyGlow = () => {
      if (!glow || reduced.matches) return;
      // Der Schein wandert je Schritt von Ecke zu Ecke; so sieht man den
      // Wechsel auch im Augenwinkel, ohne dass der Rahmen selbst springt.
      const x = active % 2 === 0 ? -6 : 6;
      const y = ((active % 3) - 1) * 5;
      glow.style.transform = `translate3d(${x}%, ${y}%, 0) rotate(${active * 4}deg)`;
    };

    const setActive = (next: number) => {
      const previous = active;
      active = next;

      steps.forEach((step, index) => step.classList.toggle('is-active', index === active));

      images.forEach((image, index) => {
        const on = index === active;
        image.classList.toggle('is-active', on);
        image.classList.toggle('is-leaving', index === previous && !on);
        image.setAttribute('aria-hidden', on ? 'false' : 'true');
      });
      window.clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(() => {
        images.forEach((image) => image.classList.remove('is-leaving'));
      }, 700);

      if (frame && !reduced.matches) {
        frame.classList.add('is-switching');
        window.setTimeout(() => frame.classList.remove('is-switching'), 320);
      }

      const current = images[active];
      if (caption) caption.textContent = current?.dataset.caption ?? '';
      if (url) url.textContent = current?.dataset.url ?? '';
      if (counter) counter.textContent = `${pad(active + 1)} / ${pad(steps.length)}`;

      applyRail();
      applyGlow();
    };

    const update = () => {
      if (!desktop.matches) return;
      const trigger = window.innerHeight * 0.45;
      let closest = 0;
      let closestDistance = Number.POSITIVE_INFINITY;

      steps.forEach((step, index) => {
        const rect = step.getBoundingClientRect();
        const center = rect.top + rect.height / 2;
        const distance = Math.abs(center - trigger);
        if (distance < closestDistance) {
          closestDistance = distance;
          closest = index;
        }
      });

      if (closest !== active) setActive(closest);
    };

    let ticking = false;
    const onChange = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    applyRail();
    applyGlow();
    update();
    document.addEventListener('scroll', onChange, { passive: true });
    window.addEventListener('resize', onChange);
  });
</script>
