---
/**
 * Screenshot im Browser-Rahmen für die Angebots-Seiten.
 *
 * Optik aus `frame.css`: Rahmen und Adressleiste folgen dem Theme der Seite,
 * nicht der Sektion. `motion` hängt einen Scroll-Effekt an (CSS-Scroll-Timeline,
 * ohne Support oder bei reduced motion steht das Bild einfach da).
 */
import './frame.css';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Pfad in der Adressleiste; ohne Wert entfällt die Leiste. */
  url?: string;
  /**
   * `cover` schneidet auf `ratio` zu (oben links verankert), `contain` passt das Bild
   * in eine Fläche mit `ratio` ein (gleich hohe Kacheln bei verschiedenen Formaten),
   * `natural` zeigt alles im eigenen Format.
   */
  fit?: 'cover' | 'contain' | 'natural';
  ratio?: string;
  sizes?: string;
  motion?: 'rise' | 'tilt' | 'drift' | 'none';
  class?: string;
  chips?: { text: string; pos: 'tl' | 'tr' | 'bl' | 'br' }[];
  loading?: 'lazy' | 'eager';
}

const {
  image,
  alt,
  url,
  fit = 'natural',
  ratio = '16/10',
  sizes = '(min-width: 1024px) 60vw, 100vw',
  motion = 'rise',
  class: className,
  chips = [],
  loading = 'lazy',
} = Astro.props;
---

<figure class:list={['af-frame', motion !== 'none' && `af-${motion}`, className]}>
  {
    url && (
      <div class="af-bar" aria-hidden="true">
        <span class="af-dots">
          <span />
          <span />
          <span />
        </span>
        <span class="af-url">{url}</span>
        <span class="af-dots invisible">
          <span />
          <span />
          <span />
        </span>
      </div>
    )
  }
  <div
    class:list={[
      'relative',
      fit === 'contain' && 'af-contain flex items-center justify-center p-4 sm:p-6',
    ]}
    style={fit === 'contain' ? `aspect-ratio: ${ratio}` : undefined}
  >
    <Picture
      src={image}
      alt={alt}
      widths={[480, 768, 1024, 1440, 1920, 2560]}
      sizes={sizes}
      formats={['avif', 'webp']}
      class:list={[
        'block',
        fit === 'contain'
          ? 'max-h-full w-auto max-w-full rounded-lg object-contain shadow-sm'
          : 'w-full',
        fit === 'cover' && 'object-cover object-left-top',
      ]}
      style={fit === 'cover' ? `aspect-ratio: ${ratio}` : undefined}
      loading={loading}
    />
    {
      chips.map((chip) => (
        <span class="af-chip" data-pos={chip.pos}>
          {chip.text}
        </span>
      ))
    }
  </div>
</figure>
