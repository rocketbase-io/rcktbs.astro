---
/**
 * Screenshot im Browser-Rahmen für die Angebots-Seiten.
 *
 * Optik aus `frame.css`: Rahmen und Adressleiste folgen dem Theme der Seite,
 * nicht der Sektion. `motion` hängt einen Scroll-Effekt an (CSS-Scroll-Timeline,
 * ohne Support oder bei reduced motion steht das Bild einfach da).
 *
 * `zoom` (Standard an) legt einen Knopf über das Bild, der es in voller Auflösung in
 * einer Lightbox öffnet (`<dialog>`, Esc und Klick daneben schließen). Der Dialog
 * existiert einmal je Seite und wird beim ersten Öffnen angelegt.
 */
import './frame.css';
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  /** Pfad in der Adressleiste; ohne Wert entfällt die Leiste. */
  url?: string;
  /**
   * `cover` schneidet auf `ratio` zu (oben links verankert), `contain` passt das Bild
   * in eine Fläche mit `ratio` ein (gleich hohe Kacheln bei verschiedenen Formaten),
   * `natural` zeigt alles im eigenen Format.
   */
  fit?: 'cover' | 'contain' | 'natural';
  ratio?: string;
  sizes?: string;
  motion?: 'rise' | 'tilt' | 'drift' | 'none';
  class?: string;
  chips?: { text: string; pos: 'tl' | 'tr' | 'bl' | 'br' }[];
  loading?: 'lazy' | 'eager';
  zoom?: boolean;
}

const {
  image,
  alt,
  url,
  fit = 'natural',
  ratio = '16/10',
  sizes = '(min-width: 1024px) 60vw, 100vw',
  motion = 'rise',
  class: className,
  chips = [],
  loading = 'lazy',
  zoom = true,
} = Astro.props;

const full = zoom
  ? await getImage({ src: image, width: Math.min(image.width, 2560), format: 'webp' })
  : undefined;
---

<figure class:list={['af-frame', motion !== 'none' && `af-${motion}`, className]}>
  {
    url && (
      <div class="af-bar" aria-hidden="true">
        <span class="af-dots">
          <span />
          <span />
          <span />
        </span>
        <span class="af-url">{url}</span>
        <span class="af-dots invisible">
          <span />
          <span />
          <span />
        </span>
      </div>
    )
  }
  <div
    class:list={[
      'relative',
      fit === 'contain' && 'af-contain flex items-center justify-center p-4 sm:p-6',
    ]}
    style={fit === 'contain' ? `aspect-ratio: ${ratio}` : undefined}
  >
    <Picture
      src={image}
      alt={alt}
      widths={[480, 768, 1024, 1440, 1920, 2560]}
      sizes={sizes}
      formats={['avif', 'webp']}
      class:list={[
        'block',
        fit === 'contain'
          ? 'max-h-full w-auto max-w-full rounded-lg object-contain shadow-sm'
          : 'w-full',
        fit === 'cover' && 'object-cover object-left-top',
      ]}
      style={fit === 'cover' ? `aspect-ratio: ${ratio}` : undefined}
      loading={loading}
    />
    {
      chips.map((chip) => (
        <span class="af-chip" data-pos={chip.pos}>
          {chip.text}
        </span>
      ))
    }
    {
      full && (
        <button
          type="button"
          class="af-zoom"
          data-zoom-src={full.src}
          data-zoom-alt={alt}
          data-zoom-width={full.attributes.width}
          data-zoom-height={full.attributes.height}
          aria-label={`Screenshot vergrößern: ${alt}`}
        >
          <span class="af-zoom-hint" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
            </svg>
            Vergrößern
          </span>
        </button>
      )
    }
  </div>
</figure>

<script>
  // Eine Lightbox je Seite. Ein Wisch (Tabs) soll keinen Klick auslösen.
  let dialog: HTMLDialogElement | null = null;
  let downX = 0;
  let downY = 0;
  let opener: HTMLElement | null = null;

  const ensureDialog = () => {
    if (dialog) return dialog;
    dialog = document.createElement('dialog');
    dialog.className = 'af-lightbox';
    dialog.setAttribute('aria-label', 'Screenshot');
    dialog.innerHTML = `
      <button type="button" class="af-lightbox-close" aria-label="Schließen">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
      <figure class="af-lightbox-figure">
        <img alt="" decoding="async" />
        <figcaption></figcaption>
      </figure>`;
    document.body.append(dialog);
    const close = () => dialog?.close();
    dialog.querySelector('.af-lightbox-close')?.addEventListener('click', close);
    // Klick auf Bild oder Hintergrund schließt, nur die Bildunterschrift nicht.
    dialog.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName !== 'FIGCAPTION') close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('af-lightbox-open');
      opener?.focus({ preventScroll: true });
    });
    return dialog;
  };

  document.addEventListener('pointerdown', (e) => {
    downX = e.clientX;
    downY = e.clientY;
  });

  document.addEventListener('click', (e) => {
    const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-zoom-src]');
    if (!button) return;
    if (e.detail > 0 && Math.hypot(e.clientX - downX, e.clientY - downY) > 10) return;
    const d = ensureDialog();
    const img = d.querySelector('img')!;
    img.src = button.dataset.zoomSrc ?? '';
    img.alt = button.dataset.zoomAlt ?? '';
    img.width = Number(button.dataset.zoomWidth) || 0;
    img.height = Number(button.dataset.zoomHeight) || 0;
    d.querySelector('figcaption')!.textContent = button.dataset.zoomAlt ?? '';
    opener = button;
    document.documentElement.classList.add('af-lightbox-open');
    d.showModal();
  });
</script>
