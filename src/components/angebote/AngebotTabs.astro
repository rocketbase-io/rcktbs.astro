---
/**
 * Schritte als Stepper mit automatischem Durchlauf, statt langer Scroll-Strecke.
 *
 * Aufbau
 *   - Stepper oben: Stationen 1–5, verbunden durch eine Linie; im aktiven
 *     Reiter läuft ein Fortschrittsbalken (automatischer Wechsel).
 *   - Darunter zwei Stapel im selben Raster: links Text, rechts Screenshot. Alle
 *     Schritte liegen übereinander (grid-area 1/1), deshalb springt die Höhe nie.
 *     Der neue Screenshot kommt je nach Richtung von rechts oder links, der alte
 *     gleitet hinaus; der Text blendet versetzt mit.
 *
 * Autoplay ist standardmäßig aus (`autoplay`): Weitergeblättert wird per Klick,
 * Pfeil oder Wischen. Eingeschaltet startet es erst im Viewport und hört für
 * immer auf, sobald jemand klickt, eine Taste drückt oder darüber fährt.
 * Bei `prefers-reduced-motion` gibt es weder Autoplay noch Bewegung.
 *
 * Barrierearm nach WAI-ARIA-Tabs: role=tablist/tab/tabpanel, Pfeiltasten
 * wechseln. Inaktive Schritte sind `inert` und `aria-hidden`.
 */
import './frame.css';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import ShotFrame from './ShotFrame.astro';
import type { ImageMetadata } from 'astro';

export interface ShowcaseChip {
  text: string;
  /** Ecke des Rahmens: top-left, top-right, bottom-left, bottom-right. */
  pos: 'tl' | 'tr' | 'bl' | 'br';
}

export interface ShowcaseStep {
  /** Kurzes Stichwort über dem Titel, z. B. „Erstellen". */
  eyebrow: string;
  title: string;
  /** Wie es heute meistens läuft, in einem Satz. Daran erkennt sich der Leser wieder. */
  before: string;
  /** Was der Baustein daraus macht. */
  text: string;
  image: ImageMetadata;
  alt: string;
  /** Pfad in der nachgebauten Adresszeile des Rahmens. */
  url: string;
  chips?: ShowcaseChip[];
}

interface Props {
  steps: ShowcaseStep[];
  id?: string;
  /** Anzeigedauer je Schritt im Autoplay, in Millisekunden. */
  interval?: number;
  /** Automatisch weiterblättern. Aus, weil Leser selbst steuern wollen. */
  autoplay?: boolean;
}

const { steps, id = 'angebot-tabs', interval = 7000, autoplay = false } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div
  data-tabs
  class="af-tabs"
  style={`--af-interval: ${interval}ms`}
  data-interval={interval}
  data-autoplay-enabled={autoplay ? 'true' : 'false'}
>
  <!-- Stepper -->
  <div class="relative mx-auto max-w-4xl">
    <span
      class="af-stepline absolute top-[1.1rem] right-[10%] left-[10%] h-px sm:top-[1.35rem]"
      aria-hidden="true"></span>
    <div
      role="tablist"
      aria-label="Schritte mit dem Angebotsbaustein"
      class="relative grid"
      style={`grid-template-columns: repeat(${steps.length}, minmax(0, 1fr))`}
    >
      {
        steps.map((step, index) => (
          <button
            type="button"
            role="tab"
            id={`${id}-tab-${index}`}
            aria-controls={`${id}-panel-${index}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-tab
            class="af-step group flex min-w-0 flex-col items-center gap-1.5 px-0.5 sm:gap-2 sm:px-1"
          >
            <span class="af-step-dot relative flex h-11 w-11 items-center justify-center rounded-full font-mono text-xs font-bold">
              <svg
                class="af-step-ring absolute inset-0 h-full w-full -rotate-90"
                viewBox="0 0 44 44"
                aria-hidden="true"
              >
                <circle cx="22" cy="22" r="20.5" fill="none" stroke-width="2" pathLength="100" />
              </svg>
              <span class="relative">{pad(index + 1)}</span>
            </span>
            <span class="af-step-label max-w-full truncate text-[10px] font-semibold sm:text-sm">
              {step.eyebrow}
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Inhalt -->
  <div
    class="mt-10 grid grid-cols-[minmax(0,1fr)] items-start gap-10 lg:mt-16 lg:grid-cols-[minmax(0,24rem)_minmax(0,1fr)] lg:gap-14 xl:grid-cols-[minmax(0,26rem)_minmax(0,1fr)]"
  >
    <!-- Text-Stapel -->
    <div class="af-stack order-2 lg:order-1">
      {
        steps.map((step, index) => (
          <div
            role="tabpanel"
            id={`${id}-panel-${index}`}
            aria-labelledby={`${id}-tab-${index}`}
            data-panel
            data-state={index === 0 ? 'active' : 'idle'}
            aria-hidden={index === 0 ? 'false' : 'true'}
            inert={index !== 0}
            class="af-text"
          >
            <p
              class="af-num font-mono text-4xl leading-none font-semibold tracking-tight sm:text-5xl"
              aria-hidden="true"
            >
              {pad(index + 1)}
            </p>
            <h3 class="font-display text-foreground mt-4 text-2xl font-bold tracking-tight text-balance sm:text-[1.75rem] sm:leading-tight">
              {step.title}
            </h3>
            <p class="text-foreground-muted mt-4 flex gap-2.5 text-[0.95rem] leading-6">
              <span class="af-before-pill mt-0.5 inline-flex h-fit shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold tracking-[0.14em] uppercase">
                <Icon name="x" size="xs" />
                Bisher
              </span>
              <span class="af-strike">{step.before}</span>
            </p>
            <div class="af-after mt-5 rounded-2xl p-5">
              <span class="af-after-pill inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-[11px] font-bold tracking-[0.14em] uppercase">
                <Icon name="check" size="xs" />
                Mit dem Baustein
              </span>
              <p class="text-foreground mt-3 text-base leading-7">{step.text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <!-- Bild-Stapel -->
    <div class="relative order-1 lg:order-2">
      <div
        class="af-glow pointer-events-none absolute -inset-8 rounded-[3rem] blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="af-stack relative touch-pan-y" data-swipe>
        {
          steps.map((step, index) => (
            <div
              data-shot
              data-state={index === 0 ? 'active' : 'idle'}
              aria-hidden={index === 0 ? 'false' : 'true'}
              inert={index !== 0}
              class="af-shot"
            >
              <ShotFrame
                image={step.image}
                alt={step.alt}
                url={step.url}
                fit="cover"
                ratio="16/10"
                motion="none"
                loading={index === 0 ? 'eager' : 'lazy'}
                sizes="(min-width: 1280px) 52rem, (min-width: 1024px) 44rem, 100vw"
                chips={step.chips}
              />
            </div>
          ))
        }
      </div>
      <!-- Vor/zurück: am Bildrand ab lg, darunter auf kleineren Bildschirmen -->
      <div
        class="af-nav mt-5 flex items-center justify-center gap-3 lg:pointer-events-none lg:absolute lg:inset-y-0 lg:-right-6 lg:-left-6 lg:mt-0 lg:justify-between"
      >
        <button
          type="button"
          data-prev
          class="af-arrow lg:pointer-events-auto"
          aria-label="Vorheriger Schritt"
        >
          <Icon name="chevron-left" size="md" />
        </button>
        <span class="text-foreground-muted font-mono text-xs tabular-nums lg:hidden" data-counter
          >01 / {pad(steps.length)}</span
        >
        <button
          type="button"
          data-next
          class="af-arrow lg:pointer-events-auto"
          aria-label="Nächster Schritt"
        >
          <Icon name="chevron-right" size="md" />
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  /* Stapel: alle Schritte in derselben Zelle */
  .af-stack {
    display: grid;
  }
  .af-stack > * {
    grid-area: 1 / 1;
    min-width: 0;
  }

  /* Stepper */
  .af-stepline {
    background: color-mix(in oklch, var(--color-foreground) 15%, transparent);
  }
  .af-step {
    color: var(--color-foreground-muted);
    transition: color 300ms ease-out;
  }
  @media (max-width: 639px) {
    .af-step-dot {
      height: 2.25rem;
      width: 2.25rem;
    }
  }
  .af-step-dot {
    background: var(--color-background);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-foreground) 18%, transparent);
    transition:
      background-color 300ms ease-out,
      color 300ms ease-out,
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .af-step-ring circle {
    stroke: var(--color-brand-300);
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  @media (hover: hover) {
    .af-step:hover {
      color: var(--color-foreground);
    }
  }
  .af-step:focus-visible {
    outline: 2px solid var(--color-brand-400);
    outline-offset: 4px;
    border-radius: 999px;
  }
  .af-step[aria-selected='true'] {
    color: var(--color-foreground);
  }
  .af-step[aria-selected='true'] .af-step-dot {
    background: var(--color-brand-500);
    color: white;
    transform: scale(1.06);
    box-shadow: 0 10px 30px -10px color-mix(in oklch, var(--color-brand-500) 80%, transparent);
  }
  /* Fortschritt im Ring, nur solange Autoplay läuft */
  .af-tabs[data-autoplay='on'] .af-step[aria-selected='true'] .af-step-ring circle {
    animation: af-ring var(--af-interval) linear forwards;
  }
  @keyframes af-ring {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Text */
  .af-strike {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in oklch, currentColor 40%, transparent);
  }
  .af-num {
    color: var(--color-brand-400);
  }
  .af-text {
    transition:
      opacity 400ms ease-out,
      transform 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .af-text[data-state='idle'] {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }
  .af-text[data-state='active'] {
    opacity: 1;
    transform: none;
    transition-delay: 120ms;
  }

  /* Screenshots: Richtung über data-dir am Wurzelelement */
  .af-shot {
    transition:
      opacity 500ms ease-out,
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }
  .af-shot[data-state='idle'] {
    opacity: 0;
    transform: translateX(8%) scale(0.96) rotate(0.6deg);
    pointer-events: none;
  }
  .af-tabs[data-dir='back'] .af-shot[data-state='idle'] {
    transform: translateX(-8%) scale(0.96) rotate(-0.6deg);
  }
  .af-shot[data-state='leaving'] {
    opacity: 0;
    transform: translateX(-8%) scale(0.96) rotate(-0.6deg);
    pointer-events: none;
  }
  .af-tabs[data-dir='back'] .af-shot[data-state='leaving'] {
    transform: translateX(8%) scale(0.96) rotate(0.6deg);
  }
  .af-shot[data-state='active'] {
    opacity: 1;
    transform: none;
    z-index: 1;
  }

  .af-arrow {
    display: inline-flex;
    height: 2.75rem;
    width: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    color: var(--color-foreground);
    background: color-mix(in oklch, var(--color-card) 85%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-foreground) 18%, transparent);
    box-shadow: 0 12px 30px -12px oklch(0% 0 0 / 0.5);
    backdrop-filter: blur(8px);
    transition:
      transform 200ms ease-out,
      background-color 200ms ease-out;
  }
  @media (hover: hover) {
    .af-arrow:hover {
      background: var(--color-brand-500);
      border-color: var(--color-brand-500);
      color: white;
    }
  }
  .af-arrow:active {
    transform: scale(0.94);
  }
  .af-arrow:focus-visible {
    outline: 2px solid var(--color-brand-400);
    outline-offset: 3px;
  }
  @media (min-width: 1024px) {
    .af-nav {
      z-index: 5;
    }
    .af-nav .af-arrow {
      align-self: center;
    }
  }

  .af-glow {
    background: radial-gradient(
      ellipse at 60% 40%,
      color-mix(in oklch, var(--color-brand-400) 35%, transparent),
      transparent 70%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .af-text,
    .af-shot,
    .af-step,
    .af-step-dot {
      transition: none;
    }
    .af-shot[data-state],
    .af-text[data-state] {
      transform: none !important;
    }
  }
</style>

<script>
  const centerInList = (tab: HTMLElement | undefined, smooth: boolean) => {
    const list = tab?.closest<HTMLElement>('[role=tablist]');
    if (!tab || !list || list.scrollWidth <= list.clientWidth) return;
    const t = tab.getBoundingClientRect();
    const l = list.getBoundingClientRect();
    list.scrollTo({
      left: list.scrollLeft + (t.left - l.left) - (l.width - t.width) / 2,
      behavior: smooth ? 'smooth' : 'auto',
    });
  };
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-panel]'));
    const shots = Array.from(root.querySelectorAll<HTMLElement>('[data-shot]'));
    const interval = Number(root.dataset.interval) || 7000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let current = 0;
    let timer: number | undefined;
    let leaveTimer: number | undefined;
    let autoplay = !reduced && root.dataset.autoplayEnabled === 'true';

    const select = (index: number, focus = false) => {
      if (index === current) return;
      root.dataset.dir = index > current ? 'forward' : 'back';
      const previous = current;
      current = index;

      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        const on = i === index;
        panel.dataset.state = on ? 'active' : 'idle';
        panel.setAttribute('aria-hidden', on ? 'false' : 'true');
        panel.toggleAttribute('inert', !on);
      });
      shots.forEach((shot, i) => {
        shot.dataset.state = i === index ? 'active' : i === previous ? 'leaving' : 'idle';
        shot.setAttribute('aria-hidden', i === index ? 'false' : 'true');
        shot.toggleAttribute('inert', i !== index);
      });
      window.clearTimeout(leaveTimer);
      leaveTimer = window.setTimeout(() => {
        shots.forEach((shot, i) => {
          if (i !== current) shot.dataset.state = 'idle';
        });
      }, 750);

      if (counter) counter.textContent = `${pad(index + 1)} / ${pad(tabs.length)}`;
      // Nur die Leiste scrollen, nie die Seite (Autoplay läuft auch, wenn man woanders liest).
      centerInList(tabs[index], !reduced);
      if (focus) tabs[index]?.focus();
      schedule();
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (!autoplay) return;
      // Ring-Animation neu starten
      root.dataset.autoplay = 'off';
      void root.offsetWidth;
      root.dataset.autoplay = 'on';
      timer = window.setTimeout(() => select((current + 1) % tabs.length), interval);
    };

    const stop = () => {
      autoplay = false;
      root.dataset.autoplay = 'off';
      window.clearTimeout(timer);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        stop();
        select(index);
      });
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        stop();
        select((index + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true);
      });
    });
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const pad = (n: number) => String(n).padStart(2, '0');
    const step = (delta: number) => {
      stop();
      select((current + delta + tabs.length) % tabs.length);
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => step(-1));
    root.querySelector('[data-next]')?.addEventListener('click', () => step(1));

    // Wischen auf dem Screenshot (Touch und Stift)
    const swipe = root.querySelector<HTMLElement>('[data-swipe]');
    let startX = 0;
    let startY = 0;
    swipe?.addEventListener('pointerdown', (e) => {
      startX = e.clientX;
      startY = e.clientY;
    });
    swipe?.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) step(dx < 0 ? 1 : -1);
    });

    root.addEventListener('pointerenter', (e) => {
      if ((e as PointerEvent).pointerType === 'mouse') stop();
    });

    if (autoplay && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting && autoplay) schedule();
            else {
              window.clearTimeout(timer);
              root.dataset.autoplay = 'off';
            }
          }
        },
        { threshold: 0.4 }
      );
      io.observe(root);
    }
  });
</script>
