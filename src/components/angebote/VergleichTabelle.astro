---
/**
 * Vergleichstabelle Word/Excel · Qwilr · PandaDoc · Angebotsmodul.
 *
 * Daten aus src/data/angebotVergleiche.ts. `kompakt` zeigt nur die Zeilen mit
 * `kurz: true` (Funnel-Seite), sonst alle (Vergleichsseiten). Auf schmalen
 * Viewports scrollt die Tabelle horizontal; die erste Spalte bleibt stehen,
 * damit das Merkmal beim Wischen lesbar bleibt.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import {
  STAND,
  vergleichSpalten,
  vergleichZeilen,
  type VergleichSpalte,
} from '@/data/angebotVergleiche';

interface Props {
  kompakt?: boolean;
  /** Spalte, die hervorgehoben wird — auf einer Vergleichsseite das verglichene Tool. */
  fokus?: VergleichSpalte;
  class?: string;
}

const { kompakt = false, fokus, class: className } = Astro.props;

const zeilen = kompakt ? vergleichZeilen.filter((z) => z.kurz) : vergleichZeilen;
const spalten: VergleichSpalte[] = ['office', 'qwilr', 'pandadoc', 'modul'];

function zellenArt(wert: string): 'ja' | 'nein' | 'text' {
  if (wert === '–') return 'nein';
  if (/^ja\b/i.test(wert)) return 'ja';
  return 'text';
}
---

<div class:list={['border-border bg-card overflow-x-auto rounded-2xl border shadow-sm', className]}>
  <table class="w-full min-w-[44rem] border-collapse text-sm">
    <thead>
      <tr class="border-border bg-background-secondary border-b">
        <th
          scope="col"
          class="bg-background-secondary text-foreground-muted sticky left-0 z-10 p-4 text-left text-xs font-semibold tracking-[0.18em] uppercase"
        >
          Merkmal
        </th>
        {
          spalten.map((spalte) => (
            <th
              scope="col"
              class:list={[
                'p-4 text-left text-xs font-semibold tracking-[0.18em] uppercase',
                spalte === 'modul' ? 'text-brand-600' : 'text-foreground-muted',
                spalte === fokus && 'text-foreground',
              ]}
            >
              {vergleichSpalten[spalte]}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        zeilen.map((zeile) => (
          <tr class="border-border border-b last:border-b-0">
            <th
              scope="row"
              class="bg-card text-foreground sticky left-0 z-10 p-4 text-left align-top font-semibold"
            >
              {zeile.merkmal}
            </th>
            {spalten.map((spalte) => {
              const wert = zeile[spalte];
              const art = zellenArt(wert);
              return (
                <td
                  class:list={[
                    'p-4 align-top leading-6',
                    spalte === 'modul'
                      ? 'bg-brand-500/5 text-foreground'
                      : 'text-foreground-secondary',
                  ]}
                >
                  {art === 'nein' ? (
                    <span class="text-foreground-muted" aria-label="nicht enthalten">
                      –
                    </span>
                  ) : art === 'ja' ? (
                    <span class="inline-flex items-start gap-1.5">
                      <Icon name="check" size="sm" class="text-brand-600 mt-0.5 shrink-0" />
                      <span>{wert.replace(/^ja,?\s*/i, '') || 'ja'}</span>
                    </span>
                  ) : (
                    wert
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="text-foreground-muted mt-3 text-xs leading-5">
  Angaben zu Qwilr und PandaDoc nach den Hersteller-Seiten, Stand {STAND}. Preise sind die jeweils
  günstigsten Tarife bei jährlicher Zahlung.
</p>
