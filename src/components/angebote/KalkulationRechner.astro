---
/**
 * Branchen-Umschalter für die Kalkulation: je Branche eine Beispielrechnung
 * (Eingaben → Regel → Preis, Kosten, was übrig bleibt, mit Ampel).
 *
 * WAI-ARIA-Tabs (Pfeiltasten, Home/End). Die Werte sind Beispielwerte und
 * stehen so auch im UI. Der Balken wächst beim Wechsel, ohne JS ist die erste
 * Branche sichtbar und vollständig.
 *
 * Entwurf 2026-10-16: Zwei Ansichten je Branche.
 *   - Unter lg eine kompakte Karte (`.kr-kompakt`): Zahlen als kleines Raster,
 *     die Regel in einem Satz, dann groß der Preis, direkt darunter die Knöpfe.
 *     Wer tippt, sieht die Wirkung, ohne zu scrollen. Die lange Karte war mobil
 *     drei Bildschirme hoch, und die Knöpfe lagen weit weg vom Ergebnis.
 *   - Ab lg die volle Karte (`.kr-card`) wie bisher, zweispaltig.
 *   Beide hängen an denselben data-Attributen, die Knöpfe stellen beide um.
 *
 * Seit 2026-10-22 dieselbe Fassung auf /angebote/ und /f/angebote/; im Funnel zeigt
 * `kontaktHref` aufs Quiz.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

export interface Rechnung {
  key: string;
  icon: string;
  branche: string;
  /** Vorschrift oder Norm, nach der dieses Gewerk rechnet. Optional: nicht jedes hat eine. */
  grundlage?: string;
  satz: string;
  /** `auto`: Wert berechnet das System (z. B. Fahrzeit), nicht von Hand. */
  eingaben: { label: string; wert: string; auto?: boolean }[];
  regel: string;
  ergebnis: { label: string; wert: string }[];
  kosten: string;
  db: string;
  dbProzent: number;
  ampel: 'gruen' | 'gelb' | 'rot';
  /** Hinweis unter der Rechnung, z. B. dass das die Beispielkalkulation im Screenshot ist. */
  hinweis?: string;
  /**
   * Stellschrauben, die der Leser umlegen kann. Je Gewerk die Größe, die dort
   * wirklich den Preis bewegt: eine Besetzung, eine Menge, ein Zuschlag. Jede
   * Option trägt ihr vollständiges Ergebnis, gerechnet wird nicht im Browser.
   */
  regler?: {
    label: string;
    optionen: {
      name: string;
      /** Kurzwert unter dem Namen, z. B. „124 €/h" oder „ab 500 Stk". */
      wert?: string;
      /** Überschreibt einzelne Eingabezeilen, Schlüssel ist das Label. */
      setzt?: Record<string, string>;
      preis?: string;
      /** Überschreibt die zweite Ergebniszeile, z. B. die Stundenzahl. */
      kennzahl?: string;
      kosten: string;
      db: string;
      dbProzent: number;
      ampel: 'gruen' | 'gelb' | 'rot';
    }[];
  };
}

interface Props {
  /** Ziel des Links „im Erstgespräch“; im Funnel das Quiz (#quiz), sonst das Formular (#kontakt). */
  kontaktHref?: string;
  rechnungen: Rechnung[];
  /** Rechengrößen, die in jedem Gewerk gleich funktionieren. Stehen einmal unter den Tabs. */
  gemeinsam?: { icon: string; titel: string; text: string }[];
}

const { rechnungen, gemeinsam = [], kontaktHref = '#kontakt' } = Astro.props;
// Dieselben Texte stehen unten im Script (für den Wechsel per Knopf).
const ampelText = {
  gruen: 'Lohnt sich',
  gelb: 'Knapp. Erst freigeben lassen',
  rot: 'Zu wenig übrig. Geht so nicht raus',
};
// Einmal rendern, in jeder Karte als Footer ausgeben (ein Slot lässt sich nicht mehrfach einsetzen).
const hinweis = Astro.slots.has('hinweis') ? await Astro.slots.render('hinweis') : '';
---

<div class="kr" data-kr data-szene>
  <!-- Nicht sticky: auf dem Handy lag die Leiste über Eingaben und Ergebnis. -->
  <div class="kr-tabs mx-auto max-w-full rounded-2xl p-1.5 lg:w-fit">
    <div role="tablist" aria-label="Beispiele nach Branche" class="grid grid-cols-2 gap-1 lg:flex">
      {
        rechnungen.map((r, i) => (
          <button
            type="button"
            role="tab"
            id={`kr-tab-${r.key}`}
            aria-controls={`kr-panel-${r.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="kr-tab flex min-w-0 items-center justify-center gap-2 rounded-xl px-2.5 py-2.5 text-center text-[0.8rem] leading-tight font-semibold lg:shrink-0 lg:px-4 lg:text-sm lg:whitespace-nowrap"
          >
            <Icon name={r.icon} size="sm" />
            {r.branche}
          </button>
        ))
      }
    </div>
  </div>

  <p class="text-foreground-muted mt-4 text-center text-sm">
    Eure Branche ist nicht dabei? Kein Problem, das klären wir{' '}
    <a
      href={kontaktHref}
      class="text-brand-600 hover:text-brand-700 dark:text-brand-300 font-semibold underline-offset-4 hover:underline"
      >im Erstgespräch</a
    >.
  </p>

  <div class="kr-stage mt-8 grid">
    {
      rechnungen.map((r, i) => (
        <div
          role="tabpanel"
          id={`kr-panel-${r.key}`}
          aria-labelledby={`kr-tab-${r.key}`}
          data-active={i === 0 ? 'true' : 'false'}
          hidden={i !== 0}
          class="kr-panel"
          style={`--db: ${r.dbProzent}%`}
          data-optionen={r.regler ? JSON.stringify(r.regler.optionen) : undefined}
          data-basis={JSON.stringify({
            preis: r.ergebnis[0]?.wert ?? '',
            kennzahl: r.ergebnis[1]?.wert ?? '',
            kosten: r.kosten,
            db: r.db,
            dbProzent: r.dbProzent,
            ampel: r.ampel,
          })}
        >
          {/* ───── Kompakt, unter lg ───── */}
          <div class="kr-kompakt overflow-hidden rounded-[1.5rem] lg:hidden">
            <div class="p-5">
              <div class="flex items-center justify-between gap-3">
                <p class="kr-label">Eure Zahlen</p>
                <span class="kr-sample rounded-full px-2 py-0.5 text-[10px] font-semibold tracking-[0.12em] uppercase">
                  Beispiel
                </span>
              </div>
              <p class="font-display text-foreground mt-2 text-lg leading-snug font-bold tracking-tight text-balance">
                {r.satz}
              </p>
              <dl class="mt-4 grid grid-cols-2 gap-1.5">
                {r.eingaben.map((e) => (
                  <div
                    class="kr-k-row rounded-lg px-2.5 py-2"
                    style={`--d: ${r.eingaben.indexOf(e) * 60}ms`}
                    data-eingabe={e.label}
                  >
                    <dt class="text-foreground-muted text-[11px] leading-4">
                      {e.label}
                      {e.auto && (
                        <>
                          <Icon
                            name="zap"
                            size="xs"
                            class="text-brand-500 ml-1 inline-block align-[-2px]"
                          />
                          <span class="sr-only">berechnet</span>
                        </>
                      )}
                    </dt>
                    <dd
                      class="text-foreground mt-0.5 font-mono text-sm font-semibold tabular-nums"
                      data-eingabe-wert
                    >
                      {e.wert}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>

            <div class="kr-k-regel flex items-start gap-3 px-5 py-3">
              <span class="kr-link-dot flex h-8 w-8 shrink-0 items-center justify-center rounded-full">
                <Icon name="zap" size="xs" />
              </span>
              <p class="text-foreground-secondary text-xs leading-5">
                <span class="text-foreground block text-[11px] font-semibold tracking-[0.14em] uppercase">
                  Eure Regel
                </span>
                {r.regel}
              </p>
            </div>

            <div class="kr-result p-5">
              <p class="kr-label">Ergebnis</p>
              <div class="mt-2 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <p class="text-foreground-secondary text-sm">{r.ergebnis[0]?.label}</p>
                <p
                  class="font-display text-foreground text-3xl font-bold tracking-tight tabular-nums"
                  data-preis
                >
                  {r.ergebnis[0]?.wert}
                </p>
              </div>
              {r.ergebnis[1] && (
                <div class="mt-1 flex items-baseline justify-between gap-4">
                  <p class="text-foreground-secondary text-sm">{r.ergebnis[1].label}</p>
                  <p
                    class="text-foreground font-mono text-sm font-semibold tabular-nums"
                    data-kennzahl
                  >
                    {r.ergebnis[1].wert}
                  </p>
                </div>
              )}
              <div class="mt-1 flex items-baseline justify-between gap-4">
                <p class="text-foreground-secondary text-sm">Kosten</p>
                <p class="text-foreground font-mono text-sm font-semibold tabular-nums" data-kosten>
                  {r.kosten}
                </p>
              </div>

              <div class="kr-db mt-4 rounded-2xl p-3.5" data-ampel={r.ampel}>
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <p class="text-foreground text-sm font-semibold">Bleibt übrig</p>
                  <p
                    class="text-foreground font-mono text-sm font-bold whitespace-nowrap tabular-nums"
                    data-db
                  >
                    {r.db} · {r.dbProzent} %
                  </p>
                </div>
                <div class="kr-bar mt-2.5 h-2 overflow-hidden rounded-full" aria-hidden="true">
                  <span class="kr-bar-fill block h-full rounded-full" />
                </div>
                <p
                  class="kr-ampel mt-2.5 inline-flex items-center gap-2 text-xs font-semibold"
                  data-ampeltext
                >
                  <span class="kr-dot" aria-hidden="true" />
                  {ampelText[r.ampel]}
                </p>
              </div>

              {r.regler && (
                <div class="kr-swap mt-4 rounded-2xl p-3.5">
                  <p class="text-foreground-muted text-[11px] font-semibold tracking-[0.14em] uppercase">
                    Probiert es: {r.regler.label}
                  </p>
                  <div class="mt-2.5 grid gap-2" role="group" aria-label={r.regler.label}>
                    {r.regler.optionen.map((o, k) => (
                      <button
                        type="button"
                        class="kr-swap-btn kr-swap-btn-row rounded-xl px-3 py-2.5 text-left"
                        data-swap={String(k)}
                        aria-pressed={k === 0 ? 'true' : 'false'}
                      >
                        <span class="text-foreground text-sm font-semibold">{o.name}</span>
                        {o.wert && (
                          <span class="text-foreground-muted font-mono text-xs">{o.wert}</span>
                        )}
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </div>
            {hinweis && (
              <div class="kr-hinweis flex gap-3 px-5 py-4">
                <Icon name="info" size="sm" class="text-brand-500 mt-0.5 shrink-0" />
                <div
                  class="text-foreground-secondary text-[0.85rem] leading-6"
                  set:html={hinweis}
                />
              </div>
            )}
          </div>

          {/* ───── Volle Karte, ab lg ───── */}
          <div class="kr-card relative hidden overflow-hidden rounded-[1.75rem] lg:grid lg:grid-cols-2">
            <span class="kr-sample absolute top-4 right-4 z-10 rounded-full px-2.5 py-1 text-[10px] font-semibold tracking-[0.14em] uppercase">
              Frei erfunden
            </span>
            {/* Eingaben */}
            <div class="kr-eingaben p-8 lg:pr-14">
              <p class="kr-label">Eure Zahlen</p>
              {r.grundlage && (
                <p class="kr-grundlage mt-3 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1">
                  <Icon name="book" size="xs" />
                  {r.grundlage}
                </p>
              )}
              <p class="font-display text-foreground mt-2 text-2xl font-bold tracking-tight">
                {r.satz}
              </p>
              <dl class="mt-6 space-y-2">
                {r.eingaben.map((e, j) => (
                  <div class="kr-row" style={`--d: ${j * 60}ms`} data-eingabe={e.label}>
                    <dt class="text-foreground-secondary flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                      {e.label}
                      {e.auto && (
                        <span class="kr-auto inline-flex items-center gap-1 rounded-full px-1.5 py-px text-[10px] font-semibold tracking-wide uppercase">
                          <Icon name="zap" size="xs" />
                          berechnet
                        </span>
                      )}
                    </dt>
                    <dd
                      class="text-foreground font-mono text-sm font-semibold whitespace-nowrap tabular-nums"
                      data-eingabe-wert
                    >
                      {e.wert}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>

            {/* Stellschrauben unter den Eingaben */}
            {r.regler && (
              <div class="kr-swap-wrap px-8 pb-8 lg:pr-14">
                <div class="kr-swap mt-5 rounded-2xl p-4">
                  <p class="text-foreground-muted text-[11px] font-semibold tracking-[0.14em] uppercase">
                    Probiert es: {r.regler.label}
                  </p>
                  <div class="mt-2.5 flex flex-wrap gap-2" role="group" aria-label={r.regler.label}>
                    {r.regler.optionen.map((o, k) => (
                      <button
                        type="button"
                        class="kr-swap-btn flex-1 rounded-xl px-3 py-2 text-left"
                        data-swap={String(k)}
                        aria-pressed={k === 0 ? 'true' : 'false'}
                      >
                        <span class="text-foreground block text-sm font-semibold">{o.name}</span>
                        {o.wert && (
                          <span class="text-foreground-muted block font-mono text-xs">
                            {o.wert}
                          </span>
                        )}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {/* Regel: Knoten auf der Trennlinie zwischen Eingaben und Ergebnis */}
            <div class="kr-link" aria-hidden="true">
              <span class="kr-link-dot flex h-12 w-12 items-center justify-center rounded-full">
                <Icon name="zap" size="sm" />
              </span>
              <span class="kr-link-label rounded-full px-2.5 py-0.5 text-[10px] font-semibold tracking-[0.14em] uppercase">
                Eure Regel
              </span>
            </div>

            {/* Ergebnis */}
            <div class="kr-result p-8 lg:pl-14">
              <p class="kr-label">Ergebnis</p>
              <p class="text-foreground-muted mt-2 text-xs leading-5 lg:pr-24">{r.regel}</p>
              <dl class="mt-5 space-y-3">
                {r.ergebnis.map((e, j) => (
                  <div class="flex items-baseline justify-between gap-4">
                    <dt class="text-foreground-secondary text-sm">{e.label}</dt>
                    <dd
                      class:list={[
                        'text-foreground font-bold tabular-nums',
                        j === 0 ? 'font-display text-4xl tracking-tight' : 'font-mono text-base',
                      ]}
                      data-preis={j === 0 ? '' : undefined}
                      data-kennzahl={j === 1 ? '' : undefined}
                    >
                      {e.wert}
                    </dd>
                  </div>
                ))}
                <div class="flex items-baseline justify-between gap-4">
                  <dt class="text-foreground-secondary text-sm">Kosten</dt>
                  <dd
                    class="text-foreground font-mono text-base font-semibold tabular-nums"
                    data-kosten
                  >
                    {r.kosten}
                  </dd>
                </div>
              </dl>

              <div class="kr-db mt-6 rounded-2xl p-4" data-ampel={r.ampel}>
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <p class="text-foreground text-sm font-semibold">
                    Bleibt übrig{' '}
                    <span class="text-foreground-muted font-normal">(Deckungsbeitrag)</span>
                  </p>
                  <p
                    class="text-foreground font-mono text-sm font-bold whitespace-nowrap tabular-nums"
                    data-db
                  >
                    {r.db} · {r.dbProzent} %
                  </p>
                </div>
                <div class="kr-bar mt-3 h-2 overflow-hidden rounded-full" aria-hidden="true">
                  <span class="kr-bar-fill block h-full rounded-full" />
                </div>
                <p
                  class="kr-ampel mt-3 inline-flex items-center gap-2 text-xs font-semibold"
                  data-ampeltext
                >
                  <span class="kr-dot" aria-hidden="true" />
                  {ampelText[r.ampel]}
                </p>
              </div>
            </div>
            {/* Footer der Karte: Einordnung der Beispielwerte (Slot „hinweis“ der Seite) */}
            {hinweis && (
              <div class="kr-hinweis flex gap-3 px-8 py-4 lg:col-span-2">
                <Icon name="info" size="sm" class="text-brand-500 mt-0.5 shrink-0" />
                <div
                  class="text-foreground-secondary text-[0.85rem] leading-6"
                  set:html={hinweis}
                />
              </div>
            )}
          </div>
        </div>
      ))
    }
  </div>

  {
    gemeinsam.length > 0 && (
      <div class="kr-shared mt-10">
        <div class="flex items-center gap-4">
          <span class="kr-rule h-px flex-1" aria-hidden="true" />
          <p class="text-foreground-muted font-mono text-xs font-semibold tracking-[0.2em] whitespace-nowrap uppercase">
            Das rechnet bei jedem mit
          </p>
          <span class="kr-rule kr-rule-r h-px flex-1" aria-hidden="true" />
        </div>
        <ul class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
          {gemeinsam.map((g) => (
            <li>
              <p class="font-display text-foreground flex items-center gap-2 text-sm font-bold tracking-tight">
                <Icon name={g.icon} size="sm" class="text-brand-500 shrink-0" />
                {g.titel}
              </p>
              <p class="text-foreground-secondary mt-2 hidden text-sm leading-6 sm:block">
                {g.text}
              </p>
            </li>
          ))}
        </ul>
        <p class="text-foreground-muted mt-7 text-center text-sm">
          Einmal nach euren Regeln gebaut. Dann gilt es für jede Leistung.
        </p>
      </div>
    )
  }
</div>

<style>
  .kr-tabs {
    /* Klebt mobil oben; deshalb deckend statt transparent, sonst scheint der
       Inhalt durch. Ab sm steht die Leiste wieder normal im Fluss. */
    background: color-mix(in oklch, var(--color-foreground) 5%, var(--color-background));
    border: 1px solid var(--color-border);
  }
  @media (min-width: 1024px) {
    .kr-tabs {
      background: color-mix(in oklch, var(--color-foreground) 5%, transparent);
    }
  }
  .kr-auto {
    color: var(--color-brand-700);
    background: color-mix(in oklch, var(--color-brand-500) 12%, transparent);
  }
  :global(.dark) .kr-auto {
    color: var(--color-brand-200);
  }
  .kr-tab {
    color: var(--color-foreground-secondary);
    transition:
      color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease;
  }
  @media (hover: hover) {
    .kr-tab:hover {
      color: var(--color-foreground);
    }
  }
  .kr-tab[aria-selected='true'] {
    color: var(--color-foreground);
    background: var(--color-card);
    box-shadow: 0 6px 18px -10px oklch(30% 0.06 265 / 0.45);
  }
  .kr-tab[aria-selected='true'] :global(svg) {
    color: var(--color-brand-500);
  }
  .kr-tab:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
  }

  .kr-stage > .kr-panel {
    grid-area: 1 / 1;
  }
  .kr-panel[data-active='true'] {
    animation: kr-in 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes kr-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  /* Kompakte Karte (unter lg) */
  .kr-kompakt {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 24px 55px -36px oklch(30% 0.08 265 / 0.55);
  }
  .kr-k-row {
    background: color-mix(in oklch, var(--color-foreground) 4%, transparent);
  }
  .kr-k-regel {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-brand-500) 5%, transparent);
  }
  .kr-kompakt .kr-link-dot {
    box-shadow: 0 8px 18px -8px var(--color-brand-500);
  }
  .kr-kompakt .kr-link-dot::after {
    display: none;
  }

  .kr-hinweis {
    order: 10; /* immer zuletzt */
    border-top: 1px solid var(--color-border);
    background: color-mix(in oklch, var(--color-brand-500) 4%, var(--color-card));
  }
  .kr-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 30px 70px -40px oklch(30% 0.08 265 / 0.55);
  }
  .kr-sample {
    color: var(--color-foreground-muted);
    background: var(--color-card);
    border: 1px dashed var(--color-border-strong, var(--color-border));
  }
  .kr-grundlage {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-brand-700);
    background: color-mix(in oklch, var(--color-brand-500) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--color-brand-400) 35%, transparent);
  }
  :global(.dark) .kr-grundlage {
    color: var(--color-brand-200);
  }
  .kr-rule {
    background: linear-gradient(to right, transparent, var(--color-border));
  }
  .kr-rule-r {
    background: linear-gradient(to left, transparent, var(--color-border));
  }
  /* Volle Karte: Stellschrauben unter den Eingaben in der linken Spalte */
  .kr-swap-wrap {
    grid-column: 1;
    grid-row: 2;
    margin-top: -1rem;
    align-self: start;
  }
  .kr-swap {
    background: color-mix(in oklch, var(--color-brand-500) 5%, transparent);
    border: 1px dashed color-mix(in oklch, var(--color-brand-400) 45%, var(--color-border));
  }
  .kr-swap-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    flex: 1 1 auto;
    min-width: max-content;
    white-space: nowrap;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  /* Kompakt: Name links, Kurzwert rechts auf einer Zeile */
  .kr-swap-btn-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
  }
  .kr-swap-btn[aria-pressed='true'] {
    border-color: var(--color-brand-400);
    box-shadow: 0 0 0 2px color-mix(in oklch, var(--color-brand-500) 22%, transparent);
  }
  @media (hover: hover) {
    .kr-swap-btn:hover {
      border-color: var(--color-brand-300);
    }
  }
  .kr-swap-btn:focus-visible {
    outline: 2px solid var(--color-brand-500);
    outline-offset: 2px;
  }
  .kr-label {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-brand-600);
  }
  :global(.dark) .kr-label {
    color: var(--color-brand-300);
  }

  .kr-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0.85rem;
    border-radius: 0.75rem;
    background: color-mix(in oklch, var(--color-foreground) 4%, transparent);
  }
  :global(html.szenen-ready)
    .kr:not([data-szene='an'])
    :is(.kr-row, .kr-k-row, .kr-bar-fill, .kr-db, .kr-swap) {
    opacity: 0;
  }
  .kr[data-szene='an'] .kr-panel[data-active='true'] :is(.kr-row, .kr-k-row) {
    animation: kr-row 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }
  .kr[data-szene='an'] .kr-panel[data-active='true'] :is(.kr-db, .kr-swap) {
    animation: kr-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.6s;
  }
  @keyframes kr-row {
    from {
      opacity: 0;
      transform: translateX(-8px);
    }
  }

  /* Regel-Knoten der vollen Karte: mittig auf der Trennlinie */
  .kr-link {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .kr-link-dot {
    position: relative;
    color: #fff;
    background: var(--color-brand-500);
    box-shadow:
      0 0 0 6px var(--color-card),
      0 14px 30px -10px var(--color-brand-500);
  }
  .kr-link-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 2px solid var(--color-brand-400);
    animation: kr-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes kr-ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.7);
      opacity: 0;
    }
  }
  .kr-link-label {
    color: var(--color-brand-700);
    background: var(--color-card);
    border: 1px solid color-mix(in oklch, var(--color-brand-400) 45%, var(--color-border));
  }
  :global(.dark) .kr-link-label {
    color: var(--color-brand-200);
  }

  .kr-eingaben {
    grid-column: 1;
    grid-row: 1;
  }
  .kr-result {
    background:
      radial-gradient(
        120% 80% at 100% 0%,
        color-mix(in oklch, var(--color-brand-400) 14%, transparent),
        transparent 60%
      ),
      color-mix(in oklch, var(--color-brand-500) 3%, var(--color-card));
  }
  .kr-card .kr-result {
    grid-column: 2;
    grid-row: 1 / span 2;
    border-left: 1px solid var(--color-border);
  }

  .kr-db {
    --ok: oklch(68% 0.15 150);
    --warn: oklch(78% 0.15 80);
    --bad: oklch(63% 0.2 25);
    background: var(--color-card);
    border: 1px solid var(--color-border);
  }
  .kr-db[data-ampel='gelb'] {
    --ok: var(--warn);
  }
  .kr-db[data-ampel='rot'] {
    --ok: var(--bad);
  }
  .kr-bar {
    background: color-mix(in oklch, var(--color-foreground) 8%, transparent);
  }
  .kr-bar-fill {
    width: var(--db);
    background: var(--ok);
  }
  .kr[data-szene='an'] .kr-panel[data-active='true'] .kr-bar-fill {
    animation: kr-bar 0.9s 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes kr-bar {
    from {
      width: 0;
    }
  }
  .kr-ampel {
    color: var(--color-foreground-secondary);
  }
  .kr-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--ok);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--ok) 25%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .kr-link-dot::after {
      animation: none;
      opacity: 0;
    }
    .kr-panel[data-active='true'],
    .kr-panel[data-active='true'] .kr-row,
    .kr-panel[data-active='true'] .kr-bar-fill {
      animation: none;
    }
  }
</style>

<script>
  import { szenenStarten, hochzaehlen } from '@/lib/szene';

  document.querySelectorAll<HTMLElement>('[data-kr]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role=tabpanel]')];
    const bewegt = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Der Preis zählt hoch, wenn die Szene anläuft und bei jedem Tabwechsel.
    const zaehlen = (panel: HTMLElement) => {
      if (!bewegt) return;
      panel.querySelectorAll<HTMLElement>('[data-preis]').forEach((el) => hochzaehlen(el, 900));
    };
    root.addEventListener('szene:an', () => {
      const aktiv = panels.find((p) => p.dataset.active === 'true');
      if (aktiv) zaehlen(aktiv);
    });

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        const panel = panels[i];
        if (!panel) return;
        panel.hidden = !on;
        panel.dataset.active = on ? 'true' : 'false';
        if (on && root.dataset.szene === 'an') zaehlen(panel);
      });
      if (focus) tabs[index]?.focus();
    };

    // Stellschrauben je Panel: Option wählen, alle abhängigen Werte nachziehen.
    // Gerechnet wird nichts im Browser — jede Option bringt ihr fertiges Ergebnis mit.
    // Jeder Wert steht zweimal im Panel (kompakte und volle Karte), deshalb überall
    // querySelectorAll.
    panels.forEach((panel) => {
      const btns = [...panel.querySelectorAll<HTMLButtonElement>('[data-swap]')];
      if (!btns.length) return;

      type Option = {
        setzt?: Record<string, string>;
        preis?: string;
        kennzahl?: string;
        kosten: string;
        db: string;
        dbProzent: number;
        ampel: string;
      };
      let optionen: Option[] = [];
      let basis: (Option & { preis: string; kennzahl: string }) | null = null;
      try {
        optionen = JSON.parse(panel.dataset.optionen ?? '[]');
        basis = JSON.parse(panel.dataset.basis ?? 'null');
      } catch {
        return;
      }
      if (!optionen.length || !basis) return;

      const alle = (sel: string) => [...panel.querySelectorAll<HTMLElement>(sel)];
      const preisEls = alle('[data-preis]');
      const kennzahlEls = alle('[data-kennzahl]');
      const kostenEls = alle('[data-kosten]');
      const dbEls = alle('[data-db]');
      const ampelEls = alle('[data-ampeltext]');
      const boxes = alle('.kr-db');
      const texte: Record<string, string> = {
        gruen: 'Lohnt sich',
        gelb: 'Knapp. Erst freigeben lassen',
        rot: 'Zu wenig übrig. Geht so nicht raus',
      };
      // Ausgangswerte der Eingabezeilen merken, damit eine andere Option sie zurücksetzt.
      const zeilen: { label: string; el: HTMLElement; start: string }[] = [];
      panel.querySelectorAll<HTMLElement>('[data-eingabe]').forEach((row) => {
        const wert = row.querySelector<HTMLElement>('[data-eingabe-wert]');
        const label = row.dataset.eingabe;
        if (wert && label) zeilen.push({ label, el: wert, start: wert.textContent ?? '' });
      });

      const apply = (i: number) => {
        const o = optionen[i];
        if (!o || !basis) return;
        const b = basis;
        preisEls.forEach((el) => (el.textContent = o.preis ?? b.preis));
        kennzahlEls.forEach((el) => (el.textContent = o.kennzahl ?? b.kennzahl));
        kostenEls.forEach((el) => (el.textContent = o.kosten));
        dbEls.forEach((el) => (el.textContent = `${o.db} · ${o.dbProzent} %`));
        ampelEls.forEach((el) => {
          const dot = el.querySelector('.kr-dot');
          el.textContent = texte[o.ampel] ?? '';
          if (dot) el.prepend(dot);
        });
        boxes.forEach((box) => (box.dataset.ampel = o.ampel));
        panel.style.setProperty('--db', `${o.dbProzent}%`);
        zeilen.forEach(({ label, el, start }) => {
          el.textContent = o.setzt?.[label] ?? start;
        });
        btns.forEach((b) =>
          b.setAttribute('aria-pressed', b.dataset.swap === String(i) ? 'true' : 'false')
        );
      };

      btns.forEach((b) => b.addEventListener('click', () => apply(Number(b.dataset.swap))));
    });

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next =
          e.key === 'ArrowRight'
            ? (i + 1) % tabs.length
            : e.key === 'ArrowLeft'
              ? (i - 1 + tabs.length) % tabs.length
              : e.key === 'Home'
                ? 0
                : e.key === 'End'
                  ? last
                  : -1;
        if (next < 0) return;
        e.preventDefault();
        select(next, true);
      });
    });
  });
  szenenStarten();
</script>
