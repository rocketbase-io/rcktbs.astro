---
/**
 * Figure - Bild mit Bildunterschrift für MDX-Beiträge.
 *
 * Nutzt Astros <Image> für responsive Varianten und Lazy-Loading. Die
 * Bildunterschrift ist Teil des Inhalts, nicht Dekoration: Sie soll erklären,
 * was auf dem Screenshot zu sehen ist und warum es die Aussage des Absatzes
 * stützt - auch für Leser, die das Bild nicht laden.
 *
 * Verwendung in MDX:
 *   import Figure from '@/components/blog/Figure.astro';
 *   import shot from '@/assets/references/fkc-proposal-calculate.png';
 *
 *   <Figure src={shot} alt="..." caption="..." source="FKC Consulting" />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  /** Bild. Fehlt es noch, rendert die Komponente einen Platzhalter mit `todo`. */
  src?: ImageMetadata;
  /** Bildbeschreibung für Screenreader - beschreibt, was zu sehen ist. */
  alt: string;
  /** Sichtbare Unterschrift. Erklärt die Relevanz, wiederholt nicht den Alt-Text. */
  caption?: string;
  /** Herkunftsangabe, z.B. der Kunde, aus dessen System der Screenshot stammt. */
  source?: string;
  /**
   * Detailreiche Oberflächen sind im Textsatz nie vollständig lesbar. Statt das
   * Bild über die Textbreite hinaus zu ziehen (was die Seite dominiert, ohne
   * lesbar zu werden), bleibt es in der Spalte und lässt sich per Klick auf
   * volle Fenstergröße öffnen.
   */
  zoom?: boolean;
  /** Aufnahme-Anweisung, erscheint nur im Platzhalter (wenn kein src gesetzt ist). */
  todo?: string;
  /** Seitenverhältnis des Platzhalters. */
  ratio?: '16/9' | '4/3';
}

const { src, alt, caption, source, zoom = true, todo, ratio = '16/9' } = Astro.props;
const ratioClass = ratio === '4/3' ? 'aspect-[4/3]' : 'aspect-video';
---

<figure class="not-prose my-10" data-reveal="fade-up">
  {
    src ? (
      <div class="border-border bg-background-secondary group relative overflow-hidden rounded-2xl border shadow-[0_18px_45px_rgba(34,43,74,0.10)] dark:shadow-[0_18px_45px_rgba(0,0,0,0.45)]">
        <Image
          src={src}
          alt={alt}
          widths={[640, 960, 1456]}
          sizes="(min-width: 768px) 44rem, 100vw"
          loading="lazy"
          decoding="async"
          class="block h-auto w-full"
        />
        {zoom && (
          <button
            type="button"
            class="absolute inset-0 flex cursor-zoom-in items-end justify-end p-3 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-brand-500"
            data-figure-zoom
            data-figure-src={src.src}
            data-figure-alt={alt}
            aria-label={`Vergrößern: ${alt}`}
          >
            <span class="bg-background/85 text-foreground-secondary border-border pointer-events-none inline-flex items-center gap-1.5 rounded-lg border px-2.5 py-1.5 text-xs font-semibold opacity-0 backdrop-blur transition-opacity group-hover:opacity-100 group-focus-within:opacity-100">
              <Icon name="search" size="xs" />
              Vergrößern
            </span>
          </button>
        )}
      </div>
    ) : (
      <div
        class={`border-border bg-background-secondary text-foreground-muted flex ${ratioClass} flex-col items-center justify-center gap-3 rounded-2xl border border-dashed p-8 text-center`}
      >
        <span class="text-brand-500">
          <Icon name="image" size="lg" />
        </span>
        <p class="text-foreground font-display text-base font-semibold">Screenshot folgt</p>
        {todo && <p class="max-w-md text-sm leading-6">{todo}</p>}
      </div>
    )
  }
  {
    (caption || source) && (
      <figcaption class="text-foreground-muted mt-3 text-sm leading-6">
        {caption}
        {source && (
          <span class="text-foreground-subtle">
            {caption ? ' ' : ''}
            (Quelle: {source})
          </span>
        )}
      </figcaption>
    )
  }
</figure>

<script>
  // Lightbox einmal pro Seite aufbauen, egal wie viele Figures eingebunden sind.
  // Nutzt <dialog>: Fokusfalle, Escape-Schliessen und Backdrop kommen vom Browser.
  (function () {
    if (document.querySelector('[data-figure-lightbox]')) return;

    const dialog = document.createElement('dialog');
    dialog.setAttribute('data-figure-lightbox', '');
    dialog.className =
      'backdrop:bg-black/70 bg-transparent p-0 max-w-[96vw] max-h-[94vh] w-auto';
    dialog.innerHTML =
      '<div class="relative">' +
      '<img alt="" class="block max-h-[88vh] max-w-[96vw] rounded-xl object-contain shadow-2xl" />' +
      '<button type="button" data-figure-close aria-label="Schließen" ' +
      'class="absolute -top-3 -right-3 grid h-9 w-9 place-items-center rounded-full border border-white/20 bg-neutral-900 text-white shadow-lg">✕</button>' +
      '</div>';
    document.body.appendChild(dialog);

    const img = dialog.querySelector('img');
    if (!img) return;

    document.addEventListener('click', function (e) {
      const trigger = e.target instanceof Element ? e.target.closest('[data-figure-zoom]') : null;
      if (trigger) {
        img.src = trigger.getAttribute('data-figure-src') || '';
        img.alt = trigger.getAttribute('data-figure-alt') || '';
        dialog.showModal();
        return;
      }
      // Klick auf den Hintergrund oder den Schliessen-Knopf beendet die Ansicht.
      if (dialog.open && e.target instanceof Element) {
        if (e.target.closest('[data-figure-close]') || e.target === dialog) dialog.close();
      }
    });

    dialog.addEventListener('close', function () {
      img.removeAttribute('src');
    });
  })();
</script>
