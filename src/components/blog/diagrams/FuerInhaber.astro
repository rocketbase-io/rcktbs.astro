---
/**
 * Kurzfassung für Inhaber und Geschäftsführer im Software-Check-Artikel: drei Folgen statt
 * Technik. Steht direkt unter „Auf einen Blick“, damit Leser, die nur überfliegen, die
 * Aussage mitnehmen. Inhalt ist eine Übersetzung der freigegebenen Befunde, nichts Neues.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

const folgen = [
  { icon: 'users', text: 'Zwei Kunden hätten dasselbe letzte Stück zugesagt bekommen.' },
  { icon: 'alert-triangle', text: 'Geld hätte doppelt das Haus verlassen können.' },
  { icon: 'eye-off', text: 'Einen Ausfall hätte niemand bemerkt, bis ein Kunde anruft.' },
];
---

<aside class="not-prose my-10 rounded-2xl border border-amber-500/40 bg-amber-500/10 p-5 sm:p-7">
  <p class="text-xs font-semibold tracking-[0.14em] text-amber-700 uppercase dark:text-amber-400">Für Inhaber, in 30 Sekunden</p>
  <p class="font-display text-foreground mt-2 text-xl leading-snug font-bold text-balance sm:text-2xl">
    Die Software lief und war ordentlich gebaut. Trotzdem:
  </p>
  <ul class="mt-5 grid gap-3 sm:grid-cols-3 sm:gap-4">
    {
      folgen.map((f) => (
        <li class="bg-background/70 border-border flex gap-3 rounded-xl border p-4 sm:flex-col">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-500/15 text-amber-700 dark:text-amber-400">
            <Icon name={f.icon} size="md" />
          </span>
          <span class="text-foreground text-[0.95rem] leading-6 font-semibold">{f.text}</span>
        </li>
      ))
    }
  </ul>
  <p class="text-foreground-secondary mt-5 text-sm leading-6">
    Nichts davon findet ein Scanner. Der Rest des Beitrags erklärt, warum das so ist,
    und ist eher für die Technik im Haus geschrieben.
  </p>
</aside>
