---
/** Was ein Kunde nach dem Check bekommt: Bericht, Abschlusstermin, Papier zum Betrieb, dazu eine Reihenfolge. Ohne Inhalte. */
const dokumente = [
  {
    titel: 'Bericht',
    umfang: 'rund 10 Seiten',
    text: 'Ergebnis in Kürze, je System: was hält, was vor dem Go-live nötig ist, weitere Befunde. Jeder Befund mit Fundstelle und einem Auftrag, den das Team so an Claude geben kann.',
  },
  {
    titel: 'Abschlusstermin',
    umfang: '1,5 Stunden',
    text: 'Die wichtigsten Befunde live vorgeführt, Fragen zum Bericht, die Reihenfolge gemeinsam festgelegt.',
  },
  {
    titel: 'Papier zum Betrieb',
    umfang: 'ergänzend',
    text: 'Themen, die im Code nicht zu sehen sind und erst im Betrieb auffallen: Datenmodell, Mailweg, ein Protokoll der Vorgänge.',
  },
];
const reihenfolge = [
  { wann: 'Sofort', was: 'Was Geld oder Daten dauerhaft beschädigen kann', n: 3 },
  { wann: 'Vor dem Go-live', was: 'Geringer Aufwand, wenige Tage je System', n: 8 },
  { wann: 'Vor dem Go-live', was: 'Größerer Umfang: Auslieferung, Alarmierung, Härtung', n: 5 },
  { wann: 'Danach', was: 'Löschkonzept, kleinere Härtungen', n: 2 },
];
---

<figure class="not-prose my-10">
  <p class="text-brand-600 dark:text-brand-300 text-xs font-semibold tracking-[0.14em] uppercase">Was am Ende auf dem Tisch liegt</p>
  <ol class="mt-3 grid gap-2 sm:grid-cols-3 sm:gap-3">
    {
      dokumente.map((d) => (
        <li class="border-border bg-background-secondary rounded-xl border p-3 sm:rounded-2xl sm:p-4">
          <p class="text-foreground text-sm font-semibold">{d.titel}</p>
          <p class="text-foreground-muted text-xs">{d.umfang}</p>
          <p class="text-foreground-secondary mt-2 text-sm leading-6">{d.text}</p>
        </li>
      ))
    }
  </ol>
  <p class="text-foreground mt-6 text-sm font-semibold">Die wichtigen Befunde, gebündelt zu 18 Schritten in vier Stufen</p>
  <ol class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4 sm:gap-3">
    {
      reihenfolge.map((r, i) => (
        <li class:list={['rounded-xl border p-3 sm:rounded-2xl sm:p-4', i === 0 ? 'border-amber-500/40 bg-amber-500/10' : 'border-border bg-background-secondary']}>
          <p class="font-display text-foreground text-xl font-bold sm:text-2xl">{r.n}</p>
          <p class="text-foreground text-sm font-semibold">{r.wann}</p>
          <p class="text-foreground-secondary text-xs leading-5 sm:text-sm sm:leading-6">{r.was}</p>
        </li>
      ))
    }
  </ol>
</figure>
