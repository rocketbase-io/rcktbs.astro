---
/**
 * Kleine, statische Vorschau je Tür für die Lösungs-Übersicht (/leistungen/). Keine echten
 * Nachbauten, nur das Motiv der jeweiligen Seite in reduzierter Form. Leicht animiert.
 */
interface Props {
  kind: 'angebot' | 'einsatz' | 'zahlen' | 'abloesung';
}
const { kind } = Astro.props;
const bars = [62, 74, 58, 88, 96, 81, 104, 92];
const plan = [
  { y: 0, x: 0, w: 40, c: 'g' },
  { y: 0, x: 44, w: 52, c: 'g' },
  { y: 1, x: 10, w: 34, c: 'o' },
  { y: 1, x: 48, w: 48, c: 'g' },
  { y: 2, x: 0, w: 50, c: 'v' },
  { y: 2, x: 54, w: 30, c: 'o' },
  { y: 3, x: 20, w: 60, c: 'o' },
];
---

<svg viewBox="0 0 240 132" class:list={['mv block h-auto w-full', `mv-${kind}`]} aria-hidden="true">
  <rect x="0.5" y="0.5" width="239" height="131" rx="12" class="mv-bg" />
  {
    kind === 'angebot' && (
      <g>
        <rect x="20" y="18" width="120" height="96" rx="8" class="mv-card" />
        <rect x="32" y="30" width="60" height="8" rx="4" class="mv-ink" />
        {[48, 62, 76].map((y, i) => (
          <g>
            <rect x="32" y={y} width="9" height="9" rx="2.5" class:list={[i === 1 ? 'mv-box' : 'mv-box-on']} />
            <rect x="46" y={y + 2} width={i === 2 ? 40 : 52} height="5" rx="2.5" class="mv-soft" />
          </g>
        ))}
        <rect x="32" y="96" width="44" height="10" rx="5" class="mv-accent" />
        <rect x="158" y="34" width="66" height="44" rx="8" class="mv-card" />
        <text x="191" y="52" text-anchor="middle" class="mv-label">Summe</text>
        <text x="191" y="70" text-anchor="middle" class="mv-num mv-pulse">7.240 €</text>
        <rect x="158" y="86" width="66" height="20" rx="6" class="mv-go" />
        <text x="191" y="100" text-anchor="middle" class="mv-gotext">Zusage</text>
      </g>
    )
  }
  {
    kind === 'einsatz' && (
      <g>
        {[0, 1, 2, 3].map((r) => (
          <g>
            <rect x="18" y={22 + r * 24} width="26" height="8" rx="4" class="mv-soft" />
            <line x1="52" y1={36 + r * 24} x2="222" y2={36 + r * 24} class="mv-grid" />
          </g>
        ))}
        {plan.map((p) => (
          <rect x={52 + p.x * 1.7} y={18 + p.y * 24} width={p.w * 1.7} height="15" rx="4" class={`mv-p-${p.c}`} />
        ))}
        <line x1="128" y1="12" x2="128" y2="116" class="mv-today" />
      </g>
    )
  }
  {
    kind === 'zahlen' && (
      <g>
        <rect x="18" y="16" width="58" height="34" rx="7" class="mv-card" />
        <text x="26" y="30" class="mv-label">Umsatz</text>
        <text x="26" y="44" class="mv-num">2,61 Mio</text>
        <rect x="82" y="16" width="58" height="34" rx="7" class="mv-card" />
        <text x="90" y="30" class="mv-label">Auslastung</text>
        <text x="90" y="44" class="mv-num">94 %</text>
        {bars.map((h, i) => (
          <rect x={20 + i * 26} y={118 - h * 0.55} width="16" height={h * 0.55} rx="3" class:list={['mv-bar', i > 5 && 'mv-bar-f']} style={`--i:${i}`} />
        ))}
        <line x1="16" y1={118 - 85 * 0.55} x2="226" y2={118 - 85 * 0.55} class="mv-target" />
      </g>
    )
  }
  {
    kind === 'abloesung' && (
      <g>
        {[24, 52, 80, 108].map((y) => <rect x="16" y={y - 9} width="56" height="18" rx="5" class="mv-island" />)}
        {[24, 52, 80, 108].map((y) => <path d={`M 72 ${y} C 100 ${y}, 100 66, 128 66`} class="mv-flow" />)}
        <rect x="128" y="40" width="64" height="52" rx="10" class="mv-core" />
        <text x="160" y="63" text-anchor="middle" class="mv-label">Eure</text>
        <text x="160" y="77" text-anchor="middle" class="mv-label">Anwendung</text>
        <path d="M 192 56 H 214" class="mv-link" />
        <path d="M 192 76 H 214" class="mv-link" />
        <rect x="214" y="48" width="14" height="14" rx="3" class="mv-keep" />
        <rect x="214" y="70" width="14" height="14" rx="3" class="mv-keep" />
      </g>
    )
  }
</svg>

<style>
  .mv text {
    font-family: inherit;
  }
  .mv-bg {
    fill: var(--color-background-secondary);
    stroke: var(--color-border);
  }
  .mv-card {
    fill: var(--color-card);
    stroke: var(--color-border);
  }
  .mv-ink {
    fill: var(--color-foreground);
    opacity: 0.75;
  }
  .mv-soft {
    fill: color-mix(in oklch, var(--color-foreground-muted) 30%, transparent);
  }
  .mv-box {
    fill: none;
    stroke: var(--color-foreground-muted);
  }
  .mv-box-on {
    fill: var(--color-brand-500);
  }
  .mv-accent {
    fill: color-mix(in oklch, var(--color-brand-500) 30%, transparent);
  }
  .mv-label {
    font-size: 8.5px;
    fill: var(--color-foreground-muted);
  }
  .mv-num {
    font-size: 12px;
    font-weight: 800;
    fill: var(--color-foreground);
  }
  .mv-go {
    fill: oklch(60% 0.15 150);
  }
  .mv-gotext {
    font-size: 9px;
    font-weight: 700;
    fill: white;
  }
  .mv-grid {
    stroke: var(--color-border);
  }
  .mv-p-g {
    fill: oklch(72% 0.15 150);
  }
  .mv-p-o {
    fill: oklch(78% 0.14 70);
  }
  .mv-p-v {
    fill: oklch(72% 0.12 305);
  }
  .mv-today {
    stroke: var(--color-brand-500);
    stroke-width: 1.5;
  }
  .mv-bar {
    fill: var(--color-brand-500);
    transform-box: fill-box;
    transform-origin: bottom;
    animation: mv-grow 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i) * 70ms);
  }
  .mv-bar-f {
    fill: color-mix(in oklch, oklch(76% 0.16 68) 80%, transparent);
  }
  .mv-target {
    stroke: oklch(60% 0.2 25);
    stroke-dasharray: 4 4;
  }
  .mv-island {
    fill: var(--color-card);
    stroke: color-mix(in oklch, var(--color-foreground-muted) 50%, transparent);
    stroke-dasharray: 4 3;
  }
  .mv-flow {
    fill: none;
    stroke: var(--color-brand-400);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    animation: mv-flow 1.4s linear infinite;
  }
  .mv-core {
    fill: color-mix(in oklch, var(--color-brand-500) 12%, var(--color-card));
    stroke: var(--color-brand-500);
    stroke-width: 1.5;
  }
  .mv-link {
    stroke: oklch(60% 0.15 150);
    stroke-width: 2;
  }
  .mv-keep {
    fill: oklch(90% 0.06 150);
    stroke: oklch(60% 0.15 150);
  }
  .mv-pulse {
    animation: mv-pulse 2.8s ease-in-out infinite;
  }
  @keyframes mv-grow {
    from {
      transform: scaleY(0.1);
    }
  }
  @keyframes mv-flow {
    to {
      stroke-dashoffset: -16;
    }
  }
  @keyframes mv-pulse {
    50% {
      fill: oklch(55% 0.15 150);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mv-bar,
    .mv-flow,
    .mv-pulse {
      animation: none;
    }
  }
</style>
