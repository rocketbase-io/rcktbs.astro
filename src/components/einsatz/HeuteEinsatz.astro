---
/**
 * „Kommt euch das bekannt vor?“ für Tür 2: Plan-Excel im Hintergrund, davor das Handy mit der
 * Krankmeldung um 6 Uhr und ein abfotografierter Stundenzettel. Rein dekorativ (aria-hidden).
 */
const tage = ['Mo', 'Di', 'Mi', 'Do', 'Fr'];
type Zelle = { t: string; c: 'w' | 'm' | 'u' | '' | 'x' | 'err' };
const zeilen: { name: string; z: Zelle[] }[] = [
  { name: 'Arne', z: [{ t: 'Deich.', c: 'w' }, { t: 'Speich.', c: 'w' }, { t: 'Speich.', c: 'w' }, { t: 'Elbch.', c: 'w' }, { t: '', c: '' }] },
  { name: 'Ingo', z: [{ t: 'Deich.', c: 'w' }, { t: 'Deich.', c: 'w' }, { t: 'Deich.', c: 'x' }, { t: 'Deich.', c: 'x' }, { t: '??', c: 'x' }] },
  { name: 'Jens', z: [{ t: 'U', c: 'u' }, { t: 'U', c: 'u' }, { t: 'U', c: 'u' }, { t: 'U', c: 'u' }, { t: 'U', c: 'u' }] },
  { name: 'Jörn', z: [{ t: 'Mühl.', c: 'w' }, { t: '', c: '' }, { t: '', c: '' }, { t: '#BEZUG!', c: 'err' }, { t: 'Indus.', c: 'w' }] },
  { name: 'Kjell', z: [{ t: 'Reep.', c: 'm' }, { t: 'Reep.', c: 'm' }, { t: 'Reep.', c: 'm' }, { t: 'Reep.', c: 'm' }, { t: '', c: '' }] },
  { name: 'Gerd', z: [{ t: '', c: '' }, { t: 'Elbch.', c: 'm' }, { t: 'Störteb.', c: 'm' }, { t: 'Störteb.', c: 'm' }, { t: 'Störteb.', c: 'm' }] },
];
const zettel = [
  { tag: 'Mo', std: '7,5', note: 'Deichstr.' },
  { tag: 'Di', std: '8', note: 'Deichstr. + Lager' },
  { tag: 'Mi', std: '?', note: '' },
  { tag: 'Do', std: '9', note: 'Fahrt 1,5 ?' },
];
---

<div class="he relative mx-auto h-[23rem] w-full max-w-lg sm:h-[26rem]" aria-hidden="true">
  <!-- Plan-Excel -->
  <div class="he-card absolute top-0 left-0 w-[86%] overflow-hidden rounded-xl" style="transform: rotate(-2deg)">
    <div class="he-xlbar flex items-center gap-2 px-3 py-1.5 font-mono text-[0.62rem] sm:text-[0.68rem]">
      <span class="h-2.5 w-2.5 shrink-0 rounded-sm bg-[oklch(52%_0.13_150)]"></span>
      <span class="truncate">Einsatzplan_KW42_NEU_v2.xlsx</span>
      <span class="shrink-0 rounded bg-[oklch(60%_0.19_25_/_0.14)] px-1.5 text-[oklch(52%_0.19_25)]">gesperrt: Petra</span>
    </div>
    <table class="he-grid w-full table-fixed border-collapse font-mono text-[0.56rem] sm:text-[0.62rem]">
      <thead>
        <tr><th class="w-[18%]"></th>{tage.map((t) => <th>{t}</th>)}</tr>
      </thead>
      <tbody>
        {
          zeilen.map((r) => (
            <tr>
              <th class="text-left">{r.name}</th>
              {r.z.map((c) => (
                <td class:list={['he-c', c.c && `he-${c.c}`]}>{c.t}</td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <!-- Stundenzettel, abfotografiert -->
  <div class="he-paper absolute bottom-0 left-[3%] w-[50%] rounded-sm px-3 pt-2.5 pb-3 sm:px-4" style="transform: rotate(-4deg)">
    <p class="he-hand text-[0.8rem] font-semibold sm:text-[0.9rem]">Stundenzettel KW 38</p>
    <p class="text-[0.58rem] opacity-60">Name: Ingo L. &nbsp;·&nbsp; Baustelle: siehe unten</p>
    <ul class="mt-1.5">
      {
        zettel.map((z) => (
          <li class="he-line flex items-baseline gap-2 text-[0.66rem] sm:text-[0.72rem]">
            <span class="w-5 opacity-60">{z.tag}</span>
            <span class:list={['he-hand w-6 font-semibold', z.std === '?' && 'text-[oklch(52%_0.19_25)]']}>{z.std}</span>
            <span class="he-hand truncate opacity-80">{z.note}</span>
          </li>
        ))
      }
    </ul>
    <span class="he-stamp absolute -right-2 bottom-3 rounded-md px-1.5 py-0.5 font-mono text-[0.6rem] font-bold sm:text-[0.66rem]">KW 39 fehlt</span>
  </div>

  <!-- Handy mit Gruppenchat -->
  <div class="he-phone absolute right-0 bottom-[4%] w-[44%] max-w-[12.5rem] rounded-[1.7rem] p-1.5" style="transform: rotate(4deg)">
    <div class="he-screen overflow-hidden rounded-[1.35rem]">
      <div class="flex items-center justify-between px-3 pt-1.5 text-[0.55rem] font-semibold">
        <span>06:12</span><span class="he-notch"></span><span>●●●</span>
      </div>
      <div class="he-chathead mt-1 px-3 py-1.5 text-[0.62rem] font-semibold">
        Montage &amp; Werkstatt
        <span class="block text-[0.52rem] font-normal opacity-70">14 Teilnehmer</span>
      </div>
      <div class="space-y-1.5 px-2 pt-2 pb-3 text-[0.6rem] leading-snug sm:text-[0.64rem]">
        <p class="he-in"><b>Ingo</b>Bin krank, heute und morgen raus.</p>
        <p class="he-in"><b>Kjell</b>Wer macht dann Deichstraße?</p>
        <p class="he-in"><b>Jörn</b>Ich hab Mühlenstr., geht nicht beides</p>
        <p class="he-out">Moment, schau gleich in die Liste</p>
      </div>
    </div>
  </div>

  <!-- Zettel am Monitor -->
  <div class="he-note absolute top-[-6%] right-[-2%] w-[26%] rounded-sm px-2.5 py-2" style="transform: rotate(5deg)">
    <p class="he-hand text-[0.72rem] leading-tight font-semibold sm:text-[0.8rem]">Rechnung Vogt noch raus!!</p>
  </div>
</div>

<style>
  .he-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 22px 44px -22px oklch(30% 0.08 265 / 0.45);
  }
  .he-xlbar {
    background: color-mix(in oklch, oklch(52% 0.13 150) 10%, var(--color-card));
    border-bottom: 1px solid var(--color-border);
    color: var(--color-foreground-secondary);
  }
  .he-grid th,
  .he-grid td {
    border: 1px solid color-mix(in oklch, var(--color-border) 80%, transparent);
    padding: 0.28rem 0.3rem;
    height: 1.55rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: clip;
    font-weight: 500;
  }
  .he-grid thead th {
    background: var(--color-background-secondary);
    color: var(--color-foreground-muted);
    height: 1.2rem;
  }
  .he-grid tbody th {
    color: var(--color-foreground-secondary);
    background: var(--color-background-secondary);
  }
  .he-w {
    background: oklch(85% 0.11 150 / 0.55);
  }
  .he-m {
    background: oklch(86% 0.12 70 / 0.6);
  }
  .he-u {
    background: oklch(84% 0.08 300 / 0.55);
    text-align: center;
  }
  .he-x {
    background: oklch(85% 0.11 150 / 0.35);
    text-decoration: line-through;
    text-decoration-color: oklch(55% 0.2 25);
    text-decoration-thickness: 2px;
    color: oklch(50% 0.17 25);
    outline: 2px solid oklch(60% 0.2 25 / 0.75);
    outline-offset: -2px;
  }
  .he-err {
    color: oklch(52% 0.19 25);
    background: oklch(60% 0.19 25 / 0.12);
    font-weight: 700;
  }
  .he-paper {
    background:
      radial-gradient(circle at 82% 28%, oklch(70% 0.06 70 / 0.18) 0 1.4rem, transparent 1.5rem),
      oklch(97.5% 0.012 90);
    color: oklch(28% 0.03 260);
    box-shadow: 0 18px 36px -18px oklch(30% 0.08 265 / 0.55);
    filter: saturate(0.9);
  }
  .he-line {
    border-bottom: 1px solid oklch(70% 0.06 240 / 0.35);
    padding: 0.2rem 0;
  }
  .he-hand {
    font-family: 'Segoe Print', 'Bradley Hand', 'Comic Sans MS', cursive;
    color: oklch(35% 0.12 260);
  }
  .he-stamp {
    color: oklch(52% 0.19 25);
    border: 1.5px solid currentColor;
    background: oklch(98% 0.01 25 / 0.85);
    transform: rotate(-8deg);
  }
  .he-phone {
    background: oklch(22% 0.01 260);
    box-shadow: 0 26px 50px -20px oklch(20% 0.05 265 / 0.6);
  }
  .he-screen {
    background: oklch(95% 0.02 120);
    color: oklch(25% 0.02 260);
  }
  .he-notch {
    width: 2.6rem;
    height: 0.55rem;
    border-radius: 999px;
    background: oklch(22% 0.01 260);
  }
  .he-chathead {
    background: oklch(45% 0.1 165);
    color: white;
  }
  .he-in,
  .he-out {
    max-width: 88%;
    border-radius: 0.6rem;
    padding: 0.3rem 0.45rem;
    box-shadow: 0 1px 1px oklch(30% 0.02 260 / 0.12);
  }
  .he-in {
    background: white;
    border-top-left-radius: 0.15rem;
  }
  .he-in b {
    display: block;
    font-size: 0.85em;
    color: oklch(48% 0.13 30);
  }
  .he-out {
    margin-left: auto;
    background: oklch(90% 0.08 140);
    border-top-right-radius: 0.15rem;
  }
  .he-note {
    background: oklch(95% 0.1 100);
    box-shadow: 0 14px 26px -14px oklch(40% 0.08 80 / 0.6);
  }
  .he-note .he-hand {
    color: oklch(32% 0.05 70);
  }
</style>
