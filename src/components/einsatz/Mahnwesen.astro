---
/**
 * Mahnwesen als Stufen mit Vorlagen: Rechnung, Zahlungserinnerung, 1. und 2. Mahnung, Übergabe
 * ans Inkasso. Ein Klick auf eine Stufe zeigt die E-Mail, die das System mit den Daten der
 * Rechnung füllt. Platzhalter sind markiert. Ohne JS steht die erste Stufe da.
 */
import '@/components/angebote/frame.css';
import '@/components/zahlen/zahlen.css';
import './einsatz.css';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  url?: string;
}
const { url = 'app.euer-betrieb.de/rechnungen/mahnwesen' } = Astro.props;

type Stufe = { id: string; titel: string; tag: string; offen: number; ton: string; betreff: string; text: string[] };
const stufen: Stufe[] = [
  {
    id: 'rechnung',
    titel: 'Rechnung',
    tag: 'Tag 0',
    offen: 38,
    ton: 'var(--z-blue)',
    betreff: 'Ihre Rechnung {Rechnungsnummer}',
    text: [
      'Guten Tag {Ansprechpartner},',
      'anbei erhalten Sie die Rechnung {Rechnungsnummer} über {Betrag} für {Leistungszeitraum}. Die einzelnen Leistungen finden Sie im Leistungsnachweis im Anhang.',
      'Bitte überweisen Sie den Betrag bis zum {Fälligkeit}.',
    ],
  },
  {
    id: 'erinnerung',
    titel: 'Zahlungserinnerung',
    tag: 'Tag 21',
    offen: 9,
    ton: 'var(--z-sky)',
    betreff: 'Kurze Erinnerung: Rechnung {Rechnungsnummer}',
    text: [
      'Guten Tag {Ansprechpartner},',
      'im Alltag geht so etwas schnell unter: Die Rechnung {Rechnungsnummer} über {Betrag} war am {Fälligkeit} fällig, bei uns ist noch keine Zahlung eingegangen.',
      'Falls die Überweisung schon unterwegs ist, betrachten Sie diese Nachricht bitte als erledigt.',
    ],
  },
  {
    id: 'mahnung1',
    titel: '1. Mahnung',
    tag: 'Tag 35',
    offen: 4,
    ton: 'var(--e-late)',
    betreff: '1. Mahnung zur Rechnung {Rechnungsnummer}',
    text: [
      'Guten Tag {Ansprechpartner},',
      'leider ist der offene Betrag von {Betrag} aus der Rechnung {Rechnungsnummer} trotz Erinnerung noch nicht bei uns eingegangen.',
      'Bitte überweisen Sie ihn bis zum {Frist}. Bei Fragen zur Rechnung erreichen Sie {Teamassistenz} direkt unter {Telefon}.',
    ],
  },
  {
    id: 'mahnung2',
    titel: '2. Mahnung',
    tag: 'Tag 49',
    offen: 2,
    ton: 'var(--e-late-dark)',
    betreff: '2. Mahnung zur Rechnung {Rechnungsnummer}',
    text: [
      'Guten Tag {Ansprechpartner},',
      'der Betrag von {Betrag} aus der Rechnung {Rechnungsnummer} ist weiterhin offen. Dies ist unsere letzte Mahnung.',
      'Geht die Zahlung nicht bis zum {Frist} ein, übergeben wir die Forderung ohne weitere Ankündigung an unser Inkassounternehmen.',
    ],
  },
  {
    id: 'inkasso',
    titel: 'Übergabe Inkasso',
    tag: 'Tag 63',
    offen: 1,
    ton: 'var(--z-red)',
    betreff: 'Übergabe Forderung {Rechnungsnummer}',
    text: [
      'An: Inkassopartner (z. B. Creditreform)',
      'Übergabe der Forderung aus Rechnung {Rechnungsnummer} über {Betrag}, fällig seit {Fälligkeit}. Rechnung, Erinnerung und beide Mahnungen liegen als PDF bei.',
      'Der Vorgang ist im Kundenprotokoll vermerkt.',
    ],
  },
];

const mark = (t: string) => t.replace(/\{([^}]+)\}/g, '<span class="e-var">$1</span>');
---

<figure class="af-frame z-app" data-mahnwesen>
  <div class="af-bar" aria-hidden="true">
    <span class="af-dots"><span></span><span></span><span></span></span>
    <span class="af-url">{url}</span>
    <span class="af-dots invisible"><span></span><span></span><span></span></span>
  </div>
  <div class="grid gap-3 p-3 sm:p-5 lg:grid-cols-[15rem_minmax(0,1fr)]">
    <div role="tablist" aria-label="Mahnstufe" class="flex gap-2 overflow-x-auto pb-1 lg:flex-col lg:overflow-visible lg:pb-0">
      {stufen.map((s, i) => (
        <button type="button" role="tab" class="e-stage min-w-[9.5rem] lg:min-w-0" aria-selected={i === 0 ? 'true' : 'false'} data-stufe={s.id}>
          <span class="flex w-full items-center justify-between gap-2">
            <span class="flex items-center gap-2 text-[0.78rem] font-bold">
              <span class="z-dot" style={`background:${s.ton}`} />
              {s.titel}
            </span>
            <span class="z-label">{s.tag}</span>
          </span>
          <span class="z-label pl-[1.05rem]">{s.offen} {s.offen === 1 ? 'Rechnung' : 'Rechnungen'} in dieser Stufe</span>
        </button>
      ))}
    </div>

    <div class="z-card p-3 sm:p-4">
      {stufen.map((s, i) => (
        <div class="e-mail" data-mail={s.id} hidden={i !== 0} role="tabpanel">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b pb-2" style="border-color: var(--z-line)">
            <p class="flex items-center gap-2 text-[0.78rem] font-semibold">
              <Icon name="mail" size="xs" class="z-muted" />
              Vorlage „{s.titel}“
            </p>
            <span class="z-label">{i === 0 ? 'beim Versand der Rechnung' : `automatisch nach ${s.tag.replace('Tag ', '')} Tagen ohne Zahlung`}</span>
          </div>
          <p class="mt-3 text-[0.72rem]">
            <span class="z-muted">Betreff: </span>
            <span class="font-semibold" set:html={mark(s.betreff)} />
          </p>
          <div class="mt-3 space-y-2.5 text-[0.8rem] leading-6">
            {s.text.map((t) => <p set:html={mark(t)} />)}
          </div>
          <p class="z-label mt-4 flex items-center gap-1.5 border-t pt-2" style="border-color: var(--z-line)">
            <Icon name="check-circle" size="xs" class="z-up" />
            Stoppt von selbst, sobald der Zahlungseingang aus der Buchhaltung gemeldet ist.
          </p>
        </div>
      ))}
    </div>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-mahnwesen]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-stufe]');
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', t === tab ? 'true' : 'false'));
        root.querySelectorAll<HTMLElement>('[data-mail]').forEach((m) => (m.hidden = m.dataset.mail !== tab.dataset.stufe));
      }),
    );
  });
</script>
