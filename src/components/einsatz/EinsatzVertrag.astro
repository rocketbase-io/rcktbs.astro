---
/**
 * Einsatzplanung je Vertrag (nach der Lösung für eine Beratung mit Jahresverträgen):
 * Zeilen sind Vertragsbausteine eines Beraters, Spalten Monate. Je Baustein steht das
 * Soll aus dem Vertrag gegen die eingeplanten Termine, je Monat feste und vorläufige
 * Termine. Unten die Summen und die Abweichung zur Kapazität. Beispieldaten.
 */
import '@/components/angebote/frame.css';
import '@/components/zahlen/zahlen.css';
import './einsatz.css';

interface Props {
  url?: string;
}
const { url = 'app.euer-betrieb.de/einsatzplanung' } = Astro.props;

const monate = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun'];
type Zelle = { std: number; fix: number; plan: number } | null;
type Zeile = { baustein: string; kunde: string; soll: number; geplant: number; zellen: Zelle[] };
const zeilen: Zeile[] = [
  { baustein: 'Jahresbetreuung', kunde: 'Kupferberg Logistik GmbH', soll: 48, geplant: 48, zellen: [{ std: 8, fix: 2, plan: 0 }, null, { std: 8, fix: 1, plan: 0 }, { std: 8, fix: 1, plan: 0 }, null, { std: 8, fix: 0, plan: 1 }] },
  { baustein: 'Wartungsvertrag Anlagen', kunde: 'Alpenblick Spedition SE', soll: 133, geplant: 112, zellen: [{ std: 24, fix: 3, plan: 0 }, { std: 16, fix: 2, plan: 0 }, { std: 24, fix: 3, plan: 0 }, null, { std: 24, fix: 2, plan: 1 }, { std: 24, fix: 0, plan: 3 }] },
  { baustein: 'Geräteprüfung', kunde: 'Blauhorn Getränke GmbH & Co. KG', soll: 16, geplant: 16, zellen: [null, null, { std: 16, fix: 2, plan: 0 }, null, null, null] },
  { baustein: 'Schulung Unterweisung', kunde: 'Deichgraf Gartenbau GmbH', soll: 9, geplant: 12, zellen: [null, { std: 4, fix: 1, plan: 0 }, null, null, { std: 8, fix: 0, plan: 1 }, null] },
  { baustein: 'Jahresbetreuung', kunde: 'Buchenhain Seniorenresidenz', soll: 30, geplant: 25, zellen: [{ std: 5, fix: 1, plan: 0 }, null, { std: 5, fix: 1, plan: 0 }, { std: 5, fix: 1, plan: 0 }, null, { std: 10, fix: 0, plan: 2 }] },
];
// Freie Kapazität des Beraters nach allen Verträgen (negativ = überplant).
const frei = [12.5, 4, -8.25, 18, 6.5, -3];
const summe = monate.map((_, m) => zeilen.reduce((s, z) => s + (z.zellen[m]?.std ?? 0), 0));
const termine = monate.map((_, m) => zeilen.reduce((s, z) => s + (z.zellen[m] ? z.zellen[m]!.fix + z.zellen[m]!.plan : 0), 0));
const fmt = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const status = (z: Zeile) => (z.geplant === z.soll ? { icon: '=', cls: 'e-eq', label: 'passt' } : z.geplant < z.soll ? { icon: '↓', cls: 'e-low', label: 'zu wenig eingeplant' } : { icon: '↑', cls: 'e-high', label: 'mehr als Vertrag' });
---

<figure class="af-frame z-app">
  <div class="af-bar" aria-hidden="true">
    <span class="af-dots"><span></span><span></span><span></span></span>
    <span class="af-url">{url}</span>
    <span class="af-dots invisible"><span></span><span></span><span></span></span>
  </div>
  <div class="p-3 sm:p-5">
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div>
        <p class="text-sm font-bold">Einsatzplanung · Ralf Seifert · 2026</p>
        <p class="z-label">Vertragsstunden gegen eingeplante Termine, je Baustein und Monat</p>
      </div>
      <div class="z-seg" aria-hidden="true">
        <button type="button" aria-pressed="true">Vor Ort</button>
        <button type="button">Remote</button>
      </div>
    </div>

    <div class="mt-3 overflow-x-auto">
      <table class="w-full min-w-[46rem] border-collapse text-[0.72rem]">
        <thead>
          <tr class="z-muted text-left">
            <th class="py-2 pr-2 font-semibold">Vertragsbaustein</th>
            <th class="w-28 py-2 pr-2 font-semibold">Soll · geplant</th>
            {monate.map((m) => <th class="py-2 text-center font-semibold">{m}</th>)}
          </tr>
        </thead>
        <tbody>
          {zeilen.map((z) => {
            const st = status(z);
            return (
              <tr class="border-t align-top" style="border-color: var(--z-line)">
                <td class="py-2.5 pr-2">
                  <p class="font-semibold">{z.baustein}</p>
                  <p class="z-label truncate">{z.kunde}</p>
                </td>
                <td class="py-2.5 pr-2">
                  <div class="z-card flex items-center justify-between gap-2 px-2 py-1">
                    <span>
                      <span class="font-semibold">{z.soll}</span>
                      <span class="z-muted"> · {z.geplant} Std.</span>
                    </span>
                    <span class:list={['e-badge', st.cls]} title={st.label}>{st.icon}</span>
                  </div>
                </td>
                {z.zellen.map((c) => (
                  <td class="px-1 py-2.5 text-center">
                    {c ? (
                      <div class="e-cellbox">
                        <p class="font-semibold">{c.std} Std.</p>
                        <p class="mt-1 flex justify-center gap-1">
                          {c.fix > 0 && <span class="e-chip e-chip-fix">{c.fix} fix</span>}
                          {c.plan > 0 && <span class="e-chip e-chip-plan">{c.plan} plan</span>}
                        </p>
                      </div>
                    ) : (
                      <span class="z-muted">–</span>
                    )}
                  </td>
                ))}
              </tr>
            );
          })}
        </tbody>
        <tfoot>
          <tr class="border-t-2" style="border-color: var(--z-line)">
            <td class="pt-2.5 font-bold" colspan="2">Summe Terminstunden</td>
            {summe.map((s) => <td class="pt-2.5 text-center font-bold">{fmt(s)}</td>)}
          </tr>
          <tr>
            <td class="z-muted pt-1" colspan="2">In Terminen</td>
            {termine.map((t) => <td class="z-muted pt-1 text-center">{t}</td>)}
          </tr>
          <tr>
            <td class="z-muted pt-1" colspan="2">Freie Kapazität, alle Verträge</td>
            {frei.map((d) => (
              <td class:list={['pt-1 text-center font-semibold', d < 0 ? 'z-over' : 'z-up']}>
                {d < 0 ? '−' : '+'}{fmt(Math.abs(d))}
              </td>
            ))}
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="z-label mt-3 flex flex-wrap items-center gap-x-4 gap-y-1">
      <span class="flex items-center gap-1.5"><span class="e-badge e-eq">=</span>Vertrag eingeplant</span>
      <span class="flex items-center gap-1.5"><span class="e-badge e-low">↓</span>noch Stunden offen</span>
      <span class="flex items-center gap-1.5"><span class="e-badge e-high">↑</span>mehr als vereinbart</span>
    </p>
  </div>
</figure>

<style>
  .e-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 800;
  }
  .e-eq {
    background: color-mix(in oklch, var(--z-blue) 14%, transparent);
    color: var(--z-blue);
  }
  .e-low {
    background: color-mix(in oklch, var(--e-late) 22%, transparent);
    color: var(--e-late-dark);
  }
  .e-high {
    background: color-mix(in oklch, var(--z-red) 14%, transparent);
    color: var(--z-red);
  }
  .e-cellbox {
    border-radius: 0.5rem;
    padding: 0.35rem 0.25rem;
    background: color-mix(in oklch, var(--z-sky) 14%, transparent);
  }
  .e-chip {
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    border-radius: 999px;
    padding: 0.05rem 0.4rem;
  }
  .e-chip-fix {
    background: color-mix(in oklch, var(--z-green) 18%, transparent);
    color: var(--z-green);
  }
  .e-chip-plan {
    background: color-mix(in oklch, var(--e-late) 22%, transparent);
    color: var(--e-late-dark);
  }
</style>
