---
/**
 * Von der erfassten Leistung zur Rechnung: links die Leistungsnachweise eines Kunden im Monat
 * (Vor Ort, Fahrzeit, Remote, Administrativ, Spesen), je Zeile abrechenbar oder nicht. Rechts
 * der Rechnungsentwurf, der live mitrechnet. Der Knopf zeigt den Versand mit Vorlage.
 * Ohne JS steht der Ausgangszustand da.
 */
import '@/components/angebote/frame.css';
import '@/components/zahlen/zahlen.css';
import './einsatz.css';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  url?: string;
}
const { url = 'app.euer-betrieb.de/leistungsnachweise' } = Astro.props;

type Leistung = { id: string; datum: string; art: string; text: string; menge: number; einheit: string; preis: number; an: boolean; hinweis?: string };
const leistungen: Leistung[] = [
  { id: 'l1', datum: '06.10.', art: 'Vor Ort', text: 'Begehung Lager 2', menge: 6.5, einheit: 'Std.', preis: 98, an: true },
  { id: 'l2', datum: '06.10.', art: 'Fahrzeit', text: 'Winsen – Hamburg-Billbrook', menge: 1, einheit: 'Std.', preis: 49, an: true },
  { id: 'l3', datum: '08.10.', art: 'Remote', text: 'Abstimmung Prüfplan', menge: 1.5, einheit: 'Std.', preis: 98, an: true },
  { id: 'l4', datum: '09.10.', art: 'Administrativ', text: 'Bericht erstellen', menge: 2, einheit: 'Std.', preis: 98, an: false, hinweis: 'in Pauschale enthalten' },
  { id: 'l5', datum: '13.10.', art: 'Vor Ort', text: 'Prüfung Anlagen Halle 3', menge: 7, einheit: 'Std.', preis: 98, an: true },
  { id: 'l6', datum: '13.10.', art: 'Spesen', text: 'Parken Halle 3', menge: 1, einheit: 'pausch.', preis: 12, an: true },
];
const eur = (n: number) => n.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
const menge = (n: number) => n.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const netto = leistungen.filter((l) => l.an).reduce((s, l) => s + l.menge * l.preis, 0);
const artColor: Record<string, string> = {
  'Vor Ort': 'var(--z-blue)',
  Fahrzeit: 'var(--z-amber)',
  Remote: 'var(--z-sky)',
  Administrativ: 'var(--z-slate)',
  Spesen: 'var(--e-vac)',
};
---

<figure class="af-frame z-app" data-rechnung>
  <div class="af-bar" aria-hidden="true">
    <span class="af-dots"><span></span><span></span><span></span></span>
    <span class="af-url">{url}</span>
    <span class="af-dots invisible"><span></span><span></span><span></span></span>
  </div>
  <div class="grid gap-3 p-3 sm:p-5 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]">
    <div class="z-card p-3 sm:p-4">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <p class="text-sm font-bold">Leistungsnachweise · Oktober</p>
          <p class="z-label">Alpenblick Spedition SE · Wartungsvertrag Anlagen</p>
        </div>
        <span class="z-label">abrechenbar?</span>
      </div>
      <ul class="mt-2">
        {leistungen.map((l) => (
          <li>
            <label class:list={['flex cursor-pointer items-center gap-3 border-t py-2', !l.an && 'e-row-off']} style="border-color: var(--z-line)" data-row>
              <span class="z-muted w-10 shrink-0 text-[0.7rem]">{l.datum}</span>
              <span class="min-w-0 flex-1">
                <span class="flex items-center gap-1.5 text-[0.75rem] font-semibold">
                  <span class="z-dot" style={`background:${artColor[l.art]}`} />
                  {l.art}
                </span>
                <span class="z-label block truncate">{l.text}{l.hinweis && ` · ${l.hinweis}`}</span>
              </span>
              <span class="w-16 shrink-0 text-right text-[0.75rem] font-semibold">{menge(l.menge)} {l.einheit}</span>
              <input
                type="checkbox"
                class="e-check"
                checked={l.an}
                data-id={l.id}
                data-text={`${l.art} · ${l.text}`}
                data-menge={l.menge}
                data-einheit={l.einheit}
                data-preis={l.preis}
                aria-label={`${l.art} ${l.datum} abrechnen`}
              />
            </label>
          </li>
        ))}
      </ul>
    </div>

    <div class="z-card flex flex-col p-3 sm:p-4" style="background: var(--z-panel)">
      <div class="flex items-start justify-between gap-2">
        <div>
          <p class="z-label font-semibold tracking-wider uppercase">Rechnung 26-13021</p>
          <p class="text-sm font-bold">Alpenblick Spedition SE</p>
        </div>
        <span class="rounded-full px-2 py-0.5 text-[0.62rem] font-bold" style="background: color-mix(in oklch, var(--e-late) 22%, transparent); color: var(--e-late-dark)" data-badge>Entwurf</span>
      </div>
      <ul class="mt-3 flex-1 space-y-1.5 text-[0.72rem]" data-positions>
        {leistungen.filter((l) => l.an).map((l) => (
          <li class="flex justify-between gap-3">
            <span class="truncate">{l.art} · {l.text}</span>
            <span class="shrink-0 font-semibold">{eur(l.menge * l.preis)}</span>
          </li>
        ))}
      </ul>
      <div class="mt-3 space-y-1 border-t pt-2 text-[0.75rem]" style="border-color: var(--z-line)">
        <p class="flex justify-between"><span class="z-muted">Netto</span><span data-netto>{eur(netto)}</span></p>
        <p class="flex justify-between"><span class="z-muted">MwSt. 19 %</span><span data-mwst>{eur(netto * 0.19)}</span></p>
        <p class="flex justify-between text-sm font-bold"><span>Brutto</span><span data-brutto>{eur(netto * 1.19)}</span></p>
      </div>
      <button type="button" class="mt-3 inline-flex items-center justify-center gap-2 rounded-lg px-3 py-2 text-[0.75rem] font-bold text-white transition-colors" style="background: var(--z-blue)" data-senden>
        <Icon name="mail" size="xs" />
        <span data-senden-text>Rechnung erstellen und versenden</span>
      </button>
      <p class="z-label mt-2 hidden" data-gesendet>
        Versendet als PDF mit Vorlage „Rechnung“, ZUGFeRD im Anhang, Zahlungsziel 14 Tage. Export an die Buchhaltung läuft heute Nacht.
      </p>
    </div>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-rechnung]').forEach((root) => {
    const eur = (n: number) => n.toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
    const list = root.querySelector<HTMLElement>('[data-positions]');
    const badge = root.querySelector<HTMLElement>('[data-badge]');
    const sendBtn = root.querySelector<HTMLButtonElement>('[data-senden]');
    const sendText = root.querySelector<HTMLElement>('[data-senden-text]');
    const sent = root.querySelector<HTMLElement>('[data-gesendet]');
    const reset = () => {
      if (badge) badge.textContent = 'Entwurf';
      if (sendText) sendText.textContent = 'Rechnung erstellen und versenden';
      sent?.classList.add('hidden');
      if (sendBtn) sendBtn.disabled = false;
    };
    const update = (changedId?: string) => {
      let netto = 0;
      const items: string[] = [];
      root.querySelectorAll<HTMLInputElement>('input.e-check').forEach((cb) => {
        cb.closest('[data-row]')?.classList.toggle('e-row-off', !cb.checked);
        if (!cb.checked) return;
        const betrag = Number(cb.dataset.menge) * Number(cb.dataset.preis);
        netto += betrag;
        const cls = cb.dataset.id === changedId ? ' class="flex justify-between gap-3 e-pos-enter"' : ' class="flex justify-between gap-3"';
        items.push(`<li${cls}><span class="truncate">${cb.dataset.text}</span><span class="shrink-0 font-semibold">${eur(betrag)}</span></li>`);
      });
      if (list) list.innerHTML = items.join('');
      root.querySelector('[data-netto]')!.textContent = eur(netto);
      root.querySelector('[data-mwst]')!.textContent = eur(netto * 0.19);
      root.querySelector('[data-brutto]')!.textContent = eur(netto * 1.19);
      reset();
    };
    root.querySelectorAll<HTMLInputElement>('input.e-check').forEach((cb) => cb.addEventListener('change', () => update(cb.dataset.id)));
    sendBtn?.addEventListener('click', () => {
      if (badge) badge.textContent = 'Versendet';
      if (sendText) sendText.textContent = 'Versendet';
      sent?.classList.remove('hidden');
      sendBtn.disabled = true;
    });
  });
</script>
