---
/**
 * „Kommt euch das bekannt vor?“ für die Ablösung: der Update-Dialog, der seit Jahren weggeklickt
 * wird, die Zusatzfelder, die niemand anfassen darf, und die Wartungsrechnung, die trotzdem
 * kommt. Rein dekorativ (aria-hidden).
 */
const felder = [
  { n: 'Zusatzfeld_03', w: 'Kontingent (NICHT LÖSCHEN)' },
  { n: 'Zusatzfeld_11', w: 'Sonderrabatt Altkunde' },
  { n: 'Zusatzfeld_17', w: '?? (Frank fragen)' },
  { n: 'Zusatzfeld_18', w: 'Stundensatz 2019' },
];
---

<div class="ha relative mx-auto h-[23rem] w-full max-w-lg sm:h-[26rem]" aria-hidden="true">
  <!-- Zusatzfelder -->
  <div class="ha-card absolute top-0 left-0 w-[72%] overflow-hidden rounded-xl" style="transform: rotate(-2.5deg)">
    <p class="ha-head px-3 py-1.5 text-[0.62rem] font-semibold sm:text-[0.68rem]">Stammdaten · Benutzerdefinierte Felder</p>
    <div class="divide-y" style="--tw-divide-opacity:1">
      {
        felder.map((f) => (
          <p class="ha-row flex items-baseline justify-between gap-3 px-3 py-1.5 font-mono text-[0.58rem] sm:text-[0.64rem]">
            <span class="opacity-60">{f.n}</span>
            <span class="truncate font-semibold">{f.w}</span>
          </p>
        ))
      }
    </div>
  </div>

  <!-- Update-Dialog -->
  <div class="ha-dialog absolute top-[30%] right-0 w-[66%] rounded-xl" style="transform: rotate(2deg)">
    <div class="flex items-center gap-1.5 px-3 pt-2.5">
      <span class="ha-dot bg-[oklch(65%_0.2_25)]"></span><span class="ha-dot bg-[oklch(80%_0.15_85)]"></span><span class="ha-dot bg-[oklch(70%_0.15_150)]"></span>
    </div>
    <div class="px-4 pt-2 pb-3.5">
      <p class="text-[0.8rem] font-bold sm:text-[0.88rem]">Update verfügbar: Version 2026.2</p>
      <p class="ha-muted mt-1 text-[0.66rem] sm:text-[0.7rem]">Installiert: 2019.4 · Anpassungen werden ggf. überschrieben.</p>
      <div class="mt-3 flex items-center justify-end gap-2 text-[0.66rem] font-semibold sm:text-[0.7rem]">
        <span class="ha-btn">Jetzt installieren</span>
        <span class="ha-btn ha-btn-main">Später erinnern</span>
      </div>
      <p class="mt-2 text-right font-mono text-[0.58rem] text-[oklch(52%_0.19_25)]">zum 31. Mal verschoben</p>
    </div>
  </div>

  <!-- Wartungsrechnung -->
  <div class="ha-paper absolute bottom-0 left-[6%] w-[54%] rounded-sm px-3.5 py-3" style="transform: rotate(-3deg)">
    <p class="text-[0.58rem] tracking-[0.18em] uppercase opacity-60">Rechnung</p>
    <p class="mt-0.5 text-[0.78rem] font-bold sm:text-[0.84rem]">Wartung &amp; Lizenzen 2026</p>
    <div class="mt-2 space-y-1 text-[0.62rem] sm:text-[0.66rem]">
      <p class="flex justify-between"><span>Wartungsvertrag, 24 Nutzer</span><span class="ha-bar w-10"></span></p>
      <p class="flex justify-between"><span>Modul Projektabrechnung</span><span class="ha-bar w-8"></span></p>
      <p class="flex justify-between"><span>Anpassungsstunden</span><span class="ha-bar w-12"></span></p>
    </div>
    <span class="ha-stamp absolute -top-2 right-2 rounded-md px-1.5 py-0.5 font-mono text-[0.58rem] font-bold">Updates: keine</span>
  </div>

  <!-- Zettel -->
  <div class="ha-note absolute right-[4%] bottom-[2%] w-[34%] rounded-sm px-2.5 py-2" style="transform: rotate(-4deg)">
    <p class="ha-hand text-[0.72rem] leading-tight font-semibold sm:text-[0.8rem]">Liste für Sonderfälle ist im Teams-Ordner!</p>
  </div>
</div>

<style>
  .ha-card,
  .ha-dialog {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 22px 44px -22px oklch(30% 0.08 265 / 0.45);
    color: var(--color-foreground);
  }
  .ha-head {
    background: var(--color-background-secondary);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-foreground-secondary);
  }
  .ha-row + .ha-row {
    border-top: 1px solid var(--color-border);
  }
  .ha-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
  }
  .ha-muted {
    color: var(--color-foreground-muted);
  }
  .ha-btn {
    padding: 0.3rem 0.6rem;
    border-radius: 0.45rem;
    border: 1px solid var(--color-border);
    color: var(--color-foreground-muted);
  }
  .ha-btn-main {
    background: var(--color-brand-500);
    border-color: var(--color-brand-500);
    color: white;
    box-shadow: 0 0 0 3px color-mix(in oklch, var(--color-brand-500) 25%, transparent);
  }
  .ha-paper {
    background: oklch(97.5% 0.008 90);
    color: oklch(28% 0.03 260);
    box-shadow: 0 18px 36px -18px oklch(30% 0.08 265 / 0.55);
  }
  .ha-bar {
    display: inline-block;
    height: 0.5rem;
    margin-top: 0.2rem;
    border-radius: 999px;
    background: oklch(80% 0.01 260);
  }
  .ha-stamp {
    color: oklch(52% 0.19 25);
    border: 1.5px solid currentColor;
    background: oklch(98% 0.01 25 / 0.9);
    transform: rotate(6deg);
  }
  .ha-note {
    background: oklch(95% 0.1 100);
    box-shadow: 0 14px 26px -14px oklch(40% 0.08 80 / 0.6);
  }
  .ha-hand {
    font-family: 'Segoe Print', 'Bradley Hand', 'Comic Sans MS', cursive;
    color: oklch(32% 0.05 70);
  }
</style>
