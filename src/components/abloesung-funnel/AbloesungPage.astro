---
/**
 * Anzeigen-Landing für eigene Software: /f/eigene-software/ (Adresse und Haltung seit
 * 2026-10-18, vorher /f/abloesung/ mit „Standardsoftware ablösen").
 *
 * Der Einstieg ist die Frage von 2024, die FKC und Diezinger gebracht hat: „Braucht ihr eine
 * Software, die es so noch nicht gibt?" Dazu, was es 2024 nicht gab: Vieles ist gebaut, und KI
 * beim Programmieren macht den Rest bezahlbar. Das Ablösen bleibt der Weg, ist aber nicht mehr
 * das Versprechen. Begründung: rcktbs-sales, docs/vertrieb/tor-hooks.md.
 *
 * Die H1 hieß bis 2026-10-19 „Braucht ihr eine Software, die es so noch nicht gibt? / Vieles
 * davon ist heute schon gebaut." Die Frage kam aus der Anzeige, der Besucher hatte sie also
 * schon gelesen und mit Ja beantwortet; die zweite Zeile klang außerdem nach Software von der
 * Stange. Jetzt steht hier der Schmerz: Ihr arbeitet anders, und das Programm kann damit nichts
 * anfangen. Bezahlbarkeit und das 80/20-Argument kommen bewusst erst beim Scrollen — im Kasten
 * unter dem Quiz und in den Einwänden (Marten, 2026-10-19).
 *
 * Wenn je Tor mehrere Anzeigen-Motive laufen: Varianten als eigene Seiten über funnels.ts, die
 * sich nur in H1 und Heute-Block unterscheiden. Nicht per Query-Parameter — der Build ist
 * statisch, die Headline würde nach dem Laden sichtbar umspringen.
 * Die ausführliche, indexierte Seite /standardsoftware-abloesung/ hängt weiter an
 * components/abloesung/. Die Visuals kommen von dort (seit 2026-10-22 geteilt, keine Kopien mehr);
 * der Ablöseplan läuft hier mit variante="funnel".
 *
 * Gleicher Aufbau wie /f/angebote-neu/: ein Ziel, das Formular.
 *
 *   Hero          Versprechen, Logos, Quiz-Formular (eigene Fragen)
 *   Heute         Wiedererkennen: angepasst bis nichts mehr geht, Excel daneben
 *   01 Landschaft Vorher/nachher, aus acht Programmen wird eins
 *   02 Plan       Parallelbetrieb, Baustein für Baustein
 *   03 Daten      Historie kommt mit, Prüfbericht
 *   04 FKC        Beweis aus der Praxis
 *   05 Ehrlich    Nicht jede Branchensoftware muss weg
 *   06 Marten     Erstgespräch-Karte, Knopf zum Formular
 *   07 FAQ        Was vor dem Absenden bremst
 *   Kontakt       Dasselbe Quiz-Formular noch einmal
 *
 * Nicht hier (steht auf /standardsoftware-abloesung/): die drei Bausteine mit Links auf die
 * Tür-Seiten, der Link zur Referenz.
 *
 * Fassung 2026-10-18: Grafiken laufen beim Hereinscrollen selbst durch (Landschaft heute → 6 → 12
 * Monate, Meilensteine, Datenübernahme-Reiter), Texte auf einen Satz je Abschnitt, Vertrauensband
 * und Lohnt-sich-Streifen wie auf den anderen Funnels. Ein Funnel führt nirgendwohin außer zum Formular.
 * Texte in einfacher Sprache. Keine Preise, kein „Festpreis“. Vertec nur bei FKC.
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Blueprint from '@/components/hero-backgrounds/Blueprint.astro';
import { ClientLogoStrip } from '@/components/ui/marketing/ClientLogoStrip';
import SectionHeader from '@/components/angebote/SectionHeader.astro';
import FunnelQuiz from '@/components/funnel/FunnelQuiz';
import ErstgespraechKarte from '@/components/funnel/ErstgespraechKarte.astro';
import DealZeile from '@/components/funnel/DealZeile.astro';
import VonHeuteBisDahin from '@/components/funnel/VonHeuteBisDahin.astro';
import LohntSich from '@/components/funnel/LohntSich.astro';
import VertrauensBand from '@/components/funnel/VertrauensBand.astro';
import '@/styles/szene.css';
import { Picture } from 'astro:assets';
import founderPortrait from '@/assets/rocketbase/founder-marten-priess.jpg';
import fkcKanban from '@/assets/references/fkc-sales-kanban.png';
import type { FunnelQuizQuestion } from '@/data/funnels';
import HeuteAbloesung from '@/components/abloesung/HeuteAbloesung.astro';
import Landschaft from '@/components/abloesung/Landschaft.astro';
import Abloeseplan from '@/components/abloesung/Abloeseplan.astro';
import Datenuebernahme from '@/components/abloesung/Datenuebernahme.astro';
import { abloesungFaqs } from './faqs';
import '@/components/angebote/frame.css';
import '@/components/zahlen/zahlen.css';
import '@/components/abloesung/abloesung.css';

const clientLogos = [
  { key: 'fkc_logo', name: 'FKC Consulting' },
  { key: 'diezinger_logo', name: 'Schlosserei Diezinger' },
  { key: 'statista-logo', name: 'Statista' },
  { key: 'stage_logo', name: 'Stage Entertainment' },
];

// Quiz: drei kurze Fragen, danach das Kontaktformular (Telefon Pflicht).
const quizFragen: FunnelQuizQuestion[] = [
  {
    id: 'system',
    question: 'Womit arbeitet ihr heute?',
    hint: 'Das Programm, um das herum der Rest läuft.',
    options: [
      {
        id: 'branchensoftware',
        label: 'Eine Branchensoftware',
        description: 'Für unsere Branche gemacht, trifft unseren Ablauf zur Hälfte.',
      },
      {
        id: 'erp',
        label: 'Ein ERP oder eine Warenwirtschaft',
        description: 'Trägt den Kern, der Rest läuft in Excel.',
      },
      {
        id: 'mehrere',
        label: 'Mehrere Programme nebeneinander',
        description: 'Jedes kann ein Stück, das Ganze kennt nur der Kopf.',
      },
      {
        id: 'excel',
        label: 'Vor allem Excel und Mail',
        description: 'Über Jahre gewachsen, zwei Leute kennen sich aus.',
      },
      {
        id: 'sonstiges',
        label: 'Anders',
        allowText: true,
        textPlaceholder: 'Schreibt in ein, zwei Sätzen, womit ihr heute arbeitet …',
      },
    ],
  },
  {
    id: 'wo',
    question: 'Was wolltet ihr schon immer anders machen?',
    hint: 'Eine Antwort reicht.',
    options: [
      { id: 'angebote', label: 'Angebote und Kalkulation' },
      { id: 'einsatz', label: 'Planung und Abrechnung' },
      { id: 'zahlen', label: 'Auswertungen und Zahlen' },
      { id: 'daneben', label: 'Das, was heute neben dem Programm läuft' },
      { id: 'ueberall', label: 'Den ganzen Ablauf, Stück für Stück' },
    ],
  },
  {
    id: 'personen',
    question: 'Wie viele Leute arbeiten damit?',
    hint: 'Alle, die das Programm täglich nutzen.',
    options: [
      { id: 'lt10', label: 'Unter 10' },
      { id: '10-30', label: '10 bis 30' },
      { id: '30-80', label: '30 bis 80' },
      { id: 'gt80', label: 'Über 80' },
    ],
  },
];

const quizProps = {
  einordnung: 'eigene-software' as const,
  funnel: 'abloesung',
  questions: quizFragen,
  contact: {
    heading: 'Wohin darf sich Marten Prieß melden?',
    text: 'Hinterlasst eure Kontaktdaten. Marten Prieß meldet sich werktags persönlich und macht einen Terminvorschlag.',
  },
  success: {
    heading: 'Danke, eure Nachricht ist da.',
    text: 'Marten Prieß meldet sich werktags bei euch.',
  },
  submitLabel: 'Nachricht senden',
  phoneHint: 'Telefon für eine kurze Rückfrage. Wir rufen an, wenn es hilft.',
  leadEvent: 'abloesung_lead',
  privacyUrl: '/datenschutz/',
};

const fkcFakten = [
  {
    zahl: '3 → 20+',
    text: 'Jahre Kundengeschichte. Im alten Programm lagen drei, heute liegen über zwanzig in einer Anwendung.',
  },
  { zahl: '1', text: 'Programm vom Vertrieb über Kalkulation und Termine bis zur Rechnung.' },
  { zahl: 'Web', text: 'Angebote als Seite mit Optionen und Summe, während andere PDFs schicken.' },
];

const antworten = [
  {
    label: 'Manchmal richtig',
    titel: 'Im Standard bleiben',
    text: 'Ein Zusatz dazu, die Tricks aufräumen, eine Auswertung daneben. Oft schneller und erst mal günstiger. Wenn euer Ablauf so ist wie überall, ist das die richtige Wahl.',
    note: 'Ein Ablauf, der kein Vorsprung ist, muss nicht eigen sein. Das sagen wir im Erstgespräch auch so.',
  },
  {
    label: 'Wenn der Ablauf euer Vorsprung ist',
    titel: 'Eigenes bauen, Schritt für Schritt',
    text: 'Den Standard behalten, wo er passt: Buchhaltung, Lohn, alles, was bei euch läuft wie bei tausend anderen. Das, womit ihr Geld verdient, bekommt ein eigenes Programm.',
    note: 'Keine Zusatzfelder mit Fragezeichen, keine Liste mit Sonderfällen. Euer Ablauf steckt im System, nicht im Kopf von zwei Leuten.',
  },
];

interface Props {
  variant?: 'funnel' | 'site';
}
const { variant = 'funnel' } = Astro.props;
const istFunnel = variant === 'funnel';

// „Von heute bis dahin“: Strecke und Einwände der Funnel-Fassung (ersetzt dort die FAQ).
const strecke = {
  stationen: [
    { wann: 'So läuft es heute', titel: 'Der Ablauf steckt in Köpfen und Excel', text: 'Das Lieferdatum steht im Bemerkungsfeld, die Kalkulation in einer Excel, der Rest in ein paar Köpfen. Jeder weiß, wie es geht, und keiner kann es jemandem übergeben.' },
    { wann: 'Woche 1 bis 2', titel: 'Erstgespräch und Aufnahme', text: 'Dreißig Minuten darüber, wie ihr arbeiten wollt. Dann nehmen wir auf, welcher Abschnitt zuerst umzieht und welche Daten mit müssen, und ihr bekommt einen Festpreis.' },
    { wann: 'Danach, 4 bis 6 Wochen', titel: 'Der erste Abschnitt läuft', text: 'Programmiert zum Festpreis, meist zuerst der Abschnitt, der am meisten Zeit kostet. Mit euren Daten darin und dem alten Programm daneben, bis das Neue trägt.' },
  ] as const,
  einwaende: [
    { satz: 'Das dauert ewig.', antwort: 'Der erste Abschnitt läuft nach vier bis sechs Wochen, jeder weitere nach ein bis drei Monaten. Für Angebote, Projekte, Rechnungen und Auswertungen zusammen rechnen wir mit vier bis sechs Monaten, dann ist die alte Lizenz gekündigt. Bis dahin läuft das alte Programm weiter.' },
    { satz: 'Dafür haben wir keine Zeit.', antwort: 'Zwei bis drei Stunden pro Woche von euch: ein Termin, dazu Ausprobieren.' },
    { satz: 'Wir hängen mit allen Daten im alten Programm.', antwort: 'Die Daten ziehen mit. Erst der Abschnitt, dann die Historie, geprüft gegen das Alte.' },
    { satz: 'Dann steht der Betrieb still.', antwort: 'Das Neue läuft neben dem alten Programm. Abgeschaltet wird erst, wenn alles trägt.' },
    { satz: 'Vielleicht ist Bleiben besser.', antwort: 'Oft ja. Das sagen wir im Erstgespräch genauso klar, obwohl wir am Bauen verdienen.' },
    { satz: 'Gibt es das nicht längst fertig?', antwort: 'Die Hälfte schon: Angebote, Planung, Rechnungen, Auswertungen laufen bei anderen Betrieben. Darauf setzen wir auf und programmieren, was bei euch anders ist. Mit unserer Erfahrung und KI beim Programmieren geht das schnell und bleibt bezahlbar.' },
    { satz: 'Das ist sicher teuer.', antwort: 'Den Rahmen hört ihr im Erstgespräch, den Festpreis nach der Aufnahme. Programmiert wird erst, wenn ihr ihn kennt.' },
  ],
};

---

<!-- HERO -->
<section
  data-hero
  class:list={[
    'relative overflow-x-clip lg:flex lg:flex-col',
    istFunnel ? 'lg:min-h-[calc(100svh-3.5rem)]' : 'pt-24 sm:pt-20 lg:min-h-[100svh] lg:pt-16',
  ]}
>
  <Blueprint />
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(ellipse_60%_50%_at_30%_40%,var(--color-background)_0%,transparent_75%)] opacity-80"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-[84rem] px-5 pt-8 pb-16 sm:px-8 sm:pt-14 lg:grid lg:flex-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:items-center lg:gap-16 lg:px-12 lg:py-6"
  >
    <div class="text-center lg:text-left">
      <p
        data-reveal="fade-down"
        class="text-brand-600 dark:text-brand-300 text-sm font-semibold tracking-[0.22em] uppercase"
      >
        Eigene Software
      </p>
      <h1
        data-reveal="fade-down"
        lang="de"
        class="font-display text-foreground mt-3 text-[2.05rem] leading-[1.08] font-bold tracking-tight text-balance hyphens-auto [-webkit-hyphens:auto] sm:mt-5 sm:text-6xl sm:leading-[1.05] xl:text-[4.25rem]"
      >
        {
          istFunnel ? (
            <>
              Ihr arbeitet anders als alle anderen.
              <span class="text-brand-500 block">Nur eure Software weiß das nicht.</span>
            </>
          ) : (
            <>
        Software, die es so noch nicht gibt.
        <span class="text-brand-500 block">Wir bauen sie euch.</span>
            </>
          )
        }
      </h1>
      <p
        data-reveal
        class="text-foreground-muted mt-6 hidden flex-wrap items-center justify-center gap-x-2.5 gap-y-2 text-sm font-medium sm:flex lg:justify-start"
      >
        <span>Gebaut für</span>
        {
          ['euren Ablauf', 'eure Regeln', 'euer Geschäft'].map((alt) => (
            <span class="hero-alt border-border rounded-md border px-2 py-0.5">{alt}</span>
          ))
        }
      </p>
      {istFunnel && <DealZeile />}
      {
        !istFunnel && (
      <p
        data-reveal
        class="text-foreground-secondary mx-auto mt-4 max-w-lg text-base leading-7 sm:mt-7 sm:text-lg sm:leading-8 lg:mx-0"
      >
        Erzählt uns, wie ihr arbeiten wollt. Wir sagen euch, was davon heute geht, was schon
        gebaut ist und womit man anfängt.
        <span class="hidden lg:inline"> Das alte Programm läuft so lange weiter.</span>
      </p>
        )
      }
      <p
        data-reveal
        class="text-foreground-muted border-border/70 bg-background/85 mx-auto mt-8 hidden max-w-lg rounded-xl border px-4 py-3 text-sm leading-6 backdrop-blur-sm lg:mx-0 lg:block"
      >
        Angebote, Projekte, Rechnungen, Auswertungen: an diesen Stellen arbeiten die meisten
        Betriebe ähnlich, und das haben wir gebaut. Darauf setzen wir auf und programmieren, was
        bei euch anders läuft. Für Betriebe ab etwa 30 Leuten.
      </p>
    </div>

    <div id="quiz" class="mt-7 scroll-mt-20 sm:mt-10 lg:mt-0 lg:min-h-[38rem]" data-quiz>
      <FunnelQuiz client:load {...quizProps} markRequired compact />
    </div>
    <p
      class="text-foreground-muted border-border/70 bg-background/85 mx-auto mt-6 max-w-lg rounded-xl border px-4 py-3 text-center text-sm leading-6 backdrop-blur-sm lg:hidden"
    >
      Angebote, Projekte, Rechnungen: das ist gebaut. Programmiert wird, was bei euch anders läuft.
    </p>
  </div>

  <div class="relative z-10">
    <a
      href="#heute"
      class="hero-scroll absolute top-0 left-1/2 z-20 hidden h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full lg:flex"
      aria-label="Weiter nach unten"
      data-hero-scroll
    >
      <span class="hero-scroll-icon flex"><Icon name="chevron-down" size="sm" /></span>
    </a>
    <ClientLogoStrip
      heading="Aus Projekten mit"
      logos={clientLogos}
      variant="light"
      uniform
      class="py-10 lg:py-11"
    />
  </div>
</section>

<!-- HEUTE: mobil zuerst das Bild -->
<section
  id="heute"
  class="heute-sec border-border relative scroll-mt-14 overflow-x-clip border-b pt-14 pb-12 sm:py-20 lg:py-24"
>
  <div
    class="container grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-16"
  >
    <div class="af-rise order-2 lg:order-1">
      <p
        class="inline-flex items-center gap-2 font-mono text-xs font-semibold tracking-[0.2em] text-[oklch(58%_0.19_25)] uppercase"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
        Kommt euch das bekannt vor?
      </p>
      <h2
        class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-[2.35rem] lg:leading-[1.15]"
      >
        Euer Ablauf ist euer Vorsprung.{' '}
        <span class="text-foreground-muted">Im Standard ist er ein Sonderfall.</span>
      </h2>
      <p class="text-foreground-secondary mt-5 text-[0.95rem] leading-7">
        Die Branchensoftware ist für alle gemacht. Euer Ablauf passt nur mit Zusatzfeldern hinein,
        und was wirklich zählt, rechnet jemand daneben.
      </p>
      <p class="text-foreground-secondary mt-4 hidden text-[0.95rem] leading-7 lg:block">
        Also wächst Excel daneben: Kalkulation, Einsatzplan, Auswertung für die Bank. Wie gerechnet
        wird, wissen zwei Leute im Haus.
      </p>
      <p class="text-foreground mt-4 text-[0.95rem] leading-7 font-semibold">
        Genau das, womit ihr Geld verdient, kennt euer Programm am schlechtesten.
      </p>
    </div>
    <div class="szene-auf order-1 lg:order-2" data-szene>
      <HeuteAbloesung />
    </div>
  </div>
</section>

<!-- 01 LANDSCHAFT -->
<section class:list={['bg-background relative overflow-x-clip py-16 lg:py-28', istFunnel && 'hidden lg:block']}>
  <div
    class="bg-brand-300/10 pointer-events-none absolute top-40 left-1/2 h-[40rem] w-[60rem] -translate-x-1/2 rounded-full blur-[120px]"
    aria-hidden="true"
  >
  </div>
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="01"
      eyebrow="Vorher, nachher"
      title="Aus acht Programmen wird eins. Stück für Stück."
      lead="Ein Abschnitt nach dem anderen zieht um. Buchhaltung und Lohn bleiben und werden angebunden."
    />
    <div
      class="szene-auf mx-auto mt-10 max-w-6xl lg:mt-14"
      data-szene
      data-szene-folge="[data-stand-btn='1'], [data-stand-btn='2']"
      data-szene-pause="1600"
      data-szene-takt="2600"
    >
      <Landschaft />
      <p class="z-note mt-4 text-center">Heute, nach 3 und nach 6 Monaten. Beispiel.</p>
    </div>
  </div>
</section>

<!-- 02 ABLÖSEPLAN -->
<section class="bg-background-secondary border-border relative border-y py-16 lg:py-28">
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="02"
      eyebrow="Der Weg dahin"
      title="Das Tagesgeschäft läuft weiter."
      lead="Das Neue geht Bereich für Bereich live, das Alte läuft so lange mit. Erst wenn alles stimmt, kommt der Stichtag."
    />
    <div
      class="szene-auf mx-auto mt-10 max-w-6xl lg:mt-14"
      data-szene
      data-szene-folge="[data-ms='p2'], [data-ms='fin'], [data-ms='st']"
      data-szene-pause="1800"
      data-szene-takt="2400"
    >
      <Abloeseplan variante="funnel" />
      <p class="z-note mt-4 text-center">
        Beispiel für einen Betrieb mit drei Bereichen. Klickt selbst auf die Meilensteine.
      </p>
    </div>
  </div>
</section>

<!-- 03 DATENÜBERNAHME -->
<section class:list={['bg-background relative overflow-x-clip py-20 lg:py-28', istFunnel && 'hidden lg:block']}>
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="03"
      eyebrow="Datenübernahme"
      title="Eure Daten kommen mit. Auch die alten."
      lead="Zuordnen, bereinigen, prüfen. Am Ende steht ein Prüfbericht: alt gegen neu."
    />
    <div
      class="szene-auf mx-auto mt-10 max-w-6xl lg:mt-14"
      data-szene
      data-szene-folge="[data-du-tab='bereinigen'], [data-du-tab='pruefen']"
      data-szene-pause="1800"
      data-szene-takt="2600"
    >
      <Datenuebernahme />
      <p class="z-note mt-4 text-center">So lief es bei FKC. Die Zahlen sind Beispiele.</p>
    </div>
  </div>
</section>

<!-- 04 FKC: Beweis aus der Praxis -->
<section class="bg-background-secondary border-border relative border-y py-20 lg:py-28">
  <div
    class="relative z-10 container grid max-w-7xl gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-16"
  >
    <div class:list={['szene-auf order-2 lg:order-1', istFunnel && 'hidden lg:block']} data-szene>
      <figure class="af-frame">
        <div class="af-bar" aria-hidden="true">
          <span class="af-dots"><span></span><span></span><span></span></span>
          <span class="af-url">FKC · Vertrieb</span>
          <span class="af-dots invisible"><span></span><span></span><span></span></span>
        </div>
        <Picture
          src={fkcKanban}
          alt="Vertrieb als Kanban-Board in der Anwendung von FKC"
          widths={[640, 960, 1280]}
          sizes="(max-width: 1024px) 100vw, 55vw"
          formats={['avif', 'webp']}
          class="block w-full"
          loading="lazy"
        />
      </figure>
    </div>
    <div class="af-rise order-1 lg:order-2">
      <SectionHeader
        size="md"
        align="left"
        number="04"
        eyebrow="In der Praxis"
        title="FKC: von Vertec zur eigenen Plattform."
      />
      <p class="text-foreground-secondary mt-6 text-base leading-7">
        Der Ablauf passte nur mit Umwegen in Vertec. Heute arbeitet eine eigene Anwendung vom
        Vertrieb bis zur Rechnung so wie FKC.
      </p>
      <dl class="mt-7 space-y-4" data-szene data-szene-kinder>
        {
          fkcFakten.map((f) => (
            <div class="flex gap-4">
              <dt class="font-display text-brand-600 dark:text-brand-300 w-24 shrink-0 text-xl font-bold tracking-tight whitespace-nowrap">
                {f.zahl}
              </dt>
              <dd class="text-foreground-secondary text-sm leading-6">{f.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<!-- 05 EHRLICH -->
<section class:list={['invert-section bg-surface-invert relative overflow-x-clip py-16 lg:py-28', istFunnel && 'hidden lg:block']}>
  <div class="relative z-10 container max-w-6xl">
    <SectionHeader
      size="md"
      invert
      number="05"
      eyebrow="Ehrlich gesagt"
      title="Nicht jeder Ablauf braucht eigene Software."
      lead="Wir verdienen daran, sie zu bauen. Trotzdem sagen wir es klar: Oft ist Bleiben besser. Es kommt darauf an, ob euer Ablauf euer Vorsprung ist."
    />
