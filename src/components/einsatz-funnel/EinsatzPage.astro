    bottom: -1.25rem;
    left: 1.125rem;
    width: 1px;
    background: var(--color-border);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-icon {
      animation: none;
    }
  }
</style>

<script>
  import { szenenStarten } from '@/lib/szene';
  szenenStarten();
  const heroScroll = document.querySelector<HTMLElement>('[data-hero-scroll]');
  if (heroScroll) {
    const sync = () => (heroScroll.dataset.hidden = window.scrollY > 40 ? 'true' : 'false');
    window.addEventListener('scroll', sync, { passive: true });
    sync();
  }
</script>
