---
/**
 * Nachbau „Auslastung nach Team“: Stunden gegen Kapazität je Team, 100-%-Linie,
 * Überlast schraffiert, Farbe nach Ampel. Der Schalter wechselt zwischen fest
 * beauftragten Stunden und „+ Geplant“ (inkl. eingeplanter, noch nicht gebuchter Termine).
 * Ein kleines Script (unten) tauscht Breiten und Werte; ohne JS steht die Fest-Ansicht da.
 */
import '@/components/angebote/frame.css';
import './zahlen.css';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  url?: string;
}
const { url = 'app.euer-betrieb.de/cockpit/team' } = Astro.props;

// Skala bis 125 %, damit die Überlast sichtbar bleibt.
const SCALE = 125;
type Team = { name: string; std: number; kap: number; plus: number };
const teams: Team[] = [
  { name: 'Team Hansestadt', std: 11259, kap: 9198, plus: 640 },
  { name: 'Team Nord', std: 9787, kap: 8148, plus: 410 },
  { name: 'Team Service', std: 5652, kap: 4774, plus: 120 },
  { name: 'Team Ost', std: 3281, kap: 2868, plus: 260 },
  { name: 'Team Schulung', std: 1885, kap: 1870, plus: 90 },
  { name: 'Team Nordwest', std: 2802, kap: 3061, plus: 330 },
  { name: 'Team Projekte', std: 2025, kap: 2280, plus: 240 },
  { name: 'Team Prüfung', std: 4124, kap: 4850, plus: 410 },
  { name: 'Team West', std: 974, kap: 1493, plus: 260 },
];
const sum = teams.reduce((a, t) => ({ std: a.std + t.std, kap: a.kap + t.kap, plus: a.plus + t.plus }), { std: 0, kap: 0, plus: 0 });
const rows = [...teams, { name: 'Gesamt', ...sum }];

const fmt = (n: number) => n.toLocaleString('de-DE');
const tone = (p: number) => (p >= 90 ? 'ok' : p >= 70 ? 'mid' : 'low');
const view = (std: number, kap: number) => {
  const p = Math.round((std / kap) * 100);
  return { p, tone: tone(p), fill: Math.min(p, 100) / SCALE * 100, over: p > 100 ? (Math.min(p, SCALE) - 100) / SCALE * 100 : 0, label: `${fmt(std)} Std. / ${fmt(kap)} Std. Kapazität` };
};
const hundred = (100 / SCALE) * 100;
---

<figure class="af-frame z-app" data-auslastung>
  <div class="af-bar" aria-hidden="true">
    <span class="af-dots"><span></span><span></span><span></span></span>
    <span class="af-url">{url}</span>
    <span class="af-dots invisible"><span></span><span></span><span></span></span>
  </div>
  <div class="p-3 sm:p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="flex items-center gap-1.5 text-sm font-bold">
        <Icon name="users" size="xs" class="z-muted" /> Auslastung nach Team
      </p>
      <div class="z-seg" role="group" aria-label="Stunden">
        <button type="button" aria-pressed="true" data-mode="fest">Fest</button>
        <button type="button" aria-pressed="false" data-mode="plan">+ Geplant</button>
      </div>
    </div>

    <ul class="mt-4 space-y-2.5">
      {
        rows.map((r) => {
          const a = view(r.std, r.kap);
          const b = view(r.std + r.plus, r.kap);
          const gesamt = r.name === 'Gesamt';
          return (
            <li
              class:list={['grid grid-cols-[minmax(0,1fr)_3.5rem] items-center gap-x-3 gap-y-1.5 sm:grid-cols-[minmax(0,12rem)_minmax(0,1fr)_3.25rem]', gesamt && 'mt-3 border-t pt-3']}
              style={gesamt ? 'border-color: var(--z-line)' : undefined}
              data-row
              data-fest={JSON.stringify(a)}
              data-plan={JSON.stringify(b)}
            >
              <div class="min-w-0">
                <p class:list={['truncate text-xs sm:text-[0.82rem]', gesamt ? 'font-bold' : 'font-medium']}>{r.name}</p>
                <p class="z-label underline decoration-dotted underline-offset-2" data-label>{a.label}</p>
              </div>
              <div class="z-bar-track order-2 col-span-2 sm:order-none sm:col-span-1">
                <span class="z-bar-fill" data-fill data-tone={a.tone} style={`width:${a.fill}%`} />
                <span class="z-bar-over" data-over style={`left:${hundred}%;width:${a.over}%`} />
                <span class="z-hundred" style={`left:${hundred}%`} />
              </div>
              <p class:list={['order-1 self-start text-right text-xs sm:order-none sm:self-auto sm:text-sm', gesamt ? 'font-bold' : 'font-semibold']} data-pct>
                {a.p} %
              </p>
            </li>
          );
        })
      }
    </ul>
    <p class="z-label mt-4 flex flex-wrap items-center gap-x-4 gap-y-1">
      <span class="flex items-center gap-1.5"><span class="z-dot" style="background: var(--z-blue)"></span>ab 90 %</span>
      <span class="flex items-center gap-1.5"><span class="z-dot" style="background: var(--z-lime)"></span>70 bis 90 %</span>
      <span class="flex items-center gap-1.5"><span class="z-dot" style="background: var(--z-red)"></span>unter 70 %</span>
      <span class="flex items-center gap-1.5"><span class="z-dot" style="background: repeating-linear-gradient(135deg, var(--z-blue-hatch) 0 2px, var(--z-blue) 2px 4px)"></span>über Kapazität</span>
    </p>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('[data-auslastung]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-mode]');
    const apply = (mode: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', b.dataset.mode === mode ? 'true' : 'false'));
      root.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
        const v = JSON.parse(row.dataset[mode === 'plan' ? 'plan' : 'fest'] ?? '{}');
        const fill = row.querySelector<HTMLElement>('[data-fill]');
        const over = row.querySelector<HTMLElement>('[data-over]');
        if (fill) {
          fill.style.width = `${v.fill}%`;
          fill.dataset.tone = v.tone;
        }
        if (over) over.style.width = `${v.over}%`;
        const pct = row.querySelector('[data-pct]');
        if (pct) pct.textContent = `${v.p} %`;
        const label = row.querySelector('[data-label]');
        if (label) label.textContent = v.label;
      });
    };
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.mode ?? 'fest')));
  });
</script>
