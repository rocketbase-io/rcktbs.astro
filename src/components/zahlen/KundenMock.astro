---
/**
 * Nachbau aus dem Kunden-Cockpit: Bestand nach Kategorie (Jahres-Vertragswert, Anteil)
 * und nach Klassifizierung (Bestand, neu, reaktiviert) als Ring. Beispieldaten.
 */
import '@/components/angebote/frame.css';
import './zahlen.css';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

interface Props {
  url?: string;
}
const { url = 'app.euer-betrieb.de/cockpit/kunden' } = Astro.props;

const kategorien = [
  { k: 'VIP', n: 17, wert: '1,49 Mio. €', anteil: 29.4 },
  { k: 'A', n: 37, wert: '991,6 Tsd. €', anteil: 19.5 },
  { k: 'B', n: 59, wert: '834,7 Tsd. €', anteil: 16.4 },
  { k: 'C', n: 117, wert: '833,7 Tsd. €', anteil: 16.4 },
  { k: 'D', n: 498, wert: '924,2 Tsd. €', anteil: 18.2 },
];

const klassen = [
  { label: 'Bestandskunde', n: 660, color: 'oklch(60% 0.09 300)' },
  { label: 'Neu', n: 66, color: 'oklch(80% 0.09 350)' },
  { label: 'Reaktiviert', n: 2, color: 'oklch(68% 0.12 160)' },
];
const total = klassen.reduce((s, k) => s + k.n, 0);
const R = 46;
const C = 2 * Math.PI * R;
let offset = 0;
const ring = klassen.map((k) => {
  const len = (k.n / total) * C;
  const seg = { ...k, dash: `${len} ${C - len}`, offset: -offset, pct: ((k.n / total) * 100).toFixed(2).replace('.', ',') };
  offset += len;
  return seg;
});

const teams = [
  { team: 'Team Hansestadt', kunden: 198, ist: '841,2 Tsd. €', prognose: '1,18 Mio. €' },
  { team: 'Team Nord', kunden: 256, ist: '642,3 Tsd. €', prognose: '995,5 Tsd. €' },
  { team: 'Team Service', kunden: 14, ist: '511,3 Tsd. €', prognose: '783,6 Tsd. €' },
  { team: 'Team Prüfung', kunden: 162, ist: '555,5 Tsd. €', prognose: '781,7 Tsd. €' },
];
---

<figure class="af-frame z-app">
  <div class="af-bar" aria-hidden="true">
    <span class="af-dots"><span></span><span></span><span></span></span>
    <span class="af-url">{url}</span>
    <span class="af-dots invisible"><span></span><span></span><span></span></span>
  </div>
  <div class="grid gap-3 p-3 sm:p-5 lg:grid-cols-[1fr_1fr_1fr]">
    <div class="z-card p-3 sm:p-4">
      <p class="flex items-center gap-1.5 text-sm font-bold"><Icon name="star" size="xs" class="z-muted" /> Kunden nach Kategorie</p>
      <table class="mt-3 w-full text-left text-[0.78rem]">
        <thead>
          <tr class="z-muted text-[0.7rem]">
            <th class="py-1 font-medium">Kategorie</th>
            <th class="py-1 text-right font-medium">Anzahl</th>
            <th class="py-1 text-right font-medium">Vertragswert 2026</th>
            <th class="py-1 text-right font-medium">Anteil</th>
          </tr>
        </thead>
        <tbody>
          {
            kategorien.map((r) => (
              <tr class="border-t" style="border-color: var(--z-line)">
                <td class="py-1.5 font-semibold">{r.k}</td>
                <td class="py-1.5 text-right underline decoration-dotted underline-offset-2">{r.n}</td>
                <td class="py-1.5 text-right">{r.wert}</td>
                <td class="py-1.5 text-right">{r.anteil.toFixed(1).replace('.', ',')} %</td>
              </tr>
            ))
          }
        </tbody>
        <tfoot>
          <tr class="border-t-2" style="border-color: var(--z-line)">
            <td class="pt-2 font-bold">Gesamt</td>
            <td class="pt-2 text-right font-bold">728</td>
            <td class="pt-2 text-right font-bold">5,08 Mio. €</td>
            <td class="pt-2 text-right font-bold">100 %</td>
          </tr>
        </tfoot>
      </table>
      <p class="z-label mt-3">Die VIP-Kunden, 2 % des Bestands, tragen 29 % des Vertragswerts.</p>
    </div>

      <div class="z-card p-3 sm:p-4">
        <p class="flex items-center gap-1.5 text-sm font-bold"><Icon name="layers" size="xs" class="z-muted" /> Kunden nach Klassifizierung</p>
        <div class="mt-3 flex items-center gap-4">
          <svg viewBox="0 0 120 120" class="h-28 w-28 shrink-0 -rotate-90" aria-hidden="true">
            {ring.map((s) => <circle cx="60" cy="60" r={R} fill="none" stroke={s.color} stroke-width="16" stroke-dasharray={s.dash} stroke-dashoffset={s.offset} />)}
          </svg>
          <ul class="min-w-0 flex-1 space-y-1.5 text-[0.78rem]">
            {
              ring.map((s) => (
                <li class="flex items-center gap-2">
                  <span class="z-dot" style={`background:${s.color}`} />
                  <span class="flex-1 truncate">{s.label}</span>
                  <span class="z-muted underline decoration-dotted underline-offset-2">{s.n}</span>
                  <span class="w-14 text-right font-semibold">{s.pct} %</span>
                </li>
              ))
            }
            <li class="flex items-center gap-2 border-t pt-1.5 font-bold" style="border-color: var(--z-line)">
              <span class="flex-1 pl-4">Gesamt</span>
              <span>{total}</span>
              <span class="w-14 text-right">100 %</span>
            </li>
          </ul>
        </div>
      </div>
      <div class="z-card p-3 sm:p-4">
        <p class="flex items-center gap-1.5 text-sm font-bold"><Icon name="users" size="xs" class="z-muted" /> Kundenbetreuung je Team</p>
        <table class="mt-2 w-full text-left text-[0.75rem]">
          <thead>
            <tr class="z-muted text-[0.68rem]">
              <th class="py-1 font-medium">Team</th>
              <th class="py-1 text-right font-medium">Kunden</th>
              <th class="py-1 text-right font-medium">Ist</th>
              <th class="py-1 text-right font-medium">Prognose</th>
            </tr>
          </thead>
          <tbody>
            {
              teams.map((t) => (
                <tr class="border-t" style="border-color: var(--z-line)">
                  <td class="py-1.5">{t.team}</td>
                  <td class="py-1.5 text-right">{t.kunden}</td>
                  <td class="py-1.5 text-right">{t.ist}</td>
                  <td class="py-1.5 text-right font-semibold">{t.prognose}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
  </div>
</figure>
