---
/**
 * Inhalt der Tür 3 „Zahlen & Steuerung“, geteilt von zwei Seiten (wie AngebotePage):
 *   /f/zahlen/  (variant="funnel"): Anzeigen-Landing, FunnelLayout, noindex, Quiz im Hero und am Ende
 *   /zahlen/    (variant="site"):   Tür 3 in der Navigation, LandingLayout, indexiert, statt Quiz ein CTA
 * Entstanden 2026-10-07.
 *
 * Die Cockpit-Ansichten sind Nachbauten aus der laufenden Kundenlösung (Geschäftsführer-, Team-,
 * Kunden-Cockpit, Ressourcen-Dashboard) in HTML/SVG, mit Beispieldaten und neutralen Team- und
 * Bereichsnamen. Keine Screenshots: scharf auf jedem Bildschirm, Dark Mode, nichts Echtes.
 *
 * Keine Preise auf dieser Seite, auch kein „Festpreis“ (wie /f/angebote/). Der Workshop wird
 * genannt, seine Konditionen stehen nur auf /discovery-workshop/.
 *
 * Abgrenzung zu Tür 2 (Einsatz & Abrechnung): hier die Verdichtung (Cockpit, Prognose,
 * Auslastung bis zur Person, Wegfall, Kunden, Forderungen). Vorgaben je Mitarbeiter,
 * Leistungserfassung, Rechnungen und Mahnstufen gehören auf die Einsatz-Seite.
 */
import { zahlenFaqs } from './faqs';
import BlogQuerverweis from '@/components/blog/BlogQuerverweis.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Blueprint from '@/components/hero-backgrounds/Blueprint.astro';
import { ClientLogoStrip } from '@/components/ui/marketing/ClientLogoStrip';
import SectionHeader from '@/components/angebote/SectionHeader.astro';
import FunnelQuiz from '@/components/funnel/FunnelQuiz';
import { Picture } from 'astro:assets';
import founderPortrait from '@/assets/rocketbase/founder-marten-priess.jpg';
import type { FunnelQuizQuestion } from '@/data/funnels';
import { contactLinks } from '@/data/rocketbase';
import CockpitMock from './CockpitMock.astro';
import AuslastungTeams from './AuslastungTeams.astro';
import RessourcenDrilldown from './RessourcenDrilldown.astro';
import WegfallZiele from './WegfallZiele.astro';
import KundenMock from './KundenMock.astro';
import HeuteKalender from './HeuteKalender.astro';
import '@/components/angebote/frame.css';
import './zahlen.css';

interface Props {
  variant: 'funnel' | 'site';
}
const { variant } = Astro.props;
const istFunnel = variant === 'funnel';

const clientLogos = [
  { key: 'fkc_logo', name: 'FKC Consulting' },
  { key: 'statista-logo', name: 'Statista' },
  { key: 'stage_logo', name: 'Stage Entertainment' },
  { key: 'diezinger_logo', name: 'Schlosserei Diezinger' },
];

// Quiz: drei kurze Fragen, danach das Kontaktformular (Telefon Pflicht, Firma optional).
const quizFragen: FunnelQuizQuestion[] = [
  {
    id: 'heute',
    question: 'Woher kommen eure Zahlen heute?',
    hint: 'Grobe Einordnung reicht.',
    options: [
      { id: 'excel', label: 'Aus Excel, von Hand zusammengebaut', description: 'Exporte ziehen, abgleichen, Monat für Monat.' },
      { id: 'system', label: 'Aus Berichten im ERP oder der Branchensoftware', description: 'Die Standardberichte passen nicht ganz zu unseren Fragen.' },
      { id: 'bi', label: 'Aus einem BI-Tool', description: 'Power BI, Metabase oder ähnlich, aber die Pflege hängt an einer Person.' },
      { id: 'bwa', label: 'Von der BWA, einmal im Monat', description: 'Was im Betrieb los ist, sehen wir erst Wochen später.' },
      { id: 'sonstiges', label: 'Anders', allowText: true, textPlaceholder: 'Beschreibt in ein, zwei Sätzen, wie ihr heute an eure Zahlen kommt …' },
    ],
  },
  {
    id: 'zuerst',
    question: 'Was wollt ihr zuerst sehen?',
    hint: 'Das, was am meisten fehlt.',
    options: [
      { id: 'umsatz', label: 'Umsatz und Prognose', description: 'Wo stehen wir, wo landen wir am Jahresende?' },
      { id: 'auslastung', label: 'Auslastung der Mitarbeiter', description: 'Wer ist voll, wer hat Luft, und wie sieht es in drei Monaten aus?' },
      { id: 'db', label: 'Deckungsbeitrag', description: 'Woran verdienen wir, je Kunde, Vertrag, Produkt?' },
      { id: 'vertraege', label: 'Verträge und Forderungen', description: 'Was läuft aus, was ist offen, wer zahlt spät?' },
    ],
  },
  {
    id: 'groesse',
    question: 'Wie viele Leute arbeiten bei euch?',
    hint: 'Ungefähr reicht.',
    options: [
      { id: 'lt30', label: 'Unter 30' },
      { id: '30-80', label: '30 bis 80' },
      { id: '80-150', label: '80 bis 150' },
      { id: 'gt150', label: 'Über 150' },
    ],
  },
];

const quizProps = {
  funnel: 'zahlen',
  questions: quizFragen,
  contact: {
    heading: 'Wohin darf sich Marten Prieß melden?',
    text: 'Hinterlasst eure Kontaktdaten, Marten Prieß meldet sich werktags persönlich und sucht mit euch einen Termin.',
  },
  success: {
    heading: 'Danke, eure Nachricht ist angekommen.',
    text: 'Marten Prieß meldet sich werktags bei euch.',
  },
  submitLabel: 'Nachricht senden',
  phoneHint: 'Telefon für eine kurze Rückfrage. Wir rufen an, wenn es hilft.',
  leadEvent: 'zahlen_lead',
  privacyUrl: '/datenschutz/',
};


// 06: Fragen, die wir im Workshop mit euch klären, bevor eine Zahl gebaut wird.
const fragen = [
  {
    icon: 'users',
    frage: 'Was heißt bei euch „ausgelastet“?',
    text: 'Kapazität aus Vertragsstunden, abzüglich Urlaub, Krankheit, interner Zeit. Mit oder ohne Disposition. Fahrzeit als Leistung oder als Verlust. Erst wenn das feststeht, sagen 108 % etwas.',
  },
  {
    icon: 'trending-up',
    frage: 'Was zählt als Umsatz, und wann?',
    text: 'Abgerechnet, beauftragt, eingeplant, aus Angeboten erwartet. Jede Stufe hat ihre eigene Sicherheit. Die Prognose rechnet sie getrennt, damit niemand Pipeline für Umsatz hält.',
  },
  {
    icon: 'layers',
    frage: 'Woran verdient ihr wirklich?',
    text: 'Deckungsbeitrag je Vertrag, Kunde, Produkt und Team, gerechnet mit dem Kostensatz der Person, die arbeitet, nicht mit einem Mittelwert. Oft liegt die Überraschung bei den treuesten Kunden.',
  },
  {
    icon: 'clock',
    frage: 'Was fällt nächstes Jahr weg?',
    text: 'Verträge mit Enddatum, Kündigungen, Reduzierungen. Wer das im Oktober sieht, hat noch Zeit für Gespräche. Wer es im Februar sieht, hat ein Loch im Plan.',
  },
];

const quellen = ['ERP', 'Branchensoftware', 'Zeiterfassung', 'DATEV', 'CRM', 'Excel-Listen', 'Lohn & Gehalt'];

// 07: der Weg, ohne Preise.
const weg = [
  {
    number: '01',
    title: 'Erstgespräch',
    meta: '30 Minuten · kostenlos',
    text: 'Ihr erzählt, welche Zahlen heute fehlen und woher die vorhandenen kommen. Wir sagen ehrlich, ob und wie wir helfen können.',
  },
  {
    number: '02',
    title: 'Workshop',
    meta: 'drei Termine',
    text: 'Aufnahme bei euch, Abstimmung wenige Tage später, Übergabe mit der Geschäftsführung. Danach steht, welche Kennzahlen ihr braucht, wie sie gerechnet werden und aus welchen Systemen sie kommen.',
  },
  {
    number: '03',
    title: 'Euer Cockpit',
    meta: 'in Wochen live',
    text: 'Angebunden an das, was ihr habt, gerechnet nach euren Regeln. Erst die drei, vier Zahlen, die am meisten fehlen, dann wächst es mit.',
  },
];

const miniFaqs = zahlenFaqs;
---

<!-- HERO -->
<section
  data-hero
  class:list={['relative overflow-x-clip lg:flex lg:flex-col', istFunnel ? 'lg:min-h-[calc(100svh-3.5rem)]' : 'pt-16 lg:min-h-[100svh]']}
>
  <Blueprint />
  <div
    class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(ellipse_60%_50%_at_30%_40%,var(--color-background)_0%,transparent_75%)] opacity-80"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 mx-auto w-full max-w-[84rem] px-5 pt-8 pb-16 sm:px-8 sm:pt-14 lg:grid lg:flex-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.95fr)] lg:items-center lg:gap-16 lg:px-12 lg:py-6"
  >
    <div class="text-center lg:text-left">
      <p data-reveal="fade-down" class="text-brand-600 dark:text-brand-300 text-sm font-semibold tracking-[0.22em] uppercase">
        Zahlen &amp; Steuerung
      </p>
      <h1
        data-reveal="fade-down"
        lang="de"
        class="font-display text-foreground mt-3 text-[2.6rem] leading-[1.05] font-bold tracking-tight text-balance sm:mt-5 sm:text-6xl xl:text-[4.25rem]"
      >
        Euer Betrieb auf einen Blick.
        <span class="text-brand-500 block">Live, nicht am Monatsende.</span>
      </h1>
      <p data-reveal class="text-foreground-muted mt-6 hidden flex-wrap items-center justify-center gap-x-2.5 gap-y-2 text-sm font-medium sm:flex lg:justify-start">
        <span>Schluss mit</span>
        {['Monats-Excel', 'Warten auf die BWA', 'Bauchgefühl'].map((alt) => <span class="hero-alt border-border rounded-md border px-2 py-0.5">{alt}</span>)}
      </p>
      <p data-reveal class="text-foreground-secondary mx-auto mt-4 max-w-lg text-base leading-7 sm:mt-7 sm:text-lg sm:leading-8 lg:mx-0">
        Umsatz und Prognose, Auslastung bis zur einzelnen Person, Deckungsbeitrag, auslaufende
        Verträge. Aus den Systemen, die ihr habt, gerechnet nach euren Regeln.
      </p>
      <p class="text-foreground-muted border-border/70 bg-background/85 mx-auto mt-8 hidden max-w-lg rounded-xl border px-4 py-3 text-sm leading-6 backdrop-blur-sm lg:mx-0 lg:block">
        Aus einer laufenden Kundenlösung, für euren Betrieb angepasst. Ob Beratung, Prüfung,
        Wartung oder Service.
      </p>
    </div>

    {
      istFunnel ? (
        <div id="quiz" class="mt-7 scroll-mt-20 sm:mt-10 lg:mt-0 lg:min-h-[38rem]" data-quiz>
          <FunnelQuiz client:load {...quizProps} phoneRequired companyOptional markRequired compact />
        </div>
      ) : (
        <div class="mt-7 sm:mt-10 lg:mt-0 lg:flex lg:items-center">
          <div class="border-border bg-card/90 rounded-[2rem] border p-7 shadow-[0_22px_55px_rgba(34,43,74,0.10)] backdrop-blur-sm sm:p-9">
            <p class="text-brand-600 text-xs font-semibold tracking-[0.22em] uppercase">So fängt es an</p>
            <h2 class="font-display text-foreground mt-4 text-2xl font-bold tracking-tight">
              30 Minuten über die Zahlen, die euch heute fehlen.
            </h2>
            <p class="text-foreground-secondary mt-4 text-base leading-7">
              Ihr erzählt, wonach ihr steuern wollt und woher die Zahlen heute kommen. Wir sagen, was
              davon sich live rechnen lässt. Kostenlos, ohne Folien.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <Button size="lg" href={contactLinks.cal} target="_blank">
                Erstgespräch buchen
                <Icon name="arrow-up-right" size="sm" />
              </Button>
              <Button variant="outline" size="lg" href="/discovery-workshop/">
                Der Workshop danach
                <Icon name="arrow-right" size="sm" />
              </Button>
            </div>
            <div class="border-border/70 mt-6 flex items-center gap-3 border-t pt-5">
              <Picture src={founderPortrait} alt="Marten Prieß" widths={[48, 96]} sizes="48px" formats={['avif', 'webp']} class="h-12 w-12 shrink-0 rounded-full object-cover" loading="lazy" />
              <p class="text-sm leading-6">
                <span class="text-foreground block font-semibold">Marten Prieß</span>
                <span class="text-foreground-secondary">Gründer von RocketBase, führt das Gespräch selbst.</span>
              </p>
            </div>
          </div>
        </div>
      )
    }
  </div>

  <div class="relative z-10">
    <a
      href="#heute"
      class="hero-scroll absolute top-0 left-1/2 z-20 hidden h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full lg:flex"
      aria-label="Weiter nach unten"
      data-hero-scroll
    >
      <span class="hero-scroll-icon flex"><Icon name="chevron-down" size="sm" /></span>
    </a>
    <ClientLogoStrip heading="Aus Projekten mit" logos={clientLogos} variant="light" uniform class="py-10 lg:py-11" />
  </div>
</section>

<!-- HEUTE: der Ist-Zustand -->
<section id="heute" class="heute-sec border-border relative scroll-mt-14 overflow-x-clip border-b pt-16 pb-12 sm:py-20 lg:py-24">
  <div class="container grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:items-center lg:gap-16">
    <div class="af-rise">
      <p class="inline-flex items-center gap-2 font-mono text-xs font-semibold tracking-[0.2em] text-[oklch(58%_0.19_25)] uppercase">
        <span class="h-1.5 w-1.5 rounded-full bg-current"></span>
        Kommt euch das bekannt vor?
      </p>
      <h2 class="font-display text-foreground mt-4 text-3xl font-bold tracking-tight text-balance sm:text-4xl lg:text-[2.35rem] lg:leading-[1.15]">
        Die Zahlen gibt es.{' '}
        <span class="text-foreground-muted">Nur nicht dann, wenn ihr sie braucht.</span>
      </h2>
      <p class="text-foreground-secondary mt-5 text-[0.95rem] leading-7">
        Umsatz steht in der Buchhaltung, Stunden in der Zeiterfassung, Verträge im ERP oder in der
        Branchensoftware. Wer wissen will, wie der Monat läuft, zieht Exporte, gleicht ab und baut eine
        Auswertung, die beim nächsten Mal wieder von vorn beginnt. Die BWA kommt drei Wochen später und
        sagt, was war, nicht was kommt.
      </p>
      <p class="text-foreground-secondary mt-4 text-[0.95rem] leading-7">
        Und die wichtigen Fragen beantwortet keine davon: Wer ist im nächsten Quartal überlastet? Welche
        Verträge laufen aus, ohne dass jemand nachfasst? Woran verdient ihr, und woran nicht?
      </p>
      <p class="text-foreground mt-4 text-[0.95rem] leading-7 font-semibold">
        Gesteuert wird dann nach Gefühl. Meistens liegt es richtig. Manchmal teuer daneben.
      </p>
    </div>

    <div class="af-rise">
      <HeuteKalender />
    </div>
  </div>
</section>

<!-- 01 DAS COCKPIT -->
<section id="cockpit" class="bg-background relative scroll-mt-16 overflow-x-clip py-24 lg:py-32">
  <div class="bg-brand-300/10 pointer-events-none absolute top-40 left-1/2 h-[40rem] w-[60rem] -translate-x-1/2 rounded-full blur-[120px]" aria-hidden="true"></div>
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="01"
      eyebrow="Das Cockpit"
      title="Was heute los ist, ohne dass jemand eine Excel baut."
      lead="Umsatz abgerechnet und erwartet, Deckungsbeitrag, Auslastung, offene Forderungen, wer was einbringt. Jeden Morgen aktuell, für jeden Zeitraum, bis zum einzelnen Vertrag aufklappbar. So sieht das bei einem unserer Kunden aus:"
    />
    <div class="af-rise mx-auto mt-14 max-w-6xl lg:mt-16">
      <CockpitMock />
      <p class="z-note mt-4 text-center">Nachgebaut aus einer laufenden Kundenlösung. Namen und Zahlen sind Beispieldaten.</p>
    </div>
  </div>
</section>

<!-- 02 AUSLASTUNG -->
<section class="bg-background-secondary border-border relative border-y py-24 lg:py-28">
  <div class="relative z-10 container grid max-w-7xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-center lg:gap-16">
    <div class="af-rise">
      <SectionHeader size="md" align="left" number="02" eyebrow="Auslastung" title="Wer ist voll, wer hat Luft?" />
      <p class="text-foreground-secondary mt-6 text-base leading-7">
        Stunden gegen Kapazität, je Team und je Person, für jeden Zeitraum. Fest beauftragte Arbeit
        getrennt von dem, was nur geplant ist. Über 100 % ist schraffiert, unter 70 % rot.
      </p>
      <ul class="mt-6 space-y-3 text-[0.95rem] leading-7">
        {
          [
            'Kapazität aus Vertragsstunden, Urlaub, Krankheit und interner Zeit, nicht aus einer Pauschale',
            'Mit und ohne Disposition, mit und ohne erwartete Angebote',
            'Neue Aufträge dort einplanen, wo wirklich Luft ist',
          ].map((t) => (
            <li class="flex gap-3">
              <Icon name="check-circle" size="sm" class="text-brand-500 mt-1 shrink-0" />
              <span class="text-foreground-secondary">{t}</span>
            </li>
          ))
        }
      </ul>
      <p class="z-note mt-6">Probiert den Schalter „+ Geplant“ an der Ansicht.</p>
    </div>
    <div class="af-rise">
      <AuslastungTeams />
    </div>
  </div>
</section>

<!-- 03 BIS ZUR PERSON -->
<section class="bg-background relative overflow-x-clip py-24 lg:py-32">
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="03"
      eyebrow="Bis zur Person"
      title="Soll gegen Ist, Monat für Monat."
      lead="Ein Klick auf eine Person zeigt, wie ihr Jahr aussieht: was gebucht ist, was eingeplant ist und was aus Verträgen noch kommt, gegen die Stunden, die sie tatsächlich hat. Vergangene Monate sind Ist, kommende Prognose. Überlast fällt im Oktober auf, nicht erst im Dezember."
    />
    <div class="af-rise mx-auto mt-14 max-w-6xl lg:mt-16">
      <RessourcenDrilldown />
      <p class="z-note mt-4 text-center">Wechselt oben zwischen den Personen und klappt „Gebucht“ auf. Beispieldaten.</p>
    </div>
  </div>
</section>

<!-- 04 VERTRÄGE UND ZIELE -->
<section class="bg-background-secondary border-border relative border-y py-24 lg:py-28">
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="04"
      eyebrow="Verträge und Ziele"
      title="Was nächstes Jahr fehlt, seht ihr in diesem."
      lead="Wer von Dauerverträgen lebt, verliert Umsatz leise: ein Vertrag endet, einer wird reduziert, einer wird nicht verlängert. Das Cockpit zeigt den Wegfall ins Folgejahr je Bereich und den Stand gegen eure Umsatzziele, solange noch Zeit für Gespräche ist."
    />
    <div class="af-rise mx-auto mt-14 max-w-6xl lg:mt-16">
      <WegfallZiele />
    </div>
  </div>
</section>

<!-- 05 KUNDEN -->
<section class="bg-background relative overflow-x-clip py-24 lg:py-28">
  <div class="relative z-10 container max-w-7xl">
    <SectionHeader
      size="md"
      number="05"
      eyebrow="Kunden"
      title="Wer trägt euren Umsatz?"
      lead="Bestand nach Kategorie und Vertragswert, neu gewonnen, reaktiviert, je Team betreut. Meist zeigt sich, dass wenige Kunden einen großen Teil tragen und bei vielen kleinen der zweite Vertrag fehlt. Beides ist eine Vertriebsaufgabe, die vorher niemand sehen konnte."
    />
    <div class="af-rise mx-auto mt-14 max-w-6xl lg:mt-16">
      <KundenMock />
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-band relative overflow-x-clip py-20 lg:py-24">
  <div class="bg-grid-pattern pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_70%_90%_at_80%_50%,black,transparent_75%)] opacity-[0.08]" aria-hidden="true"></div>
  <div class="af-rise relative z-10 container grid max-w-6xl gap-10 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-16">
    <div class="max-w-xl">
      <h2 class="font-display text-foreground text-2xl font-bold tracking-tight text-balance sm:text-3xl lg:text-[2.25rem] lg:leading-tight">
        Welche Zahlen fehlen euch?
      </h2>
      <p class="text-brand-600 dark:text-brand-300 mt-2 text-sm font-semibold">30 Minuten · online · kostenlos</p>
      <p class="text-foreground-secondary mt-4 text-[0.95rem] leading-7">
        Erzählt uns, wonach ihr steuern wollt und woher die Zahlen heute kommen. Wir sagen euch ehrlich,
        was sich davon live rechnen lässt und was nicht.
      </p>
    </div>
    <div class="lg:justify-self-end">
      <Button size="lg" href={istFunnel ? '#kontakt' : contactLinks.cal} target={istFunnel ? undefined : '_blank'} class="bg-brand-500 hover:bg-brand-400 text-white shadow-[0_14px_34px_-12px_var(--color-brand-500)]">
        <Icon name={istFunnel ? 'mail' : 'arrow-up-right'} size="sm" />
        {istFunnel ? 'Kontakt aufnehmen' : 'Erstgespräch buchen'}
      </Button>
    </div>
  </div>
</section>

<!-- 06 BERATUNG: erst die Fragen, dann die Zahlen -->
<section class="invert-section bg-surface-invert relative overflow-x-clip py-20 lg:py-28">
  <div class="relative z-10 container max-w-6xl">
    <SectionHeader
      size="md"
      invert
      number="06"
      eyebrow="Erst die Fragen"
      title="Ein Cockpit ist nur so gut wie die Fragen dahinter."
      lead="Die meisten Auswertungen scheitern nicht an der Technik, sondern an der Definition. Deshalb klären wir mit euch zuerst, was eure Zahlen bedeuten sollen, und bauen dann. Das sind die Fragen, die in jedem Workshop auf den Tisch kommen:"
    />
    <div class="mt-14 grid gap-4 sm:grid-cols-2">
      {
        fragen.map((f) => (
          <article class="af-rise rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur sm:p-7">
            <span class="bg-brand-500/20 text-brand-200 flex h-10 w-10 items-center justify-center rounded-xl">
              <Icon name={f.icon} size="sm" />
            </span>
            <h3 class="font-display text-on-invert mt-5 text-lg font-bold tracking-tight sm:text-xl">{f.frage}</h3>
            <p class="text-on-invert-secondary mt-3 text-[0.95rem] leading-7">{f.text}</p>
          </article>
        ))
      }
    </div>
    <div class="af-rise mt-10 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-2xl border border-white/10 bg-white/[0.03] px-5 py-4">
      <span class="text-on-invert-secondary mr-1 text-sm font-semibold">Die Daten kommen aus dem, was ihr habt:</span>
      {quellen.map((q) => <span class="text-on-invert rounded-full border border-white/15 px-3 py-1 text-xs font-semibold">{q}</span>)}
    </div>
  </div>
</section>

<!-- 07 SO KOMMT IHR DAZU -->
<section id="ablauf" class="bg-background-secondary border-border relative scroll-mt-16 border-b py-20 lg:py-24">
  <div class="relative z-10 container max-w-6xl">
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
