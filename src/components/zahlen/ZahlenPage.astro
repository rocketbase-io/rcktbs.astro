<style>
  .hero-scroll {
    color: var(--color-foreground-secondary);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: 0 14px 30px -14px oklch(30% 0.08 265 / 0.45);
    transition:
      opacity 0.3s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  @media (hover: hover) {
    .hero-scroll:hover {
      color: var(--color-brand-600);
      border-color: color-mix(in oklch, var(--color-brand-400) 60%, var(--color-border));
    }
  }
  .hero-scroll[data-hidden='true'] {
    opacity: 0;
    pointer-events: none;
  }
  .hero-scroll-icon {
    animation: hero-scroll-bob 1.8s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes hero-scroll-bob {
    0%,
    100% {
      transform: translateY(-2px);
    }
    50% {
      transform: translateY(3px);
    }
  }
  .hero-alt {
    text-decoration: line-through;
    text-decoration-color: color-mix(in oklch, var(--color-brand-500) 70%, transparent);
    text-decoration-thickness: 2px;
    background: var(--color-card);
  }
  .heute-sec {
    background:
      radial-gradient(50% 70% at 85% 50%, color-mix(in oklch, oklch(60% 0.19 25) 6%, transparent), transparent 70%),
      var(--color-background-secondary);
  }
  .cta-band {
    background:
      radial-gradient(55% 140% at 90% 50%, color-mix(in oklch, var(--color-brand-400) 28%, transparent), transparent 70%),
      radial-gradient(45% 120% at 0% 100%, color-mix(in oklch, var(--color-brand-300) 18%, transparent), transparent 70%),
      color-mix(in oklch, var(--color-brand-500) 9%, var(--color-background));
  }
  .kontakt-sec {
    background:
      radial-gradient(55% 80% at 85% 40%, color-mix(in oklch, var(--color-brand-400) 16%, transparent), transparent 70%),
      color-mix(in oklch, var(--color-brand-500) 6%, var(--color-background));
  }
  .kontakt-ablauf > li:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 2.5rem;
    bottom: -1.25rem;
    left: 1.125rem;
    width: 1px;
    background: var(--color-border);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scroll-icon {
      animation: none;
    }
  }
</style>

<script>
  const heroScroll = document.querySelector<HTMLElement>('[data-hero-scroll]');
  if (heroScroll) {
    const sync = () => (heroScroll.dataset.hidden = window.scrollY > 40 ? 'true' : 'false');
    window.addEventListener('scroll', sync, { passive: true });
    sync();
  }
</script>
