---
/**
 * Zwei Karten nebeneinander, nachgebaut aus dem Geschäftsführer-Cockpit:
 * links der Vertragswert, der ins Folgejahr wegfällt (enden, ohne Folgevertrag, reduziert),
 * rechts der Stand gegen die Umsatzziele je Geschäftsbereich. Beispieldaten.
 */
import '@/components/angebote/frame.css';
import './zahlen.css';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';

const wegfall = [
  { bereich: 'Wartungsverträge', projekte: 153, std: '−8.291,82', wert: '−925,46 Tsd. €' },
  { bereich: 'Schulungen', projekte: 90, std: '−1.042,53', wert: '−119,12 Tsd. €' },
  { bereich: 'Beratung', projekte: 23, std: '−878,82', wert: '−113,58 Tsd. €' },
  { bereich: 'Prüfungen', projekte: 19, std: '−713,89', wert: '−88,39 Tsd. €' },
];

const SCALE = 115;
const ziele = [
  { bereich: 'Schulungen', ist: '252,3 Tsd. €', ziel: '235,8 Tsd. €', pct: 107.01, diff: '+16,52 Tsd. €' },
  { bereich: 'Wartungsverträge', ist: '2,76 Mio. €', ziel: '2,84 Mio. €', pct: 97.42, diff: '−73,28 Tsd. €' },
  { bereich: 'Prüfungen', ist: '639,1 Tsd. €', ziel: '669,4 Tsd. €', pct: 95.49, diff: '−30,22 Tsd. €' },
  { bereich: 'Beratung', ist: '257,6 Tsd. €', ziel: '297,3 Tsd. €', pct: 86.65, diff: '−39,68 Tsd. €' },
];
const gesamt = { bereich: 'Gesamt', ist: '3,91 Mio. €', ziel: '4,04 Mio. €', pct: 96.86, diff: '−126,66 Tsd. €' };
const pctTxt = (p: number) => p.toFixed(2).replace('.', ',') + ' %';
const tone = (p: number) => (p >= 90 ? 'ok' : p >= 70 ? 'mid' : 'low');
const hundred = (100 / SCALE) * 100;
---

<div class="z-app grid gap-4 rounded-[1.25rem] lg:grid-cols-2" style="background: transparent">
  <figure class="af-frame z-app">
    <div class="p-4 sm:p-5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="flex items-center gap-1.5 text-sm font-bold">
          <Icon name="clock" size="xs" class="z-muted" /> Vertragswert-Wegfall
          <span class="z-muted text-xs font-medium">2026 → 2027</span>
        </p>
        <div class="z-seg" aria-hidden="true">
          <button type="button" aria-pressed="true">Bereiche</button>
          <button type="button">Gründe</button>
        </div>
      </div>
      <div class="mt-3 overflow-x-auto">
        <table class="w-full min-w-[22rem] text-left text-[0.78rem]">
          <thead>
            <tr class="z-muted text-[0.7rem]">
              <th class="py-1.5 font-medium">Geschäftsbereich</th>
              <th class="py-1.5 text-right font-medium">Projekte</th>
              <th class="py-1.5 text-right font-medium">Stunden</th>
              <th class="py-1.5 text-right font-medium">Vertragswert</th>
            </tr>
          </thead>
          <tbody>
            {
              wegfall.map((r) => (
                <tr class="border-t" style="border-color: var(--z-line)">
                  <td class="py-2 font-medium">{r.bereich}</td>
                  <td class="py-2 text-right">{r.projekte}</td>
                  <td class="z-muted py-2 text-right">{r.std} Std.</td>
                  <td class="py-2 text-right font-bold">{r.wert}</td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr class="border-t-2" style="border-color: var(--z-line)">
              <td class="pt-2.5 pb-1 font-bold">
                Gesamt
                <span class="z-label block font-normal">164 enden · 115 ohne Folgevertrag · 6 reduziert</span>
              </td>
              <td class="pt-2.5 pb-1 text-right font-semibold">285</td>
              <td class="z-muted pt-2.5 pb-1 text-right">−10.927,06 Std.</td>
              <td class="z-over pt-2.5 pb-1 text-right font-bold">−1,25 Mio. €</td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </figure>

  <figure class="af-frame z-app">
    <div class="p-4 sm:p-5">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="flex items-center gap-1.5 text-sm font-bold">
          <Icon name="trending-up" size="xs" class="z-muted" /> Umsatzziele nach Geschäftsbereich
          <span class="z-muted text-xs font-medium">2026</span>
        </p>
        <div class="z-seg" aria-hidden="true">
          <button type="button" aria-pressed="true">Fest</button>
          <button type="button">+ Geplant</button>
        </div>
      </div>
      <ul class="mt-4 space-y-3">
        {
          [...ziele, gesamt].map((z) => (
            <li
              class:list={['grid grid-cols-[minmax(0,11.5rem)_minmax(0,1fr)_5.5rem] items-center gap-3', z.bereich === 'Gesamt' && 'border-t pt-3']}
              style={z.bereich === 'Gesamt' ? 'border-color: var(--z-line)' : undefined}
            >
              <div class="min-w-0">
                <p class:list={['truncate text-[0.8rem]', z.bereich === 'Gesamt' ? 'font-bold' : 'font-medium']}>{z.bereich}</p>
                <p class="z-label truncate">
                  {z.ist} / {z.ziel} Ziel
                </p>
              </div>
              <div class="z-bar-track">
                <span class="z-bar-fill" data-tone={tone(z.pct)} style={`width:${(Math.min(z.pct, 100) / SCALE) * 100}%`} />
                {z.pct > 100 && <span class="z-bar-over" style={`left:${hundred}%;width:${((z.pct - 100) / SCALE) * 100}%`} />}
                <span class="z-hundred" style={`left:${hundred}%`} />
              </div>
              <p class="text-right text-[0.78rem] leading-tight">
                <span class="font-bold underline decoration-dotted underline-offset-2">{pctTxt(z.pct)}</span>
                <span class:list={['block text-[0.66rem]', z.diff.startsWith('+') ? 'z-up' : 'z-muted']}>{z.diff}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </figure>
</div>
