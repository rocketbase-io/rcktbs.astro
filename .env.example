# =============================================================================
# Velocity - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Variables prefixed with PUBLIC_ are exposed to the browser - NEVER prefix secrets

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Your production site URL (used for sitemap, canonical URLs, OG images)
SITE_URL=https://example.com

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------

# Plunk secret key for contact form email sending (server-side only — never expose to browser)
# PLUNK_SECRET_KEY=sk_
# Recipient address for contact form notifications
# CONTACT_NOTIFICATION_EMAIL=you@example.com

# Plausible Analytics per-site script ID (cookieless, no consent required)
# Find this in your Plausible dashboard under Site Settings → Tracker; it looks like pa-XXXXXXXX
# PUBLIC_PLAUSIBLE_SCRIPT_ID=pa-yhySJdsGHFMqpcbsczFVd

# LinkedIn Insight Tag partner ID (requires marketing consent)
# PUBLIC_LINKEDIN_PARTNER_ID=5204394

# Meta (Facebook/Instagram) Pixel — requires marketing consent
# Two-part setup: the browser pixel and the server-side Conversions API.
#
# 1) Browser pixel — MUST use the PUBLIC_ prefix so Astro ships it to the browser.
#    Find the ID in Meta Events Manager → Data sources → your pixel (e.g. Leadgen-Pixel).
# PUBLIC_META_PIXEL_ID=3024094301086107
#
# 2) Conversions API (server-side, in netlify/functions/funnel-lead.ts) — NO PUBLIC_ prefix.
#    META_PIXEL_ID is the SAME id as above, just without PUBLIC_ (server can't read PUBLIC_ vars reliably at runtime).
#    META_CAPI_TOKEN is SECRET — generate it in Events Manager → pixel → Settings → Conversions API → Generate access token.
#    Set these two in Netlify (Site configuration → Environment variables), never commit the token.
# META_PIXEL_ID=3024094301086107
# META_CAPI_TOKEN=EAAG...secret...
#
# Optional: while testing, paste the Test Event Code from Events Manager → Test events
#    so server events show up there without polluting live data. Remove it for production.
# META_CAPI_TEST_EVENT_CODE=TEST12345

# Google Analytics 4 Measurement ID
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID
# PUBLIC_GTM_ID=GTM-XXXXXXX

# -----------------------------------------------------------------------------
# Form Handling (optional)
# -----------------------------------------------------------------------------

# External endpoint for contact form submissions
# CONTACT_FORM_ENDPOINT=https://api.example.com/contact

# Newsletter service API key (server-side only)
# NEWSLETTER_API_KEY=your-api-key

# -----------------------------------------------------------------------------
# Search Engine Verification (optional)
# -----------------------------------------------------------------------------

# Google Search Console verification code
# GOOGLE_SITE_VERIFICATION=your-verification-code

# Bing Webmaster Tools verification code
# BING_SITE_VERIFICATION=your-verification-code

# -----------------------------------------------------------------------------
# Consent / Privacy (optional)
# -----------------------------------------------------------------------------

# Enable the cookie consent banner (requires analytics to be configured)
# PUBLIC_CONSENT_ENABLED=true

# Link to your privacy policy page (shown in consent banner when set)
# PUBLIC_PRIVACY_POLICY_URL=/datenschutz
